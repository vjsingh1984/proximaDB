@startuml
title Unified Vector Search Architecture with Multi-Tier Deduplication

package "API Layer" {
  [REST Handler] as REST
  [gRPC Handler] as GRPC
}

package "Service Layer" {
  [VectorService] as VS
  [CollectionService] as CS
  
  VS --> CS : collection metadata
}

package "Unified Search Factory" {
  component [SearchEngineFactory] as SEF
  note right of SEF : search_with_deduplication()\ncreate_for_collection()\ncreate_optimized_hints()
  
  component [MultiTierDeduplicator] as MTD
  note right of MTD : add_tier_results()\nget_final_results()\nID-based deduplication
  
  SEF --> MTD : unified deduplication
}

package "Storage-Aware Search Engines" {
  interface "StorageSearchEngine" as SSE
  note right of SSE : search_vectors()\nsearch_capabilities()\nengine_type()
  
  component [ViperSearchEngine] as VSE
  component [LSMSearchEngine] as LSE
  
  VSE ..|> SSE
  LSE ..|> SSE
}

package "Storage Tiers" {
  package "WAL (Unflushed)" {
    [WAL Manager] as WAL
    [Memtable] as MEM
    
    WAL --> MEM : in-memory data
  }
  
  package "VIPER Storage (Compacted)" {
    [ViperCoreEngine] as VCE
    [Parquet Files] as PF
    [ML Clustering] as MLC
    
    VCE --> PF
    VCE --> MLC
  }
  
  package "LSM Storage (Flushed)" {
    [LsmTree] as LT
    [SSTable] as ST
    [BloomFilter] as BF
    
    LT --> ST
    LT --> BF
  }
}

' Connections
REST --> VS
GRPC --> VS

VS --> SEF : unified search request

SEF --> WAL : search unflushed (priority 1)
SEF --> SSE : search flushed/compacted
SEF --> MTD : deduplicate by ID

VSE --> VCE : VIPER optimizations
LSE --> LT : LSM optimizations

note right of SEF
  Unified Search Pipeline:
  1. Search WAL (unflushed)
  2. Search storage engines
  3. Multi-tier deduplication
  4. Latest version wins
  5. Return top-k results
end note

note left of MTD
  Deduplication Priority:
  Unflushed > Flushed > Compacted
  
  Ordering: Sequence > Version > Timestamp
end note

@enduml