{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proximadb.io/contracts/statistics-envelope/v1",
  "title": "StatisticsEnvelope",
  "x-envelope-version": "1.0.0",
  "x-owner": "proximaDB (OSS) — sole producer; see ProximaDB ADR-037",
  "x-consumer": "AnvaiOps — see AnvaiOps ADR-0021 (pins this schema under pricing/)",
  "description": "Versioned, modality-neutral statistics envelope: the boundary object between the OSS engine (producer) and AnvaiOps (consumer). Carries UNITS and DISTRIBUTIONS only. It MUST NOT carry meaning or money: no descriptions/glossary, no data-quality grade, no PII classification, no per-account scope, no pricing/$ — those are AnvaiOps-owned (ADR-0021). The engine attests a freshness FACT (a watermark), never an SLA. additionalProperties is true everywhere for forward-compat: the engine owns envelope_version and may add fields within a major; the consumer pins the major.",
  "type": "object",
  "required": ["envelope_version", "collection_id", "freshness", "record_count", "storage_size_bytes"],
  "additionalProperties": true,
  "properties": {
    "envelope_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "semver; engine-owned. Consumers pin the MAJOR and reject anything outside it (ADR-0016 version-pin discipline)."
    },
    "collection_id": { "type": "string" },
    "freshness": { "$ref": "#/$defs/Freshness" },
    "record_count": { "type": "integer", "minimum": 0 },
    "storage_size_bytes": { "type": "integer", "minimum": 0 },
    "index_size_bytes": { "type": "integer", "minimum": 0 },
    "fields": { "type": "array", "items": { "$ref": "#/$defs/FieldStatistics" } },
    "modality": { "type": "array", "items": { "$ref": "#/$defs/ModalityStatistics" } }
  },
  "$defs": {
    "Freshness": {
      "type": "object",
      "description": "Snapshot watermark — a FACT, not an SLA. Advanced at flush/compaction.",
      "required": ["as_of", "source"],
      "additionalProperties": true,
      "properties": {
        "as_of": { "type": "string", "format": "date-time" },
        "source": { "type": "string", "enum": ["flush", "compaction"] },
        "segment_watermark": { "type": "integer", "minimum": 0 }
      }
    },
    "Quantiles": {
      "type": "object",
      "required": ["method"],
      "additionalProperties": true,
      "properties": {
        "method": { "type": "string", "enum": ["tdigest", "histogram"] },
        "q": {
          "type": "object",
          "description": "quantile -> value, e.g. {\"0.5\": .., \"0.9\": ..} (t-digest)",
          "additionalProperties": { "type": "number" }
        },
        "buckets": {
          "type": "array",
          "description": "histogram buckets when method=histogram (engine-defined shape)"
        }
      }
    },
    "FieldStatistics": {
      "type": "object",
      "required": ["name", "data_type"],
      "additionalProperties": true,
      "properties": {
        "name": { "type": "string" },
        "data_type": {
          "description": "Canonical ProximaType (ADR-024) in serde form: a string for unit variants (\"String\", \"Int64\", ...) or an object for parametrized variants (e.g. {\"DenseVector\": {\"element\": \"Float32\", \"dim\": 768}}).",
          "oneOf": [ { "type": "string" }, { "type": "object" } ]
        },
        "null_rate": { "type": "number", "minimum": 0, "maximum": 1 },
        "distinct_estimate": { "type": "integer", "minimum": 0 },
        "distinct_method": { "type": "string", "enum": ["hll", "exact"] },
        "min": { "description": "zone-map minimum (typed value)" },
        "max": { "description": "zone-map maximum (typed value)" },
        "quantiles": { "$ref": "#/$defs/Quantiles" },
        "examples": { "type": "array", "description": "reservoir sample of typed values" },
        "indexed": { "type": "boolean" },
        "filterable": { "type": "boolean" },
        "approximate": { "type": "boolean", "description": "true if any statistic for this field is sketch-derived" }
      }
    },
    "ModalityStatistics": {
      "description": "Tagged union discriminated by `kind`. A consumer that understands only fields[] can ignore this array.",
      "oneOf": [
        { "$ref": "#/$defs/DocumentStatistics" },
        { "$ref": "#/$defs/VectorStatistics" },
        { "$ref": "#/$defs/GraphStatistics" },
        { "$ref": "#/$defs/TraceStatistics" },
        { "$ref": "#/$defs/TimeseriesStatistics" }
      ]
    },
    "DocumentStatistics": {
      "type": "object",
      "required": ["kind", "doc_count"],
      "additionalProperties": true,
      "properties": {
        "kind": { "const": "document" },
        "doc_count": { "type": "integer", "minimum": 0 },
        "avg_doc_length": { "type": "number", "minimum": 0 },
        "unique_terms_estimate": { "type": "integer", "minimum": 0 },
        "top_terms": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["term", "doc_frequency", "idf"],
            "additionalProperties": true,
            "properties": {
              "term": { "type": "string" },
              "doc_frequency": { "type": "integer", "minimum": 0 },
              "idf": { "type": "number" }
            }
          }
        }
      }
    },
    "VectorStatistics": {
      "type": "object",
      "required": ["kind", "dimension", "distance_metric"],
      "additionalProperties": true,
      "properties": {
        "kind": { "const": "vector" },
        "dimension": { "type": "integer", "minimum": 1 },
        "distance_metric": { "type": "string" },
        "spread": { "type": "number", "minimum": 0, "description": "mean distance to centroid" },
        "centroid": { "type": "array", "items": { "type": "number" } },
        "cluster_occupancy": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
        "approximate": { "type": "boolean" }
      }
    },
    "GraphStatistics": {
      "type": "object",
      "description": "Aligns with the engine's GraphStats (src/graph/model.rs) for reuse.",
      "required": ["kind", "total_nodes", "total_edges"],
      "additionalProperties": true,
      "properties": {
        "kind": { "const": "graph" },
        "total_nodes": { "type": "integer", "minimum": 0 },
        "total_edges": { "type": "integer", "minimum": 0 },
        "average_degree": { "type": "number", "minimum": 0 },
        "max_degree": { "type": "integer", "minimum": 0 },
        "connected_components": { "type": "integer", "minimum": 0 },
        "label_counts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["label", "count"],
            "additionalProperties": true,
            "properties": { "label": { "type": "string" }, "count": { "type": "integer", "minimum": 0 } }
          }
        },
        "edge_type_counts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["edge_type", "count"],
            "additionalProperties": true,
            "properties": { "edge_type": { "type": "string" }, "count": { "type": "integer", "minimum": 0 } }
          }
        }
      }
    },
    "TraceStatistics": {
      "type": "object",
      "required": ["kind", "span_count"],
      "additionalProperties": true,
      "properties": {
        "kind": { "const": "trace" },
        "span_count": { "type": "integer", "minimum": 0 },
        "service_distribution": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["service", "count"],
            "additionalProperties": true,
            "properties": { "service": { "type": "string" }, "count": { "type": "integer", "minimum": 0 } }
          }
        },
        "trace_depth": {
          "type": "object",
          "required": ["p50", "p90", "max"],
          "additionalProperties": true,
          "properties": { "p50": { "type": "number" }, "p90": { "type": "number" }, "max": { "type": "integer" } }
        }
      }
    },
    "TimeseriesStatistics": {
      "type": "object",
      "required": ["kind", "point_count"],
      "additionalProperties": true,
      "properties": {
        "kind": { "const": "timeseries" },
        "point_count": { "type": "integer", "minimum": 0 },
        "time_range": {
          "type": "object",
          "required": ["start", "end"],
          "additionalProperties": true,
          "properties": { "start": { "type": "string", "format": "date-time" }, "end": { "type": "string", "format": "date-time" } }
        },
        "downsample_state": { "type": "string" }
      }
    }
  }
}
