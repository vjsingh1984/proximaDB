---
title: ProximaDB - Cache Subsystem (Cross-Cache Orchestrator)
---
graph TB
    subgraph "Cross-Cache Orchestrator"
        ORCH["CrossCacheOrchestrator\nstorage/cache/orchestrator.rs\n- Global memory budget (total_mb)\n- Partition budget across caches\n- Adaptive eviction scheduling\n- Per-cache hit/miss stats\n- Prometheus metrics export"]
    end

    subgraph "Cache Types"
        FOOTER["FooterCache\nPAX block footers\n- Zone maps + bloom filters\n- Avoids per-block footer reads\n- Small entries (< 1KB)\n- Very high hit rate\n- File-backed: footer_cache.bin\n- mmap persistence"]
        QUERY_CACHE["QueryPlanCache\nCompiled query plans\n- Per (tenant, collection) scope\n- Cache invalidation on any DML\n  (invalidate_query_cache)\n- Bypassed for Strong freshness\n  (VectorFreshnessMode::Strong)\n- LRU eviction"]
        BLOCK_CACHE["BlockCache (PageCache)\nHot PAX data blocks\n- LRU eviction policy\n- Configurable max size\n- Per-tenant quota isolation\n- Promotion: frequent access\n- Demotion: infrequent access"]
        TENANT_CACHE["TenantMetaCache\nTenant configuration, schemas\n- Very high hit rate\n- Small entry size\n- TTL-based refresh\n- Pre-loaded at startup\n- Invalidated on DDL"]
        RESULT_CACHE["ResultSetCache\nMemoized query results\n- TTL-based expiry\n- Configurable max results\n- Per-tenant budget\n- Skipped for Strong reads"]
    end

    subgraph "Cache Invalidation"
        INVAL["CacheInvalidationCoordinator\nPost-WAL-commit invalidation:\n- invalidate_query_cache(tenant, coll)\n- invalidate_collection_cache(tenant, coll)\nCalled on EVERY write:\n  INSERT, UPDATE, DELETE, DDL\nWrite fence invariant:\n  write → invalidate → next read\n  sees fresh data. Always."]
    end

    subgraph "Freshness Modes & Cache Behavior"
        STRONG["Strong Read\n- Always computes fresh\n- Bypasses ALL caches\n- No stale data possible\n- Higher latency, correct"]
        STALE_OK["StaleOk / Eventually\n- Uses cached results\n- May return slightly stale\n- Acceptable for dashboards,\n  reporting, analytics\n- Lower latency"]
    end

    subgraph "Eviction Service"
        EVICT["EvictionService\nBackground eviction thread\n- Monitors total memory pressure\n- Configurable policies:\n  LRU, LFU, FIFO, Clock\n- Adaptive: increases eviction\n  rate when pressure high\n- Per-cache eviction signals"]
    end

    ORCH --> FOOTER
    ORCH --> QUERY_CACHE
    ORCH --> BLOCK_CACHE
    ORCH --> TENANT_CACHE
    ORCH --> RESULT_CACHE
    ORCH --> EVICT

    EVICT --> BLOCK_CACHE
    EVICT --> QUERY_CACHE

    INVAL --> QUERY_CACHE
    INVAL --> RESULT_CACHE
    INVAL --> TENANT_CACHE

    STRONG -.-> QUERY_CACHE
    STRONG -.-> RESULT_CACHE
    STALE_OK --> QUERY_CACHE
    STALE_OK --> RESULT_CACHE

    DML["DmlService\n(post-WAL-commit)"] --> INVAL
    READ_PATH["Read Path\n(checks freshness mode)"] --> STRONG
    READ_PATH --> STALE_OK

    classDef orch fill:#bbdefb,stroke:#1565c0
    classDef cache fill:#c8e6c9,stroke:#2e7d32
    classDef inval fill:#ffe0b2,stroke:#f57c00
    classDef mode fill:#e1bee7,stroke:#7b1fa2
    classDef evict fill:#ffcdd2,stroke:#d32f2f
    classDef ext fill:#b3e5fc,stroke:#0288d1,stroke-dasharray: 5 5

    class ORCH orch
    class FOOTER,QUERY_CACHE,BLOCK_CACHE,TENANT_CACHE,RESULT_CACHE cache
    class INVAL inval
    class STRONG,STALE_OK mode
    class EVICT evict
    class DML,READ_PATH ext
