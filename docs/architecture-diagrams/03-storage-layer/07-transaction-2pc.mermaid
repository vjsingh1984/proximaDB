---
title: ProximaDB - Transaction Coordinator & 2-Phase Commit
---
graph TB
    subgraph "Transaction Coordinator"
        TX_COORD["TransactionCoordinator\ntransaction/coordinator.rs\n- Orchestrates distributed txns\n- Assigns monotonic TxID\n- Active txn tracking\n- Deadlock detection\n- Snapshot timestamp assignment"]
        TX_ENGINE["EngineWiring\ntransaction/engine_wiring.rs\n- Wires txns across storage engines\n- Per-engine participant registration\n- Ensures ACID across backends\n- Multi-engine atomicity"]
    end

    subgraph "2-Phase Commit Engine"
        TWOPC["TwoPhaseCommit\ntransaction/two_phase_commit.rs\nPhase 1: PREPARE\n  - All participants write to WAL\n  - Each votes COMMIT or ABORT\n  - Coordinator collects votes\nPhase 2: COMMIT/ABORT\n  - If all vote COMMIT → apply\n  - If any ABORT → rollback all\n  - WAL coordinator records outcome"]
        PARTICIPANTS["TransactionParticipants\ntransaction/participants.rs\n- Per-resource participant tracking\n  (collections, tables, graphs, docs)\n- Vote collection\n- Timeout handling\n- Participant health monitoring"]
    end

    subgraph "WAL Transaction Log"
        WAL_COORD["WALTransactionCoordinator\ntransaction/wal_coordinator.rs\nWAL entries:\n  - BEGIN {txid, timestamp}\n  - PREPARE {txid, participants[]}\n  - COMMIT {txid} / ABORT {txid}\nRecovery:\n  - Scan WAL for in-doubt txns\n  - Re-query participants for outcome\n  - Resolve: COMMIT if quorum\n    agreed, else ABORT"]
    end

    subgraph "Storage Engine MVCC"
        STORE_TX["StorageEngine Tx Support\nstorage/transaction_coordinator.rs\n- Per-engine MVCC integration\n- Snapshot isolation\n- Write intents with TxID\n- Read visibility at snapshot ts\n- Cleanup on commit/abort"]
        MVCC["MVCC Version Chain\nEach record:\n  - txid: writer transaction\n  - valid_from_ns: snapshot ts\n  - valid_to_ns: tombstone ts\nRead visibility:\n  - txid committed before snapshot\n  - valid_from_ns <= snapshot\n  - valid_to_ns > snapshot\nTombstone: valid_to_ns = Some(0)\nTTL-expired: valid_to_ns < now_ns"]
    end

    subgraph "Failure Recovery"
        RECOVERY["Recovery Logic\nOn startup:\n  1. Scan WAL for PREPARE without\n     matching COMMIT/ABORT\n  2. For each in-doubt txn:\n     a. Query participants for outcome\n     b. If quorum agreed COMMIT → commit\n     c. Else → ABORT (timeout threshold)\n  3. Clean up write intents\n  4. Resume normal operation"]
    end

    DML_SVC["DmlService\n(begins transactions)"] --> TX_COORD
    API["REST/gRPC/pgwire"] --> DML_SVC

    TX_COORD --> TX_ENGINE
    TX_COORD --> TWOPC
    TWOPC --> PARTICIPANTS
    TWOPC --> WAL_COORD
    TX_ENGINE --> STORE_TX
    STORE_TX --> MVCC
    TX_COORD --> RECOVERY
    WAL_COORD --> RECOVERY

    classDef coord fill:#bbdefb,stroke:#1565c0
    classDef twopc fill:#c8e6c9,stroke:#2e7d32
    classDef wal fill:#e1bee7,stroke:#7b1fa2
    classDef store fill:#ffe0b2,stroke:#f57c00
    classDef mvcc fill:#ffcdd2,stroke:#d32f2f
    classDef recov fill:#d7ccc8,stroke:#5d4037
    classDef ext fill:#b3e5fc,stroke:#0288d1,stroke-dasharray: 5 5

    class TX_COORD,TX_ENGINE coord
    class TWOPC,PARTICIPANTS twopc
    class WAL_COORD wal
    class STORE_TX store
    class MVCC mvcc
    class RECOVERY recov
    class DML_SVC,API ext
