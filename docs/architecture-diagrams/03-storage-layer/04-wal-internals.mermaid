---
title: ProximaDB - Write-Ahead Log Internal Component Diagram (3.6K loc God-File)
---
graph TB
    subgraph "WAL Core Manager"
        WAL_MGR["🟦 WriteAheadLogManager\nmod.rs:3611 lines\n- Core coordinator for all WAL ops\n- Owns memtable + disk mgr + flush coord\n- append() → LSN assigned\n- Config: 512MB threshold / 30s flush"]
    end

    subgraph "WAL Strategy Layer"
        BATCH_STRAT["🟧 WALBatchStrategy\nbatch_strategy.rs\nTrait: serialize/deserialize batches\n3 impls: Proto · Avro · Bincode"]
        PROTO_STRAT["🟧 ProtoBatchStrategy\nbatch_strategy.rs\n- Protocol Buffers (default)\n- Zero-copy deserialization\n- Schema ~/.proto"]
        AVRO_STRAT["🟧 AvroSerializationStrategy\navro_serialization_strategy.rs\n- Schema evolution support\n- Self-describing records"]
        BINCODE_STRAT["🟧 BincodeSerializationStrategy\nbincode_serialization_strategy.rs\n- Maximum raw throughput\n- No schema overhead"]
    end

    subgraph "Memory Layer"
        MEMTBL["🟩 MemtableManager\nmemtable/ (specialized/wal_behavior)\n- In-memory buffer for hot vectors\n- WALVectorBatch storage\n- TTL-aware expiry\n- Bloom filter for fast lookup\n- Configurable memory threshold"]
        BLOOM["🟩 BloomFilterStrategy\ncore/bloom/\n- Fast membership testing\n- Reduces disk reads"]
    end

    subgraph "Disk Layer"
        DISK_MGR["🟣 DiskManager\npersistence/disk_manager.rs\n- Multi-disk WAL files\n- Sequential I/O optimized\n- Load balanced across disks\n- Collection affinity for locality"]
        DISK_IO["🟣 Disk I/O Subsystem\n- fsync durability modes\n- Configurable sync: O_DSYNC | fsync | batch\n- Compression: LZ4/Snappy/Zstd"]
        RECOVERY["🟣 RecoveryManager\nrecovery/\n- Crash recovery on startup\n- Parallel segment replay\n- LSN chain validation"]
    end

    subgraph "Flush Pipeline"
        FLUSH_COORD["🔴 FlushCoordinator\nflush_coordinator.rs\n- Orchestrates WAL → Storage Engine\n- Triggers on: memory threshold / timer / manual\n- Coordinates with FlushMaterializer"]
        COMPACT_COORD["🔴 CompactionCoordinator\ncompaction/\n- WAL segment compaction\n- Tombstone GC\n- Segment merging"]
        BACKUP_COORD["🔴 BackupCoordinator\nbackup/\n- Incremental WAL backups\n- Point-in-time recovery"]
    end

    subgraph "Batch & Sync"
        BATCH_FACTORY["🟤 BatchFactory\nbatch_factory.rs\n- Creates optimized batches\n- Batching by collection affinity"]
        BATCH_SYNC["🟤 BatchSyncCoordinator\nbatch_sync_coordinator.rs\n- Coordinates concurrent batch writes\n- Ordering guarantees"]
        BG_MGR["🟤 BackgroundManager\nbackground_manager.rs\n- Background flush scheduling\n- Periodic health checks"]
    end

    subgraph "Path Building"
        COLL_PATH["⬜ CollectionPathResolver\ncollection_path.rs\n- DrPathBuilder integration\n- data/{tenant}/{ns}/{collection}/wal/"]
    end

    %% Internal flow
    WAL_MGR --> BATCH_STRAT
    BATCH_STRAT --> PROTO_STRAT
    BATCH_STRAT --> AVRO_STRAT
    BATCH_STRAT --> BINCODE_STRAT

    WAL_MGR --> MEMTBL
    MEMTBL --> BLOOM

    WAL_MGR --> DISK_MGR
    DISK_MGR --> DISK_IO
    DISK_MGR --> RECOVERY

    WAL_MGR --> FLUSH_COORD
    FLUSH_COORD --> COMPACT_COORD
    FLUSH_COORD --> BACKUP_COORD

    WAL_MGR --> BATCH_FACTORY
    WAL_MGR --> BATCH_SYNC
    WAL_MGR --> BG_MGR

    DISK_MGR --> COLL_PATH
    MEMTBL --> COLL_PATH

    %% External connections
    DML_SERVICE["DmlService\n(write caller)"] --> WAL_MGR
    FLUSH_COORD --> FLUSH_MAT["FlushMaterializer\n(builds PAX blocks)"]

    classDef core fill:#bbdefb,stroke:#1565c0
    classDef strategy fill:#ffe0b2,stroke:#f57c00
    classDef mem fill:#c8e6c9,stroke:#2e7d32
    classDef disk fill:#e1bee7,stroke:#7b1fa2
    classDef flush fill:#ffcdd2,stroke:#d32f2f
    classDef batch fill:#d7ccc8,stroke:#5d4037
    classDef path fill:#f5f5f5,stroke:#9e9e9e
    classDef ext fill:#b3e5fc,stroke:#0288d1,stroke-dasharray: 5 5

    class WAL_MGR core
    class BATCH_STRAT,PROTO_STRAT,AVRO_STRAT,BINCODE_STRAT strategy
    class MEMTBL,BLOOM mem
    class DISK_MGR,DISK_IO,RECOVERY disk
    class FLUSH_COORD,COMPACT_COORD,BACKUP_COORD flush
    class BATCH_FACTORY,BATCH_SYNC,BG_MGR batch
    class COLL_PATH path
    class DML_SERVICE,FLUSH_MAT ext
