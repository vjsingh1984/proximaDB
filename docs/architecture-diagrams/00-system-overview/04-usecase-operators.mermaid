---
title: ProximaDB - Use Case Diagram (Operators, Analysts and Platform)
---
graph TB
    subgraph "Actors"
        ML_ENG["ML/AI Engineer\n- Build RAG pipelines\n- Semantic search apps\n- Embedding management"]
        APP_DEV["App Developer\n- Production API integration\n- SDK consumption\n- Multi-model queries"]
        DBA["Database Admin\n- Schema management\n- Index tuning\n- Monitoring & alerts"]
        SRE["SRE / Platform Engineer\n- Cluster ops\n- Backup & recovery\n- Capacity planning"]
        ANALYST["Data Analyst\n- SQL analytics over pgwire\n- TPC-H/TPC-DS workloads\n- BI tool integration"]
    end

    subgraph "Vector Search"
        UC1["🔵 Insert Vectors\nBatch/streaming ingest with\noptional embedding generation"]
        UC2["🔵 ANN Search\nk-NN similarity search with\nmetadata filtering & hybrid ranking"]
        UC3["🔵 Index Management\nCreate/tune HNSW, IVF, SST\nindexes; monitor recall"]
    end

    subgraph "Relational / SQL"
        UC4["🟢 SQL over pgwire\nFull ANSI SQL: SELECT, JOIN,\naggregation, window functions"]
        UC5["🟢 Materialize Tables\nALTER TABLE ... MATERIALIZE\nParquet-backed for OLAP"]
        UC6["🟢 TPC-H / TPC-DS\nConformance benchmarking\nover standard Postgres wire"]
    end

    subgraph "Graph Database"
        UC7["🟣 Graph Traversal\nNode/edge queries, path finding,\npattern matching"]
        UC8["🟣 Graph + Vector Hybrid\nGraph-RAG: traverse graph + ANN\non node embeddings"]
    end

    subgraph "Multi-Model / Cross-Modal"
        UC9["🟠 Cross-Model Queries\nJoin vector results with relational\ntables + graph patterns"]
        UC10["🟠 Hybrid Ranking\nRRF fusion: vector distance +\nkeyword BM25 + graph signals"]
    end

    subgraph "Operational"
        UC11["🟤 Multi-Tenant Isolation\nTenant context at every I/O boundary\nPath isolation via DrPathBuilder"]
        UC12["🟤 Cluster Management\nPartition leasing, Raft consensus,\npod failover, write fencing"]
        UC13["🟤 Backup & Recovery\nWAL-based incremental backup,\npoint-in-time recovery"]
        UC14["🟤 Monitoring & Telemetry\nPrometheus metrics, billing telemetry,\nIO traces per query"]
    end

    subgraph "SDK / Client"
        UC15["⬜ SDK Integration\nPython · Rust · Go · TypeScript\nsync + async REST, gRPC, Arrow Flight"]
        UC16["⬜ Embedding Providers\nOpenAI, Cohere, HuggingFace, etc.\nChunking strategies, language parsers"]
    end

    ML_ENG --> UC1 & UC2 & UC3 & UC15 & UC16
    APP_DEV --> UC2 & UC9 & UC10 & UC15
    DBA --> UC3 & UC4 & UC5 & UC14
    SRE --> UC11 & UC12 & UC13 & UC14
    ANALYST --> UC4 & UC6

    classDef actor fill:#ffcc80,stroke:#e65100
    classDef vec fill:#bbdefb,stroke:#1565c0
    classDef rel fill:#c8e6c9,stroke:#2e7d32
    classDef graph fill:#e1bee7,stroke:#7b1fa2
    classDef multi fill:#ffe0b2,stroke:#f57c00
    classDef ops fill:#d7ccc8,stroke:#5d4037
    classDef sdk fill:#f5f5f5,stroke:#9e9e9e

    class ML_ENG,APP_DEV,DBA,SRE,ANALYST actor
    class UC1,UC2,UC3 vec
    class UC4,UC5,UC6 rel
    class UC7,UC8 graph
    class UC9,UC10 multi
    class UC11,UC12,UC13,UC14 ops
    class UC15,UC16 sdk
