---
title: ProximaDB - Use Case Diagram (Comprehensive: actors x 21 use cases)
---
graph TB
    subgraph "Actors"
        ML_ENG["🧑‍💻 ML/AI Engineer\n- RAG pipeline builder\n- Semantic search developer"]
        APP_DEV["👩‍💻 App Developer\n- Full-stack engineer\n- REST/gRPC API consumer"]
        DATA_ENG["🧑‍🔬 Data Engineer\n- Warehouse builder\n- ETL pipeline owner"]
        DBA["🧑‍💼 DBA / SRE\n- System administrator\n- Performance tuner"]
        EXT_SYS["⚙️ External System\n- Kafka / CDC\n- Spark / ETL\n- LLM Providers"]
    end

    subgraph "Vector Search Use Cases"
        UC1["🔍 ANN Search\nSimilarity search with top-K\n- HNSW/IVF index\n- SQ8/RaBitQ quantization\n- Pre/post-filter"]
        UC2["🔀 Hybrid Search\nVector + metadata + graph\n- RRF fusion\n- Multi-modal scoring\n- Adaptive selectivity"]
        UC3["📊 Batch Vector Ops\nBulk insert/upsert/delete\n- Arrow Flight bulk ops\n- WAL-backed durability\n- Streaming ingest"]
    end

    subgraph "SQL / Relational Use Cases"
        UC4["📝 Full SQL over pgwire\nStandard PostgreSQL wire protocol\n- TPC-H / TPC-DS conformance\n- DataFusion OLAP for Parquet\n- Volcano OLTP for native"]
        UC5["🗄️ Data Warehouse\nParquet + Iceberg tables\n- ALTER TABLE MATERIALIZE\n- Snapshot isolation\n- Columnar scans"]
        UC6["🔗 Federated Queries\nExternal data source queries\n- Connector framework\n- Remote table access"]
    end

    subgraph "Graph Use Cases"
        UC7["🕸️ Graph Traversal\nMulti-hop property graph\n- Path queries\n- Pattern matching\n- ORION engine"]
        UC8["🔗 Knowledge Graph\nTriple store queries\n- Entity resolution\n- RDF-adjacent\n- Symbol write"]
        UC9["⚛️ Cross-Model Tx\nAtomic graph+vector writes\n- Node + embedding + edges\n- 2PC coordination\n- Rollback support"]
    end

    subgraph "AI / LLM Use Cases"
        UC10["🤖 Text-to-SQL\nNatural language querying\n- LLM integration\n- Intent detection\n- Query decomposition"]
        UC11["📈 AI Insights\nPattern & anomaly detection\n- AutoML tuning\n- Workload prediction\n- RL-based optimization"]
        UC12["🧠 RAG Pipeline\nRetrieval-Augmented Generation\n- Embedding orchestration\n- Document chunking\n- Re-ranking"]
    end

    subgraph "Platform Use Cases"
        UC13["🔐 Auth & RBAC\nMulti-tenant security\n- JWT/API key auth\n- Federated delegation\n- SSO integration"]
        UC14["📋 Audit & Compliance\nFull operation audit trail\n- Change tracking\n- Access logs\n- GDPR retention"]
        UC15["📊 Observability\nMetrics & monitoring\n- Prometheus billing (KSU/KRU/KOU/KIU/KU)\n- Distributed tracing\n- Health checks"]
        UC16["🏗️ Cluster Operations\nDistributed deployment\n- Partition leasing\n- Raft consensus\n- CDC streaming"]
    end

    subgraph "SDK / Integration Use Cases"
        UC17["🐍 Python SDK\nSync + Async REST clients\n- Embedding providers\n- Chunking strategies\n- OpenAPI-generated transport"]
        UC18["🦀 Rust SDK\nType-safe native client\n- gRPC streaming\n- Arrow Flight bulk ops"]
        UC19["🐘 PostgreSQL Driver\nAny PG-compatible driver\n- psql, JDBC, ODBC\n- Full SQL over pgwire"]
    end

    subgraph "Admin Use Cases"
        UC20["🖥️ Admin UI\nWeb-based management\n- Collection CRUD\n- Schema management\n- Performance dashboard"]
        UC21["🤖 MCP Server\nModel Context Protocol\n- AI agent integration\n- Tool calling interface"]
    end

