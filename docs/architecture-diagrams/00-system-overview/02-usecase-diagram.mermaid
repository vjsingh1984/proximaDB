---
title: ProximaDB - Use Case Diagram (Key Entry Points)
---
graph TB
    subgraph Actors
        DEV["👨‍💻 ML/AI Engineer\n- RAG pipelines\n- Semantic search\n- Embedding management"]
        APP["🖥️ Application Developer\n- SQL queries\n- REST/gRPC integration\n- SDK usage"]
        DBA["🔧 DB Administrator\n- Schema management\n- Tenant configuration\n- Monitoring"]
        SYS["⚙️ System Integrator\n- Federated queries\n- CDC/Streaming\n- Spark jobs"]
    end

    subgraph "Use Cases: Data Ingestion"
        UC1["🟢 Insert Vectors\nPOST /v2/collections/{id}/vectors"]
        UC2["🟢 Bulk Load\nArrow Flight bulk ingestion"]
        UC3["🟢 Streaming Ingest\nKafka/CDC connector"]
        UC4["🟢 Upsert with Embedding\nAuto-embed via LLM provider"]
        UC5["🟢 Graph Data Ingest\nInsert nodes + edges"]
    end

    subgraph "Use Cases: Query & Search"
        UC6["🟢 Vector Similarity Search\nANN with distance metrics"]
        UC7["🟢 SQL Queries (pgwire)\nFull ANSI SQL over PostgreSQL wire"]
        UC8["🟢 Hybrid Search\nVector + metadata + graph"]
        UC9["🟢 Graph Traversal\nCypher-like graph queries"]
        UC10["🟢 Federated Query\nCross-source SQL"]
        UC11["🟢 Multi-Modal Search\nText + Image + Vector"]
    end

    subgraph "Use Cases: Management"
        UC12["🟢 Collection Lifecycle\nCREATE/ALTER/DROP collection"]
        UC13["🟢 Index Management\nBuild/rebuild/tune indices"]
        UC14["🟢 Tenant Management\nMulti-tenant isolation"]
        UC15["🟢 Tier Management\nHot/Cool/Cold storage tiering"]
        UC16["🟢 Snapshot & Branch\nTime-travel / versioning"]
        UC17["🟢 Schema Evolution\nALTER TABLE / migration"]
    end

    subgraph "Use Cases: Observability"
        UC18["🟢 Metrics & Monitoring\nPrometheus metrics"]
        UC19["🟢 Audit Logging\nCompliance audit trail"]
        UC20["🟢 Recall Probing\nANN quality monitoring"]
        UC21["🟢 Explain Plan\nQuery plan visualization"]
    end

    subgraph "Use Cases: Cluster Ops"
        UC22["🟡 Partition Lease\nDistributed ownership"]
        UC23["🟡 Replication\nCross-node data sync"]
        UC24["🟡 Consensus\nRaft-based leader election"]
    end

    %% Actor → Use Case mappings
    DEV --> UC1 & UC2 & UC4 & UC6 & UC8 & UC11
    APP --> UC5 & UC6 & UC7 & UC9 & UC10
    DBA --> UC12 & UC13 & UC14 & UC15 & UC16 & UC17 & UC18 & UC19 & UC21
    SYS --> UC3 & UC10 & UC22 & UC23 & UC24

    %% Relationships
    UC1 -.->|extends| UC4
    UC6 -.->|extends| UC8
    UC7 -.->|extends| UC10
    UC12 -.->|includes| UC17
    UC6 -.->|includes| UC13
    UC20 -.->|monitors| UC6
    UC22 -.->|enables| UC23

    classDef actor fill:#bbdefb,stroke:#1565c0
    classDef uc_green fill:#c8e6c9,stroke:#2e7d32
    classDef uc_yellow fill:#fff9c4,stroke:#f9a825

    class DEV,APP,DBA,SYS actor
    class UC1,UC2,UC3,UC4,UC5,UC6,UC7,UC8,UC9,UC10,UC11,UC12,UC13,UC14,UC15,UC16,UC17,UC18,UC19,UC20,UC21 uc_green
    class UC22,UC23,UC24 uc_yellow
