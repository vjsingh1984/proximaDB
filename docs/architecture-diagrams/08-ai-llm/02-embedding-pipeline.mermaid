---
title: ProximaDB - Embedding Pipeline (Modalities)
---
graph TB
    subgraph "Embedding Provider Traits"
        EMB_TRAIT["EmbeddingProvider Trait\ncrates/modalities/proximadb-embedding/\n- embed(text) → Vec<f32>\n- embed_batch(texts) → Vec<Vec<f32>>\n- dimensions() → usize\n- model_name() → &str"]
    end

    subgraph "Built-in Providers"
        ONNX["ONNX Runtime Provider\n- Local ONNX model execution\n- BERT, MiniLM, E5, etc.\n- GPU acceleration (CUDA/Metal)\n- Dynamic batching"]
        OPENAI["OpenAI Provider\n- text-embedding-3-small/large\n- text-embedding-ada-002\n- API key from config/env\n- Rate limiting + retry"]
        COHERE["Cohere Provider\n- embed-english-v3\n- embed-multilingual-v3\n- API-based remote"]
        HUGGINGFACE["HuggingFace Provider\n- Inference API or local\n- Any HF embedding model"]
        CUSTOM["Custom Provider\n- User-provided HTTP endpoint\n- Configurable request/response"]
    end

    subgraph "Chunking Strategies"
        CHUNK_TRAIT["ChunkingStrategy Trait\n- chunk(text) → Vec<Chunk>\n- Chunk: text, start_idx, end_idx, metadata"]
        FIXED["Fixed-Size Chunking\n- Configurable size/overlap"]
        SENTENCE["Sentence Chunking\n- Splits on sentence boundaries"]
        RECURSIVE["Recursive Chunking\n- paragraph → sentence → word"]
        CODE_PARSER["LanguageParser\n- 20+ language parsers\n- AST-aware chunking"]
    end

    subgraph "Document Processing"
        DOC["Document Processor\nproximadb-document\n- PDF, Markdown, HTML, Text\n- OCR (Tesseract)\n- Table extraction"]
    end

    subgraph "Vector Modality"
        VECTOR["Vector Modality\nproximadb-vector\n- Raw vectors + multi-vector\n- Sparse: SPLADE\n- Hybrid: dense + sparse"]
    end

    subgraph "Ranking Modality"
        RANK_CORE["Rank Core\n- Cross-encoder reranking\n- Score fusion (RRF, weighted)\n- Multi-stage pipeline"]
        RANK_ONNX["Rank ONNX\n- ONNX cross-encoder: BGE-Reranker\n- Batch reranking"]
        RANK_FEATURES["Rank Features\n- Feature extraction for LTR\n- BM25, TF-IDF features"]
    end

    EMB_TRAIT --> ONNX
    EMB_TRAIT --> OPENAI
    EMB_TRAIT --> COHERE
    EMB_TRAIT --> HUGGINGFACE
    EMB_TRAIT --> CUSTOM

    CHUNK_TRAIT --> FIXED
    CHUNK_TRAIT --> SENTENCE
    CHUNK_TRAIT --> RECURSIVE
    CHUNK_TRAIT --> CODE_PARSER

    DOC --> EMB_TRAIT
    CHUNK_TRAIT --> EMB_TRAIT
    EMB_TRAIT --> VECTOR
    VECTOR --> RANK_CORE
    RANK_CORE --> RANK_ONNX
    RANK_CORE --> RANK_FEATURES

    classDef trait fill:#fff9c4,stroke:#f9a825
    classDef prov fill:#c8e6c9,stroke:#2e7d32
    classDef chunk fill:#ffe0b2,stroke:#f57c00
    classDef doc fill:#e1bee7,stroke:#7b1fa2
    classDef vec fill:#bbdefb,stroke:#1565c0
    classDef rank fill:#ffcdd2,stroke:#d32f2f

    class EMB_TRAIT,CHUNK_TRAIT trait
    class ONNX,OPENAI,COHERE,HUGGINGFACE,CUSTOM prov
    class FIXED,SENTENCE,RECURSIVE,CODE_PARSER chunk
    class DOC doc
    class VECTOR vec
    class RANK_CORE,RANK_ONNX,RANK_FEATURES rank
