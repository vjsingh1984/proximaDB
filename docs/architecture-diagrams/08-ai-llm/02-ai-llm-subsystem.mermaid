---
title: ProximaDB - AI and LLM Subsystem (Integration and Data-Flow View)
---
graph TB
    subgraph "Natural Language Interface"
        NL_API["Natural Language API\nai/natural_language_api.rs (43K)\n- Text-to-SQL: natural language → SQL\n- Text-to-AQL: natural language → ProximaDB query\n- RUBICON query planner integration\n- Intent classification\n- Entity extraction (collection/field names)"]
        NLP["NLP Processor\nai/nlp.rs (28K)\n- Tokenization + parsing\n- Semantic parsing\n- Query intent detection\n- Named entity recognition\n- Prompt template management"]
    end

    subgraph "LLM Integration"
        LLM["LLM Manager\nai/llm.rs (36K)\n- Multi-provider abstraction\n- Model registry: OpenAI, Anthropic,\n  Gemini, Llama, Mistral, local\n- Prompt construction + templating\n- Response parsing + validation\n- Token usage tracking + billing"]
        LLM_INT["LLM Integration\nai/llm_integration/\n- Provider-specific adapters\n- Rate limiting per provider\n- Fallback chain: primary → secondary\n- Response caching for repeated queries\n- Streaming response support (SSE)"]
    end

    subgraph "Analytics & Insights"
        INSIGHTS["AI Insights\nai/insights.rs (39K)\n- Automated anomaly detection\n- Trend analysis over time-series\n- Query pattern recognition\n- Index optimization suggestions\n- Capacity forecasting"]
        BI["Business Intelligence\nai/business_intelligence/\n- Dashboard query generation\n- KPI tracking\n- Automated report generation\n- Natural language → chart/visualization"]
        EXEC_DASH["Executive Dashboard\nai/executive_dashboard.rs (29K)\n- System health summaries\n- Usage trends\n- Cost analysis\n- Growth metrics"]
    end

    subgraph "AutoML"
        AUTOML["AutoML Engine\nsrc/automl/\n- Automatic index type selection\n- Parameter tuning (M, ef_construction)\n- Quantization strategy selection\n- Workload-based optimization\n- Prediction: index performance estimation"]
        AUTOML_OPT["AutoML Optimization\nautoml/optimization.rs (28K)\n- Bayesian optimization\n- Multi-armed bandit\n- A/B testing framework"]
        AUTOML_PRED["AutoML Prediction\nautoml/prediction.rs\n- Index build time estimation\n- Recall vs latency trade-off\n- Memory usage estimation"]
    end

    subgraph "Prompt Management"
        PROMPTS["Prompt Store\nsrc/prompts/\n- Versioned prompt templates\n- A/B prompt testing\n- Prompt evaluation harness\n- Context window management\n- System prompts for RUBICON"]
    end

    NL_API --> NLP
    NL_API --> LLM
    LLM --> LLM_INT
    INSIGHTS --> NL_API
    BI --> NL_API
    EXEC_DASH --> INSIGHTS
    AUTOML --> AUTOML_OPT
    AUTOML --> AUTOML_PRED
    PROMPTS --> LLM

    QUERY["Query Pipeline\n(RUBICON plans)"] --> NL_API
    NL_API --> QUERY

