---
title: ProximaDB - AI and LLM Subsystem (Component View)
---
graph TB
    subgraph "AI Core"
        AI_MOD["🟦 AI Module\nsrc/ai/mod.rs\n- AI pipeline orchestration\n- Insight generation"]
        LLM_CORE["🟦 LLM Integration\nsrc/ai/llm.rs\n(36K loc)\n- LLM provider abstraction\n- Prompt templates\n- Response parsing"]
    end

    subgraph "LLM Integration Layer"
        LLM_INT["🟧 LLM Integration\nsrc/ai/llm_integration/\n- Multi-provider support\n- OpenAI/Claude/Llama\n- Streaming responses"]
        LLM_PROVIDERS["🟧 LLM Providers\n- OpenRouter\n- Anthropic\n- Ollama (local)\n- HuggingFace TGI"]
    end

    subgraph "Natural Language"
        NL_API["🟩 Natural Language API\nsrc/ai/natural_language_api.rs\n(43K loc)\n- Text-to-SQL\n- Text-to-vector-search\n- Semantic understanding"]
        NL_MOD["🟩 Natural Language Module\nsrc/ai/natural_language/\n- Intent detection\n- Entity extraction\n- Query decomposition"]
        NLP["🟩 NLP Module\nsrc/ai/nlp.rs\n(29K loc)\n- Tokenization\n- Embedding orchestration\n- Chunking"]
    end

    subgraph "Analytics & Insights"
        INSIGHTS["🟣 AI Insights\nsrc/ai/insights.rs\n(40K loc)\n- Pattern detection\n- Anomaly detection\n- Trend analysis"]
        ANALYTICS["🟣 AI Analytics\nsrc/ai/analytics.rs\n(16K loc)\n- Usage analytics\n- Performance analytics"]
        BI["🟣 Business Intelligence\nsrc/ai/business_intelligence/\n- Report generation\n- Dashboard data"]
        DASHBOARD["🟣 Executive Dashboard\nsrc/ai/executive_dashboard.rs\n(29K loc)\n- Key metrics\n- Visualization data"]
    end

    subgraph "AutoML"
        AUTOML["🟤 AutoML\nsrc/automl/\n- Index auto-tuning\n- Engine auto-selection\n- Parameter optimization\n- RL-based planner"]
        OPTIMIZE["🟤 Optimization\nsrc/automl/optimization.rs\n(29K loc)\n- Hyperparameter search\n- Recall/latency tradeoffs"]
        PREDICT["🟤 Prediction\nsrc/automl/prediction.rs\n- Workload prediction\n- Resource forecasting"]
    end

    subgraph "Prompt Management"
        PROMPTS["⬜ Prompt System\nsrc/prompts/\n- Template management\n- Version control\n- Dynamic prompt building"]
        PROMPT_STORE["⬜ Prompt Store\n- Cached templates\n- Multi-language support"]
    end

    subgraph "API Handlers (AI)"
        AI_ENDPOINTS["🔶 AI Endpoints\nsrc/api_handlers/ai_endpoints.rs\n(14K loc)\n- /ai/query\n- /ai/insights\n- /ai/search"]
    end

    %% Flow
    AI_MOD --> LLM_CORE
    AI_MOD --> NL_API
    AI_MOD --> INSIGHTS

    LLM_CORE --> LLM_INT
    LLM_INT --> LLM_PROVIDERS

    NL_API --> NL_MOD
    NL_API --> NLP
    NL_API --> PROMPTS

    ANALYTICS --> INSIGHTS
    INSIGHTS --> DASHBOARD
    BI --> DASHBOARD

    AUTOML --> OPTIMIZE
    AUTOML --> PREDICT

    AI_ENDPOINTS --> AI_MOD
    AI_ENDPOINTS --> AUTOML

    classDef core fill:#bbdefb,stroke:#1565c0
    classDef llm fill:#ffe0b2,stroke:#f57c00
    classDef nl fill:#c8e6c9,stroke:#2e7d32
    classDef insights fill:#e1bee7,stroke:#7b1fa2
    classDef automl fill:#d7ccc8,stroke:#5d4037
    classDef prompts fill:#f5f5f5,stroke:#9e9e9e
    classDef api fill:#ffccbc,stroke:#e64a19

    class AI_MOD,LLM_CORE core
    class LLM_INT,LLM_PROVIDERS llm
    class NL_API,NL_MOD,NLP nl
    class INSIGHTS,ANALYTICS,BI,DASHBOARD insights
    class AUTOML,OPTIMIZE,PREDICT automl
    class PROMPTS,PROMPT_STORE prompts
    class AI_ENDPOINTS api
