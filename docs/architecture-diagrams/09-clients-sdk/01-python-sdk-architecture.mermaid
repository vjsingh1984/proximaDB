---
title: ProximaDB - Python SDK Internal Architecture (Generated + Handwritten)
---
graph TB
    subgraph "SDK Client Facade"
        CLIENT["ProximaDBClient\nclients/python/src/proximadb_sdk/client.py\n- Initializes transports: REST, gRPC, Arrow Flight\n- Connection pooling + retry\n- Auth: JWT token, API key\n- Locality-aware routing (gzip negotiation)\n- Context manager: close(), health()"]
    end

    subgraph "Protocol Layer — Generated REST"
        GEN_REST_SYNC["_rest_codegen/sync/\nGenerated from OpenAPI\n- sync(): blocking HTTP calls\n- sync_detailed(): full response\n- httpx-based HTTP client\n- Auto-generated per-endpoint\n- Type-safe: pydantic models"]
        GEN_REST_ASYNC["_rest_codegen/async/\nGenerated from OpenAPI\n- asyncio(): async HTTP calls\n- asyncio_detailed(): full response\n- httpx.AsyncClient\n- Parallel request support"]
        GEN_GRPC["_generated/grpc/\ngenerated proto stubs\n- protoc + grpcio-tools\n- Request/Response protobuf types\n- tonic-based async stubs"]
    end

    subgraph "Protocol Layer — Handwritten"
        REST_HW["REST Transport\n_rest_transport.py\n- Wraps generated sync/async\n- Connection pool management\n- Retry with backoff\n- Gzip compression negotiation\n- Error mapping: HTTP → Python exception"]
        GRPC_HW["gRPC Transport\n_grpc_transport.py\n- Channel management\n- Streaming: insert_batch(), search()\n- Interceptors: auth, metrics, tracing\n- Error types: grpc.RpcError → Python"]
        FLIGHT_HW["Arrow Flight Transport\n_flight_transport.py\n- Zero-copy bulk reads\n- RecordBatch → numpy/pandas\n- High-throughput ingest\n- Streaming DoGet/DoPut"]
    end

    subgraph "Embedding Providers"
        EMB_BASE["BaseEmbeddingProvider\nembedding_providers/core/base.py\n- embed(texts) → np.ndarray\n- embed_batch(texts, batch_size)\n- token_count(text)\n- Dimensions, model_name"]
        EMB_IMPLS["Provider Implementations (9 total)\n- OpenAIEmbeddingProvider (text-embedding-3)\n- CohereEmbeddingProvider\n- HuggingFaceEmbeddingProvider\n- SentenceTransformerProvider\n- GoogleVertexAIProvider\n- AzureOpenAIProvider\n- OllamaEmbeddingProvider\n- CustomHTTPProvider (any REST)\n- MockProvider (testing)"]
    end

    subgraph "Chunking"
        CHUNK_BASE["ChunkingStrategyInterface\nchunking/core/base.py\n- chunk(text, metadata) → [Chunk]\n- Overlap handling\n- Token counting"]
        CHUNK_IMPLS["Chunking Strategies (8 total)\n- FixedSizeChunking (char-based)\n- TokenBasedChunking (tiktoken)\n- SentenceChunking (spaCy)\n- ParagraphChunking\n- RecursiveChunking (markdown/HTML)\n- SemanticChunking (sentence-transformers)\n- LangChainChunking (wrapper)\n- CodeChunking (20 language parsers)"]
    end

    subgraph "Data Conversion"
        CONVERT["Proto Conversion\n- numpy → proto Vector\n- Python dict → proto Record\n- proto SearchResult → Python SearchResult\n- Schema bridging: Arrow ↔ numpy\n- Type mapping: proto ↔ Python types"]
    end

    subgraph "Error Hierarchy"
        ERRORS["Python Exception Hierarchy (22 types)\nexceptions.py\n- ProximaDBError (base)\n- ProximaDBConnectionError\n- ProximaDBTimeoutError\n- ProximaDBAuthError\n- ProximaDBValidationError\n- ProximaDBNotFoundError\n- ProximaDBRateLimitError\n- ProximaDBQueryError\n- ProximaDBIndexError\n- ... (mirrors Rust ProximaDBError)"]
    end

    CLIENT --> GEN_REST_SYNC
    CLIENT --> GEN_REST_ASYNC
    CLIENT --> GEN_GRPC
    CLIENT --> REST_HW
    CLIENT --> GRPC_HW
    CLIENT --> FLIGHT_HW

    GEN_REST_SYNC --> REST_HW
    GEN_REST_ASYNC --> REST_HW
    GEN_GRPC --> GRPC_HW

    REST_HW --> CONVERT
    GRPC_HW --> CONVERT
    FLIGHT_HW --> CONVERT

    CLIENT --> EMB_BASE
    EMB_BASE --> EMB_IMPLS

    CLIENT --> CHUNK_BASE
    CHUNK_BASE --> CHUNK_IMPLS

    CLIENT --> ERRORS

    REST_SERVER["REST API\n(port 5678)"] --> REST_HW
    GRPC_SERVER["gRPC Service\n(port 5678)"] --> GRPC_HW
    FLIGHT_SERVER["Arrow Flight\n(port 5678)"] --> FLIGHT_HW

