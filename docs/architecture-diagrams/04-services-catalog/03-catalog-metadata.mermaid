---
title: ProximaDB - Catalog & Metadata Subsystem
---
graph TB
    subgraph "Catalog Core"
        CATALOG["CatalogManager\nproximadb-catalog crate (229 symbols)\n- Central metadata registry\n- CRUD for collections, tables, schemas\n- Namespace + tenant management\n- Schema versioning\n- DDL: CREATE/ALTER/DROP"]
    end

    subgraph "Metadata Types"
        COLLECTION["Collection Metadata\n- name, id, tenant_id, ns_id\n- schema: field definitions\n- index_config: HNSW/Compact/IVF\n- distance_metric: L2/Cosine/IP\n- vector_dimension\n- freshness_config: Strong/StaleOk\n- materialization: Parquet/PAX"]
        TABLE["Table Metadata\n- Iceberg table metadata\n- Partition spec\n- Sort order\n- Snapshot history\n- Schema evolution log"]
        GRAPH["Graph Metadata\n- Node types + edge types\n- Property schemas\n- Index config per node/edge type"]
        DOC_META["Document Collection\n- Ingestion pipeline config\n- Chunking strategy\n- Embedding provider + model\n- Chunk metadata fields"]
    end

    subgraph "Schema Registry"
        SCHEMA_REG["Schema Registry\n- Protobuf / Avro / JSON schemas\n- Schema ID assignment\n- Backward/forward compatibility\n- Evolution rules enforcement\n- Integration: Kafka Schema Registry"]
    end

    subgraph "DDL Operations"
        DDL["DDL Executor\n- CREATE COLLECTION/TABLE/GRAPH\n- ALTER ... ADD COLUMN / SET CONFIG\n- DROP ... (with safety checks)\n- SHOW / DESCRIBE\n- GRANT / REVOKE permissions\n- Materialization: ALTER TABLE ... MATERIALIZE"]
    end

    subgraph "Persistence"
        CATALOG_STORE["Catalog Storage\n- Metadata persisted as state files\n- DrPathBuilder: data/{tenant}/{ns}/_catalog/\n- Atomic replaces for safety\n- Snapshot-based backup\n- Bootstraps from disk on startup"]
    end

    subgraph "Cache & Distribution"
        CATALOG_CACHE["Catalog Cache\n- In-memory hot metadata\n- Invalidated on DDL\n- Per-node local cache\n- Cluster: gossip-based invalidation\n- Lease-holder authoritative for writes"]
    end

    CATALOG --> COLLECTION
    CATALOG --> TABLE
    CATALOG --> GRAPH
    CATALOG --> DOC_META
    CATALOG --> SCHEMA_REG
    CATALOG --> DDL
    CATALOG --> CATALOG_STORE
    CATALOG --> CATALOG_CACHE

    API["REST/gRPC/pgwire DDL"] --> CATALOG
    DML["DmlService\n(resolves schemas)"] --> CATALOG
    QUERY["Query Planner\n(resolves tables)"] --> CATALOG

    classDef core fill:#bbdefb,stroke:#1565c0
    classDef meta fill:#c8e6c9,stroke:#2e7d32
    classDef schema fill:#ffe0b2,stroke:#f57c00
    classDef ddl fill:#e1bee7,stroke:#7b1fa2
    classDef store fill:#ffcdd2,stroke:#d32f2f
    classDef cache fill:#d7ccc8,stroke:#5d4037
    classDef ext fill:#b3e5fc,stroke:#0288d1,stroke-dasharray: 5 5

    class CATALOG core
    class COLLECTION,TABLE,GRAPH,DOC_META meta
    class SCHEMA_REG schema
    class DDL ddl
    class CATALOG_STORE store
    class CATALOG_CACHE cache
    class API,DML,QUERY ext
