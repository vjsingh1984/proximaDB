---
title: ProximaDB - Services & Record Store Internal Architecture
---
graph TB
    subgraph "Services Entry Point"
        SVC_ROOT["Service Layer\nCollectionService · SearchService · DmlService\nTableService · NamespaceService · TransactionService"]
    end

    subgraph "WriteLaneRouter (src/services/write_lane_router.rs)"
        LANE["WriteLaneRouter\nroute_write(collection, op) → WriteLaneDecision"]
        LANE_DWAL["DirectWal\nUnstructured inserts\nLowest latency\nNo catalog routing"]
        LANE_CAT["CatalogRouting\nTable-aware writes\nPK enforcement\nIndex sync"]
        LANE_ICEBERG["IcebergWarehouse\nParquet-backed tables\nManifest commit\nSnapshot isolation"]
        LANE --> LANE_DWAL
        LANE --> LANE_CAT
        LANE --> LANE_ICEBERG
    end

    subgraph "RecordStore Abstraction (src/services/record_store/)"
        RS_TRAIT["TableRecordStore (trait)\n├── get(TableRecordGetRequest) → Option<ProximaRecord>\n├── scan(TableRecordScanRequest) → Stream\n├── mutate(TableRecordMutation) → MutationResult\n├── get_stats() → TableStats\n└── invalidate_cache()"]
        RS_VECTOR["VectorOpsTableRecordStore\nWraps VectorOps service\nLegacy collection path"]
        RS_DIRECT["DirectWalTableRecordStore\nRaw WAL writes\nNo schema enforcement"]
        RS_CATALOG["CatalogRoutingTableRecordStore\nFull catalog metadata\nPK + schema validation"]
        RS_ICEBERG["ObjectStoreIcebergRecordStore\nIceberg-managed Parquet\nObjectStoreVectorRecordStore"]
        RS_TRAIT -.-> RS_VECTOR
        RS_TRAIT -.-> RS_DIRECT
        RS_TRAIT -.-> RS_CATALOG
        RS_TRAIT -.-> RS_ICEBERG
    end

    subgraph "TableWriteExecutor (src/query/table_write_executor.rs)"
        TWE["TableWriteExecutor (trait)\nexecute(TableWriteExecutionRequest)\n→ TableWriteExecutionStatus"]
        TWE_NATIVE["NativeTableWriteExecutor\nVolcano row-at-a-time\nWAL + Memtable path"]
        TWE_DF["DataFusionTableWriteExecutor\nArrow RecordBatch input\nParquet/Iceberg output"]
        TWE_PLANNED["PlannedOnlyTableWriteExecutor\nPre-planned write\nDelegates to routed executor"]
        TWE --> TWE_NATIVE
        TWE --> TWE_DF
        TWE --> TWE_PLANNED
    end

    subgraph "DmlService (src/services/dml/mod.rs — 11K+ lines)"
        DML["DmlService\ninsert · update · delete · upsert\ncopy_into · merge_into\nmaterialize_table_to_parquet"]
        DML_PLAN["WritePlanner\nplan_write() → RoutedExecutionPlan\nConflictPolicy · WriteMode\nDistributionMode"]
        DML_LOCK["PartitionLease integration\nacquire DmlLockGuard\nrelease after commit"]
        DML --> DML_PLAN
        DML --> DML_LOCK
    end

    subgraph "Query Execution"
        EXEC["NativeVolcanoExecutor\nexecute_dml(plan)\nWAL → Memtable → Ack → Flush"]
        DF_EXEC["DataFusionExecutor\nexecute_sql(plan)\nArrow → Parquet → Iceberg commit"]
    end

    subgraph "Cache Invalidation"
        CACHE["CacheInvalidationCoordinator\ninvalidate_query_cache(tenant, collection)\ninvalidate_collection_cache(id)\nWrite-path must call post-commit"]
    end

    subgraph "Cross-Model Tx (TD-133)"
        XMODEL["CrossModelTransactionCoordinator\nAtomic: node + embedding + edges\nTransactionOutcome: Committed | RolledBack\nFeature-flag: PROXIMADB_CROSS_MODEL_TX_ENABLED"]
    end

    SVC_ROOT --> LANE
    SVC_ROOT --> DML
    LANE --> DML
    DML --> TWE
    TWE_NATIVE --> RS_CATALOG
    TWE_NATIVE --> RS_DIRECT
    TWE_DF --> RS_ICEBERG
    TWE --> EXEC
    TWE --> DF_EXEC
    DML --> CACHE
    SVC_ROOT --> XMODEL

    classDef service fill:#ffcc80,stroke:#e65100
    classDef lane fill:#ce93d8,stroke:#7b1fa2
    classDef rs fill:#90caf9,stroke:#1565c0
    classDef exec fill:#a5d6a7,stroke:#2e7d32
    classDef cache fill:#f48fb1,stroke:#c2185b
    classDef xmodel fill:#fff176,stroke:#f9a825

    class SVC_ROOT,DML,DML_PLAN,DML_LOCK service
    class LANE,LANE_DWAL,LANE_CAT,LANE_ICEBERG lane
    class RS_TRAIT,RS_VECTOR,RS_DIRECT,RS_CATALOG,RS_ICEBERG rs
    class TWE,TWE_NATIVE,TWE_DF,TWE_PLANNED,EXEC,DF_EXEC exec
    class CACHE cache
    class XMODEL xmodel
