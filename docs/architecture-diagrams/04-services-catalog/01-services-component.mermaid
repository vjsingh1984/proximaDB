---
title: ProximaDB - Services & Catalog Layer Component Diagram
---
graph TB
    subgraph "Facade - ProximaDB Instance"
        DB["🟦 ProximaDB struct\nsrc/database.rs\n(66K loc)\n- Lifecycle management\n- Server orchestration\n- RL checkpointing\n- Queue subsystem\n- God-file (TD-GOD-FILE)"]
    end

    subgraph "Catalog Subsystem"
        CAT_MGR["🟧 CatalogManager\nsrc/catalog/\ncatalog_manager.rs (130K loc)\n- DDL coordination\n- Schema registry\n- Collection metadata\n- Generation-fenced"]
        CAT_META["🟧 Catalog Metadata\nsrc/catalog/metadata.rs (36K loc)\n- Collection/Index metadata\n- Durable config"]
        CAT_TYPES["🟧 Catalog Types\nsrc/catalog/types.rs\n- CatalogTableRef\n- CatalogSchema"]
        CAT_CACHE["🟧 Catalog Cache\nsrc/catalog/catalog_cache.rs (55K loc)\n- In-memory caching\n- LSN-based invalidation"]
        CAT_CRATE["🟧 Catalog Crate\ncrates/control/proximadb-catalog\n- CatalogTableSchema\n- CatalogColumn\n- TableIdentifier\n- 229 symbols"]
    end

    subgraph "DML Service Layer"
        DML_MOD["🔴 DML Service\nsrc/services/dml/mod.rs\n(11K loc)\n- INSERT/UPDATE/DELETE/UPSERT\n- Cross-model transactions\n- Write routing"]
        DML_INSERT["🔴 Insert Operations\n- Batch insert\n- Auto-flush\n- Embedding pipeline"]
        DML_UPDATE["🔴 Update Operations\n- Partial updates\n- Metadata mutation"]
        DML_DELETE["🔴 Delete Operations\n- Soft delete (TTL)\n- Hard delete (tombstone)"]
        DML_UPSERT["🔴 Upsert Operations\n- INSERT ON CONFLICT\n- Merge semantics"]
    end

    subgraph "Write Lane Routing"
        WL["🟤 WriteLaneRouter\nsrc/services/write_lane_router.rs\n- Multi-path write dispatch\n- DirectWal vs CatalogRouting\n- Iceberg vs Vector path\n- WriteIntent resolution"]
        WL_INTENT["🟤 WriteIntent\n- WriteMode\n- WriteLaneDecision"]
        WL_DUR["🟤 WriteDurability\n- WriteDurabilityRequirement\n- BestEffort vs Guaranteed"]
    end

    subgraph "Record Store Abstraction"
        RS_TRAIT["🟩 TableRecordStore (port trait)\n- get_record()\n- scan_records()\n- write_mutation()\n- CatalogRouting mode\n- DirectWal mode\n- Iceberg mode"]
        RS_VECTOR["🟩 Vector TableRecordStore\nObjectStoreVectorRecordStore\n- PAX-backed vectors\n- HNSW index routing"]
        RS_ICEBERG["🟩 Iceberg TableRecordStore\nObjectStoreIcebergRecordStore\n- Parquet-backed tables\n- Iceberg manifest reads"]
        RS_DIRECT["🟩 Direct Wal TableRecordStore\nDirectWalTableRecordStore\n- Direct WAL access\n- Low-latency path"]
        RS_CATALOG["🟩 Catalog Routing\nCatalogRoutingTableRecordStore\n- Catalog-mediated routing\n- Engine dispatch"]
    end

    subgraph "Collection Service"
        COL_SVC["🟣 Collection Service\nsrc/services/collection/\n- CRUD lifecycle\n- Schema validation\n- Engine assignment"]
        COL_TYPES["🟣 Collection Types\n- CollectionInfo\n- CollectionConfig"]
    end

    subgraph "Search Service"
        SEARCH_SVC["🔵 Search Service\nsrc/services/search/\n- Query orchestration\n- Hybrid search\n- Result aggregation\n- Streaming results"]
        HYBRID["🔵 Hybrid Search\n- Pre-filter vs post-filter\n- Adaptive selectivity\n- Score fusion"]
    end

    subgraph "Operations Service"
        OPS["🟢 VectorOps Service\nsrc/services/operations/\n- Vector CRUD\n- Batch operations\n- Rich search results\n- Direct memtable access"]
    end

    subgraph "Event Service"
        EVENTS["🟨 Event Log Service\nsrc/services/events/\n- Operation logging\n- Event replay\n- Compaction triggers"]
    end

    subgraph "Transaction Service"
        TX_SVC["⬜ Transaction Service\nsrc/services/transaction/\n- CrossModelTransactionCoordinator\n- Atomic multi-modal writes\n- PROXIMADB_CROSS_MODEL_TX_ENABLED flag"]
    end

    subgraph "Record Validation"
        VALIDATOR["⚪ Record Validator\nsrc/services/record_validator/\n- Schema validation\n- Type checking\n- Constraint enforcement"]
    end

    subgraph "Table & Namespace Service"
        TABLE_SVC["🔶 Table Service\nsrc/services/table_service.rs\n(56K loc)\n- Relational table operations\n- DDL execution"]
        NS_SVC["🔶 Namespace Service\nsrc/services/namespace_service.rs\n- Tenant namespace mgmt"]
    end

    %% Flow
    DB --> CAT_MGR
    DB --> DML_MOD
    DB --> COL_SVC

    NETWORK["Network Layer"] -->|REST/gRPC| DML_MOD
    NETWORK -->|REST/gRPC| SEARCH_SVC
    NETWORK -->|REST/gRPC| OPS
    NETWORK -->|REST/gRPC| COL_SVC
    NETWORK -->|REST/gRPC| TABLE_SVC
    NETWORK -->|REST/gRPC| NS_SVC

    DML_MOD --> WL
    WL --> RS_TRAIT
    WL --> DML_INSERT
    WL --> DML_UPDATE
    WL --> DML_DELETE
    WL --> DML_UPSERT

    RS_TRAIT --> RS_VECTOR
    RS_TRAIT --> RS_ICEBERG
    RS_TRAIT --> RS_DIRECT
    RS_TRAIT --> RS_CATALOG

    RS_VECTOR --> STORE_ENGINE["Storage Engine"]
    RS_ICEBERG --> ICEBERG_STORE["Iceberg Engine"]
    RS_DIRECT --> WAL["Write-Ahead Log"]
    RS_CATALOG --> CAT_MGR

    SEARCH_SVC --> HYBRID
    SEARCH_SVC --> OPS
    HYBRID --> RS_TRAIT

    OPS --> STORE_ENGINE
    OPS --> VALIDATOR

    DML_MOD --> VALIDATOR
    VALIDATOR --> EVENTS

    DML_MOD --> TX_SVC
    TX_SVC --> STORE_ENGINE["Vector Engine"]
    TX_SVC --> GRAPH_ENGINE["Graph Engine (ORION)"]

    CAT_MGR --> CAT_META
    CAT_MGR --> CAT_TYPES
    CAT_MGR --> CAT_CACHE

    COL_SVC --> CAT_MGR
    TABLE_SVC --> CAT_MGR

    classDef facade fill:#bbdefb,stroke:#1565c0
    classDef catalog fill:#ffe0b2,stroke:#f57c00
    classDef dml fill:#ffcdd2,stroke:#d32f2f
    classDef write fill:#d7ccc8,stroke:#5d4037
    classDef rs fill:#c8e6c9,stroke:#2e7d32
    classDef col fill:#e1bee7,stroke:#7b1fa2
    classDef search fill:#b3e5fc,stroke:#0288d1
    classDef ops fill:#b2dfdb,stroke:#00695c
    classDef events fill:#fff9c4,stroke:#f9a825
    classDef tx fill:#f5f5f5,stroke:#9e9e9e
    classDef other fill:#ffccbc,stroke:#e64a19

    class DB facade
    class CAT_MGR,CAT_META,CAT_TYPES,CAT_CACHE,CAT_CRATE catalog
    class DML_MOD,DML_INSERT,DML_UPDATE,DML_DELETE,DML_UPSERT dml
    class WL,WL_INTENT,WL_DUR write
    class RS_TRAIT,RS_VECTOR,RS_ICEBERG,RS_DIRECT,RS_CATALOG rs
    class COL_SVC,COL_TYPES col
    class SEARCH_SVC,HYBRID search
    class OPS ops
    class EVENTS events
    class TX_SVC tx
    class VALIDATOR,TABLE_SVC,NS_SVC other
