---
title: ProximaDB - Streaming / CDC Subsystem
---
graph TB
    subgraph "Streaming Coordinator"
        COORD["StreamingCoordinator\nstreaming/coordinator.rs\n- Manages subscription lifecycle\n- Watermark tracking\n- Rate limiting per tenant\n- Backpressure handling\n- IntegratedService wrapper"]
    end

    subgraph "Change Data Capture"
        CDC["CDC Module\nsrc/cdc/\n- WAL tailing for change events\n- Event types: INSERT, UPDATE, DELETE\n- Per-collection change streams\n- Snapshot + incremental mode\n- Resume from LSN/offset"]
    end

    subgraph "Subscription Management"
        SUBS["Subscription Manager\nstreaming/subscriptions/\n- Create/list/drop subscriptions\n- Per-subscription cursor tracking\n- Acknowledgment-based delivery\n- At-least-once semantics"]
        SESSION["Streaming Session\nstreaming/session.rs\n- Per-connection session state\n- Cursor position\n- Client heartbeat/ping\n- Graceful disconnect handling"]
    end

    subgraph "Kafka Integration"
        KAFKA["Kafka Bridge\nstreaming/kafka/\n- ProximaDB → Kafka sink\n- Kafka → ProximaDB source\n- Topic auto-creation\n- Partition key: tenant_id\n- Schema registry integration\n- Configurable delivery guarantees"]
    end

    subgraph "Ring Buffer"
        RING["Ring Buffer\nstreaming/ring_buffer.rs\n- Lock-free SPSC ring buffer\n- Bounded capacity (configurable)\n- Batch read/write\n- Overflow policy: drop-oldest\n  or block-producer\n- Per-subscriber buffer"]
    end

    subgraph "Watermarks"
        WM["Watermark Tracker\nstreaming/watermarks.rs\n- Event-time watermarks\n- Per-partition watermark\n- Low-watermark across partitions\n- Idle partition detection\n- Late-data handling policy"]
    end

    subgraph "Rate Limiting"
        RL["Rate Limiter\nstreaming/rate_limiter.rs\n- Token bucket algorithm\n- Per-tenant rate limits\n- Burst allowance\n- Backpressure signal to\n  producers when near limit"]
    end

    subgraph "Metrics"
        METRICS["Streaming Metrics\nstreaming/metrics.rs\n- Events produced/consumed\n- End-to-end latency P50/P99\n- Buffer utilization\n- Subscription lag\n- Prometheus exposition"]
    end

    CDC --> COORD
    COORD --> SUBS
    COORD --> SESSION
    COORD --> RING
    COORD --> WM
    COORD --> RL
    COORD --> KAFKA

    WAL["WAL (source of CDC events)"] --> CDC
    SUBS --> RING
    SESSION --> SUBS

    METRICS -.-> COORD
    METRICS -.-> CDC
    METRICS -.-> KAFKA

    classDef coord fill:#bbdefb,stroke:#1565c0
    classDef cdc fill:#c8e6c9,stroke:#2e7d32
    classDef sub fill:#ffe0b2,stroke:#f57c00
    classDef kafka fill:#e1bee7,stroke:#7b1fa2
    classDef ring fill:#ffcdd2,stroke:#d32f2f
    classDef wm fill:#b3e5fc,stroke:#0288d1
    classDef rl fill:#d7ccc8,stroke:#5d4037
    classDef met fill:#f5f5f5,stroke:#9e9e9e
    classDef ext fill:#b3e5fc,stroke:#0288d1,stroke-dasharray: 5 5

    class COORD coord
    class CDC cdc
    class SUBS,SESSION sub
    class KAFKA kafka
    class RING ring
    class WM wm
    class RL rl
    class METRICS met
    class WAL ext
