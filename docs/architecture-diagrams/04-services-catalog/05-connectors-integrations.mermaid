---
title: ProximaDB - Connectors & Integrations Subsystem
---
graph TB
    subgraph "Connector Manager"
        CONNECTOR["ConnectorManager\nsrc/connectors/\n- Plugin-based connector registry\n- Dynamic loading: .so / .dylib\n- Lifecycle: start, stop, health\n- Config: per-connector settings\n- Metrics: events/sec, latency, errors"]
    end

    subgraph "Source Connectors (Ingest)"
        KAFKA_SRC["Kafka Source\n- Consumer group model\n- Topic → collection mapping\n- Schema Registry integration\n- Offset management\n- Exactly-once semantics"]
        PULSAR_SRC["Pulsar Source\n- Multi-topic subscription\n- Partition-aware routing\n- Pulsar Functions integration"]
        S3_SRC["S3/Blob Source\n- Object notification trigger\n- Batch load: Parquet, JSON, CSV\n- Incremental: new object detection\n- Schema inference"]
        CDC_SRC["CDC Source\n- Postgres WAL reader\n- MySQL binlog reader\n- Change event → DmlOperation\n- Snapshot + incremental sync"]
    end

    subgraph "Sink Connectors (Export)"
        KAFKA_SINK["Kafka Sink\n- Produce DML events as messages\n- Exactly-once: idempotent producer\n- Topic per collection"]
        ICEBERG_SINK["Iceberg Sink\n- Parquet format\n- Partition evolution\n- Manifest metadata\n- Time-travel snapshots"]
        ELAS_SINK["Elasticsearch Sink\n- Full-text indexing\n- Bulk API writes\n- Index template management"]
    end

    subgraph "Kafka Bridge (Internal)"
        KAFKA_BRIDGE["KafkaBridge\nsrc/cdc/kafka_bridge.rs\n- Internal event propagation\n- WAL → Kafka (async replication)\n- Multi-region: produce to local\n  Kafka for remote cluster sync\n- Consumer: apply remote writes\n- Schema versioning: proto-backed"]
    end

    subgraph "Connector SDK"
        SDK["Connector SDK\nsrc/connectors/sdk/\n- SourceConnector trait\n- SinkConnector trait\n- ConfigSchema trait\n- ConnectorContext (metrics, logging)\n- State store: persistent offsets"]
    end

    CONNECTOR --> KAFKA_SRC
    CONNECTOR --> PULSAR_SRC
    CONNECTOR --> S3_SRC
    CONNECTOR --> CDC_SRC
    CONNECTOR --> KAFKA_SINK
    CONNECTOR --> ICEBERG_SINK
    CONNECTOR --> ELAS_SINK
    CONNECTOR --> SDK
    CONNECTOR --> KAFKA_BRIDGE

    KAFKA_BRIDGE --> CDC_SRC
    KAFKA_BRIDGE --> KAFKA_SINK

    WAL["WAL Engine"] --> KAFKA_BRIDGE
    KAFKA_BRIDGE --> DML["DmlService\n(replay remote writes)"]

    classDef core fill:#bbdefb,stroke:#1565c0
    classDef src fill:#c8e6c9,stroke:#2e7d32
    classDef sink fill:#ffe0b2,stroke:#f57c00
    classDef bridge fill:#e1bee7,stroke:#7b1fa2
    classDef sdk fill:#ffcdd2,stroke:#d32f2f
    classDef ext fill:#b3e5fc,stroke:#0288d1,stroke-dasharray: 5 5

    class CONNECTOR core
    class KAFKA_SRC,PULSAR_SRC,S3_SRC,CDC_SRC src
    class KAFKA_SINK,ICEBERG_SINK,ELAS_SINK sink
    class KAFKA_BRIDGE bridge
    class SDK sdk
    class WAL,DML ext
