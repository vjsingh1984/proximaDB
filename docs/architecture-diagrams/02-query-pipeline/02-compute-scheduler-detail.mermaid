---
title: ProximaDB - ComputeScheduler Engine Selection Detail (Read-Side Routing)
---
graph TB
    subgraph "Route Inputs"
        FRESHNESS["ReadFreshnessSla\n- Strong: always Native (P0)\n- StaleOk: OLAP eligible (future)"]
        CARDINALITY["CardinalityClass\n- Unknown → coarse\n- Small ≤1K → Volcano\n- Medium ≤1M → hybrid\n- Large >1M → DataFusion"]
        FANOUT["PartitionFanout\n- Unknown → coarse\n- Single → 1 segment\n- Few ≤8 → bounded\n- Many → GET-dominated"]
        WORKLOAD["CatalogWorkloadProfile\n- OLTP · OLAP · Hybrid"]
    end

    subgraph "Route Decision"
        SCHEDULER["ComputeScheduler\nroute_select(plan, freshness, workload)\nPolicy→RL (future)\nP0: ALWAYS ComputeBackend::Native"]
        DECISION["SelectRouteDecision\n- chosen_backend: ComputeBackend\n- shape_class: coarse|s|card=m|...\n- reason: diagnostic string"]
    end

    subgraph "Backend Dispatch (one engine per query plan)"
        VOLCANO["ComputeBackend::Native\nVolcano executor, live WAL+RecordStorage\nStrong freshness, row-wise\nP0: ALWAYS selected"]
        DATAFUSION["ComputeBackend::DataFusion\nOLAP: vectorized columnar operators\nrequires parquet-backed table\nP1+: wired once live read path exists\nADR-052 Accepted 2026-07-04"]
        POLARS["ComputeBackend::Polars\nDeclared, future\nAlternative columnar engine"]
    end

    subgraph "Cost Model"
        COST_TABLE["RouteCostTable\nPer (workload,shape_class,backend)\nCold: static heuristics\nWarm: RL-updated (future)"]
        RL["RL Planner\nObserves latency/throughput traces\nUpdates RouteCostTable weights\nCheckpoints every 5 min"]
    end

    FRESHNESS --> SCHEDULER
    CARDINALITY --> SCHEDULER
    FANOUT --> SCHEDULER
    WORKLOAD --> SCHEDULER
    SCHEDULER --> DECISION
    DECISION --> VOLCANO
    DECISION --> DATAFUSION
    DECISION --> POLARS
    SCHEDULER --> COST_TABLE
    COST_TABLE --> RL
    PGWIRE["pgwire SELECT\nrelational_pipeline.rs\nlowers SQL→route_select()"] --> SCHEDULER

    classDef input fill:#e8f5e9,stroke:#43a047
    classDef sched fill:#bbdefb,stroke:#1565c0
    classDef dec fill:#90caf9,stroke:#1565c0
    classDef volcano fill:#c8e6c9,stroke:#2e7d32
    classDef df fill:#e1bee7,stroke:#7b1fa2
    classDef polars fill:#ffe0b2,stroke:#f57c00
    classDef cost fill:#f5f5f5,stroke:#9e9e9e
    classDef ext fill:#b3e5fc,stroke:#0288d1

    class FRESHNESS,CARDINALITY,FANOUT,WORKLOAD input
    class SCHEDULER sched
    class DECISION dec
    class VOLCANO volcano
    class DATAFUSION df
    class POLARS polars
    class COST_TABLE,RL cost
    class PGWIRE ext
