---
title: ProximaDB - Read Path (Vector Search) Component Diagram
---
graph TB
    subgraph "Read Entry Points"
        API["API Layer\nSearchRequest {query_vector, k, filter}" ]
        PGWIRE["pgwire\nSELECT ... ORDER BY vector_distance\n→ lowered to vector search"]
    end

    subgraph "Search Pipeline"
        SEARCH["Search Service\nsrc/search/\n- Orchestrates vector search\n- Merges results from engines\n- Applies post-filters\n- Reranking + score fusion"]
        FRESHNESS["Freshness Check\n- Strong: bypass cache, compute live\n- StaleOk: check result cache\n  hit → return cached\n  miss → compute + cache"]
    end

    subgraph "Engine Dispatch"
        COMPUTE_SCHED["ComputeScheduler\n- Routes to engine per config\n- P0 (Strong): native volcano\n- P1+: engine-specific path\n- Cost model: engine perf stats"]
    end

    subgraph "Index Search"
        HNSW_SEARCH["HNSW Index Search\n- Layer-wise greedy traversal\n- Entry point → top layer → layer 0\n- ef_search beam width\n- Returns: Vec<(id, distance)>\n- Post-filter: apply metadata filters"]
        COMPACT_SEARCH["Compact Index Search\n- Coarse quantizer lookup\n- Probe nearest centroids\n- Fine quantizer distance\n- PQ distance approximation\n- Rerank top k with f32"]
    end

    subgraph "Storage Engine"
        ENGINE["Storage Engine\n- Reads PAX blocks for result records\n- Applies is_dead(now_ns) predicate\n  (valid_to_ns == Some(0) → tombstone)\n  (valid_to_ns < now_ns → TTL expired)\n- Decodes full record from block\n- Returns ProximaRecord list"]
    end

    subgraph "Record Filter"
        FILTER["Record Filter\n- Apply metadata conditions\n- Tenant isolation check\n- Permission check (RBAC)\n- Field projection"]
    end

    subgraph "Quantization Path"
        QUANT_SEARCH["Quantized Search\n- SQ8/RaBitQ: fast approximate\n- Coarse search in quantized space\n- Rerank f32 on top candidates\n- Trade: speed vs recall"]
    end

    subgraph "Result Assembly"
        ASSEMBLY["Result Assembly\n- Merge index results + record data\n- Sort by distance\n- Apply limit (k)\n- Format: JSON/Protobuf/Arrow"]
    end

    API --> SEARCH
    PGWIRE --> SEARCH
    SEARCH --> FRESHNESS
    FRESHNESS --> COMPUTE_SCHED
    COMPUTE_SCHED --> HNSW_SEARCH
    COMPUTE_SCHED --> COMPACT_SEARCH
    COMPUTE_SCHED --> QUANT_SEARCH

    HNSW_SEARCH --> ENGINE
    COMPACT_SEARCH --> ENGINE
    QUANT_SEARCH --> ENGINE

    ENGINE --> FILTER
    FILTER --> ASSEMBLY
    ASSEMBLY --> API

    classDef api fill:#b3e5fc,stroke:#0288d1
    classDef search fill:#bbdefb,stroke:#1565c0
    classDef fresh fill:#fff9c4,stroke:#f9a825
    classDef sched fill:#c8e6c9,stroke:#2e7d32
    classDef idx fill:#ffe0b2,stroke:#f57c00
    classDef engine fill:#e1bee7,stroke:#7b1fa2
    classDef filt fill:#ffcdd2,stroke:#d32f2f
    classDef quant fill:#d7ccc8,stroke:#5d4037
    classDef asm fill:#b3e5fc,stroke:#0288d1,stroke-dasharray: 5 5

    class API,PGWIRE api
    class SEARCH search
    class FRESHNESS fresh
    class COMPUTE_SCHED sched
    class HNSW_SEARCH,COMPACT_SEARCH idx
    class ENGINE engine
    class FILTER filt
    class QUANT_SEARCH quant
    class ASSEMBLY asm
