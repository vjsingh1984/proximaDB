---
title: ProximaDB - Query Pipeline Component Diagram
---
graph TB
    subgraph "SQL Frontend"
        PARSER["🔵 SQL Parser\nsrc/query/sql_frontend/parser.rs\n(171K loc)\n- sqlparser-rs integration\n- DDL/DML/DQL parsing\n- CREATE/ALTER/DROP/SELECT"]
        LOWER["🔵 SQL Lowering\nsrc/query/sql_frontend/lowering/\n- SQL AST → Internal IR\n- Type resolution\n- Name binding"]
        ANALYZER["🔵 Query Analyzer\n- Semantic validation\n- Schema resolution\n- Permission checks"]
    end

    subgraph "Optimization Layer"
        OPT["🟣 Query Optimizer\nsrc/query/query_optimizer.rs\n(124K loc)\n- Cost-based optimization\n- Rule-based rewrites\n- Predicate pushdown\n- Join reordering\n- Limit pushdown"]
        HEURISTIC["🟣 Heuristic Rules\n- Filter pushdown\n- Projection pruning\n- Constant folding"]
        CBO["🟣 Cost-Based Optimizer\n- Cardinality estimation\n- Index selection\n- Engine costing"]
    end

    subgraph "Compute Scheduler (Router)"
        CS["🟧 ComputeScheduler\nsrc/query/compute_scheduler.rs\n- Engine dispatch\n- OLAP vs OLTP routing\n- Backend selection\n- Freshness mode gating"]
        CS_ROUTE["🟧 route_select()\n- Check: parquet-backed table?\n- Yes → DataFusion (OLAP)\n- No → Native Volcano (OLTP)\n- Strong mode → bypass cache"]
        CS_COST["🟧 Cost Model\n- I/O cost estimation\n- Network round-trip counting\n- Per-engine statistics"]
    end

    subgraph "Execution Engines"
        EXEC_MOD["🔴 Execution Module\nsrc/query/execution/"]
        NV["🔴 NativeVolcanoEngine\nsrc/query/execution/engine.rs\n- Row-at-a-time Volcano\n- OLTP/point-lookup floor\n- build_executor → collect"]
        DF_BACKEND["🔴 DataFusion Backend\nsrc/datafusion/\n- TableProvider impl\n- ScanExec with pushdown\n- PhysicalFilterTranslate\n- ADR-052 vectorized OLAP"]
        STREAM["🔴 Streaming Executor\n- ExecutionStreamResult\n- BoxStream of rows\n- Pipeline parallelism"]
    end

    subgraph "Query Cache"
        QC["🟡 Query Result Cache\nsrc/query/cache/query_result_cache.rs\n- ADR-051 D2\n- Structurally keyed\n- LSN-pinned freshness\n- env: QUERY_RESULT_CACHE"]
        CIC["🟡 Cache Invalidation Coordinator\nsrc/query/cache/invalidation_coordinator.rs\n- Write-path invalidation\n- (tenant, collection) scoping\n- DDL invalidation"]
        QC_KEY["🟡 QueryKey / StructuralKey\n- Normalized SQL fingerprint\n- Tenant-scoped"]
    end

    subgraph "Multi-Model Query"
        MM_PLAN["🟢 Multi-Model Plan\ncrates/query/proximadb-multimodel-plan\n- Cross-modal planning\n- Vector + Graph + Doc"]
        MM_QUERY["🟢 Multi-Model Query\ncrates/query/proximadb-multimodel-query\n- Unified query AST"]
        FUSION["🟢 Query Fusion\ncrates/query/proximadb-query-fusion\n- RRF / hybrid ranking\n- Multi-modal merge"]
    end

    subgraph "Relational Engine"
        REL_FE["🔷 Relational Frontend\ncrates/query/proximadb-relational-frontend\n- CatalogLookup\n- lower_sql()"]
        REL_PLAN["🔷 Relational Planner\ncrates/query/proximadb-relational-planner\n- PhysicalPlan\n- CapabilityResolver\n- explain_physical()"]
        REL_EXEC["🔷 Relational Executor\ncrates/query/proximadb-relational-executor\n- ExecNode tree\n- build_executor()\n- collect()"]
        REL_READER["🔷 Relational Reader\ncrates/query/proximadb-relational-reader\n- RelationalReader trait\n- ScanContext\n- ReaderCapabilities"]
        ALGEBRA["🔷 Relational Algebra\ncrates/query/proximadb-relational-algebra\n- TableId\n- Algebraic operators"]
        INMEM["🔷 InMemoryRelationalEngine\ncrates/query/proximadb-relational-engine\n- Process-wide engine\n- GLOBAL_ENGINE static"]

    end

    subgraph "Table Write Path"
        TWP["🟤 Table Write Planner\nsrc/query/table_write_plan/\n- DmlWritePlanner\n- ConflictPolicy\n- WriteMode\n- RoutedExecutionPlan"]
        TWE["🟤 Table Write Executor\nsrc/query/table_write_executor/\n- DataFusionTableWriteExecutor\n- NativeTableWriteExecutor\n- TableRecordStore"]
    end

    subgraph "Result Output"
        PGWIRE["pgwire DataRow\npostgres/protocol.rs"]
        REST_JSON["REST JSON Response\nrest/handlers/"]
        FLIGHT["Arrow Flight\narrow_ipc/service.rs"]
    end

    %% Flow
    PARSER --> ANALYZER
    ANALYZER --> LOWER
    PARSER --> OPT

    LOWER --> OPT
    LOWER --> MM_QUERY

    OPT --> CS
    OPT --> MM_PLAN
    MM_PLAN --> CS

    CS --> CS_ROUTE
    CS_ROUTE --> CS_COST
    CS_ROUTE -->|"parquet table"| DF_BACKEND
    CS_ROUTE -->|"native table"| NV
    CS_ROUTE -->|"Strong freshness"| QC

    NV --> QC
    DF_BACKEND --> QC
    QC --> QC_KEY

    CS -.->|"write path"| TWP
    TWP --> TWE
    TWE -.->|invalidate| CIC

    NV --> STREAM
    DF_BACKEND --> STREAM

    STREAM --> PGWIRE
    STREAM --> REST_JSON
    STREAM --> FLIGHT

    %% Relational pipeline
    PGWIRE --> REL_FE
    REL_FE --> REL_PLAN
    REL_PLAN --> REL_EXEC
    REL_FE --> ALGEBRA
    REL_EXEC --> REL_READER
    REL_EXEC --> INMEM

    %% Cross connections
    FUSION --> STREAM
    MM_QUERY --> MM_PLAN

    classDef frontend fill:#bbdefb,stroke:#1565c0
    classDef opt fill:#e1bee7,stroke:#7b1fa2
    classDef sched fill:#ffe0b2,stroke:#f57c00
    classDef exec fill:#ffcdd2,stroke:#d32f2f
    classDef cache fill:#fff9c4,stroke:#f9a825
    classDef mm fill:#c8e6c9,stroke:#2e7d32
    classDef rel fill:#b3e5fc,stroke:#0288d1
    classDef write fill:#d7ccc8,stroke:#5d4037

    class PARSER,LOWER,ANALYZER frontend
    class OPT,HEURISTIC,CBO opt
    class CS,CS_ROUTE,CS_COST sched
    class EXEC_MOD,NV,DF_BACKEND,STREAM exec
    class QC,CIC,QC_KEY cache
    class MM_PLAN,MM_QUERY,FUSION mm
    class REL_FE,REL_PLAN,REL_EXEC,REL_READER,ALGEBRA,INMEM rel
    class TWP,TWE write
