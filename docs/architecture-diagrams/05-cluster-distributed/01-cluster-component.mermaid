---
title: ProximaDB - Cluster & Distributed Systems Component Diagram
---
graph TB
    subgraph "Cluster Coordination"
        PL["🟦 Partition Lease\nsrc/cluster/partition_lease.rs\n(4.5K loc, 255 symbols)\n- Per (tenant,collection) lease\n- Generation-fenced\n- CockroachDB-style\n- Renew/Acquire/Expire lifecycle"]
        PM["🟦 Primary Pod Registry\nsrc/cluster/primary_pod_registry.rs\n- Active pod tracking\n- Write routing decisions\n- AssignmentReason"]
        CONSENSUS["🟦 Consensus Engine\nsrc/cluster/consensus/\n(feature-gated: 'cluster')\n- Raft consensus\n- Leader election\n- Log replication"]
        REPL["🟦 Engine Replication\nsrc/cluster/replication/\n(feature-gated: 'cluster')\n- State machine replication\n- Snapshot transfer"]
        MEMBERSHIP["🟦 Cluster Membership\nsrc/cluster/membership_manager.rs\n- Gossip protocol\n- Failure detection\n- Ring membership"]
    end

    subgraph "Distributed Query"
        SHUFFLE["🟧 Distributed Shuffle\ncrates/query/proximadb-query/src/distributed/\n- ShuffleKey-based partitioning\n- Partition-wise execution\n- RemoteExchange operator"]
        SCATTER["🟧 Scatter/Gather\n- Fan-out to partitions\n- Result merging\n- Partial results"]
        DIST_PLAN["🟧 Distributed Planner\nsrc/query/distributed_planner/\n- Plan fragmentation\n- Partition assignment"]
    end

    subgraph "Node Discovery & Routing"
        DISCOVERY["🟩 Node Discovery\nsrc/cluster/discovery.rs\n- Peer discovery\n- Health heartbeats"]
        ROUTING["🟩 Request Routing\n- Proxied requests\n- Remote execution\n- Node affinity"]
        LOAD_BAL["🟩 Load Balancing\nsrc/cluster/load_balancer.rs\n- Request distribution\n- Node selection"]
    end

    subgraph "Fencing & Safety"
        FENCE["🔴 Write Fence\nsrc/cluster/fence.rs\n- Double-write prevention\n- Generation-based fencing\n- Stale-writer detection"]
        GUARD["🔴 Cross-Tenant Guard\nsrc/audit/cross_tenant_guard.rs\n- Tenant boundary enforcement\n- I/O path gating"]
        MANIFEST["🔴 Manifest Committer\nproximadb-iceberg-engine manifest\n- commit_fenced()\n- put_if_absent CAS\n- Atomic lease acquisition"]
    end

    subgraph "Streaming & CDC"
        STREAM_COORD["🟣 Streaming Coordinator\nsrc/streaming/coordinator.rs\n(33K loc)\n- Async pub/sub\n- Change data capture"]
        KAFKA["🟣 Kafka Integration\nsrc/streaming/kafka/\n- Kafka source/sink\n- Partition consumers"]
        SESSION["🟣 Streaming Session\nsrc/streaming/session.rs\n- Client sessions\n- Subscription state"]
        CDC["🟣 CDC Subsystem\nsrc/cdc/\n- Change capture\n- Event streaming"]
        WATERMARK["🟣 Watermarks\nsrc/streaming/watermarks.rs\n- Event time tracking"]
    end

    subgraph "Connectors"
        CONN_MGR["⬜ Connector Manager\nsrc/connectors/\n- External data sources\n- Sink connectors"]
        CONN_STORE["⬜ Connector Store\n- Connector state\n- Offset tracking"]
    end

    %% Relationships
    PL --> PM
    PL --> MANIFEST
    PM --> ROUTING
    CONSENSUS --> REPL
    CONSENSUS --> MEMBERSHIP

    DISCOVERY --> MEMBERSHIP
    ROUTING --> DISCOVERY
    LOAD_BAL --> ROUTING

    FENCE --> PL
    GUARD --> PL

    SHUFFLE --> PL
    SHUFFLE --> SCATTER
    DIST_PLAN --> SHUFFLE

    STREAM_COORD --> KAFKA
    STREAM_COORD --> SESSION
    STREAM_COORD --> CDC
    CDC --> WATERMARK

    CONN_MGR --> STREAM_COORD

    classDef lease fill:#bbdefb,stroke:#1565c0
    classDef dist fill:#ffe0b2,stroke:#f57c00
    classDef disc fill:#c8e6c9,stroke:#2e7d32
    classDef fence fill:#ffcdd2,stroke:#d32f2f
    classDef stream fill:#e1bee7,stroke:#7b1fa2
    classDef conn fill:#f5f5f5,stroke:#9e9e9e

    class PL,PM,CONSENSUS,REPL,MEMBERSHIP lease
    class SHUFFLE,SCATTER,DIST_PLAN dist
    class DISCOVERY,ROUTING,LOAD_BAL disc
    class FENCE,GUARD,MANIFEST fence
    class STREAM_COORD,KAFKA,SESSION,CDC,WATERMARK stream
    class CONN_MGR,CONN_STORE conn
