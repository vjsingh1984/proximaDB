---
title: ProximaDB - Security, Auth & Governance Component Diagram
---
graph TB
    subgraph "Security Coordinator"
        SEC_COORD["🟦 SecurityCoordinator\nsrc/security/\n- Auth/AuthZ orchestration\n- RBAC enforcement\n- Security policy"]
        SEC_CONFIG["🟦 SecurityConfig\n- Authentication config\n- Security mode\n- Tenant isolation policy"]
    end

    subgraph "Authentication"
        AUTH_MOD["🟧 Auth Module\nsrc/auth/mod.rs\n(18K loc)\n- JWT validation\n- API key auth\n- Token management"]
        AUTH_JWT["🟧 JWT\nsrc/auth/jwt.rs\n- Token generation\n- Validation\n- Refresh flow"]
        AUTH_PROV["🟧 Providers\nsrc/auth/providers.rs\n- OIDC provider\n- SAML provider\n- Custom provider"]
        AUTH_FED["🟧 Federated Delegation\nsrc/auth/federated_delegation_complete.rs\n(44K loc)\n- Cross-tenant auth\n- Delegation chains\n- Impersonation"]
        AUTH_SSO["🟧 SSO\nsrc/auth/sso/\n- Enterprise SSO\n- OAuth flows"]
    end

    subgraph "Authorization (RBAC)"
        RBAC["🟩 RBAC Engine\nsrc/auth/rbac.rs\n- Role definitions\n- Permission grants\n- Resource scoping"]
        RBAC_TYPES["🟩 RBAC Types\nsrc/auth/rbac_types.rs\n- Role hierarchy\n- Permission enum\n- Policy definitions"]
    end

    subgraph "Governance"
        GOV["🟣 Governance\nsrc/governance/\n- Compliance tracking\n- Data retention\n- Access audit"]
        GOV_POLICY["🟣 Policy Engine\n- Retention policies\n- GDPR compliance\n- Data classification"]
    end

    subgraph "Audit System"
        AUDIT_LOG["🔴 Audit Logger\nsrc/audit/logger.rs\n(54K loc)\n- Operation auditing\n- Access logs\n- Change tracking"]
        AUDIT_STORE["🔴 Audit Storage\nsrc/audit/storage.rs\n(31K loc)\n- Durable audit trail\n- Retention management"]
        AUDIT_CORR["🔴 Audit Correlation\nsrc/audit/correlation.rs\n(33K loc)\n- Event correlation\n- Forensic analysis"]
        AUDIT_TYPES["🔴 Audit Types\nsrc/audit/types.rs\n- AuditEvent\n- AuditLevel"]
    end

    subgraph "Observability"
        OBS["🟤 Observability\nsrc/observability/\n- Distributed tracing\n- Metrics aggregation\n- Log collection"]
        METRICS["🟤 Metrics\nsrc/metrics/\n- Prometheus metrics\n- Billing tracking\n- KSU/KRU/KOU/KIU/KU"]
        MONITORING["🟤 Monitoring\nsrc/monitoring/\n- Health checks\n- Alert rules\n- Dashboards"]
    end

    subgraph "Telemetry"
        TELEM["⬜ Telemetry\ncrates/horizontal/proximadb-telemetry\n- Billing metrics\n- I/O attribution\n- Tenant accounting"]
    end

    subgraph "TLS & Encryption"
        TLS_CRATE["🔐 TLS Crate\ncrates/horizontal/proximadb-tls\n- Certificate management\n- TLS config"]
        ENCRYPTION["🔐 Storage Encryption\ncrates/storage/proximadb-storage-encryption\n- At-rest encryption\n- Key management"]
        SEC_HORIZ["🔐 Security Crate\ncrates/horizontal/proximadb-security\n- Shared security primitives\n- Crypto utilities"]
    end

    %% Flow
    SEC_COORD --> AUTH_MOD
    SEC_COORD --> RBAC
    SEC_COORD --> GOV

    AUTH_MOD --> AUTH_JWT
    AUTH_MOD --> AUTH_PROV
    AUTH_MOD --> AUTH_FED
    AUTH_MOD --> AUTH_SSO

    RBAC --> RBAC_TYPES

    GOV --> GOV_POLICY
    GOV --> AUDIT_LOG

    AUDIT_LOG --> AUDIT_STORE
    AUDIT_LOG --> AUDIT_CORR
    AUDIT_LOG --> AUDIT_TYPES

    OBS --> METRICS
    OBS --> MONITORING
    METRICS --> TELEM

    TLS_CRATE --> AUTH_MOD
    ENCRYPTION --> SEC_COORD

    classDef coord fill:#bbdefb,stroke:#1565c0
    classDef auth fill:#ffe0b2,stroke:#f57c00
    classDef rbac fill:#c8e6c9,stroke:#2e7d32
    classDef gov fill:#e1bee7,stroke:#7b1fa2
    classDef audit fill:#ffcdd2,stroke:#d32f2f
    classDef obs fill:#d7ccc8,stroke:#5d4037
    classDef tele fill:#f5f5f5,stroke:#9e9e9e
    classDef enc fill:#b2dfdb,stroke:#00695c

    class SEC_COORD,SEC_CONFIG coord
    class AUTH_MOD,AUTH_JWT,AUTH_PROV,AUTH_FED,AUTH_SSO auth
    class RBAC,RBAC_TYPES rbac
    class GOV,GOV_POLICY gov
    class AUDIT_LOG,AUDIT_STORE,AUDIT_CORR,AUDIT_TYPES audit
    class OBS,METRICS,MONITORING obs
    class TELEM tele
    class TLS_CRATE,ENCRYPTION,SEC_HORIZ enc
