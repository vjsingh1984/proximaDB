---
title: ProximaDB - Security & Governance Subsystem
---
graph TB
    subgraph "Authentication"
        AUTH["Auth Module\nsrc/auth/mod.rs\n- JWT validation (HS256, RS256)\n- API key lookup + validation\n- Token refresh\n- Session management\n- OAuth2/OIDC integration"]
        SSO["SSO Integration\nsrc/auth/sso/\n- SAML 2.0\n- OIDC discovery\n- LDAP bind\n- Azure AD / Okta / Google"]
        FED_DELEGATION["Federated Delegation\nsrc/auth/federated_delegation_complete.rs (43K)\n- Token exchange (subject → delegate)\n- Impersonation chains\n- Cross-account access\n- AWS IAM / GCP SA federation"]
    end

    subgraph "Authorization (RBAC)"
        RBAC["RBAC Engine\nsrc/auth/rbac.rs\n- Role definitions (admin, writer, reader)\n- Permission: {resource, action}\n- Resource: collection, table, graph, doc\n- Action: read, write, admin, manage\n- Policy evaluation: union of role perms\n- Tenant-scoped roles"]
    end

    subgraph "Tenant Isolation"
        TENANT_CTX["TenantContext\nproximadb-tenant crate\n- Mandatory at every I/O boundary\n- tenant_id: UUID\n- namespace_id: UUID\n- billing_account_id\n- tier: Free, Pro, Enterprise\n- Fail-closed: no context → 401"]
        DR_PATH["DrPathBuilder\n- All object storage writes prefixed:\n  data/{tenant_id}/{namespace_id}/...\n- Structural isolation, not predicate\n- CI-enforced: check_tenant_path.py"]
    end

    subgraph "Encryption"
        ENCRYPTION["Storage Encryption\nproximadb-storage-encryption\n- AES-256-GCM at rest\n- Per-tenant encryption keys\n- Key rotation support\n- KMS integration: AWS KMS, Azure Key Vault\n- Envelope encryption pattern\n- Encryption at block level"]
        TLS["TLS / mTLS\nproximadb-tls crate\n- TLS 1.3 for all network surfaces\n- mTLS for cluster inter-node\n- Cert rotation without restart\n- Let's Encrypt auto-renewal"]
    end

    subgraph "Governance"
        GOV["Governance Module\nsrc/governance/\n- Data retention policies\n- GDPR: right to erasure\n- Data classification labels\n- Access review automation\n- Compliance reports\n- PII detection + masking"]
    end

    subgraph "Secret Management"
        SECRETS["Secret Detection\n- CI: secret-scanning + push-protection\n- CodeQL: credential literal detection\n- Pre-commit: detect-secrets hook\n- .env excluded from git\n- Vault integration for production secrets"]
    end

    AUTH --> SSO
    AUTH --> FED_DELEGATION
    AUTH --> RBAC
    RBAC --> TENANT_CTX
    TENANT_CTX --> DR_PATH
    ENCRYPTION --> TLS
    GOV --> ENCRYPTION

    API["All network surfaces"] --> AUTH
    AUTH --> TENANT_CTX

    classDef auth fill:#bbdefb,stroke:#1565c0
    classDef rbac fill:#c8e6c9,stroke:#2e7d32
    classDef tenant fill:#ffe0b2,stroke:#f57c00
    classDef encrypt fill:#e1bee7,stroke:#7b1fa2
    classDef gov fill:#ffcdd2,stroke:#d32f2f
    classDef sec fill:#d7ccc8,stroke:#5d4037
    classDef ext fill:#b3e5fc,stroke:#0288d1,stroke-dasharray: 5 5

    class AUTH,SSO,FED_DELEGATION auth
    class RBAC rbac
    class TENANT_CTX,DR_PATH tenant
    class ENCRYPTION,TLS encrypt
    class GOV gov
    class SECRETS sec
    class API ext
