---
title: ProximaDB - Network Layer Component Diagram
---
graph TB
    subgraph "Multi-Protocol Entry Points"
        MS["🟦 MultiServer\nsrc/network/multi_server.rs\n(87K loc)\n- Lifecycle orchestration\n- Graceful shutdown\n- TLS wiring"]
        SB["🟦 ServerBuilder\nsrc/network/server_builder.rs\n(28K loc)\n- Config-driven construction\n- Port binding"]
        UDS["🟦 Unix Domain Socket\nsrc/network/uds.rs\n- Local IPC"]
    end

    subgraph "TCP Multiplexing (Port :5678)"
        MUX["🟧 TCP Multiplexer\nsrc/network/multiplex/tcp_multiplexer.rs\n- Protocol detection\n- HTTP/1.1 vs HTTP/2 routing\n- ALPN negotiation"]
    end

    subgraph "REST API Subsystem"
        REST_SRV["🟨 REST Server\nsrc/network/rest/server.rs\n(54K loc)\n- Axum HTTP/1.1\n- Route registration\n- Request parsing"]
        REST_H["🟨 REST Handlers\nsrc/network/rest/handlers/\n- v1: Legacy handlers\n- v2: Current handlers\n- proto_json: JSON/Proto conversion"]
        REST_V1["🟨 REST v1\nsrc/network/rest/v1/\n- routes.rs\n- sunset middleware"]
        REST_V2["🟨 REST v2\nsrc/network/rest/v2/\n- routes.rs\n- proto_json.rs"]
        OPENAPI["🟨 OpenAPI Gen\nsrc/network/rest/openapi.rs\n- utoipa annotations\n- Spec auto-generation"]
        WS["🟨 WebSocket\nsrc/network/rest/websocket.rs\n- Streaming results\n- Progressive search"]
        HEALTH["🟨 Health Check\nsrc/network/rest/health.rs"]
    end

    subgraph "gRPC Service Subsystem"
        GRPC_AUTH["🟩 gRPC Auth\nsrc/network/grpc/auth.rs\n- JWT validation\n- Interceptor"]
        GRPC_GRAPH["🟩 gRPC Graph\nsrc/network/grpc/graph_service.rs"]
        GRPC_RANK["🟩 gRPC Rank\nsrc/network/grpc/rank_service.rs"]
        GRPC_SEC["🟩 gRPC Security\nsrc/network/grpc/security_service.rs"]
        GRPC_STREAM["🟩 gRPC Streaming\nsrc/network/grpc/streaming_service.rs"]
        GRPC_V2["🟩 gRPC v2\nsrc/network/grpc/v2/"]
        GRPC_OBS["🟩 gRPC Observability\nsrc/network/grpc/observability_service.rs"]
    end

    subgraph "Arrow Flight Subsystem"
        FLIGHT_SRV["🟪 Arrow Flight Server\nsrc/network/arrow_ipc/server.rs\n- Flight service"]
        FLIGHT_SVC["🟪 Arrow Flight Service\nsrc/network/arrow_ipc/service.rs\n(157K loc)\n- Bulk operations"]
        FLIGHT_CODEC["🟪 Arrow Codec\nsrc/network/arrow_ipc/codec.rs\n(79K loc)"]
        FLIGHT_GRAPH["🟪 Graph Codec\nsrc/network/arrow_ipc/graph_codec.rs"]
        FLIGHT_MM["🟪 Multi-Model Codec\nsrc/network/arrow_ipc/multimodel_codec.rs"]
        FLIGHT_EXPORT["🟪 File Export\nsrc/network/arrow_ipc/file_export.rs\n(90K loc)"]
        FLIGHT_RANK["🟪 Rank Export\nsrc/network/arrow_ipc/rank_features_export.rs"]
    end

    subgraph "PostgreSQL Wire Protocol"
        PG_PROTO["🟥 pgwire Protocol\nsrc/network/postgres/protocol.rs\n(259K loc)\n- PostgreSQL wire protocol\n- Frontend/Backend messages"]
        PG_REL["🟥 Relational Pipeline\nsrc/network/postgres/relational_pipeline.rs\n(103K loc)\n- SQL → algebra bridge\n- Global engine"]
        PG_SESSION["🟥 Session Manager\nsrc/network/postgres/session.rs\n- Connection state"]
        PG_TRANS["🟥 Type Translator\nsrc/network/postgres/translator.rs\n- ProximaType ↔ PgType"]
        PG_VEC["🟥 pgvector Compat\nsrc/network/postgres/pgvector_params.rs\n- pgvector extension params"]
    end

    subgraph "Middleware Stack"
        MW_AUTH["🔒 Auth Middleware\nsrc/network/middleware/auth.rs,\nauth_failclosed.rs"]
        MW_TENANT["🏢 Tenant Middleware\nsrc/network/middleware/tenant.rs\n- TenantContext extraction"]
        MW_RATE["⏱️ Rate Limiter\nsrc/network/middleware/rate_limit.rs"]
        MW_CORS["🌐 CORS\nsrc/network/middleware/cors.rs"]
        MW_METRICS["📊 Metrics\nsrc/network/middleware/metrics.rs"]
        MW_TLS["🔐 TLS\nsrc/network/middleware/tls.rs"]
        MW_TIMEOUT["⏰ Timeout\nsrc/network/middleware/timeout.rs"]
        MW_REQID["🆔 Request ID\nsrc/network/middleware/request_id.rs"]
        MW_BP["🚦 Backpressure\nsrc/network/middleware/backpressure.rs"]
        MW_V1SUNSET["🌅 V1 Sunset\nsrc/network/middleware/v1_sunset.rs"]
    end

    subgraph "Auth Subsystem"
        AUTH_CFG["Auth Config\nsrc/network/auth/config.rs"]
        AUTH_JWT["JWT Handler\nsrc/network/auth/jwt.rs"]
        AUTH_MW["Auth Middleware\nsrc/network/auth/middleware.rs\n(52K loc)"]
        AUTH_PROV["Auth Providers\nsrc/network/auth/providers.rs"]
        AUTH_RBAC["RBAC\nsrc/network/auth/rbac.rs"]
    end

    subgraph "MCP Integration"
        MCP_BE["MCP Backend\nsrc/network/mcp/backend.rs\n- Model Context Protocol"]
    end

    subgraph "Service Composition"
        SS["🟫 SharedServices\nsrc/network/shared_services.rs\n(161K loc)\n- Service composition root\n- Dependency injection\n- All service wiring"]
    end

    %% Flow connections
    MS --> MUX
    MS --> SB
    MS --> UDS

    MUX --> REST_SRV
    MUX --> GRPC_AUTH
    MUX --> FLIGHT_SRV

    %% REST chain
    REST_SRV --> MW_AUTH --> MW_TENANT --> MW_RATE
    MW_RATE --> REST_H
    REST_H --> REST_V1
    REST_H --> REST_V2
    REST_H --> OPENAPI
    REST_H --> WS
    REST_H --> HEALTH

    %% gRPC chain
    GRPC_AUTH --> GRPC_GRAPH
    GRPC_AUTH --> GRPC_RANK
    GRPC_AUTH --> GRPC_SEC
    GRPC_AUTH --> GRPC_STREAM
    GRPC_AUTH --> GRPC_V2
    GRPC_AUTH --> GRPC_OBS

    %% Flight chain
    FLIGHT_SRV --> FLIGHT_SVC
    FLIGHT_SVC --> FLIGHT_CODEC
    FLIGHT_SVC --> FLIGHT_GRAPH
    FLIGHT_SVC --> FLIGHT_MM
    FLIGHT_SVC --> FLIGHT_EXPORT
    FLIGHT_SVC --> FLIGHT_RANK

    %% pgwire chain
    PGWIRE_ENTRY["pgwire Entry"] --> PG_PROTO
    PG_PROTO --> PG_REL
    PG_PROTO --> PG_SESSION
    PG_PROTO --> PG_TRANS
    PG_PROTO --> PG_VEC

    %% All to SharedServices
    REST_H --> SS
    GRPC_GRAPH --> SS
    FLIGHT_SVC --> SS
    PG_REL --> SS
    MCP_BE --> SS

    classDef entry fill:#bbdefb,stroke:#1565c0
    classDef rest fill:#fff9c4,stroke:#f9a825
    classDef grpc fill:#c8e6c9,stroke:#2e7d32
    classDef flight fill:#e1bee7,stroke:#7b1fa2
    classDef pgwire fill:#ffcdd2,stroke:#d32f2f
    classDef mw fill:#b2dfdb,stroke:#00695c
    classDef svc fill:#d7ccc8,stroke:#5d4037

    class MS,SB,UDS entry
    class REST_SRV,REST_H,REST_V1,REST_V2,OPENAPI,WS,HEALTH rest
    class GRPC_AUTH,GRPC_GRAPH,GRPC_RANK,GRPC_SEC,GRPC_STREAM,GRPC_V2,GRPC_OBS grpc
    class FLIGHT_SRV,FLIGHT_SVC,FLIGHT_CODEC,FLIGHT_GRAPH,FLIGHT_MM,FLIGHT_EXPORT,FLIGHT_RANK flight
    class PG_PROTO,PG_REL,PG_SESSION,PG_TRANS,PG_VEC pgwire
    class MW_AUTH,MW_TENANT,MW_RATE,MW_CORS,MW_METRICS,MW_TLS,MW_TIMEOUT,MW_REQID,MW_BP,MW_V1SUNSET mw
    class SS svc
