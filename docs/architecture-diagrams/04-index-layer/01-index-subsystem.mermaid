---
title: ProximaDB - Index Subsystem (HNSW + Compact + IVF)
---
graph TB
    subgraph "Index Traits (foundation crate)"
        IDX_TRAIT["Index Trait\nproximadb-index-traits\n- insert(vector, id)\n- search(query, k, filter) → Vec<(id, distance)>\n- delete(id)\n- build(batch) → bulk insert\n- save(path) / load(path)\n- stats() → IndexStats\n- Supports incremental updates"]
    end

    subgraph "Index Types (foundation crate)"
        IDX_TYPES["Index Types\nproximadb-index-types\n- IndexConfig: type + params\n- IndexType enum: HNSW, Compact, IVF, DiskANN, Flat\n- DistanceType enum"]
    end

    subgraph "HNSW Engine"
        HNSW["HNSW Index\nsrc/index/hnsw/\n- M: max connections per layer\n- ef_construction: search depth on build\n- ef_search: search depth on query\n- Layer-based skip-list\n- Incremental insert + delete\n- Memory-mapped persistence\n- Configurable memory budget"]
        HNSW_LAYER["Layer Structure\n- Layer 0: all vectors (dense)\n- Layer i+1: subsets (sparse)\n- Exponential decay: ~1/M^i vectors\n- Entry point: top-layer node\n- Search: greedy traverse down\n  then beam search at layer 0"]
    end

    subgraph "Compact Index"
        COMPACT["Compact Index\nsrc/index/compact/\n- Space-optimized for embeddings\n- IVF-like clustering pre-build\n- Coarse quantizer → fine quantizer\n- Product Quantization (PQ) variant\n- Good for: large collections, memory-constrained\n- Trade: lower recall than HNSW"]
    end

    subgraph "IVF Family"
        IVF["IVF Index Family\nsrc/index/ivf/\n- Inverted File with clustering\n- Train: cluster vectors → centroids\n- Index: assign each vector to closest centroid\n- Search: probe nearest centroids → scan\n- Variants: IVFFlat, IVFPQ, IVFSQ\n- Trade: fast for clustered data"]
    end

    subgraph "DiskANN"
        DISKANN["DiskANN Index\nsrc/index/diskann/\n- SSD-optimized graph index\n- Builds graph in memory, writes to disk\n- Search: loads only hot subgraph\n- Vamana graph algorithm\n- Good for: very large collections\n  that don't fit in RAM\n- Trade: slower than HNSW, but scalable"]
    end

    subgraph "Index Factory"
        FACTORY["IndexFactory\nsrc/index/factory.rs\n- Selects index type from IndexConfig\n- Creates appropriate builder\n- Validates config params\n- Registers new index types"]
    end

    subgraph "Distance Kernels"
        DKERNEL["Distance Kernel\nproximadb-distance-kernel\n- f32 SIMD-optimized kernels\n- L2, Cosine, InnerProduct, Hamming\n- AVX2/AVX-512/NEON dispatch\n- SQ8/RaBitQ quantized distance\n- Batch distance computation"]
    end

    subgraph "Quantization Integration"
        QUANT["Quantization Bridge\n- Quantize vectors pre-index\n- SQ8: 8-bit scalar quantization\n- RaBitQ: rotation + binarization\n- PQ: product quantization\n- Index stores quantized codes\n- Rerank with f32 on final k"]
    end

    FACTORY --> HNSW
    FACTORY --> COMPACT
    FACTORY --> IVF
    FACTORY --> DISKANN
    HNSW --> HNSW_LAYER
    HNSW --> DKERNEL
    COMPACT --> DKERNEL
    IVF --> DKERNEL
    DISKANN --> DKERNEL

    HNSW --> QUANT
    COMPACT --> QUANT

    IDX_TRAIT -.-> HNSW
    IDX_TRAIT -.-> COMPACT
    IDX_TRAIT -.-> IVF
    IDX_TRAIT -.-> DISKANN

    IDX_TYPES --> FACTORY

    DML["DmlService\n(build/search)"] --> FACTORY

    classDef trait fill:#fff9c4,stroke:#f9a825
    classDef types fill:#fff9c4,stroke:#f9a825
    classDef hnsw fill:#c8e6c9,stroke:#2e7d32
    classDef compact fill:#ffe0b2,stroke:#f57c00
    classDef ivf fill:#e1bee7,stroke:#7b1fa2
    classDef disk fill:#b3e5fc,stroke:#0288d1
    classDef factory fill:#bbdefb,stroke:#1565c0
    classDef kernel fill:#ffcdd2,stroke:#d32f2f
    classDef quant fill:#d7ccc8,stroke:#5d4037
    classDef ext fill:#b3e5fc,stroke:#0288d1,stroke-dasharray: 5 5

    class IDX_TRAIT,IDX_TYPES trait
    class HNSW,HNSW_LAYER hnsw
    class COMPACT compact
    class IVF ivf
    class DISKANN disk
    class FACTORY factory
    class DKERNEL kernel
    class QUANT quant
    class DML ext
