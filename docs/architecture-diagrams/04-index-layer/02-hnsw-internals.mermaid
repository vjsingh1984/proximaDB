---
title: ProximaDB - HNSW Index Internal Architecture
---
graph TB
    subgraph "HNSW Core"
        HNSW["HNSW Index\nsrc/index/hnsw/\n- Navigable Small World graph\n- Hierarchical layers\n- Layer 0: all vectors (dense)\n- Layer L: sparse subset (1/M^L)\n- Logarithmic search complexity\n- Config: M, ef_construction, ef_search"]
    end

    subgraph "Build Pipeline"
        INSERT["Incremental Insert\n- Random level assignment (exp decay)\n- Entry point discovery\n- Greedy search at top layer\n- Beam search at layer 0\n- Neighbor selection + pruning\n- Idempotent: insert same id = upsert"]
        BULK["Bulk Build\n- Pre-sorted batch insertion\n- Parallel: multiple workers\n- Each worker: independent sub-graph\n- Merge: connect sub-graphs\n- Memory: double buffer pattern"]
        DEL_OP["Delete Operation\n- Mark node as deleted (tombstone)\n- Lazy: no graph repair on delete\n  (graph heals on subsequent searches)\n- Periodic: full rebuild after\n  many deletions for quality"]
    end

    subgraph "Search Pipeline"
        ENTRY["Entry Point Cache\n- Per-layer entry points\n- Updated on each insert\n- Entry = node with highest layer"]
        TOP_LAYER["Top-Layer Search\n- Greedy: move to closest neighbor\n- Until: no closer neighbor found\n- Result: entry point for next layer"]
        LAYER0["Layer 0 Search\n- Beam search with ef_search beam\n- Maintain k-best candidates\n- Prune: distance > worst in beam\n- Return top-k with ids + distances"]
    end

    subgraph "Neighbor Selection"
        NEIGHBOR["Neighbor Selection\n- Simple: closest M nodes\n- Heuristic: prune redundant neighbors\n  (if C is closer to A than B,\n   add C but may drop B)\n- Max neighbors per node: M\n- Max neighbors at layer 0: 2*M"]
    end

    subgraph "Memory Layout"
        MEM["Memory-Mapped Storage\n- Node metadata: id, level, flags\n- Per-layer adjacency lists\n- Compact: u32 node IDs (not pointers)\n- mmap: OS-level persistence\n- Optional: in-memory acceleration\n  buffer for hottest layers"]
        MMAP["mmap Persistence\n- Single file per collection\n- Append-only: new nodes at end\n- Metadata header: entry point, config\n- Recovery: scan all nodes on load\n- File format versioned for migration"]
    end

    subgraph "Concurrency"
        CONCUR["Concurrency Model\n- Lock-free search: atomic reads\n  (no locks during query)\n- Insert: fine-grained per-node locks\n- Global read-write lock for\n  entry point / layer structure\n- No stop-the-world rebuilds"]
    end

    subgraph "Distance Integration"
        DIST["Distance Primitives\n- Calls SIMD distance kernels\n- L2, Cosine, Inner Product\n- Quantized distance: SQ8, RaBitQ\n- Configurable distance at index build\n- Mixed: index with quantized,\n  rerank with f32"]
    end

    HNSW --> INSERT
    HNSW --> BULK
    HNSW --> DEL_OP
    HNSW --> ENTRY
    HNSW --> MEM
    HNSW --> CONCUR

    ENTRY --> TOP_LAYER
    TOP_LAYER --> LAYER0
    LAYER0 --> NEIGHBOR
    NEIGHBOR --> DIST

    MEM --> MMAP

    SEARCH_CALL["Search Request\n(query_vector, k, ef)"] --> ENTRY
    INSERT_CALL["Insert Request\n(vector, id)"] --> INSERT

    classDef core fill:#bbdefb,stroke:#1565c0
    classDef build fill:#c8e6c9,stroke:#2e7d32
    classDef search fill:#ffe0b2,stroke:#f57c00
    classDef neigh fill:#e1bee7,stroke:#7b1fa2
    classDef mem fill:#b3e5fc,stroke:#0288d1
    classDef conc fill:#ffcdd2,stroke:#d32f2f
    classDef dist fill:#d7ccc8,stroke:#5d4037
    classDef ext fill:#b3e5fc,stroke:#0288d1,stroke-dasharray: 5 5

    class HNSW core
    class INSERT,BULK,DEL_OP build
    class ENTRY,TOP_LAYER,LAYER0 search
    class NEIGHBOR neigh
    class MEM,MMAP mem
    class CONCUR conc
    class DIST dist
    class SEARCH_CALL,INSERT_CALL ext
