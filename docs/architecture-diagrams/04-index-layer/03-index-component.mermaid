---
title: ProximaDB - Index Layer Component Diagram
---
graph TB
    subgraph "Index Traits (Foundation)"
        IDX_TRAIT["🟦 IndexTraits\ncrates/foundation/proximadb-index-traits\n- Index trait definition\n- Search/Insert/Delete ops\n- Port/abstraction boundary"]
        IDX_TYPES["🟦 IndexTypes\ncrates/foundation/proximadb-index-types\n- IndexConfig\n- IndexMetric\n- IndexCapability"]
        DIST_KERNEL["🟦 DistanceKernel\ncrates/foundation/proximadb-distance-kernel\n- f32, f16, u8 distance functions\n- SIMD implementations\n- Batch processing"]
        DIST_TYPES["🟦 DistanceMetric\ncrates/foundation/proximadb-distance-types\n(61 cross-references)\n- Cosine/L2/DotProduct/IP\n- 20+ variants"]
        QUANT_TYPES["🟦 QuantizationTypes\ncrates/foundation/proximadb-quantization-types\n- SQ8/RaBitQ/PQ\n- Codec configs"]
    end

    subgraph "HNSW Index"
        HNSW["🟧 HNSW Index\nsrc/index/hnsw/\n- Hierarchical Navigable Small World\n- Approximate nearest neighbor\n- Multi-layer graph"]
        HNSW_BUILD["🟧 HNSW Builder\n- Insertion algorithm\n- Layer assignment\n- Heuristic neighbor selection"]
        HNSW_SEARCH["🟧 HNSW Search\n- Beam search\n- Greedy traversal\n- Entry point management"]
        HNSW_PERSIST["🟧 HNSW Persistence\n- Index serialization\n- Incremental checkpoint"]
    end

    subgraph "IVF Index"
        IVF["🟩 IVF Index\nsrc/index/ivf/\n- Inverted File Index\n- Coarse quantization\n- Cluster assignment"]
        IVF_TRAIN["🟩 IVF Training\n- K-means clustering\n- Centroid computation"]
        IVF_SEARCH["🟩 IVF Search\n- Probe-based search\n- Cell selection\n- Distance refinement"]
    end

    subgraph "Compact Index"
        COMPACT["🟣 Compact Index\nsrc/index/compact/\n- Memory-optimized\n- Dense storage\n- Batch-friendly"]
    end

    subgraph "AXIS Index (Unified)"
        AXIS["🔴 AXIS Index\nsrc/index/axis/\n- Adaptive Index Selection\n- Multi-strategy orchestration\n- Auto-tuning"]
    end

    subgraph "Quantization Kernel"
        QKERNEL["🟤 Quantization Kernel\ncrates/modalities/proximadb-quantization-kernel\n- SQ8 encode/decode\n- RaBitQ quantization\n- PQ (Product Quantization)\n- f32 reranking"]
    end

    subgraph "Index Management"
        IDX_MGR["⬜ Index Manager\nsrc/index/index_manager.rs\n- Index lifecycle\n- Per-collection management\n- Build/rebuild coordination"]
        IDX_CACHE["⬜ Index Cache\n- Hot index loading\n- LRU eviction\n- Footer-cached metadata"]
    end

    %% Flow
    IDX_TRAIT --> IDX_TYPES
    HNSW --> IDX_TRAIT
    IVF --> IDX_TRAIT
    COMPACT --> IDX_TRAIT

    HNSW --> DIST_KERNEL
    IVF --> DIST_KERNEL
    COMPACT --> DIST_KERNEL

    HNSW --> QKERNEL
    IVF --> QKERNEL
    QKERNEL --> QUANT_TYPES

    AXIS --> HNSW
    AXIS --> IVF
    AXIS --> COMPACT

    IDX_MGR --> HNSW
    IDX_MGR --> IVF
    IDX_MGR --> COMPACT
    IDX_MGR --> AXIS
    IDX_MGR --> IDX_CACHE

    STORAGE_ENGINE["Storage Engine"] --> IDX_MGR

    classDef trait fill:#bbdefb,stroke:#1565c0
    classDef hnsw fill:#ffe0b2,stroke:#f57c00
    classDef ivf fill:#c8e6c9,stroke:#2e7d32
    classDef compact fill:#e1bee7,stroke:#7b1fa2
    classDef axis fill:#ffcdd2,stroke:#d32f2f
    classDef quant fill:#d7ccc8,stroke:#5d4037
    classDef mgr fill:#f5f5f5,stroke:#9e9e9e

    class IDX_TRAIT,IDX_TYPES,DIST_KERNEL,DIST_TYPES,QUANT_TYPES trait
    class HNSW,HNSW_BUILD,HNSW_SEARCH,HNSW_PERSIST hnsw
    class IVF,IVF_TRAIN,IVF_SEARCH ivf
    class COMPACT compact
    class AXIS axis
    class QKERNEL quant
    class IDX_MGR,IDX_CACHE mgr
