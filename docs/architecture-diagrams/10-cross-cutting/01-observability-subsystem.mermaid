---
title: ProximaDB - Observability Subsystem (Metrics + Tracing + Auditing)
---
graph TB
    subgraph "Metrics Subsystem"
        METRICS["Metrics Registry\nsrc/metrics/\n- Prometheus-compatible metrics\n- Counter, Gauge, Histogram, Summary\n- Per-tenant dimension labels\n- Custom exporters (Prometheus, OTLP)\n- Scraped by Prometheus at /metrics"]
    end

    subgraph "Tracing"
        TRACING["Distributed Tracing\nsrc/observability/\n- OpenTelemetry integration\n- Span context propagation (W3C)\n- Trace sampling: adaptive\n- Span events: query phases\n- Exporters: Jaeger, OTLP, Zipkin\n- B3 propagation for legacy"]
    end

    subgraph "Audit Logging"
        AUDIT_LOGGER["Audit Logger\naudit/logger.rs (54K)\n- All operations logged:\n  INSERT, DELETE, SEARCH, GET, DDL\n- Fields: tenant_id, user_id, operation,\n  timestamp, resource, result\n- Tamper-evident: hash-chained\n- Configurable retention"]
        AUDIT_STORAGE["Audit Storage\naudit/storage.rs (31K)\n- WAL-backed audit persistence\n- Separate from data WAL\n- Compaction: merge + compress\n- Query interface: filter by tenant,\n  user, operation, time range"]
        CORRELATION["Audit Correlation\naudit/correlation.rs (32K)\n- Cross-tenant correlation\n- Anomaly detection\n- Pattern matching on audit trails"]
        CROSS_TENANT["Cross-Tenant Guard\naudit/cross_tenant_guard.rs (14K)\n- Detects cross-tenant data access\n- Prevents tenant isolation breaches\n- Alerts on suspicious patterns"]
    end

    subgraph "Billing / Financial Telemetry"
        BILLING["Financial Telemetry\n- Storage: GB-month (KSU)\n- Compute: KRU/KIU (read units)\n- Network egress: KOU (data shipped)\n- Cache: hit ratio billing adjustment\n- Plumbed via TenantContext at\n  every I/O boundary"]
    end

    subgraph "Health / Readiness"
        HEALTH["Health Endpoints\n- /health: liveness probe\n- /ready: readiness probe\n  (checks: WAL, storage, cluster)\n- /metrics/prometheus: scrape endpoint\n- /debug/pprof: profiling (optional)"]
    end

    subgraph "Server Observability"
        SERVER_OBS["Server Observability\nsrc/observability/\n- RUST_LOG env configuration\n- Structured JSON logging\n- Request ID propagation\n- Slow query logging (> threshold)\n- Panic hook → log + metrics"]
    end

    METRICS --> BILLING
    TRACING --> SERVER_OBS
    AUDIT_LOGGER --> AUDIT_STORAGE
    AUDIT_LOGGER --> CORRELATION
    AUDIT_LOGGER --> CROSS_TENANT

    API["REST/gRPC/pgwire\n(all requests flow\nthrough metrics+audit)"] --> METRICS
    API --> TRACING
    API --> AUDIT_LOGGER
    API --> HEALTH

    classDef met fill:#bbdefb,stroke:#1565c0
    classDef trace fill:#c8e6c9,stroke:#2e7d32
    classDef audit fill:#ffe0b2,stroke:#f57c00
    classDef bill fill:#e1bee7,stroke:#7b1fa2
    classDef health fill:#ffcdd2,stroke:#d32f2f
    classDef obs fill:#d7ccc8,stroke:#5d4037
    classDef ext fill:#b3e5fc,stroke:#0288d1,stroke-dasharray: 5 5

    class METRICS met
    class TRACING trace
    class AUDIT_LOGGER,AUDIT_STORAGE,CORRELATION,CROSS_TENANT audit
    class BILLING bill
    class HEALTH health
    class SERVER_OBS obs
    class API ext
