---
title: ProximaDB - Coupling Analysis & TD God-File Map
---
graph LR
    subgraph "High Fan-In (61+ dependents) — Change-Risk Hotspots"
        DIST["DistanceMetric\n61 cross-refs\ncrates/foundation/proximadb-distance-types/"]
        DUR["Duration\n98 cross-refs\ntemporal types"]
        NOW["now()\n1,466 callers\nmost-used fn in codebase"]
        CONFIG["Config\npervasive\nsrc/core/config/"]
        ERR["ProximaDBError\n21 variants\nsrc/core/errors/core_error.rs:248"]
        TABLEID["TableIdentifier\ncatalog cornerstone"]
        RECORD["ProximaRecord\nrecord crate\ncanonical dead-record predicate"]
    end

    subgraph "God-Files (>3K LOC) — Decomposition Targets"
        GF1["src/database.rs\n1,481 lines\nTD: split → instance + lifecycle + maintenance"]
        GF2["src/services/dml/mod.rs\n11,257 lines\nTD: decompose by operation"]
        GF3["src/network/postgres/protocol.rs\n259K (est)\nTD: split by message type"]
        GF4["src/network/arrow_ipc/service.rs\n157K (est)\nTD: extract codec & handler"]
        GF5["src/network/shared_services.rs\n161K (est)\nTD: extract per-service construction"]
        GF6["src/storage/engines/sst/\n200K+ (est)\nTD: extract helpers & sub-engines"]
        GF7["src/cluster/partition_lease.rs\n4,579 lines\nTD: extract ResourceType-specific strategies"]
    end

    subgraph "High Coupling Clusters (tightly connected components)"
        C1["Catalog ↔ Storage\nTableId used in every engine\nCatalogManager ↔ factory\nSchema ↔ record encoding"]
        C2["Query ↔ Services\nDmlService ↔ WritePlanner\nComputeScheduler ↔ CatalogWorkloadProfile\nRecordStore ↔ TableWriteExecutor"]
        C3["Network ↔ Services\nREST handlers → Service layer\ngRPC → proto v1/v2\nArrow IPC → Arrow schemas"]
        C4["Proto v1 ↔ v2\nDual API surface\n559 (v1) + 230 (v2) symbols\nShared domain types"]
    end

    subgraph "Loose Coupling (stable seams)"
        L1["StorageEngine trait\nsrc/storage/traits/mod.rs\n7 refs, stable port"]
        L2["TableRecordStore trait\nsrc/services/record_store/\n4 backends, unified port"]
        L3["TableWriteExecutor trait\nsrc/query/table_write_executor.rs\n3 impls, planner→executor seam"]
        L4["ComputeBackend enum\nsrc/query/table_write_plan.rs\n1 taxonomy across read+write"]
        L5["TenantContext\ncrates/foundation/proximadb-tenant/\nI/O boundary contract"]
    end

    subgraph "Cyclic Dependency Risk"
        CYCLE["src/services/ → src/query/ → src/storage/\nComplex inter-module deps\nTD: extract port traits to break cycles"]
    end

