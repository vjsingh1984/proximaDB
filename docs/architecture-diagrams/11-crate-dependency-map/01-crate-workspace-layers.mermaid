graph TB
    subgraph "Layer 0: Foundation (no internal deps)"
        F_PROTO["proximadb-proto\nProtobuf definitions v1/v2\n559+230 symbols"]
        F_DIST_TYPES["proximadb-distance-types\nDistanceMetric enum\n61 cross-refs"]
        F_DIST_KERNEL["proximadb-distance-kernel\nSIMD distance functions\nf32/f16/u8"]
        F_RECORDS["proximadb-records\nProximaRecord\nis_dead() predicate"]
        F_DATA_MODEL["proximadb-data-model\nProximaType · ProximaValue"]
        F_TENANT["proximadb-tenant\nTenantContext\nIsolation + billing boundary"]
        F_INDEX_TYPES["proximadb-index-types\nIndexConfig · IndexMetric"]
        F_INDEX_TRAITS["proximadb-index-traits\nIndex trait port"]
        F_QUANT_TYPES["proximadb-quantization-types\nSQ8/RaBitQ/PQ configs"]
        F_REL_TYPES["proximadb-relational-types\nRelationalSchema · ExprError"]
        F_FILTER["proximadb-filter-expression\nFilter predicates"]
        F_SEARCH_TYPES["proximadb-search-types\nSearch request/response"]
        F_COMPRESS_TYPES["proximadb-compression-types\nCompression configs"]
        F_ENCODING_TYPES["proximadb-encoding-types\nEncoding configs"]
        F_FUNCTIONS["proximadb-functions\nScalar/aggregate UDFs"]
        F_BLOOM["proximadb-bloom\nBloom filters"]
        F_HARDWARE["proximadb-hardware\nHardware detection"]
        F_HW_CAPS["proximadb-hardware-caps\nCPU feature detection"]
        F_CACHE["proximadb-cache\nGeneric cache traits"]
