---
title: ProximaDB - Workspace Crate Layering (CI Enforced)
---
graph LR
    subgraph "Layer 0 — Foundation (leaf types, 0 upstream deps)"
        PROTO["proximadb-proto\ngRPC + REST types"]
        RECORDS["proximadb-records\nProximaRecord, validity"]
        TENANT["proximadb-tenant\nTenantContext, billing"]
        DISTANCE["proximadb-distance-types\nL2, Cosine, IP"]
        QUANT["proximadb-quantization\nSQ8, RaBitQ types"]
        INDEX_T["proximadb-index-types\nHNSW, IVF config types"]
        REL_TYPES["proximadb-relational-types\nSchema, DataType"]
        BLOCK["proximadb-block-format\nPAX block types"]
    end

    subgraph "Layer 1 — Horizontal (cross-cutting, depends on layer 0)"
        CODEC["proximadb-codec\nCompression codecs"]
        COMPRESS["proximadb-compression\nzstd, lz4, snappy"]
        SECURITY["proximadb-security\nEncryption, TLS"]
        TELEMETRY["proximadb-telemetry\nMetrics, tracing"]
        OBJ_STORE["proximadb-object-store\nS3, Azure, GCS abstraction"]
    end

    subgraph "Layer 2 — Storage (engine implementations)"
        STORAGE_BLOCK["proximadb-block-storage\nPAX segment reader/writer"]
        STORAGE_ICE["proximadb-iceberg-engine\nParquet + Iceberg manifests"]
        STORAGE_WAL["proximadb-wal\nWrite-ahead log engine"]
        STORAGE_CACHE["proximadb-cache\nCache orchestrator"]
        STORAGE_PAX["proximadb-pax\nPAX storage engine"]
    end

    subgraph "Layer 3 — Query (planner + execution)"
        QUERY_REL["proximadb-relational-executor\nVolcano execution engine"]
        QUERY_FED["proximadb-federation\nFederated query support"]
        QUERY_SQL["proximadb-sql-frontend\nSQL parser + planner"]
        QUERY_DIST["proximadb-query\nDistributed shuffle"]
    end

    subgraph "Layer 4 — Modalities (domain engines)"
        MOD_VEC["proximadb-vector\nVector search engine"]
        MOD_GRAPH["proximadb-graph\nGraph engine (ORION)"]
        MOD_DOC["proximadb-document\nDocument store"]
        MOD_EMBED["proximadb-embedding\nEmbedding pipeline"]
        MOD_RANK["proximadb-ranking\nHybrid ranking / RRF"]
    end

    subgraph "Layer 5 — Control (metadata)"
        CATALOG["proximadb-catalog\nCollection/Table metadata"]
        MIGRATE["proximadb-migration\nSchema migrations"]
    end

    subgraph "Layer 6 — Platform (runtime + API)"
        PLATFORM["proximadb-platform\nRuntime, API, MCP"]
        ADMIN_UI["proximadb-admin-ui\nAdmin dashboard"]
    end

    subgraph "Root Crate"
        ROOT["proximadb\nsrc/ (monolith being decomposed)\nDepends on ALL layers"]
    end

    PROTO --> BLOCK
    RECORDS --> BLOCK
    CODEC --> BLOCK
    COMPRESS --> CODEC
    SECURITY --> TENANT
    TELEMETRY --> TENANT
    OBJ_STORE --> TENANT

    STORAGE_BLOCK --> BLOCK
    STORAGE_BLOCK --> CODEC
    STORAGE_ICE --> OBJ_STORE
    STORAGE_WAL --> RECORDS
    STORAGE_PAX --> STORAGE_BLOCK

    QUERY_REL --> RECORDS
    QUERY_SQL --> REL_TYPES
    QUERY_DIST --> QUERY_REL

    MOD_VEC --> DISTANCE
    MOD_VEC --> QUANT
    MOD_VEC --> INDEX_T
    MOD_GRAPH --> RECORDS
    MOD_DOC --> RECORDS
    MOD_RANK --> MOD_VEC

    CATALOG --> REL_TYPES
    CATALOG --> TENANT

    PLATFORM --> CATALOG
    PLATFORM --> MOD_VEC
    PLATFORM --> QUERY_SQL

    ROOT -.-> PROTO
    ROOT -.-> RECORDS
    ROOT -.-> STORAGE_BLOCK
    ROOT -.-> STORAGE_ICE
    ROOT -.-> QUERY_REL
    ROOT -.-> MOD_VEC
    ROOT -.-> MOD_GRAPH
    ROOT -.-> MOD_DOC
    ROOT -.-> CATALOG
    ROOT -.-> PLATFORM

    classDef l0 fill:#e8f5e9,stroke:#43a047
    classDef l1 fill:#f3e5f5,stroke:#8e24aa
    classDef l2 fill:#e3f2fd,stroke:#1976d2
    classDef l3 fill:#fff3e0,stroke:#f57c00
    classDef l4 fill:#fce4ec,stroke:#d81b60
    classDef l5 fill:#e0f2f1,stroke:#00897b
    classDef l6 fill:#f9fbe7,stroke:#827717
    classDef root fill:#eceff1,stroke:#546e7a

    class PROTO,RECORDS,TENANT,DISTANCE,QUANT,INDEX_T,REL_TYPES,BLOCK l0
    class CODEC,COMPRESS,SECURITY,TELEMETRY,OBJ_STORE l1
    class STORAGE_BLOCK,STORAGE_ICE,STORAGE_WAL,STORAGE_CACHE,STORAGE_PAX l2
    class QUERY_REL,QUERY_FED,QUERY_SQL,QUERY_DIST l3
    class MOD_VEC,MOD_GRAPH,MOD_DOC,MOD_EMBED,MOD_RANK l4
    class CATALOG,MIGRATE l5
    class PLATFORM,ADMIN_UI l6
    class ROOT root
