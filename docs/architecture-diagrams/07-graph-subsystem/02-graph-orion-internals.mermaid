---
title: ProximaDB - Graph Subsystem (ORION) Internal Architecture
---
graph TB
    subgraph "Graph Engine Core"
        ENGINE["Graph Engine\nsrc/graph/engine/ (34K LOC, 56 files)\n- Property graph model (nodes + edges)\n- Node: id, labels, properties\n- Edge: id, source, target, type, properties\n- Supports directed + undirected\n- Multi-edge between same nodes"]
    end

    subgraph "Graph Types"
        NODE["Node\n- id: UUID\n- labels: Set<String>\n- properties: HashMap<String, Value>\n- Multi-valued properties\n- Indexed by: id, labels, properties"]
        EDGE["Edge\n- id: UUID\n- source_node: UUID\n- target_node: UUID\n- type: String\n- properties: HashMap<String, Value>\n- Direction: OUT, IN, BOTH"]
        PATH["Path / Walk\n- Ordered sequence of nodes + edges\n- Variable-length: 1..N hops\n- Pattern matching: (a)-[:TYPE*1..3]->(b)"]
    end

    subgraph "Traversal Engine"
        TRAVERSAL["Traversal Engine\nsrc/graph/traversal/\n- BFS / DFS traversal strategies\n- Bi-directional BFS (shortest path)\n- Dijkstra / A* weighted paths\n- Recursive CTE-style traversal\n- Parallel edge expansion\n- Traversal limits: max_depth, max_results"]
        PATTERN["Pattern Matching\nsrc/graph/pattern/\n- Cypher-like pattern language\n- (n:Person)-[:KNOWS]->(m:Person)\n- Variable-length: -[:KNOWS*1..3]->\n- Optional matches (LEFT JOIN)\n- WHERE filter inside patterns\n- Pattern compilation → execution plan"]
    end

    subgraph "Graph Index"
        G_INDEX["Graph Index\nsrc/graph/index/\n- Adjacency list index\n- Label-based indexing (node types)\n- Property index: range + equality scans\n- Edge type index\n- Full-text search on properties\n- Spatial index (if geo properties)"]
    end

    subgraph "Knowledge Graph"
        KG["Knowledge Graph\nsrc/graph/knowledge/\n- RDF triple store variant\n- Subject-Predicate-Object model\n- Ontology support: classes, relations\n- Inference: transitive, symmetric\n- SPARQL-like query interface\n- Entity resolution + dedup"]
    end

    subgraph "Graph Algorithms"
        ALGOS["Graph Algorithms\nsrc/graph/algorithms/\n- PageRank (centrality)\n- Connected components\n- Community detection (Louvain)\n- Triangle counting\n- Label propagation\n- BFS/DFS traversal templates"]
    end

    subgraph "Cross-Model Integration"
        CROSS["Cross-Model Tx\n- Graph traversal → vector search\n  (find neighbors → embedding similarity)\n- Vector search → graph expansion\n  (ANN hits → traverse edges)\n- HybridGraphRAG: graph context\n  + semantic similarity\n- Transactional: graph+vector in same tx"]
    end

    subgraph "Arrow Integration"
        G_ARROW["Graph-Arrow Bridge\nsrc/graph/arrow/\n- Graph → Arrow RecordBatch\n- Columnar representation of nodes/edges\n- Enables DataFusion SQL on graph\n- Arrow Flight: bulk export/import\n- Zero-copy to Python (pyarrow)"]
    end

    subgraph "Persistence"
        G_STORE["Graph Store\n- Backed by the same storage engine\n- Nodes + edges in RecordStore\n- Adjacency lists in specialized segments\n- WAL: all mutations logged\n- MVCC: snapshot isolation\n- Partition: by node ID hash"]
    end

    ENGINE --> NODE
    ENGINE --> EDGE
    ENGINE --> PATH
    ENGINE --> TRAVERSAL
    ENGINE --> PATTERN
    ENGINE --> G_INDEX
    ENGINE --> KG
    ENGINE --> ALGOS
    ENGINE --> CROSS
    ENGINE --> G_ARROW
    ENGINE --> G_STORE

    TRAVERSAL --> PATTERN
    TRAVERSAL --> G_INDEX
    ALGOS --> TRAVERSAL
    CROSS --> TRAVERSAL
    G_ARROW --> G_STORE

    DML["DmlService\n(graph mutations)"] --> ENGINE
    QUERY["Query Pipeline\n(Cypher / SPARQL)"] --> PATTERN

    classDef core fill:#bbdefb,stroke:#1565c0
    classDef types fill:#c8e6c9,stroke:#2e7d32
    classDef trav fill:#ffe0b2,stroke:#f57c00
    classDef idx fill:#e1bee7,stroke:#7b1fa2
    classDef kg fill:#b3e5fc,stroke:#0288d1
    classDef algo fill:#ffcdd2,stroke:#d32f2f
    classDef cross fill:#d7ccc8,stroke:#5d4037
    classDef arr fill:#fff9c4,stroke:#f9a825
    classDef store fill:#c8e6c9,stroke:#388e3c
    classDef ext fill:#b3e5fc,stroke:#0288d1,stroke-dasharray: 5 5

    class ENGINE core
    class NODE,EDGE,PATH types
    class TRAVERSAL,PATTERN trav
    class G_INDEX idx
    class KG kg
    class ALGOS algo
    class CROSS cross
    class G_ARROW arr
    class G_STORE store
    class DML,QUERY ext
