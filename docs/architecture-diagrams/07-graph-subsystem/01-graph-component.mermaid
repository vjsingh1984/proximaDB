---
title: ProximaDB - Graph Subsystem (ORION Engine)
---
graph TB
    subgraph "Graph Engine (ORION)"
        GRAPH_ENG["🟦 ORION Graph Engine\nsrc/graph/\n- Property graph model\n- Traversal engine\n- Multi-hop queries"]
        GRAPH_ENG2["🟦 Graph Engine\nsrc/storage/engines/graph_engine.rs\n- Storage-backed graph\n- Node/Edge CRUD"]
    end

    subgraph "Graph Types & Model"
        NODE["🟧 Graph Node\ncrates/modalities/proximadb-graph\n- ProximaTreeNode\n- Node properties\n- Node labels"]
        EDGE["🟧 Graph Edge\n- Directed edges\n- Edge properties\n- Edge types"]
        PATH["🟧 Graph Path\n- Traversal paths\n- Pattern matching\n- Path algebra"]
    end

    subgraph "Graph Query"
        GQ["🟩 Graph Query Engine\ncrates/query/proximadb-graph-query\n- Cypher-like queries\n- Pattern matching\n- Traversal plans"]
        GA["🟩 Graph Arrow\ncrates/query/proximadb-graph-arrow\n- Arrow-encoded graph\n- Columnar graph ops\n- Batch processing"]
        GS["🟩 Graph Subset\ncrates/query/proximadb-graph-subset\n- Subgraph extraction\n- Induced subgraphs"]
    end

    subgraph "Graph Storage"
        KG["🟣 Knowledge Graph Store\nsrc/storage/knowledge_graph/\n- Triple store\n- Entity resolution\n- RDF/SPARQL-adjacent"]
        ENTITY["🟣 Entity Store\nsrc/storage/entity_store/\n- Entity management\n- Relationship persistence"]
    end

    subgraph "Multi-Model Integration"
        MM["🔴 Cross-Model Write\nsrc/services/transaction/cross_model.rs\n- Atomic: node + embedding + edges\n- PROXIMADB_CROSS_MODEL_TX_ENABLED"]
        SYMBOL["🔴 Symbol Write\n- write_symbol_atomically()\n- TransactionOutcome\n- Rollback support"]
    end

    subgraph "Graph Algorithms"
        ALGO["⬜ Graph Algorithms\nsrc/graph/algorithms/\n- Shortest path\n- PageRank\n- Community detection\n- Centrality"]
    end

    %% Flow
    GRAPH_ENG --> NODE
    GRAPH_ENG --> EDGE
    GRAPH_ENG --> PATH

    GQ --> GRAPH_ENG
    GA --> GRAPH_ENG
    GS --> GRAPH_ENG

    KG --> ENTITY
    KG --> GRAPH_ENG

    MM --> GRAPH_ENG
    MM --> GRAPH_ENG2
    MM --> SYMBOL
    SYMBOL --> NODE
    SYMBOL --> EDGE

    ALGO --> GRAPH_ENG

    classDef engine fill:#bbdefb,stroke:#1565c0
    classDef types fill:#ffe0b2,stroke:#f57c00
    classDef query fill:#c8e6c9,stroke:#2e7d32
    classDef storage fill:#e1bee7,stroke:#7b1fa2
    classDef mm fill:#ffcdd2,stroke:#d32f2f
    classDef algo fill:#f5f5f5,stroke:#9e9e9e

    class GRAPH_ENG,GRAPH_ENG2 engine
    class NODE,EDGE,PATH types
    class GQ,GA,GS query
    class KG,ENTITY storage
    class MM,SYMBOL mm
    class ALGO algo
