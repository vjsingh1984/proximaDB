```mermaid
graph TD
    subgraph "API Layer"
        A[Clients: gRPC/REST] --> B{MultiServer};
        B --> C[Unified Handlers];
    end

    subgraph "Service Layer"
        C --> D[SharedServices];
        D --> E[CollectionService];
        D --> F[VectorOperationsService];
    end

    subgraph "Indexing Layer"
        F --> G[AxisManager];
        G --> H{Index Algorithms};
        H --> HNSW[HNSW];
        H --> IVF[IVF];
        H --> LSH[LSH];
        H --> OtherIndexes[...];
    end

    subgraph "Storage Layer"
        F --> I[StorageEngine Trait];
        I --> J{Pluggable Storage Engines};
        J --> K[Viper Engine: Columnar];
        J --> L[SST Engine: Row-based];
        J --> M[Other Engines: Nova, Swift, ...];
        K --> N[Parquet Files];
        L --> O[SST Files];
        F --> P[WriteAheadLogManager];
        P --> Q[Memtable];
    end

    subgraph "Underlying Infrastructure"
        E --> R[MetadataBackend];
        R --> S[RocksDB, FileStore, ...];
        I --> T[FilesystemFactory];
        T --> U[Local FS, S3, GCS, Azure];
    end

    style A fill:#f9f,stroke:#333,stroke-width:2px;
    style B fill:#ccf,stroke:#333,stroke-width:2px;
    style D fill:#cfc,stroke:#333,stroke-width:2px;
    style G fill:#ffc,stroke:#333,stroke-width:2px;
    style I fill:#fcf,stroke:#333,stroke-width:2px;
```