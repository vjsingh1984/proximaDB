@startuml ProximaDB_Vector_Search_Sequence
!theme aws-orange
title Vector Search with Multi-Tier Deduplication Sequence

actor Client
participant "REST/gRPC\nHandler" as Handler
participant "Vector Service\n(Unified)" as VectorService
participant "Search Engine\nFactory" as Factory
participant "Storage-Aware\nSearch Engine" as SearchEngine
participant "Multi-Tier\nDeduplicator" as Deduplicator
participant "WAL Search\nEngine" as WalSearch
participant "WAL Behavior\nWrapper" as WalWrapper
participant "VIPER Search\nEngine" as ViperSearch
participant "VIPER Engine" as ViperEngine
participant "LSM Search\nEngine" as LsmSearch
participant "LSM Engine" as LsmEngine
participant "Unified Distance\nCompute" as DistanceCompute

Client -> Handler : GET /vectors/search\n{query_vector, k, filters}
activate Handler

Handler -> VectorService : search_vectors_similarity(query, k, filters)
activate VectorService

VectorService -> Factory : create_unified_search_engine()
activate Factory
Factory --> VectorService : SearchEngine
deactivate Factory

VectorService -> SearchEngine : search_vectors(query, k, filters)
activate SearchEngine

' Initialize deduplicator
SearchEngine -> Deduplicator : new()
activate Deduplicator

' Parallel search across storage tiers
par WAL Search (Unflushed Data)
  SearchEngine -> WalSearch : search_unflushed_data(query, k, filters)
  activate WalSearch
  
  WalSearch -> WalWrapper : get_unflushed_batches(collection_id)
  activate WalWrapper
  WalWrapper --> WalSearch : unflushed_batches: Vec<WalVectorBatch>
  deactivate WalWrapper
  
  loop for each batch in unflushed_batches
    WalSearch -> DistanceCompute : calculate_distance_batch(query, batch.vectors)
    activate DistanceCompute
    DistanceCompute --> WalSearch : distances: Vec<f32>
    deactivate DistanceCompute
  end
  
  WalSearch -> WalSearch : sort_and_limit(results, k)
  WalSearch --> SearchEngine : wal_results: Vec<TieredSearchResult>
  deactivate WalSearch

else VIPER Search (Flushed Data)
  SearchEngine -> ViperSearch : search_parquet_data(query, k, filters)
  activate ViperSearch
  
  ViperSearch -> ViperEngine : search_with_clustering(query, k, filters)
  activate ViperEngine
  
  ViperEngine -> ViperEngine : ml_cluster_selection(),\npredicate_pushdown()
  ViperEngine -> DistanceCompute : calculate_distance_batch(query, candidates)
  activate DistanceCompute
  DistanceCompute --> ViperEngine : distances: Vec<f32>
  deactivate DistanceCompute
  
  ViperEngine --> ViperSearch : viper_results: Vec<VectorRecord>
  deactivate ViperEngine
  
  ViperSearch --> SearchEngine : viper_results: Vec<TieredSearchResult>
  deactivate ViperSearch

else LSM Search (Compacted Data)
  SearchEngine -> LsmSearch : search_sstables(query, k, filters)
  activate LsmSearch
  
  LsmSearch -> LsmEngine : search_across_levels(query, k, filters)
  activate LsmEngine
  
  LsmEngine -> LsmEngine : bloom_filter_check(),\nlevel_traversal()
  LsmEngine -> DistanceCompute : calculate_distance_batch(query, candidates)
  activate DistanceCompute
  DistanceCompute --> LsmEngine : distances: Vec<f32>
  deactivate DistanceCompute
  
  LsmEngine --> LsmSearch : lsm_results: Vec<VectorRecord>
  deactivate LsmEngine
  
  LsmSearch --> SearchEngine : lsm_results: Vec<TieredSearchResult>
  deactivate LsmSearch
end

' Deduplication and merging
SearchEngine -> Deduplicator : deduplicate_results(all_tier_results)
Deduplicator -> Deduplicator : id_based_deduplication(),\ntier_priority_resolution()
Deduplicator -> Deduplicator : merge_and_sort_by_distance(results, k)
Deduplicator --> SearchEngine : final_results: Vec<TieredSearchResult>
deactivate Deduplicator

SearchEngine --> VectorService : search_results
deactivate SearchEngine

VectorService --> Handler : Success{vectors, distances, sources}
deactivate VectorService

Handler --> Client : HTTP 200\n{results: [{vector, distance, source}]}
deactivate Handler

note over Deduplicator : **Key Innovation**: ID-based deduplication\nacross storage tiers with tier priority\nresolution ensures 100% accuracy

note over DistanceCompute : **Performance**: SIMD-optimized distance\ncalculations with hardware-specific\noptimizations (AVX2, NEON)

note over WalSearch : **Zero I/O**: Direct access to deserialized\nWalVectorBatch eliminates disk reads\nfor unflushed data (50-80% improvement)

note over ViperSearch : **ML Optimization**: Clustering-based\ncandidate selection reduces search\nspace through intelligent partitioning

@enduml