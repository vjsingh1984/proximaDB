@startuml ProximaDB_Deployment_Architecture
!theme aws-orange
title ProximaDB Distributed Deployment Architecture

!define RECTANGLE component

cloud "Client Applications" {
  RECTANGLE PythonSDK [
    Python SDK
    ----
    • REST/gRPC clients
    • Connection pooling
    • Retry logic
  ]
  
  RECTANGLE WebApp [
    Web Applications
    ----
    • HTTP REST API
    • JSON payloads
    • Session management
  ]
  
  RECTANGLE MLPipeline [
    ML Pipelines
    ----
    • gRPC streaming
    • Batch operations
    • High throughput
  ]
}

cloud "Load Balancer Layer" {
  RECTANGLE LoadBalancer [
    Load Balancer
    ----
    • HAProxy/nginx
    • Health checks
    • SSL termination
    • Sticky sessions
  ]
}

cloud "ProximaDB Cluster" {
  node "Node 1 (Primary)" {
    RECTANGLE ProximaDB1 [
      ProximaDB Server
      ----
      • REST API (5678)
      • gRPC Service (5679)
      • Health endpoint
      • Metrics collection
    ]
    
    RECTANGLE Storage1 [
      Local Storage
      ----
      • WAL: file:///data/wal/
      • VIPER: file:///data/viper/
      • LSM: file:///data/lsm/
      • Configs: /etc/proximadb/
    ]
  }
  
  node "Node 2 (Replica)" {
    RECTANGLE ProximaDB2 [
      ProximaDB Server
      ----
      • REST API (5678)
      • gRPC Service (5679)
      • Read-only mode
      • Metrics collection
    ]
    
    RECTANGLE Storage2 [
      Local Storage
      ----
      • WAL: file:///data/wal/
      • VIPER: file:///data/viper/
      • LSM: file:///data/lsm/
      • Configs: /etc/proximadb/
    ]
  }
  
  node "Node 3 (Standby)" {
    RECTANGLE ProximaDB3 [
      ProximaDB Server
      ----
      • REST API (5678)
      • gRPC Service (5679)
      • Backup mode
      • Metrics collection
    ]
    
    RECTANGLE Storage3 [
      Local Storage
      ----
      • WAL: file:///data/wal/
      • VIPER: file:///data/viper/
      • LSM: file:///data/lsm/
      • Configs: /etc/proximadb/
    ]
  }
}

cloud "Shared Storage Layer" {
  RECTANGLE S3Storage [
    AWS S3
    ----
    • WAL: s3://proximadb-wal/
    • VIPER: s3://proximadb-viper/
    • Backups: s3://proximadb-backup/
    • Multi-region replication
  ]
  
  RECTANGLE GCSStorage [
    Google Cloud Storage
    ----
    • WAL: gcs://proximadb-wal/
    • VIPER: gcs://proximadb-viper/
    • Cross-region sync
  ]
  
  RECTANGLE AzureStorage [
    Azure Blob Storage
    ----
    • WAL: adls://proximadb-wal/
    • VIPER: adls://proximadb-viper/
    • Geo-redundancy
  ]
}

cloud "Monitoring & Observability" {
  RECTANGLE Prometheus [
    Prometheus
    ----
    • Metrics scraping (9090)
    • Alert rules
    • Data retention
  ]
  
  RECTANGLE Grafana [
    Grafana
    ----
    • Dashboards
    • Visualization
    • Alerting
  ]
  
  RECTANGLE Jaeger [
    Jaeger
    ----
    • Distributed tracing
    • Performance analysis
    • Request flow
  ]
}

cloud "Configuration & Service Discovery" {
  RECTANGLE Consul [
    Consul
    ----
    • Service discovery
    • Configuration KV
    • Health checks
    • Leader election
  ]
  
  RECTANGLE Vault [
    HashiCorp Vault
    ----
    • Secrets management
    • PKI certificates
    • Dynamic credentials
  ]
}

' Client connections
PythonSDK --> LoadBalancer : HTTPS/gRPC
WebApp --> LoadBalancer : HTTPS REST
MLPipeline --> LoadBalancer : gRPC streaming

' Load balancer distribution
LoadBalancer --> ProximaDB1 : Primary (R/W)
LoadBalancer --> ProximaDB2 : Replica (R)
LoadBalancer --> ProximaDB3 : Standby

' Local storage connections
ProximaDB1 --> Storage1 : Local I/O
ProximaDB2 --> Storage2 : Local I/O
ProximaDB3 --> Storage3 : Local I/O

' Shared storage connections
ProximaDB1 --> S3Storage : WAL backup\nLong-term storage
ProximaDB1 --> GCSStorage : Multi-cloud\nRedundancy
ProximaDB1 --> AzureStorage : Disaster recovery

ProximaDB2 --> S3Storage : Read access
ProximaDB3 --> S3Storage : Backup/restore

' Monitoring connections
ProximaDB1 --> Prometheus : Metrics (9090)
ProximaDB2 --> Prometheus : Metrics (9090)
ProximaDB3 --> Prometheus : Metrics (9090)

Prometheus --> Grafana : Data source
ProximaDB1 --> Jaeger : Trace data
ProximaDB2 --> Jaeger : Trace data

' Service discovery
ProximaDB1 --> Consul : Registration\nHealth checks
ProximaDB2 --> Consul : Registration\nHealth checks
ProximaDB3 --> Consul : Registration\nHealth checks

LoadBalancer --> Consul : Service discovery
ProximaDB1 --> Vault : Secrets\nCertificates

note as DeploymentNote
**Deployment Patterns**

**Local Development**:
• Single node with file:// storage
• Docker Compose setup
• Local Prometheus/Grafana

**Production (Cloud)**:
• Multi-node cluster with shared storage
• Cloud-native filesystems (s3://, gcs://)
• Kubernetes orchestration
• Horizontal scaling

**Hybrid Deployment**:
• Local storage for hot data
• Cloud storage for cold data
• Automatic tiering based on access patterns

**Zero-Downtime Migration**:
• URL-based storage abstraction
• Config-driven cloud migration
• No application changes required
end note

@enduml