graph TD
    subgraph "ProximaDB Platform"
        C[Client Request] --> MR{Mode Router}

        MR --> |Vector-Only| VE[Vector Engine]
        MR --> |Graph-Only| GE[Graph Engine]
        MR --> |Unified SKS| UE[Unified SKS Engine]

        VE -- "Arc Memory Sharing" --> SMP[Shared Memory Pool]
        GE -- "Arc Memory Sharing" --> SMP

        UE --> SMP
        UE -- "Unified Query" --> VE
        UE -- "Unified Query" --> GE
    end

    style UE fill:#f96,stroke:#333,stroke-width:4px
    style SMP fill:#e1f5fe,stroke:#333,stroke-width:2px