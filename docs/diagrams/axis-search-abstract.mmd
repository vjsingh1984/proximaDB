sequenceDiagram
    participant Client
    participant QR as Query Router
    participant UTM as UnifiedTierManager
    participant CSM as CollectionStateManager
    participant IMT as IndexMemoryTracker
    participant HSC as HeatScorer
    participant MEM as Memory Tier
    participant DISK as Disk Tier
    participant CLOUD as Cloud Tier
    participant FSM as FileSystemManager
    
    Note over Client,FSM: AXIS Tiering Search Flow
    
    Client->>QR: VectorQuery(collection_id)
    QR->>UTM: execute_query(query)
    
    UTM->>HSC: record_access(collection_id)
    Note over HSC: Update heat score
    
    UTM->>CSM: get_state(collection_id)
    
    alt Index in Memory
        CSM-->>UTM: Memory state
        UTM->>IMT: is_index_available(collection_id)
        IMT-->>UTM: true
        UTM->>MEM: query_from_memory()
        MEM-->>UTM: results
        UTM-->>Client: QueryResult (fast path)
    
    else Index on Disk
        CSM-->>UTM: Disk state
        UTM->>CSM: calculate_heat_score()
        
        alt Hot enough to promote
            CSM-->>UTM: heat_score > threshold
            
            UTM->>IMT: check_memory_budget()
            
            alt Need to evict
                IMT->>IMT: evict_lru_indexes()
                IMT->>DISK: save_evicted_index()
                Note over IMT: Free memory
            end
            
            UTM->>CSM: start_transition(Disk→Memory)
            UTM->>FSM: read_from_disk(path)
            FSM->>DISK: load_index_data()
            DISK-->>FSM: index_bytes
            FSM-->>UTM: index_data
            
            UTM->>MEM: load_into_memory(index)
            UTM->>CSM: complete_transition(Memory)
            UTM->>IMT: register_index_loaded()
            
            UTM->>MEM: query_from_memory()
            MEM-->>UTM: results
            UTM-->>Client: QueryResult (promoted)
            
        else Query from disk
            CSM-->>UTM: heat_score < threshold
            UTM->>DISK: query_from_disk()
            DISK-->>UTM: results
            UTM-->>Client: QueryResult (disk path)
        end
    
    else Index in Cloud
        CSM-->>UTM: Cloud state
        
        alt Worth restoring
            UTM->>CSM: is_restore_worthwhile()
            CSM-->>UTM: true
            
            UTM->>CSM: start_transition(Cloud→Memory)
            UTM->>FSM: download_from_cloud(url)
            
            alt S3 Express (fast)
                FSM->>CLOUD: multipart_download()
                CLOUD-->>FSM: index_chunks
            else S3 Standard (slower)
                FSM->>CLOUD: standard_download()
                CLOUD-->>FSM: index_data
            end
            
            FSM-->>UTM: index_data
            UTM->>MEM: load_into_memory(index)
            UTM->>CSM: complete_transition(Memory)
            
            UTM->>MEM: query_from_memory()
            MEM-->>UTM: results
            UTM-->>Client: QueryResult (restored)
            
        else Fallback to storage scan
            UTM->>UTM: fallback_to_storage_scan()
            UTM-->>Client: QueryResult (scan)
        end
    
    else Index Unbuilt
        CSM-->>UTM: Unbuilt state
        UTM->>UTM: fallback_to_storage_scan()
        UTM-->>Client: QueryResult (scan)
    end
    
    Note over UTM,HSC: Background Policy Enforcement
    
    loop Every 60 seconds
        UTM->>CSM: get_demotion_candidates()
        CSM-->>UTM: cold_collections[]
        
        UTM->>IMT: demote_to_disk(collection)
        IMT->>DISK: save_index()
        IMT->>MEM: remove_from_memory()
        
        UTM->>CSM: get_promotion_candidates()
        CSM-->>UTM: hot_collections[]
        
        UTM->>MEM: promote_to_memory(collection)
    end