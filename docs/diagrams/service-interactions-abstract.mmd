%%{init: {"theme":"neutral", "themeVariables": {"primaryColor":"#4A90E2","primaryBorderColor":"#2563eb","secondaryColor":"#5CB85C","tertiaryColor":"#F5A623","lineColor":"#64748b","background":"transparent","fontFamily":"-apple-system, BlinkMacSystemFont, Segoe UI, Roboto, sans-serif","fontSize":"14px"}}}%%
sequenceDiagram
    participant Client as  Client
    participant REST as  REST API
    participant gRPC as  gRPC API  
    participant Handler as  UnifiedHandlers
    participant VOS as  VectorOperationsService
    participant CS as  CollectionService
    participant Engine as  StorageEngine
    participant VIPER as  VIPER Engine
    participant SST as  SST Engine
    participant TxCoord as  TransactionCoordinator
    participant SQL as  SQL Engine
    participant GPU as  GPU Parser
    participant SIMD as  SIMD Parser
    participant HW as  Hardware Capabilities
    participant Cloud as  Cloud Storage
    
    %% Vector Insert Flow
    Note over Client,Cloud: VECTOR INSERT OPERATION
    
    Client->>+REST: POST /collections/{id}/vectors<br/>JSON Batch
    REST->>+Handler: insert_vectors_unified()
    Handler->>+VOS: insert_vectors_direct()
    
    Note over VOS: Engine Routing
    
    VOS->>+CS: get_collection_metadata()
    CS->>CS: Check storage_assignment
    CS-->>-VOS: StorageEngine + Locations
    
    alt VIPER Engine
        VOS->>+VIPER: do_flush()
        VIPER->>+TxCoord: begin_atomic_operation()
        TxCoord->>+Cloud: write_to_staging()
        Cloud-->>-TxCoord: Confirmed
        TxCoord-->>-VIPER: Transaction ID
        VIPER-->>-VOS: Complete
    else SST Engine
        VOS->>+SST: do_flush()
        SST->>+TxCoord: begin_atomic_operation()
        TxCoord->>+Cloud: write_sstables()
        Cloud-->>-TxCoord: Confirmed
        TxCoord-->>-SST: Transaction ID
        SST-->>-VOS: Complete
    end
    
    VOS-->>-Handler: Batch Inserted
    Handler-->>-REST: Response
    REST-->>-Client: Success
    
    %% Vector Search Flow
    Note over Client,Cloud: VECTOR SEARCH OPERATION
    
    Client->>+gRPC: SearchVectors()
    gRPC->>+Handler: search_vectors_unified()
    Handler->>+VOS: search_vectors()
    
    Note over VOS: Parallel Search
    
    par VIPER Search
        VOS->>+VIPER: search_vectors_unified()
        VIPER->>VIPER: Apply filters
        VIPER-->>-VOS: Results
    and SST Search
        VOS->>+SST: search_vectors_unified()
        SST->>SST: Apply filters
        SST-->>-VOS: Results
    end
    
    VOS->>VOS: merge_and_deduplicate()
    VOS-->>-Handler: Search Results
    Handler-->>-gRPC: Response
    gRPC-->>-Client: Results
    
    Note over VIPER, SST: All systems operational
    
    %% Collection Management Flow
    Note over Client,Cloud: COLLECTION MANAGEMENT
    
    Client->>+REST: POST /collections
    REST->>+Handler: handle_collection_operation()
    Handler->>+CS: create_collection()
    CS->>CS: Assign storage
    CS->>+Engine: initialize_storage()
    Engine->>Engine: Create directories
    Engine->>+TxCoord: setup_collection_storage()
    TxCoord->>+Cloud: create_collection_dirs()
    Cloud-->>-TxCoord: Created
    TxCoord-->>-Engine: Ready
    Engine-->>-CS: Initialized
    CS->>CS: Persist metadata
    CS-->>-Handler: Created
    Handler-->>-REST: Response
    REST-->>-Client: Success
    
    %% SQL Query Processing Flow
    Note over Client,Cloud: SQL QUERY PROCESSING
    
    Client->>+REST: POST /query
    REST->>+SQL: execute_sql()
    
    SQL->>+HW: get_hardware_capabilities()
    HW-->>-SQL: Hardware profile
    
    alt GPU Available
        SQL->>+GPU: parse_sql_gpu()
        GPU->>+HW: has_gpu_parsing()
        HW-->>-GPU: true
        GPU->>GPU: tokenize_gpu()
        GPU->>GPU: parse_tokens()
        GPU-->>-SQL: ParsedQuery
    else CPU/SIMD
        SQL->>+SIMD: parse_vector_array()
        SIMD->>+HW: has_simd()
        HW-->>-SIMD: AVX2
        SIMD->>SIMD: parse_avx2()
        SIMD-->>-SQL: Vec<f32>
    end
    
    SQL->>+VOS: search_vectors()
    VOS->>+Engine: search_with_metadata()
    Engine-->>-VOS: Results
    VOS-->>-SQL: Ranked results
    SQL-->>-REST: Query results
    REST-->>-Client: Response
    
    %% Error Handling Flow
    Note over Client,Cloud: ERROR HANDLING
    
    Client->>+gRPC: InsertVectors()
    gRPC->>+Handler: handle_vector_batch()
    Handler->>Handler: validate_proto()
    Handler-->>-gRPC: ValidationError
    gRPC-->>-Client: Error Response
    
    %% Note: Sequence diagrams don't support classDef styling
    %% Colors are controlled by the theme variables in the header