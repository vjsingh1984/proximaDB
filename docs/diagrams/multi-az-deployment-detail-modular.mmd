graph TB
    subgraph "AXIS Single-Server Deployment"
        subgraph "Single Availability Zone"
            subgraph "Server Resources"
                SVR[ProximaDB Server]
                MEM[Memory Indexes<br/>Hot Data]
                NVME[Instance Store NVMe<br/>Warm Data]
                EBS[EBS Volume<br/>Persistent Storage]
                S3[S3 Bucket<br/>Cold Data Archive]
            end
        end
        
        subgraph "AXIS Tiering Engine"
            TM[Tier Manager]
            AP[Access Pattern Tracker]
            PM[Promotion/Demotion Engine]
        end
    end
    
    %% Data flow
    SVR --> MEM
    SVR --> NVME
    SVR --> EBS
    SVR --> S3
    
    %% Tiering control
    TM --> PM
    AP --> TM
    PM --> MEM
    PM --> NVME
    PM --> EBS
    PM --> S3
    
    %% Note
    Note[Note: Multi-AZ deployment<br/>planned for future releases]
    
    style Note fill:#fffbeb,stroke:#f59e0b,stroke-width:2px,color:#000000