graph TB
    %% Unified Technical Architecture - Consolidates multiple architecture views
    
    %% Client Layer
    subgraph ClientLayer["Client Layer"]
        Python["Python SDK<br/>proximadb-python<br/>✅ IMPLEMENTED"]
        Rust["Rust SDK<br/>Native server integration<br/>✅ IMPLEMENTED"]
        REST["REST API<br/>:5678"]
        GRPC["gRPC API<br/>:5679"]
    end
    
    %% API Gateway & Service Layer  
    subgraph ServiceLayer["Service Layer"]
        VOS["VectorOperationsService<br/>40-60% latency reduction<br/>Direct memtable access"]
        Router["Intelligent Router<br/>Collection-aware<br/>Protocol selection"]
        Handlers["Unified Handlers<br/>Proto ↔ JSON conversion<br/>Validation & routing"]
    end
    
    %% Query Processing & Optimization
    subgraph QueryLayer["Query Processing"]
        QueryPlanner["Query Planner<br/>Compression-aware<br/>Hardware-optimized"]
        SqlEngine["SQL Engine<br/>VECTOR_SIMILARITY support<br/>GPU/SIMD acceleration"]
        BloomFilter["Bloom Filters<br/>95% scan reduction<br/>3-stage filtering"]
        CacheOrchestrator["Cache Orchestrator<br/>Multi-tier caching<br/>LRU/LFU/ARC"]
    end
    
    %% Storage Engines with Enhanced Architecture
    subgraph StorageLayer["Storage Engines"]
        direction TB
        VIPER["VIPER Engine<br/>Columnar format<br/>Analytics-optimized<br/>Dual storage FP32+Quantized"]
        SST["SST Engine<br/>Row format<br/>OLTP-optimized<br/>Hierarchical SST architecture"]
        WAL["Write-Ahead Log<br/>Proto serialization<br/>Durability & recovery"]
        
        subgraph "Hierarchical SST Features"
            HSST1["Enhanced Headers<br/>Direct access offsets"]
            HSST2["Smart Bloom Filters<br/>85% API call reduction"]
            HSST3["Zero-Copy Compaction<br/>SstRecord streaming"]
        end
    end
    
    %% Unified Compression & Quantization
    subgraph CompressionLayer["Unified Compression"]
        CompEngine["Compression Module<br/>src/core/compression/mod.rs<br/>13 algorithms, context-aware"]
        QuantEngine["Quantization Engine<br/>INT8/PQ8/PQ4<br/>Two-stage search"]
        
        subgraph "Compression Strategies"
            CS1["SST: Never quantize<br/>FP32 + lossless compression"]
            CS2["VIPER: Dual columns<br/>FP32 (primary) + Quantized (index)"]
        end
    end
    
    %% Hardware Acceleration
    subgraph HardwareLayer["Hardware Acceleration"]
        SIMD["SIMD/AVX-512<br/>Vector operations<br/>Auto-detection"]
        GPU["GPU Support<br/>CUDA/ROCm/MPS<br/>Optional acceleration"]
        Memory["Memory Management<br/>Zero-copy operations<br/>Buffer reuse"]
    end
    
    %% AXIS Tiering System
    subgraph TieringLayer["AXIS Tiering"]
        TierManager["Tier Manager<br/>Hot→Warm→Cold<br/>Auto-migration"]
        StorageTiers["Storage Tiers<br/>Memory→NVMe→SSD→S3<br/>Cost-optimized"]
        AccessTracker["Access Pattern Tracker<br/>Heat scoring<br/>Migration triggers"]
    end
    
    %% Indexing Algorithms
    subgraph IndexingLayer["Index Algorithms"]
        HNSW["HNSW<br/>Graph-based<br/>High recall"]
        IVF["IVF<br/>Clustering<br/>Scalable search"]
        LSH["LSH<br/>Hash-based<br/>Fast approximate"]
    end
    
    %% Transaction & Recovery
    subgraph TransactionLayer["ACID & Recovery"]
        TxCoord["Transaction Coordinator<br/>ACID operations<br/>Multi-backend consistency"]
        Recovery["Recovery Manager<br/>WAL replay<br/>Point-in-time recovery"]
        Staging["Staging Operations<br/>Atomic writes<br/>Rollback support"]
    end
    
    %% Monitoring & Observability
    subgraph ObservabilityLayer["Observability"]
        Metrics["Metrics Collector<br/>OpenTelemetry<br/>Real-time statistics"]
        Tracing["Distributed Tracing<br/>Performance analysis<br/>Request flow tracking"]
        Health["Health Monitoring<br/>Service status<br/>Resource utilization"]
    end
    
    %% Request Flow Connections
    Python --> REST
    Python --> GRPC
    Rust --> VOS
    
    REST --> Handlers
    GRPC --> Handlers
    
    Handlers --> VOS
    VOS --> Router
    Router --> QueryPlanner
    
    %% Query Processing Flow
    QueryPlanner --> SqlEngine
    QueryPlanner --> BloomFilter
    QueryPlanner --> CacheOrchestrator
    
    %% Storage Engine Routing
    Router --> VIPER
    Router --> SST
    
    %% Enhanced SST Architecture
    SST --> HSST1
    SST --> HSST2
    SST --> HSST3
    
    %% Compression Integration
    VIPER --> CompEngine
    SST --> CompEngine
    CompEngine --> CS1
    CompEngine --> CS2
    CompEngine --> QuantEngine
    
    %% Write Path
    VIPER --> WAL
    SST --> WAL
    
    %% Hardware Integration
    QuantEngine --> SIMD
    SqlEngine --> GPU
    SIMD --> Memory
    
    %% AXIS Tiering Integration
    VIPER --> TierManager
    SST --> TierManager
    TierManager --> AccessTracker
    TierManager --> StorageTiers
    
    %% Index Integration
    QueryPlanner --> HNSW
    QueryPlanner --> IVF
    QueryPlanner --> LSH
    
    %% Transaction Integration
    VIPER --> TxCoord
    SST --> TxCoord
    TxCoord --> Recovery
    TxCoord --> Staging
    
    %% Monitoring Integration
    VOS --> Metrics
    Router --> Tracing
    QueryPlanner --> Health
    
    %% Advanced Features Connection
    CacheOrchestrator --> Memory
    BloomFilter --> HSST2
    
