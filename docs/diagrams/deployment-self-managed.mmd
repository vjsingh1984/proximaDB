graph TB
    subgraph "Self-Managed Deployment Options"
        subgraph "Cloud VM Deployment"
            VM[Virtual Machine<br/>(e.g., EC2, Azure VM, GCP Compute Engine)]
            subgraph "Local Storage"
                LocalSSD[High-Performance Local SSD<br/>(Ephemeral)]
            end
            subgraph "Network Attached Storage"
                NetStorage[Persistent Network Storage<br/>(e.g., EBS, Azure Disk, GCP Persistent Disk)]
            end
            subgraph "Object Storage Backend"
                CloudObject[Cloud Object Storage<br/>(e.g., S3, Azure Blob, GCS)]
            end
            
            VM --> LocalSSD
            VM --> NetStorage
            VM --> CloudObject
        end
        
        subgraph "On-Premise / Bare Metal Deployment"
            Server[Physical Server<br/>(Bare Metal or VM)]
            subgraph "Direct Attached Storage"
                DAS[High-Performance NVMe/SSD<br/>(Direct Attached)]
            end
            subgraph "Network Attached Storage"
                NAS[NAS/SAN Storage<br/>(Network Attached)]
            end
            subgraph "Object Storage Backend"
                OnPremObject[On-Premise Object Storage<br/>(e.g., MinIO)]
            end
            
            Server --> DAS
            Server --> NAS
            Server --> OnPremObject
        end
    end
