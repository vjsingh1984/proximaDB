flowchart TD
    Start([ProximaDB Startup]) --> Config[Load Configuration]
    Config --> Core[Initialize Core Services]
    Core --> Storage[Setup Storage Engines]
    Storage --> Network[Start Network Services]
    Network --> Recovery[Recover Data]
    Recovery --> Ready[Ready to Serve]
    
    %% Service groupings
    Core -.-> Metrics[Metrics Collector]
    Core -.-> Shared[Shared Services]
    
    Storage -.-> SST[SST Engine]
    Storage -.-> VIPER[VIPER Engine]
    
    Network -.-> REST[REST API]
    Network -.-> GRPC[gRPC API]
    
    Recovery -.-> Collections[Collections]
    Recovery -.-> Vectors[Vector Data]
    
    %% Styling for clear abstraction
    classDef startStyle fill:#dbeafe,stroke:#1d4ed8,stroke-width:2px,color:#1e293b,font-weight:bold
    classDef processStyle fill:#f0fdf4,stroke:#16a34a,stroke-width:2px,color:#14532d,font-weight:bold
    classDef endStyle fill:#fef2f2,stroke:#dc2626,stroke-width:2px,color:#7f1d1d,font-weight:bold
    classDef detailStyle fill:#f8fafc,stroke:#64748b,stroke-width:1px,color:#475569
    
    class Start startStyle
    class Config,Core,Storage,Network,Recovery processStyle
    class Ready endStyle
    class Metrics,Shared,SST,VIPER,REST,GRPC,Collections,Vectors detailStyle