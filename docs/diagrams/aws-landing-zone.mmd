graph TB
    subgraph "AWS Landing Zone Architecture"
        subgraph "Management Account"
            ControlTower[AWS Control Tower<br/>Centralized Governance]
            Organizations[AWS Organizations<br/>Multi-Account Management]
        end
        
        subgraph "Core Infrastructure"
            TGW[Transit Gateway<br/>$36/mo per account<br/>Centralized Network Hub]
            SharedServices[Shared Services<br/>DNS, Monitoring, Security]
        end
        
        subgraph "Production Account: ProximaDB"
            ProdVPC[Production VPC<br/>10.1.0.0/16]
            ProximaDB[ProximaDB Cluster<br/>m7i.2xlarge instances]
            GWEndpoint[S3 Gateway Endpoint<br/>FREE - Landing Zone Standard]
            IFEndpoint[Interface Endpoints<br/>$7.20/mo each]
        end
        
        subgraph "Application Account"
            AppVPC[Application VPC<br/>10.2.0.0/16] 
            Applications[Business Applications<br/>API Gateway, Lambda]
        end
        
        subgraph "Data Account"
            DataVPC[Data VPC<br/>10.3.0.0/16]
            DataLake[Enterprise Data Lake<br/>S3, Athena, Glue]
        end
        
        CloudStorage[S3 Enterprise Storage<br/>Landing Zone Compliant<br/>Cross-Region Replication]
    end
    
    %% Landing Zone Connections
    ControlTower -.->|Governs| ProdVPC
    ControlTower -.->|Governs| AppVPC
    ControlTower -.->|Governs| DataVPC
    
    %% Network Architecture
    ProdVPC -.->|$36/mo attachment| TGW
    AppVPC -.->|$36/mo attachment| TGW  
    DataVPC -.->|$36/mo attachment| TGW
    
    %% Optimized Data Flow
    ProximaDB -->|FREE routing via Gateway Endpoint| GWEndpoint
    GWEndpoint -->|Landing zone compliant path| CloudStorage
    
    ProximaDB -->|Cross-account via TGW<br/>$0.02/GB| TGW
    TGW -->|Secure routing| Applications
    TGW -->|Analytics access| DataLake
    
    style GWEndpoint fill:#90ee90
    style ControlTower fill:#e6f3ff
    style TGW fill:#ffe4b5
    style CloudStorage fill:#ffd700
    
    classDef landingzone fill:#e6f3ff,stroke:#4169e1,stroke-width:2px
    classDef free fill:#90ee90,stroke:#2d7a2d,stroke-width:2px
    classDef paid fill:#ffcccb,stroke:#8b0000,stroke-width:2px
    
    class ControlTower,Organizations,SharedServices landingzone
    class GWEndpoint free
    class TGW,IFEndpoint paid