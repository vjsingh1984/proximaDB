%%{init: {'theme':'base', 'themeVariables': { 'primaryColor':'#1f2937', 'primaryTextColor':'#fff', 'primaryBorderColor':'#374151', 'lineColor':'#6b7280', 'secondaryColor':'#3b82f6', 'tertiaryColor':'#10b981', 'tertiaryTextColor':'#fff', 'tertiaryBorderColor':'#059669', 'background':'#ffffff', 'mainBkg':'#f3f4f6', 'secondBkg':'#e5e7eb', 'tertiaryBkg':'#d1d5db'}}}%%

graph TB
    subgraph "Compute Module Architecture"
        UC[UnifiedDistanceCompute<br/>Central Distance Calculations]
        
        subgraph "Distance Metrics"
            L1["L1/Manhattan<br/>abs(a-b)"]
            L2["L2/Euclidean<br/>sqrt(sum(a-b)²)"]
            COS["Cosine<br/>1 - dot(a,b)/(||a||*||b||)"]
            DOT["DotProduct<br/>-sum(a*b)"]
            HAM["Hamming<br/>XOR + popcount"]
            JAC["Jaccard<br/>intersection/union"]
        end
        
        subgraph "AXIS Framework"
            AXIS[AxisManager<br/>Adaptive Index Selection<br/>Zero-downtime Migration]
            
            subgraph "Index Algorithms"
                HNSW[HNSW<br/>Hierarchical Graph<br/>98% recall @ 15K QPS]
                IVF[IVF<br/>K-means Clustering<br/>95% recall @ 22K QPS]
                LSH[LSH<br/>Hash Buckets<br/>90% recall @ 45K QPS]
                ANNOY[Annoy<br/>Tree-based<br/>92% recall @ 20K QPS]
            end
        end
        
        subgraph "Hardware Acceleration"
            AVX[AVX2/AVX512<br/>256/512-bit SIMD<br/>1.3B elem/sec]
            NEON[ARM NEON<br/>128-bit SIMD]
            ROCM[AMD ROCm<br/>GPU acceleration]
            CUDA[NVIDIA CUDA<br/>GPU acceleration]
            METAL[Metal<br/>Apple GPU]
            OPENCL[OpenCL<br/>Cross-platform GPU]
        end
        
        subgraph "Platform-Specific Optimizations"
            GENERIC[GenericScalar<br/>Fallback implementation]
            X86[x86_64 SIMD<br/>AVX optimized]
            ARM[ARM SIMD<br/>NEON optimized]
            GPU_OPT[GPU Kernels<br/>Parallel compute]
        end
    end
    
    subgraph "Integration Points"
        DVS[DirectVectorService<br/>Main entry point]
        LSM_ENGINE[LSM Engine<br/>UnifiedSearchEngine]
        VIPER_ENGINE[VIPER Engine<br/>UnifiedSearchEngine]
    end
    
    %% Distance metric connections
    UC --> L1
    UC --> L2
    UC --> COS
    UC --> DOT
    UC --> HAM
    UC --> JAC
    
    %% Hardware acceleration connections
    UC --> AVX
    UC --> NEON
    UC --> ROCM
    UC --> CUDA
    UC --> METAL
    UC --> OPENCL
    
    %% Platform optimization connections
    AVX --> X86
    NEON --> ARM
    ROCM --> GPU_OPT
    CUDA --> GPU_OPT
    METAL --> GPU_OPT
    OPENCL --> GPU_OPT
    
    %% AXIS connections
    AXIS --> HNSW
    AXIS --> IVF
    AXIS --> LSH
    AXIS --> ANNOY
    
    %% Indexing algorithm connections
    HNSW --> UC
    IVF --> UC
    LSH --> UC
    ANNOY --> UC
    
    %% Integration connections
    DVS --> AXIS
    
    LSM_ENGINE --> UC
    VIPER_ENGINE --> UC
    
    %% Styling
    classDef compute fill:#ede9fe,stroke:#7c3aed,color:#4c1d95,stroke-width:2px
    classDef index fill:#fef3c7,stroke:#d97706,color:#78350f,stroke-width:2px
    classDef hardware fill:#dbeafe,stroke:#2563eb,color:#1e3a8a,stroke-width:2px
    classDef integration fill:#d1fae5,stroke:#10b981,color:#064e3b,stroke-width:2px
    
    class UC,L1,L2,COS,DOT,HAM,JAC,GENERIC compute
    class AXIS,HNSW,IVF,LSH,ANNOY index
    class AVX,NEON,ROCM,CUDA,METAL,OPENCL,X86,ARM,GPU_OPT hardware
    class DVS,LSM_ENGINE,VIPER_ENGINE integration
    
