@startuml ProximaDB WAL Flush Activity
!theme plain
title ProximaDB - WAL Flush Process Activity Diagram

start

:WAL Flush Triggered;
note right
  Triggers:
  - Timer interval
  - Memory threshold
  - Segment size limit
  - Manual flush
end note

partition "Flush Preparation" {
  :Acquire Flush Lock;
  
  :Identify Segments to Flush;
  note left
    Select unflushed segments
    older than checkpoint
  end note
  
  :Create New Active Segment;
  note right
    Ensures writes continue
    during flush process
  end note
}

partition "Segment Processing" #LightBlue {
  while (More segments to flush?) is (yes)
    :Load Segment from WAL;
    
    :Deserialize Batch Records;
    note right
      Avro or Bincode format
      based on strategy
    end note
    
    :Group by Collection ID;
    
    fork
      partition "LSM Collections" {
        :Convert to LSM Records;
        :Sort by Vector ID;
        :Write to SSTable;
        :Update Bloom Filter;
        :Add to LSM Index;
      }
    fork again
      partition "VIPER Collections" {
        :Convert to Arrow Format;
        :Apply Quantization;
        note left
          Storage quantization
          if configured
        end note
        :Group into Row Groups;
        :Write Parquet File;
        :Update ML Clusters;
      }
    end fork
    
    :Update Collection Metadata;
    note right
      - Vector count
      - Storage size
      - Last flush time
    end note
    
    :Mark Segment as Flushed;
  endwhile (no)
}

partition "Cleanup" #LightGreen {
  :Update WAL Checkpoint;
  
  :Release Old Segments;
  note left
    Memory can be reclaimed
    after successful flush
  end note
  
  :Trigger Compaction Check;
  
  if (Compaction needed?) then (yes)
    :Schedule Background Compaction;
  endif
  
  :Update Flush Metrics;
  note right
    - Flush duration
    - Records flushed
    - Bytes written
  end note
}

:Release Flush Lock;

stop

@enduml