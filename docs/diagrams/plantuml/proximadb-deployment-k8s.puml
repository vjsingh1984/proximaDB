@startuml ProximaDB Kubernetes Deployment
!theme plain
title ProximaDB - Kubernetes Deployment Architecture

!define ICONURL https://raw.githubusercontent.com/tupadr3/plantuml-icon-font-sprites/v2.4.0
!includeurl ICONURL/common.puml
!includeurl ICONURL/devicons2/kubernetes.puml

package "Kubernetes Cluster" <<cloud>> {
  
  package "Ingress" {
    component "NGINX Ingress\nController" as INGRESS
    note right of INGRESS
      Routes:
      - /api/v1/* → REST Service
      - :5679 → gRPC Service
    end note
  }
  
  package "ProximaDB Namespace" {
    
    package "StatefulSet: proximadb-server" {
      component "Pod: proximadb-0" as POD0 {
        component "proximadb:latest" as PROX0
        component "metrics-exporter" as ME0
      }
      
      component "Pod: proximadb-1" as POD1 {
        component "proximadb:latest" as PROX1
        component "metrics-exporter" as ME1
      }
      
      component "Pod: proximadb-2" as POD2 {
        component "proximadb:latest" as PROX2
        component "metrics-exporter" as ME2
      }
    }
    
    package "Services" {
      component "Service: proximadb-rest\nClusterIP\n:5678" as SVC_REST
      component "Service: proximadb-grpc\nClusterIP\n:5679" as SVC_GRPC
      component "Service: proximadb-headless\nNone" as SVC_HEADLESS
    }
    
    package "ConfigMaps & Secrets" {
      component "ConfigMap:\nproximadb-config" as CM {
        file "config.toml"
        file "log4rs.yaml"
      }
      
      component "Secret:\nproximadb-tls" as SEC {
        file "tls.crt"
        file "tls.key"
      }
    }
    
    package "PersistentVolumes" {
      database "PVC: data-proximadb-0\n100Gi SSD" as PVC0
      database "PVC: data-proximadb-1\n100Gi SSD" as PVC1
      database "PVC: data-proximadb-2\n100Gi SSD" as PVC2
    }
  }
  
  package "Monitoring Namespace" {
    component "Prometheus\nOperator" as PROM_OP
    component "ServiceMonitor:\nproximadb" as SM
    component "Grafana" as GRAF
  }
  
  package "Storage Classes" {
    component "StorageClass:\nfast-ssd" as SC_SSD {
      note bottom
        - NVMe backed
        - Low latency
        - For WAL/LSM
      end note
    }
    
    component "StorageClass:\nstandard" as SC_STD {
      note bottom
        - HDD backed
        - High capacity
        - For VIPER/Archive
      end note
    }
  }
}

cloud "External Services" {
  database "PostgreSQL\n(Metadata)" as PG
  database "S3 Compatible\n(Backups)" as S3
  component "Container\nRegistry" as REG
}

' Ingress routing
INGRESS --> SVC_REST : HTTP
INGRESS --> SVC_GRPC : gRPC

' Service routing
SVC_REST --> POD0 : Round Robin
SVC_REST --> POD1
SVC_REST --> POD2

SVC_GRPC --> POD0 : Session Affinity
SVC_GRPC --> POD1
SVC_GRPC --> POD2

SVC_HEADLESS --> POD0 : DNS A records
SVC_HEADLESS --> POD1
SVC_HEADLESS --> POD2

' Pod configurations
POD0 ..> CM : Mount
POD0 ..> SEC : Mount
POD1 ..> CM : Mount
POD1 ..> SEC : Mount
POD2 ..> CM : Mount
POD2 ..> SEC : Mount

' Storage mounting
POD0 --> PVC0 : /data
POD1 --> PVC1 : /data
POD2 --> PVC2 : /data

' Monitoring
ME0 ..> PROM_OP : Scrape
ME1 ..> PROM_OP : Scrape
ME2 ..> PROM_OP : Scrape
PROM_OP --> SM : Discover
PROM_OP --> GRAF : Query

' External connections
PROX0 ..> PG : Metadata
PROX1 ..> PG : Metadata
PROX2 ..> PG : Metadata

PROX0 ..> S3 : Backup
PROX1 ..> S3 : Backup
PROX2 ..> S3 : Backup

REG --> POD0 : Image Pull
REG --> POD1 : Image Pull
REG --> POD2 : Image Pull

note bottom of POD0
  Resource Requests:
  - CPU: 4 cores
  - Memory: 16Gi
  - GPU: Optional (nvidia.com/gpu)
  
  Limits:
  - CPU: 8 cores
  - Memory: 32Gi
end note

note right of SVC_HEADLESS
  Headless service enables:
  - Direct pod addressing
  - Stable network identities
  - Stateful set ordering
end note

@enduml