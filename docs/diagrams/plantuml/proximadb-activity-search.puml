@startuml ProximaDB Search Activity
!theme plain
title ProximaDB - Search Process Activity Diagram

start

:Receive Search Request;
note right
  - Collection ID
  - Query vector
  - Top K
  - Metadata filters
  - Optimization hints
end note

:Validate Request Parameters;

if (Collection exists?) then (yes)
  :Load Collection Configuration;
  
  :Parse Search Parameters;
  note right
    - Distance metric
    - Quantization hints
    - Two-stage settings
    - Timeout limits
  end note
  
  :Create Search Context;
  
  partition "Storage Detection" {
    :Check WAL Status;
    :Check LSM Status;
    :Check VIPER Status;
    
    :Determine Search Strategy;
    note left
      Based on:
      - Data distribution
      - Query complexity
      - Performance hints
    end note
  }
  
  if (Multi-tier search needed?) then (yes)
    fork
      partition "WAL Search" {
        :Scan Memory Buffers;
        :Apply Distance Function;
        :Filter by Metadata;
        :Collect WAL Results;
      }
    fork again
      partition "LSM Search" {
        :Load SSTable Indexes;
        :Check Bloom Filters;
        :Search B-Tree Structures;
        :Apply Metadata Predicates;
        :Collect LSM Results;
      }
    fork again
      partition "VIPER Search" {
        if (Two-stage enabled?) then (yes)
          :ML Cluster Selection;
          :Quantized Coarse Search;
          note right
            INT8/PQ8/Binary
            quantization
          end note
          :Select Candidates;
          :FP32 Reranking;
        else (no)
          :Direct Parquet Scan;
          :Predicate Pushdown;
        endif
        :Collect VIPER Results;
      }
    end fork
    
    :Merge Results from All Tiers;
    
    partition "Deduplication" {
      :Group by Vector ID;
      :Select Latest Version;
      note right
        Based on timestamp
        and sequence number
      end note
      :Remove Duplicates;
    }
    
  else (no)
    :Execute Single-Tier Search;
  endif
  
  :Sort by Relevance Score;
  :Apply Top-K Limit;
  
  if (Include vectors?) then (yes)
    :Fetch Vector Data;
  endif
  
  if (Include metadata?) then (yes)
    :Fetch Metadata;
  endif
  
  :Calculate Search Metrics;
  note left
    - Query time
    - Vectors scanned
    - Tiers accessed
  end note
  
  :Format Response;
  :Return Success Response;
  
else (no)
  :Return Collection Not Found Error;
endif

stop

@enduml