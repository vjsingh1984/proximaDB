@startuml ProximaDB Service Layer Class Diagram
!theme plain
title ProximaDB - Service Layer Class Diagram

package "Core Services" {
  class VectorService {
    -wal_manager: Arc<WalManager>
    -storage_engines: HashMap<String, Arc<dyn StorageEngine>>
    -collection_coordinators: HashMap<String, Arc<CollectionStorageIndexCoordinator>>
    -start_time: Instant
    --
    +insert_vectors_batch(collection_id: &str, vectors: Vec<VectorData>): Result<Vec<u8>>
    +search_vectors_polymorphic(params: SearchParams): Result<Vec<u8>>
    +get_vector_by_id(collection_id: &str, vector_id: &str): Result<Option<Vec<u8>>>
    +delete_vector(collection_id: &str, vector_id: &str): Result<bool>
    +health_check(): Result<Vec<u8>>
    +get_metrics(): Result<Vec<u8>>
    +force_flush_all(): Result<FlushStats>
  }
  
  class CollectionService {
    -metadata_store: Arc<dyn MetadataBackend>
    -vector_service: Option<Arc<VectorService>>
    --
    +create_collection(config: &CollectionConfig): Result<CollectionResponse>
    +get_collection(id: &str): Result<Option<Collection>>
    +list_collections(filters: ListFilters): Result<Vec<Collection>>
    +update_collection(id: &str, updates: CollectionUpdate): Result<CollectionResponse>
    +delete_collection(id: &str): Result<CollectionResponse>
    +get_collection_stats(id: &str): Result<CollectionStats>
  }
  
  class CollectionStorageIndexCoordinator {
    -collection_id: String
    -axis_manager: Arc<AxisManager>
    -viper_engine: Arc<ViperEngine>
    -lsm_engine: Arc<LsmTree>
    -storage_engine_type: StorageEngine
    -operation_metrics: Arc<RwLock<CoordinatorMetrics>>
    --
    +handle_vector_insert(vectors: Vec<VectorRecord>): Result<()>
    +handle_flush_event(stats: FlushStats): Result<()>
    +handle_compaction_event(stats: CompactionStats): Result<()>
    +get_search_hints(): SearchHints
    +update_metrics(op: OperationType, duration: Duration): Result<()>
  }
}

package "Network Handlers" {
  abstract class Handler {
    #state: Arc<AppState>
    --
    {abstract} +handle_request(request: Request): Result<Response>
  }
  
  class RestHandler {
    -router: Router
    --
    +collection_operation(req: CollectionOperationRequest): Result<CollectionResponse>
    +vector_batch(req: VectorBatchRequest): Result<VectorOperationResponse>
    +vector_search(req: VectorSearchRequest): Result<VectorOperationResponse>
    +health_check(): Result<ApiResponse<HealthData>>
  }
  
  class GrpcHandler {
    -vector_service: Arc<VectorService>
    -collection_service: Arc<CollectionService>
    --
    +collection_operation(req: CollectionRequest): Result<CollectionResponse>
    +batch_insert(req: BatchInsertRequest): Result<BatchInsertResponse>
    +batch_search(req: BatchSearchRequest): Result<BatchSearchResponse>
    +stream_insert(stream: Stream<VectorData>): Result<StreamResponse>
  }
  
  class AppState {
    +vector_service: Arc<VectorService>
    +collection_service: Arc<CollectionService>
  }
}

package "Proto/Model Types" {
  class Collection <<proto>> {
    +id: String
    +config: Option<CollectionConfig>
    +stats: Option<CollectionStats>
    +created_at: i64
    +updated_at: i64
  }
  
  class CollectionConfig <<proto>> {
    +name: String
    +dimension: i32
    +distance_metric: DistanceMetric
    +storage_engine: StorageEngine
    +primary_indexing_algorithm: IndexingAlgorithm
    +filterable_columns: Vec<FilterableColumn>
    +index_configs: Vec<IndexConfig>
    +quantization_config: Option<QuantizationConfig>
  }
  
  class VectorRecord {
    +id: String
    +vector: Vec<f32>
    +metadata: HashMap<String, Value>
    +timestamp: i64
    +version: u64
    +expires_at: Option<i64>
  }
  
  class SearchParams {
    +top_k: Option<usize>
    +filters: Option<HashMap<String, Value>>
    +accuracy_threshold: Option<f32>
    +timeout_ms: Option<i64>
    +quantization_hint: Option<QuantizationLevel>
    +enable_two_stage: bool
    +enable_clustering_hint: bool
  }
}

package "Index Management" {
  class AxisManager {
    -indexes: HashMap<String, Box<dyn Index>>
    -config: AxisConfig
    -quantization_engine: Arc<UnifiedQuantization>
    --
    +create_index(config: IndexConfig): Result<String>
    +update_index(id: &str, vectors: Vec<VectorRecord>): Result<()>
    +search_index(id: &str, query: SearchQuery): Result<Vec<SearchResult>>
    +optimize_index(id: &str): Result<OptimizationStats>
    +get_index_stats(id: &str): Result<IndexStats>
  }
  
  interface Index {
    +insert(id: &str, vector: &[f32]): Result<()>
    +search(query: &[f32], k: usize): Result<Vec<(String, f32)>>
    +delete(id: &str): Result<bool>
    +optimize(): Result<()>
    +stats(): IndexStats
  }
  
  class HnswIndex {
    -graph: HnswGraph
    -config: HnswConfig
    --
    +set_ef(ef: usize)
    +get_neighbors(id: &str): Vec<String>
  }
  
  class IvfIndex {
    -centroids: Vec<Vec<f32>>
    -inverted_lists: HashMap<u32, Vec<String>>
    -config: IvfConfig
    --
    +train(vectors: &[Vec<f32>]): Result<()>
    +assign_to_cluster(vector: &[f32]): u32
  }
}

' Inheritance relationships
Handler <|-- RestHandler
Handler <|-- GrpcHandler
Index <|.. HnswIndex
Index <|.. IvfIndex

' Composition relationships
VectorService *-- CollectionStorageIndexCoordinator
CollectionService o-- VectorService
CollectionStorageIndexCoordinator *-- AxisManager
CollectionStorageIndexCoordinator o-- ViperEngine
CollectionStorageIndexCoordinator o-- LsmTree
RestHandler o-- AppState
GrpcHandler o-- AppState
AppState *-- VectorService
AppState *-- CollectionService
AxisManager *-- Index
Collection *-- CollectionConfig
Collection *-- CollectionStats

' Usage relationships
VectorService ..> SearchParams : uses
CollectionService ..> Collection : manages
RestHandler ..> VectorService : delegates
GrpcHandler ..> VectorService : delegates
RestHandler ..> CollectionService : delegates
GrpcHandler ..> CollectionService : delegates
CollectionStorageIndexCoordinator ..> VectorRecord : processes

note top of VectorService
  Central service for all vector
  operations across protocols
end note

note right of CollectionStorageIndexCoordinator
  Coordinates between storage
  engines and index structures
  for each collection
end note

note bottom of AxisManager
  AXIS: Adaptive eXtensible
  Index System - manages
  multiple index types
end note

@enduml