@startuml proximadb-architecture-overview
!theme plain
title ProximaDB Proto-First Architecture Overview - 2025

package "Network Layer" {
    package "Unified Handlers" {
        class UnifiedHandlers {
            - collection_service: Arc<CollectionService>
            - vector_service: Arc<VectorService>
            + handle_collection_operation(proto_request): proto::CollectionResponse
            + handle_vector_batch(proto_batch): proto::VectorOperationResponse
            + handle_vector_search(proto_query): proto::SearchResponse
            --
            <<Proto-First Design>>
            Zero double serialization
            85% code reduction vs legacy
        }
        
        class RestAdapter {
            - unified_handlers: Arc<UnifiedHandlers>
            + collection_endpoint(json): JsonResponse
            + vector_endpoint(json): JsonResponse
            --
            JSON ↔ Proto conversion only
        }
        
        class GrpcAdapter {
            - unified_handlers: Arc<UnifiedHandlers>
            + CreateCollection(request): CreateCollectionResponse
            + InsertVectors(request): InsertVectorsResponse
            + SearchVectors(request): SearchVectorsResponse
            --
            Direct proto passthrough
        }
    }
    
    package "Proto Schema" {
        class ProtoTypes <<Generated>> {
            + proto::proximadb::Collection
            + proto::proximadb::CollectionConfig
            + proto::proximadb::VectorRecord
            + proto::proximadb::SearchQuery
            + proto::proximadb::MetadataItem
            --
            Single source of truth
            64MB message support
        }
    }
}

package "Service Layer" {
    class VectorService {
        - storage_engine: Arc<dyn StorageEngine>
        - wal_manager: Arc<WalManager>
        - axis_manager: Arc<AxisManager>
        - collection_service: Option<Arc<CollectionService>>
        + handle_vector_batch_proto_vec(batch: Vec<proto::VectorRecord>): Result<()>
        + search_vectors_storage_aware(query: proto::SearchQuery): Result<Vec<proto::SearchResult>>
        + coordinate_flush_operations(): Result<()>
        --
        <<Proto-Native Operations>>
        Zero-copy batch processing
        Storage-aware polymorphic search
        6.10x performance improvement
    }
    
    class CollectionService {
        - metadata_backend: Arc<FilestoreMetadataBackend>
        - assignment_service: Arc<dyn AssignmentService>
        - index_config_cache: Arc<RwLock<HashMap<String, IndexConfig>>>
        + create_collection(config: proto::CollectionConfig): Result<proto::Collection>
        + get_collection(id: String): Result<Option<proto::Collection>>
        + update_collection_stats(id: String, stats: proto::CollectionStats): Result<()>
        + create_storage_directories(assignment: &StorageAssignment): Result<()>
        --
        <<Proto-First Collections>>
        Direct proto serialization
        Unified atomic coordinator
        .proto file extensions
    }
    
    class AssignmentService {
        - strategy: AssignmentStrategy
        - storage_layout: StorageLayoutConfig
        - filesystem: Arc<dyn FileSystem>
        + assign_collection_storage(collection_id: &str): StorageAssignment
        + get_assignment(collection_id: &str): Option<StorageAssignment>
        + create_storage_paths(assignment: &StorageAssignment): Result<()>
        --
        Multi-disk coordination
        Sequential I/O optimization
    }
}

package "Storage Layer" {
    package "Storage-Aware Search" {
        interface StorageSearchEngine {
            + search_vectors(hints: &SearchHints): Result<Vec<SearchResult>>
            + search_capabilities(): SearchCapabilities
            + supports_predicate_pushdown(): bool
            + supports_clustering(): bool
        }
    }
    
    class ViperEngine implements StorageSearchEngine {
        - parquet_writer: ParquetWriter
        - ml_clustering_engine: MLClusteringEngine
        - collection_service: Option<Arc<CollectionService>>
        - quantization_engine: UnifiedQuantizationEngine
        + generate_dynamic_schema(collection_config: &proto::CollectionConfig): Schema
        + write_vectors_to_parquet(vectors: Vec<proto::VectorRecord>): Result<()>
        + predicate_pushdown_search(filters: &HashMap<String, Value>): Result<Vec<SearchResult>>
        --
        <<Columnar Storage>>
        Parquet predicate pushdown
        ML clustering optimization
        Vector quantization support
    }
    
    class LsmEngine implements StorageSearchEngine {
        - memtable: Arc<dyn UnifiedMemtable>
        - compaction_manager: CompactionManager
        - bloom_filters: BloomFilterManager
        - sst_levels: Vec<LsmLevel>
        + write_to_sst(records: Vec<proto::VectorRecord>): Result<()>
        + merge_sstables(levels: &[LsmLevel]): Result<()>
        + bloom_filter_search(vector_id: &str): bool
        --
        <<Row-based Storage>>
        SSTable level compaction
        Bloom filter optimization
        MVCC with versioning
    }
    
    package "Unified Memtable" {
        interface UnifiedMemtable {
            + insert(key: String, value: proto::VectorRecord): Result<()>
            + get(key: &str): Option<proto::VectorRecord>
            + scan_range(start: &str, end: &str): Iterator<proto::VectorRecord>
            + flush(): Result<Vec<proto::VectorRecord>>
        }
        
        class GlobalPartitionedMemtable implements UnifiedMemtable {
            - btree_backend: Arc<BTreeMemtable>
            - skiplist_backend: Arc<SkipListMemtable>
            - hashmap_backend: Arc<HashMapMemtable>
            - dashmap_backend: Arc<DashMapMemtable>
            --
            <<40% Code Reduction>>
            Polymorphic backend selection
            Specialized WAL/LSM wrappers
        }
    }
}

package "WAL & Persistence" {
    class WalManager {
        - batch_factory: Arc<WalBatchFactory>
        - flush_coordinator: Arc<WalFlushCoordinator>
        - strategy_type: WalStrategyType
        - memtable_wrapper: Arc<WalBehaviorWrapper>
        + write_vector_batch_proto(batch: Vec<proto::VectorRecord>): Result<Vec<u64>>
        + flush_to_storage(collection_id: &str): Result<()>
        + recover_from_wal(): Result<()>
        --
        <<Proto-First WAL>>
        One API call = One batch
        Zero double serialization
    }
    
    interface WalBatchStrategy {
        + serialize_batch(vectors: Vec<proto::VectorRecord>): Result<Vec<u8>>
        + deserialize_batch(data: &[u8]): Result<Vec<proto::VectorRecord>>
        + get_format_name(): &str
        + supports_compression(): bool
    }
    
    class ProtoWalBatchStrategy implements WalBatchStrategy {
        - compression_enabled: bool
        + serialize_batch(vectors: Vec<proto::VectorRecord>): Result<Vec<u8>>
        + deserialize_batch(data: &[u8]): Result<Vec<proto::VectorRecord>>
        --
        <<Default Strategy>>
        Native proto serialization
        Zero conversion overhead
        Fastest performance
    }
    
    class AvroWalBatchStrategy implements WalBatchStrategy {
        - avro_schema: Schema
        + serialize_batch(vectors: Vec<proto::VectorRecord>): Result<Vec<u8>>
        + deserialize_batch(data: &[u8]): Result<Vec<proto::VectorRecord>>
        --
        <<Legacy Support>>
        Proto → Avro conversion
        Backward compatibility
    }
    
    class BincodeWalBatchStrategy implements WalBatchStrategy {
        - rust_optimized: bool
        + serialize_batch(vectors: Vec<proto::VectorRecord>): Result<Vec<u8>>
        + deserialize_batch(data: &[u8]): Result<Vec<proto::VectorRecord>>
        --
        <<Rust Optimization>>
        Proto → Bincode conversion
        Type-safe serialization
    }
}

package "Metadata Layer" {
    interface MetadataBackend {
        + create_collection(config: proto::CollectionConfig): Result<proto::Collection>
        + get_collection(id: &str): Result<Option<proto::Collection>>
        + list_collections(): Result<Vec<proto::Collection>>
        + update_collection_stats(id: &str, stats: proto::CollectionStats): Result<()>
        + delete_collection(id: &str): Result<()>
    }
    
    class FilestoreMetadataBackend implements MetadataBackend {
        - filesystem: Arc<dyn FileSystem>
        - collections_index: HashMap<String, proto::Collection>
        - operation_log: Vec<MetadataOperation>
        - proto_serializer: ProtoSerializer
        + save_collection_proto(collection: &proto::Collection): Result<()>
        + load_collection_proto(id: &str): Result<Option<proto::Collection>>
        + snapshot_to_disk(): Result<()>
        + recover_from_disk(): Result<()>
        --
        <<Proto-First Metadata>>
        .proto file extensions
        Direct proto serialization
        Unified atomic coordinator
    }
    
    class RocksDbMetadataBackend implements MetadataBackend {
        - db: Arc<rocksdb::DB>
        - proto_serializer: ProtoSerializer
        + put_collection_proto(key: &str, collection: &proto::Collection): Result<()>
        + get_collection_proto(key: &str): Result<Option<proto::Collection>>
        --
        Proto binary storage
        ACID transactions
    }
}

package "Hardware Optimization" {
    class UnifiedQuantizationEngine {
        - hardware_capabilities: HardwareCapabilities
        - simd_level: SimdLevel
        + quantize_vectors(vectors: &[Vec<f32>], level: QuantizationLevel): Result<QuantizedVectors>
        + dequantize_vectors(quantized: &QuantizedVectors): Result<Vec<Vec<f32>>>
        + hardware_accelerated_distance(a: &[f32], b: &[f32]): f32
        --
        <<Hardware Detection>>
        SIMD optimization
        GPU acceleration support
    }
}

' Relationships - Proto-First Architecture
RestAdapter --> UnifiedHandlers : delegates to
GrpcAdapter --> UnifiedHandlers : delegates to
UnifiedHandlers --> VectorService : uses
UnifiedHandlers --> CollectionService : uses
VectorService --> StorageSearchEngine : polymorphic dispatch
VectorService --> WalManager : batch coordination
VectorService --> UnifiedQuantizationEngine : vector processing
CollectionService --> MetadataBackend : proto storage
CollectionService --> AssignmentService : storage coordination
WalManager --> WalBatchStrategy : strategy pattern
WalManager --> StorageSearchEngine : flush coordination
ViperEngine --> CollectionService : schema generation
ViperEngine --> UnifiedQuantizationEngine : vector optimization
LsmEngine --> UnifiedMemtable : memory management
GlobalPartitionedMemtable --> UnifiedMemtable : backend selection
ProtoTypes --> VectorService : native types
ProtoTypes --> CollectionService : native types
ProtoTypes --> WalManager : native types

