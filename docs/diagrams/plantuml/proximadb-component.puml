@startuml ProximaDB Component Diagram
!theme plain
title ProximaDB - System Component Architecture

package "Client Layer" {
  [Python SDK] as PY_SDK
  [REST Client] as REST_CLI
  [gRPC Client] as GRPC_CLI
  [Other SDKs] as OTHER_SDK
}

package "API Gateway Layer" {
  [REST API Server] as REST_API
  [gRPC Server] as GRPC_API
  
  component "Protocol Handlers" {
    [REST Handler] as REST_H
    [gRPC Handler] as GRPC_H
  }
}

package "Service Layer" {
  component "Core Services" {
    [Vector Service] as VEC_SVC
    [Collection Service] as COL_SVC
    [Search Service] as SRCH_SVC
  }
  
  component "Coordinators" {
    [Storage-Index Coordinator] as SI_COORD
    [Flush Coordinator] as FLUSH_COORD
    [Compaction Coordinator] as COMP_COORD
  }
}

package "Storage Layer" {
  component "WAL System" {
    [WAL Manager] as WAL_MGR
    [Batch Factory] as BATCH_FAC
    [Segment Manager] as SEG_MGR
  }
  
  component "Storage Engines" {
    [LSM Engine] as LSM_ENG
    [VIPER Engine] as VIPER_ENG
    [Memtable Manager] as MEM_MGR
  }
  
  component "Storage Utilities" {
    [Atomicity Manager] as ATOM_MGR
    [Filesystem Factory] as FS_FAC
    [Compression Engine] as COMP_ENG
  }
}

package "Index Layer" {
  component "AXIS System" {
    [AXIS Manager] as AXIS_MGR
    [Index Factory] as IDX_FAC
  }
  
  component "Index Implementations" {
    [HNSW Index] as HNSW
    [IVF Index] as IVF
    [Flat Index] as FLAT
    [PQ Index] as PQ
    [Annoy Index] as ANNOY
  }
}

package "Compute Layer" {
  component "Distance Computation" {
    [SIMD Engine] as SIMD
    [GPU Accelerator] as GPU
    [Distance Metrics] as DIST
  }
  
  component "Quantization" {
    [Unified Quantization] as UNI_QUANT
    [INT8 Quantizer] as INT8
    [PQ Quantizer] as PQ_QUANT
    [Binary Quantizer] as BIN_QUANT
  }
  
  [Hardware Detection] as HW_DETECT
}

package "Metadata Layer" {
  [Metadata Store] as META_STORE
  [Collection Registry] as COL_REG
  [Index Registry] as IDX_REG
  
  component "Backends" {
    [RocksDB Backend] as ROCKS_BE
    [FileStore Backend] as FILE_BE
    [Memory Backend] as MEM_BE
  }
}

package "Monitoring & Operations" {
  [Metrics Collector] as METRICS
  [Health Monitor] as HEALTH
  [Performance Analyzer] as PERF
  [Debug Tools] as DEBUG
}

' Client connections
PY_SDK --> REST_API : HTTP/JSON
PY_SDK --> GRPC_API : Protocol Buffers
REST_CLI --> REST_API
GRPC_CLI --> GRPC_API
OTHER_SDK --> REST_API
OTHER_SDK --> GRPC_API

' API to Handler connections
REST_API --> REST_H
GRPC_API --> GRPC_H

' Handler to Service connections
REST_H --> VEC_SVC
REST_H --> COL_SVC
GRPC_H --> VEC_SVC
GRPC_H --> COL_SVC

' Service layer connections
VEC_SVC --> SI_COORD
VEC_SVC --> WAL_MGR
VEC_SVC --> SRCH_SVC
COL_SVC --> META_STORE
SRCH_SVC --> LSM_ENG
SRCH_SVC --> VIPER_ENG

' Coordinator connections
SI_COORD --> AXIS_MGR
SI_COORD --> LSM_ENG
SI_COORD --> VIPER_ENG
FLUSH_COORD --> WAL_MGR
FLUSH_COORD --> LSM_ENG
FLUSH_COORD --> VIPER_ENG
COMP_COORD --> LSM_ENG
COMP_COORD --> VIPER_ENG

' Storage layer connections
WAL_MGR --> BATCH_FAC
WAL_MGR --> SEG_MGR
WAL_MGR --> FS_FAC
LSM_ENG --> MEM_MGR
LSM_ENG --> ATOM_MGR
LSM_ENG --> COMP_ENG
VIPER_ENG --> ATOM_MGR
VIPER_ENG --> COMP_ENG
VIPER_ENG --> UNI_QUANT

' Index layer connections
AXIS_MGR --> IDX_FAC
IDX_FAC --> HNSW
IDX_FAC --> IVF
IDX_FAC --> FLAT
IDX_FAC --> PQ
IDX_FAC --> ANNOY

' Compute layer connections
LSM_ENG --> DIST
VIPER_ENG --> DIST
DIST --> SIMD
DIST --> GPU : optional
UNI_QUANT --> INT8
UNI_QUANT --> PQ_QUANT
UNI_QUANT --> BIN_QUANT
SIMD --> HW_DETECT
GPU --> HW_DETECT

' Metadata connections
META_STORE --> ROCKS_BE : default
META_STORE --> FILE_BE : alternative
META_STORE --> MEM_BE : testing
COL_REG --> META_STORE
IDX_REG --> META_STORE

' Monitoring connections
VEC_SVC ..> METRICS : reports
LSM_ENG ..> METRICS : reports
VIPER_ENG ..> METRICS : reports
AXIS_MGR ..> METRICS : reports
WAL_MGR ..> HEALTH : status
METRICS --> PERF : analysis

note top of VEC_SVC
  Central service handling
  all vector operations
end note

note right of VIPER_ENG
  Vector-optimized
  Parquet storage
  with ML clustering
end note

note bottom of UNI_QUANT
  Unified quantization
  supporting multiple
  compression levels
end note

note left of SI_COORD
  Coordinates storage
  and index updates
  per collection
end note

@enduml