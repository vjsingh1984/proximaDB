@startuml python-sdk-architecture
!theme plain
title ProximaDB Unified Python SDK - Proto-First Design 2025

package "Unified Python SDK" {
    package "Client Layer" {
        class UnifiedClient {
            - transport: Transport
            - config: ClientConfig
            - proto_models: ProtoModules
            + __init__(url: str, protocol: str = "auto", **kwargs)
            + create_collection(config: proto.CollectionConfig) -> proto.Collection
            + get_collection(collection_id: str) -> Optional[proto.Collection]
            + insert_vectors(collection_id: str, vectors: List[proto.VectorRecord]) -> proto.VectorOperationResponse
            + search_vectors(collection_id: str, query: proto.SearchQuery) -> proto.SearchResponse
            + batch_operations(operations: List[proto.Operation]) -> List[proto.Response]
            --
            <<87% Code Reduction>>
            6,467 → 800 lines
            Single API surface
            Proto-native operations
        }
        
        interface Transport {
            + execute_request(request: proto.Request) -> proto.Response
            + health_check() -> bool
            + get_connection_info() -> ConnectionInfo
        }
        
        class RestTransport implements Transport {
            - http_client: httpx.AsyncClient
            - base_url: str
            - auth_headers: Dict[str, str]
            + execute_request(request: proto.Request) -> proto.Response
            + _proto_to_json(proto_obj: Any) -> Dict[str, Any]
            + _json_to_proto(json_data: Dict, proto_class: Type) -> Any
            --
            JSON ↔ Proto conversion only
            Async HTTP client
            Automatic retry logic
        }
        
        class GrpcTransport implements Transport {
            - channel: grpc.aio.Channel
            - stub: proximadb_pb2_grpc.ProximaDBStub
            - call_options: grpc.CallOptions
            + execute_request(request: proto.Request) -> proto.Response
            + _setup_tls_channel() -> grpc.aio.Channel
            + _setup_compression() -> grpc.Compression
            --
            Direct proto passthrough
            Streaming support
            Connection pooling
        }
    }
    
    package "Proto-Generated Models" {
        class ProtoModels <<auto-generated>> {
            + proto.proximadb.Collection
            + proto.proximadb.CollectionConfig
            + proto.proximadb.VectorRecord
            + proto.proximadb.MetadataItem
            + proto.proximadb.SearchQuery
            + proto.proximadb.SearchResult
            + proto.proximadb.VectorOperationResponse
            + proto.proximadb.DistanceMetric <<enum>>
            + proto.proximadb.StorageEngine <<enum>>
            + proto.proximadb.IndexingAlgorithm <<enum>>
            + proto.proximadb.QuantizationLevel <<enum>>
            --
            <<Single Source of Truth>>
            Generated from .proto files
            Type-safe Python bindings
            Automatic serialization
        }
        
        class QuantizationModels <<new>> {
            + proto.proximadb.QuantizationConfig
            + proto.proximadb.QuantizationLevel
            + proto.proximadb.SearchOptimizationHints
            + proto.proximadb.TwoStageSearchConfig
            + proto.proximadb.ClusteringHints
            --
            Full quantization support
            Performance optimization
        }
    }
    
    package "Configuration" {
        class ClientConfig {
            + url: str
            + protocol: str = "auto"  # auto, rest, grpc
            + api_key: Optional[str]
            + timeout: float = 30.0
            + max_retries: int = 3
            + compression: bool = True
            + tls_verify: bool = True
            + connection_pool_size: int = 10
            --
            Environment variable support
            Auto protocol detection
        }
        
        class ConnectionManager {
            + create_transport(config: ClientConfig) -> Transport
            + _detect_best_protocol(url: str) -> str
            + _setup_connection_pool(config: ClientConfig) -> Any
            + _validate_connection(transport: Transport) -> bool
            --
            Smart protocol selection
            Connection health monitoring
        }
    }
    
    package "Utilities" {
        class ProximaDBExceptions {
            + ProximaDBError
            + CollectionNotFoundError
            + VectorValidationError
            + SearchTimeoutError
            + QuantizationError
            + StorageEngineError
            + ProtoSerializationError
            --
            Rich error context
            Proto-aware error handling
        }
        
        class VectorUtils {
            + validate_vector_dimensions(vectors: List[List[float]]) -> bool
            + normalize_vectors(vectors: List[List[float]]) -> List[List[float]]
            + convert_numpy_to_proto(array: np.ndarray) -> List[proto.VectorRecord]
            + batch_vectors(vectors: List[proto.VectorRecord], batch_size: int) -> Iterator
            --
            NumPy integration
            Automatic type conversion
            Batch processing helpers
        }
    }
}

' Relationships - Unified Architecture
UnifiedClient --> Transport : uses
RestTransport ..|> Transport
GrpcTransport ..|> Transport
UnifiedClient --> ProtoModels : proto-native
UnifiedClient --> QuantizationModels : optimization
ConnectionManager --> Transport : creates
ConnectionManager --> ClientConfig : configures
UnifiedClient --> VectorUtils : vector processing
UnifiedClient --> ProximaDBExceptions : error handling

package "Usage Examples" {
    note as usage_example
        **Unified Client Usage**
        ```python
        from proximadb import UnifiedClient, proto
        
        # Auto-detect best protocol
        client = UnifiedClient("https://api.proximadb.com")
        
        # Create collection with quantization
        config = proto.CollectionConfig(
            name="embeddings",
            dimension=768,
            distance_metric=proto.DistanceMetric.COSINE,
            storage_engine=proto.StorageEngine.VIPER,
            quantization_config=proto.QuantizationConfig(
                level=proto.QuantizationLevel.PQ8
            )
        )
        collection = client.create_collection(config)
        
        # Insert vectors with metadata
        vectors = [
            proto.VectorRecord(
                vector=[0.1, 0.2, ...],
                metadata=[
                    proto.MetadataItem(key="category", value="tech"),
                    proto.MetadataItem(key="year", value="2025")
                ]
            )
        ]
        client.insert_vectors(collection.id, vectors)
        
        # Search with optimization hints
        query = proto.SearchQuery(
            query_vector=[0.1, 0.2, ...],
            k=10,
            metadata_filters={"category": "tech"},
            optimization_hints=proto.SearchOptimizationHints(
                two_stage_search=True,
                candidate_multiplier=3.0
            )
        )
        results = client.search_vectors(collection.id, query)
        ```
    end note
}

