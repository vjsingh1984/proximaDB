@startuml proximadb-deployment-2025
!theme plain
title ProximaDB Production Deployment Architecture - 2025

!define CLOUD_COLOR #E8F4FD
!define PROXIMADB_COLOR #4A90E2
!define STORAGE_COLOR #F5F5F5
!define NETWORK_COLOR #E8F8E8

package "Production Environment" {
    package "Load Balancer Layer" <<NETWORK_COLOR>> {
        node "HAProxy / Nginx" as lb {
            [REST Endpoint :80/443]
            [gRPC Endpoint :5679]
            [Health Check :8080]
        }
    }
    
    package "ProximaDB Cluster" <<PROXIMADB_COLOR>> {
        node "ProximaDB Node 1" as node1 {
            component "Multi-Server" as ms1 {
                [REST Server :5678]
                [gRPC Server :5679]
                [Unified Handlers]
            }
            component "Services" as svc1 {
                [VectorService]
                [CollectionService]
                [AssignmentService]
            }
            component "Storage Engines" as storage1 {
                [VIPER Engine]
                [LSM Engine]
                [WAL Manager]
            }
        }
        
        node "ProximaDB Node 2" as node2 {
            component "Multi-Server" as ms2 {
                [REST Server :5678]
                [gRPC Server :5679]
                [Unified Handlers]
            }
            component "Services" as svc2 {
                [VectorService]
                [CollectionService]
                [AssignmentService]
            }
            component "Storage Engines" as storage2 {
                [VIPER Engine]
                [LSM Engine]
                [WAL Manager]
            }
        }
        
        node "ProximaDB Node 3" as node3 {
            component "Multi-Server" as ms3 {
                [REST Server :5678]
                [gRPC Server :5679]
                [Unified Handlers]
            }
            component "Services" as svc3 {
                [VectorService]
                [CollectionService]
                [AssignmentService]
            }
            component "Storage Engines" as storage3 {
                [VIPER Engine]
                [LSM Engine]
                [WAL Manager]
            }
        }
    }
    
    package "Multi-Disk Storage Layer" <<STORAGE_COLOR>> {
        node "Node 1 Storage" {
            database "Disk 1 (NVMe)" as disk1_1 {
                folder "WAL Files" as wal1_1
                folder "LSM SSTables" as lsm1_1
            }
            database "Disk 2 (SSD)" as disk1_2 {
                folder "VIPER Parquet" as viper1_2
                folder "ML Clusters" as cluster1_2
            }
            database "Disk 3 (HDD)" as disk1_3 {
                folder "Compacted Data" as compact1_3
                folder "Archived Vectors" as archive1_3
            }
        }
        
        node "Node 2 Storage" {
            database "Disk 1 (NVMe)" as disk2_1 {
                folder "WAL Files" as wal2_1
                folder "LSM SSTables" as lsm2_1
            }
            database "Disk 2 (SSD)" as disk2_2 {
                folder "VIPER Parquet" as viper2_2
                folder "ML Clusters" as cluster2_2
            }
            database "Disk 3 (HDD)" as disk2_3 {
                folder "Compacted Data" as compact2_3
                folder "Archived Vectors" as archive2_3
            }
        }
        
        node "Node 3 Storage" {
            database "Disk 1 (NVMe)" as disk3_1 {
                folder "WAL Files" as wal3_1
                folder "LSM SSTables" as lsm3_1
            }
            database "Disk 2 (SSD)" as disk3_2 {
                folder "VIPER Parquet" as viper3_2
                folder "ML Clusters" as cluster3_2
            }
            database "Disk 3 (HDD)" as disk3_3 {
                folder "Compacted Data" as compact3_3
                folder "Archived Vectors" as archive3_3
            }
        }
    }
    
    package "Cloud Storage Integration" <<CLOUD_COLOR>> {
        cloud "S3 Compatible" as s3 {
            [Backup Parquet Files]
            [Long-term Archives]
            [Disaster Recovery]
        }
        
        cloud "Azure Blob Storage" as azure {
            [Cross-region Replication]
            [Cold Storage Tier]
        }
        
        cloud "Google Cloud Storage" as gcs {
            [ML Pipeline Integration]
            [BigQuery Export]
        }
    }
    
    package "Metadata Management" {
        node "Metadata Cluster" {
            database "Metadata Store" as metadata {
                [Collections Metadata (.proto)]
                [Index Configurations]
                [Storage Assignments]
                [Operation Logs]
            }
            
            component "Metadata Backends" as backends {
                [Filestore Backend]
                [RocksDB Backend]
                [Distributed Consensus]
            }
        }
    }
    
    package "Monitoring & Observability" {
        node "Monitoring Stack" {
            component "Metrics Collection" as metrics {
                [Prometheus Exporter]
                [OpenTelemetry Traces]
                [Custom Metrics]
            }
            
            component "Alerting" as alerts {
                [Performance Degradation]
                [Storage Capacity]
                [Search Latency]
                [WAL Flush Failures]
            }
        }
        
        node "Logging & Analytics" {
            database "Log Aggregation" as logs {
                [Structured Logs]
                [Proto Message Traces]
                [Performance Analytics]
            }
        }
    }
}

package "Client Applications" {
    component "AI/ML Applications" as ai_apps {
        [Vector Embeddings]
        [Similarity Search]
        [RAG Systems]
        [Recommendation Engines]
    }
    
    component "Web Applications" as web_apps {
        [REST API Clients]
        [JavaScript SDKs]
        [Mobile Applications]
    }
    
    component "Data Pipelines" as pipelines {
        [Batch Vector Ingestion]
        [Real-time Streaming]
        [ETL Processes]
        [gRPC Clients]
    }
}

' Connections
ai_apps --> lb : REST/gRPC
web_apps --> lb : REST API
pipelines --> lb : gRPC Streaming

lb --> node1 : Load Balanced
lb --> node2 : Load Balanced  
lb --> node3 : Load Balanced

node1 --> disk1_1 : NVMe (Hot)
node1 --> disk1_2 : SSD (Warm)
node1 --> disk1_3 : HDD (Cold)

node2 --> disk2_1 : NVMe (Hot)
node2 --> disk2_2 : SSD (Warm)
node2 --> disk2_3 : HDD (Cold)

node3 --> disk3_1 : NVMe (Hot)
node3 --> disk3_2 : SSD (Warm)
node3 --> disk3_3 : HDD (Cold)

node1 --> metadata : Collection Ops
node2 --> metadata : Collection Ops
node3 --> metadata : Collection Ops

storage1 --> s3 : Backup/Archive
storage2 --> azure : Replication
storage3 --> gcs : ML Integration

node1 --> metrics : Telemetry
node2 --> metrics : Telemetry
node3 --> metrics : Telemetry

metrics --> alerts : Notifications
metrics --> logs : Analysis

note top of lb
**Load Balancing Strategy**
• Health-check based routing
• Protocol-aware balancing
• Session affinity for gRPC
• TLS termination
end note

note right of node1
**Proto-First Benefits**
• Zero double serialization
• 85% code reduction
• Protocol-agnostic handlers
• Native proto storage
end note

note bottom of disk1_1
**Tiered Storage Strategy**
• NVMe: WAL + Hot data (< 1 day)
• SSD: Active vectors (< 30 days)
• HDD: Compacted/archived (> 30 days)
• Cloud: Long-term backup
end note

note right of metadata
**Collection-Based Partitioning**
• Independent scaling per collection
• Proto-native metadata storage
• .proto file extensions
• Unified atomic coordinator
end note

note top of metrics
**Observability Stack**
• Sub-100ms search latency SLA
• Storage-aware performance tracking
• Proto message tracing
• Real-time alerting
end note

@enduml