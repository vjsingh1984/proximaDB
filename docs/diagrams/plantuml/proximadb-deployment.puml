@startuml ProximaDB Deployment Diagram
!theme plain
title ProximaDB - Deployment Architecture

!define ICONURL https://raw.githubusercontent.com/tupadr3/plantuml-icon-font-sprites/v2.4.0
!includeurl ICONURL/common.puml
!includeurl ICONURL/devicons/rust.puml
!includeurl ICONURL/devicons/docker.puml
!includeurl ICONURL/font-awesome-5/database.puml
!includeurl ICONURL/font-awesome-5/server.puml

node "Client Applications" <<client>> {
  component "Python SDK" as PY_SDK {
    [REST Client]
    [gRPC Client]
  }
  
  component "Other SDKs" as OTHER_SDK {
    [Go Client]
    [Java Client]
    [Node.js Client]
  }
}

cloud "Load Balancer" as LB {
  component "NGINX/HAProxy" as PROXY
}

node "ProximaDB Cluster" <<cluster>> {
  node "ProximaDB Node 1" <<server>> {
    component "ProximaDB Server" as SVR1 {
      [REST API\n:5678] as REST1
      [gRPC API\n:5679] as GRPC1
      [Vector Service] as VS1
      [Collection Service] as CS1
    }
    
    database "Local Storage" as LS1 {
      folder "WAL" as WAL1 {
        file "wal_segments" as WALS1
      }
      folder "LSM" as LSM1 {
        file "sstables" as SST1
      }
      folder "VIPER" as VPR1 {
        file "parquet_files" as PQ1
      }
    }
  }
  
  node "ProximaDB Node 2" <<server>> {
    component "ProximaDB Server" as SVR2 {
      [REST API\n:5678] as REST2
      [gRPC API\n:5679] as GRPC2
      [Vector Service] as VS2
      [Collection Service] as CS2
    }
    
    database "Local Storage" as LS2 {
      folder "WAL" as WAL2
      folder "LSM" as LSM2
      folder "VIPER" as VPR2
    }
  }
  
  node "ProximaDB Node 3" <<server>> {
    component "ProximaDB Server" as SVR3 {
      [REST API\n:5678] as REST3
      [gRPC API\n:5679] as GRPC3
      [Vector Service] as VS3
      [Collection Service] as CS3
    }
    
    database "Local Storage" as LS3 {
      folder "WAL" as WAL3
      folder "LSM" as LSM3
      folder "VIPER" as VPR3
    }
  }
}

database "Metadata Store" <<shared>> {
  component "RocksDB/FileStore" as META {
    [Collection Metadata]
    [Index Configurations]
    [System Settings]
  }
}

cloud "Object Storage" <<storage>> {
  component "S3/GCS/Azure" as OBJ {
    folder "Backups" as BACKUP
    folder "Archived Data" as ARCHIVE
    folder "ML Models" as MODELS
  }
}

node "Monitoring Stack" <<monitoring>> {
  component "Prometheus" as PROM
  component "Grafana" as GRAF
  component "Jaeger" as JAEG
}

' Client connections
PY_SDK --> LB : HTTPS/gRPC
OTHER_SDK --> LB : HTTPS/gRPC

' Load balancer distribution
LB --> REST1 : HTTP
LB --> REST2 : HTTP
LB --> REST3 : HTTP
LB --> GRPC1 : gRPC
LB --> GRPC2 : gRPC
LB --> GRPC3 : gRPC

' Internal component connections
REST1 --> VS1
GRPC1 --> VS1
VS1 --> CS1
VS1 --> LS1

REST2 --> VS2
GRPC2 --> VS2
VS2 --> CS2
VS2 --> LS2

REST3 --> VS3
GRPC3 --> VS3
VS3 --> CS3
VS3 --> LS3

' Metadata store connections
CS1 ..> META : Read/Write
CS2 ..> META : Read/Write
CS3 ..> META : Read/Write

' Object storage connections
SVR1 ..> OBJ : Backup/Archive
SVR2 ..> OBJ : Backup/Archive
SVR3 ..> OBJ : Backup/Archive

' Monitoring connections
SVR1 ..> PROM : Metrics
SVR2 ..> PROM : Metrics
SVR3 ..> PROM : Metrics
PROM --> GRAF : Visualization
SVR1 ..> JAEG : Traces
SVR2 ..> JAEG : Traces
SVR3 ..> JAEG : Traces

note top of LB
  Load Balancing Strategies:
  - Round Robin
  - Least Connections
  - Consistent Hashing
  - Health Check Based
end note

note right of META
  Metadata Replication:
  - Master-Slave
  - Multi-Master
  - Raft Consensus
end note

note bottom of OBJ
  Storage Tiers:
  - Hot: Local NVMe
  - Warm: Network SSD
  - Cold: Object Storage
end note

@enduml