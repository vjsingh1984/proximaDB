@startuml ProximaDB Insert Sequence
!theme plain
title ProximaDB - Vector Insert Sequence Diagram

participant "Client" as C
participant "REST/gRPC\nHandler" as H
participant "Vector\nService" as VS
participant "Collection\nService" as CS
participant "WAL\nManager" as WAL
participant "Batch\nFactory" as BF
participant "AXIS\nManager" as AXIS
participant "Storage\nEngine" as SE

== Insert Request Flow ==

C -> H: POST /api/v1/vector/batch
activate H
H -> H: Parse JSON/Proto request
H -> H: Extract vectors & metadata

H -> VS: insert_vectors_batch(\ncollection_id, vectors)
activate VS

VS -> CS: get_collection(collection_id)
activate CS
CS -> CS: Load from metadata store
CS --> VS: Collection config
deactivate CS

VS -> VS: Validate vector dimensions
VS -> VS: Generate vector IDs if missing
VS -> VS: Set timestamps

== WAL Write ==

VS -> BF: create_batch(vectors,\ncollection_config)
activate BF
BF -> BF: Select serialization format\n(Avro/Bincode)
BF -> BF: Compress if enabled
BF --> VS: Serialized batch
deactivate BF

VS -> WAL: append_batch(collection_id,\nserialized_batch)
activate WAL
WAL -> WAL: Write to memory buffer
WAL -> WAL: Update sequence numbers

alt Sync Mode = Immediate
  WAL -> WAL: fsync() to disk
else Sync Mode = Batch
  WAL -> WAL: Queue for batch sync
end

WAL --> VS: Write confirmation
deactivate WAL

== Index Update ==

VS -> AXIS: update_indexes(\ncollection_id, vectors)
activate AXIS

AXIS -> AXIS: Get active indexes\nfor collection

loop For each index
  AXIS -> AXIS: Update index structure\n(HNSW/IVF/Flat)
  AXIS -> AXIS: Apply quantization\nif configured
end

AXIS --> VS: Index update status
deactivate AXIS

== Response ==

VS -> VS: Calculate metrics\n(write time, index time)
VS --> H: Insert response
deactivate VS

H -> H: Format response\n(success, metrics)
H --> C: HTTP 200 OK
deactivate H

== Background Flush ==

WAL -> SE: flush_to_storage()
activate SE
note over SE
  Async background process
  triggers based on:
  - Time interval
  - Batch size
  - Memory pressure
end note

SE -> SE: Deserialize vectors
SE -> SE: Write to LSM/VIPER
SE -> WAL: Mark segments flushed
deactivate SE

== Error Scenarios ==

alt Dimension Mismatch
  VS --> H: Error: Invalid dimension
  H --> C: HTTP 400 Bad Request
end

alt Collection Not Found
  CS --> VS: Error: Not found
  VS --> H: Error: Collection not found
  H --> C: HTTP 404 Not Found
end

alt WAL Full
  WAL --> VS: Error: WAL full
  VS --> H: Error: System overloaded
  H --> C: HTTP 503 Service Unavailable
end

note right of BF
  Batch Factory optimizations:
  - Zero-copy serialization
  - Adaptive compression
  - Schema evolution support
end note

note right of AXIS
  AXIS features:
  - Multi-index support
  - Async index building
  - Quantization integration
end note

@enduml