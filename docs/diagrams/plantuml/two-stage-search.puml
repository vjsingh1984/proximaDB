@startuml two-stage-search
!theme plain
skinparam backgroundColor #FEFEFE
skinparam activityBackgroundColor #E3F2FD
skinparam activityBorderColor #1976D2

title Two-Stage Search Algorithm

start

:Receive search request;
note right
  Query vector
  k = 10
  candidate_multiplier = 3.0
end note

partition "Stage 1: Quantized Filtering" {
  :Load quantized vectors;
  note right
    Reduced memory bandwidth
    (1/8 to 1/32 of original)
  end note
  
  :Compute approximate distances;
  note right
    Using SIMD operations
    on quantized data
  end note
  
  :Select k × multiplier candidates;
  note right
    10 × 3.0 = 30 candidates
  end note
  
  if (Metadata filters?) then (yes)
    :Apply metadata filtering;
  else (no)
  endif
}

partition "Stage 2: Full Precision Verification" {
  :Load FP32 vectors for candidates;
  note right
    Only 30 vectors loaded
    instead of entire dataset
  end note
  
  :Compute exact distances;
  note right
    High precision calculation
    for final accuracy
  end note
  
  :Rerank candidates;
  
  :Select final top-k results;
}

:Return results;
note right
  10 results with
  100% accuracy
end note

stop

@enduml