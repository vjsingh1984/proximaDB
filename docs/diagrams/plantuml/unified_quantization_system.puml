@startuml unified_quantization_system
!define SPACING 1.5
skinparam componentStyle rectangle
skinparam backgroundColor #F7F7F7
skinparam component {
    BackgroundColor<<compute>> #E8F4FD
    BackgroundColor<<storage>> #FFF4E6
    BackgroundColor<<hardware>> #E8F5E9
    BackgroundColor<<search>> #FCE4EC
    BorderColor #333333
    FontSize 12
}

title Unified Quantization System Architecture\n(Phase 4 Implementation)

package "Compute Module" <<compute>> {
    component "UnifiedQuantizationEngine" as UQE
    note right of UQE
        - Async quantize/dequantize
        - Distance calculation
        - Batch processing
        - Codebook management
    end note
    
    component "UnifiedQuantizationLevel" as UQL
    note left of UQL
        - None (FP32)
        - Uniform (1-32 bits)
        - ProductQuantization
        - Scalar (INT8/INT16)
        - Binary (1 bit)
        - Custom
    end note
    
    component "UnifiedDistanceCompute" as UDC
    note right of UDC
        - Hardware acceleration
        - Normalized semantics
        - Batch optimization
    end note
    
    component "CodebookStore" as CS
    note left of CS
        - Store/retrieve codebooks
        - LSM/VIPER backed
        - Async interface
    end note
}

package "Storage Engines" <<storage>> {
    component "VIPER Engine" as VIPER
    note right of VIPER
        - Parquet columnar storage
        - Pre-computed quantization
        - Column projection
    end note
    
    component "LSM Engine" as LSM
    note left of LSM
        - SSTable storage
        - Quantized memtables
        - Bloom filters
    end note
    
    component "WAL" as WAL
    note right of WAL
        - Batch processing
        - Zero-copy Avro
        - Quantization on flush
    end note
}

package "Hardware Acceleration" <<hardware>> {
    component "SIMD (x86)" as SIMD
    note right of SIMD : AVX2, AVX512
    
    component "NEON (ARM)" as NEON
    note left of NEON : ARM SIMD
    
    component "GPU Backends" as GPU
    note right of GPU
        - CUDA (NVIDIA)
        - ROCm (AMD)
        - MPS (Apple)
    end note
}

package "Search Strategies" <<search>> {
    component "Two-Stage Search" as TSS
    note right of TSS
        Stage 1: Quantized filtering
        Stage 2: FP32 refinement
        Configurable multiplier
    end note
    
    component "Column Projection" as CP
    note left of CP
        - Query-aware selection
        - 50-80% I/O reduction
        - Automatic format detection
    end note
}

' Relationships
UQE --> UQL : uses
UQE --> UDC : delegates
UQE --> CS : stores/retrieves

VIPER --> UQE : quantize on flush
LSM --> UQE : quantize on compaction
WAL --> UQE : batch quantization

UDC --> SIMD : x86 optimization
UDC --> NEON : ARM optimization
UDC --> GPU : GPU acceleration

TSS --> UQE : Stage 1 search
TSS --> CP : column selection
CP --> VIPER : optimized I/O

' Flow annotations
note bottom of UQE
    **Key Benefits**
    • Storage-agnostic interface
    • Hardware acceleration
    • Progressive quantization
    • Efficient batch processing
end note

@enduml