graph TB
    subgraph "Azure Landing Zone Architecture"
        subgraph "Management Group Hierarchy"
            RootMG[Root Management Group<br/>Azure Policy Governance]
            PlatformMG[Platform Management Group<br/>Core Infrastructure]
            LandingZoneMG[Landing Zone Management Group<br/>Application Workloads]
        end
        
        subgraph "Connectivity Subscription"
            VWANHub[Virtual WAN Hub<br/>$125/mo - Hub Infrastructure<br/>Landing Zone Standard]
            AzureFirewall[Azure Firewall<br/>Security Gateway]
        end
        
        subgraph "ProximaDB Production Subscription"
            ProdVNet[Production VNet<br/>10.1.0.0/16]
            ProximaDB[ProximaDB Cluster<br/>Standard_D8s_v5 instances]
            ServiceEndpoint[Service Endpoint<br/>FREE - Landing Zone Optimized]
            PrivateEndpoint[Private Endpoints<br/>$7.20/mo each]
        end
        
        subgraph "Application Subscription"
            AppVNet[Application VNet<br/>10.2.0.0/16]
            WebApps[App Services<br/>API Management, Functions]
        end
        
        subgraph "Data Subscription"
            DataVNet[Data VNet<br/>10.3.0.0/16]
            DataServices[Data Platform<br/>Synapse, Data Factory, Power BI]
        end
        
        BlobStorage[Azure Storage Account<br/>Landing Zone Compliant<br/>GRS Replication, Lifecycle Policies]
    end
    
    %% Landing Zone Governance
    RootMG -.->|Policies| PlatformMG
    RootMG -.->|Policies| LandingZoneMG
    PlatformMG -.->|Manages| VWANHub
    LandingZoneMG -.->|Manages| ProdVNet
    
    %% Network Architecture  
    ProdVNet -.->|Hub Connection<br/>Included in $125/mo| VWANHub
    AppVNet -.->|Spoke Connection<br/>Included| VWANHub
    DataVNet -.->|Spoke Connection<br/>Included| VWANHub
    
    %% Optimized Data Flow
    ProximaDB -->|FREE via Service Endpoint<br/>Landing Zone Pattern| ServiceEndpoint
    ServiceEndpoint -->|Microsoft Backbone<br/>No hub charges| BlobStorage
    
    ProximaDB -->|Cross-subscription via Hub<br/>$0.02/GB| VWANHub
    VWANHub -->|Secure routing| WebApps
    VWANHub -->|Analytics access| DataServices
    
    style ServiceEndpoint fill:#90ee90
    style RootMG fill:#e6f3ff
    style VWANHub fill:#ffe4b5
    style BlobStorage fill:#ffd700
    
    classDef landingzone fill:#e6f3ff,stroke:#0078d4,stroke-width:2px  
    classDef free fill:#90ee90,stroke:#2d7a2d,stroke-width:2px
    classDef paid fill:#ffcccb,stroke:#8b0000,stroke-width:2px
    
    class RootMG,PlatformMG,LandingZoneMG,AzureFirewall landingzone
    class ServiceEndpoint free
    class VWANHub,PrivateEndpoint paid