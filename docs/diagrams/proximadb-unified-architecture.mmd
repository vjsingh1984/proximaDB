        end
    end
    
    subgraph StorageArchitecture[" Dual Storage Architecture"]
        direction TB
        StorageCoordinator[" Storage Coordinator<br/> storage/engine.rs<br/> Intelligent Engine Selection<br/> Workload-Based Routing"]
        
        subgraph MemoryLayer[" Memory Management Layer"]
