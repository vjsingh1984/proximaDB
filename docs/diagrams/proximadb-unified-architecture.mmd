            GCSBackend["🔴 Google Cloud Storage<br/> filesystem/gcs.rs<br/> GCS SDK Integration"]
            LocalBackend["💻 Local Filesystem<br/> filesystem/local.rs<br/> POSIX Compliance"]
        end
    end
    
    subgraph AdvancedFeatures[" Advanced Enterprise Features"]
        direction TB
        MVCCSystem[" MVCC System<br/> core/search/results.rs<br/> Version Continuity Validation<br/>⏰ Timestamp-based Resolution<br/> Tombstone Handling<br/> Multi-Version Concurrency"]
        
        Quantization[" Quantization Engine<br/> compute/quantization/<br/> 80% Memory Reduction<br/> INT8/INT4 Support<br/> Auto-Selection Strategies"]
        
        Compression[" Vector Compression<br/> core/serialization/<br/> Bytemuck Zero-Copy<br/> ZSTD Compression<br/> 5-10x Serialization Speedup<br/> 30-50% Storage Reduction"]
    end
    
    %% ===========================================
    %% Connection Flow - Optimized Layout
    %% ===========================================
    
    %% Client to API Layer
    PythonSDK --> RestAPI
    PythonSDK --> GrpcAPI
    
    %% API to Network Layer
    RestAPI --> MultiServer
    GrpcAPI --> MultiServer
    SQLEngine --> SharedServices
    
    MultiServer --> SharedServices
    SharedServices --> UnifiedHandlers
    
    %% Network to Core Services
    UnifiedHandlers --> DirectVectorSvc
    UnifiedHandlers --> CollectionSvc
    
    %% Core Service Optimizations
    DirectVectorSvc --> VectorMemPool
    DirectVectorSvc --> StorageCoordinator
    SQLEngine --> QueryCache
    CollectionSvc --> StorageCoordinator
    
    %% Storage Architecture Flow
    StorageCoordinator --> WriteBufferWrapper
    StorageCoordinator --> ViperEngine
    StorageCoordinator --> SstEngine
    
    WriteBufferWrapper --> WriteBufferMgr
    WriteBufferMgr --> AtomicCoordinator
    
    %% Engine to Search Optimization
    ViperEngine --> ViperSearch
    SstEngine --> SstSearch
    
    %% Indexing Integration
    StorageCoordinator --> AxisManager
    AxisManager --> IndexTypes
    
    %% Advanced Features Integration
    ViperSearch --> MVCCSystem
    SstSearch --> MVCCSystem
    DirectVectorSvc --> HardwareAccel
    HardwareAccel --> Quantization
    ViperEngine --> Compression
    SstEngine --> Compression
    
    %% Persistence Layer
    AtomicCoordinator --> S3Backend
    AtomicCoordinator --> AzureBackend
    AtomicCoordinator --> GCSBackend
    AtomicCoordinator --> LocalBackend
    
