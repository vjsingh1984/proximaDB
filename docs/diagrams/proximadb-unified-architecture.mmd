            SstSearch[" SST Search Engine<br/> sst/unified_search_engine.rs<br/> Three-Stage Filter Pipeline<br/> Bloom Pre-filtering (99%)<br/> MVCC Resolution<br/> Row-level Optimization"]
        end
    end
    
    subgraph IndexingSystem[" AXIS Adaptive Indexing"]
        direction TB
        AxisManager[" AXIS Manager<br/> index/axis/manager.rs<br/> Adaptive Index Selection<br/> Performance Monitoring<br/> Zero-Downtime Switching"]
        
        IndexTypes[" Multi-Algorithm Support<br/> index/axis/<br/> HNSW (Precision)<br/> IVF (Scale)<br/> LSH (Speed)<br/> Annoy (Static)<br/> Auto-Selection Based on Data"]
