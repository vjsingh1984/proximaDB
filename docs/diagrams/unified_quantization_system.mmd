graph TB
    subgraph "Unified Quantization Engine"
        UQE[UnifiedQuantizationEngine<br/>Single Entry Point]
        
        subgraph "Quantization Types"
            BINARY[Binary Quantization<br/>1-bit compression]
            SCALAR[Scalar Quantization<br/>INT8/INT16]
            PQ[Product Quantization<br/>PQ4/PQ8]
        end
        
        subgraph "Hardware Acceleration"
            SIMD[SIMD Detection<br/>AVX/SSE/NEON]
            GPU[GPU Support<br/>CUDA/ROCm/MPS]
            CACHE[CPU Cache<br/>L1/L2/L3 Detection]
        end
    end
    
    subgraph "Storage Integration"
        VIPER_Q[VIPER Quantization<br/>Column Projection]
        LSM_Q[LSM Quantization<br/>Row-based Storage]
        WAL_Q[WAL Quantization<br/>In-memory Cache]
    end
    
    subgraph "Search Optimization"
        TWO_STAGE[Two-Stage Search<br/>Candidate Selection]
        REFINE[Refinement<br/>FP32 Accuracy]
        MULTIPLIER[Candidate Multiplier<br/>Default: 3x]
    end
    
    UQE --> BINARY
    UQE --> SCALAR
    UQE --> PQ
    
    UQE --> SIMD
    UQE --> GPU
    UQE --> CACHE
    
    BINARY --> VIPER_Q
    SCALAR --> VIPER_Q
    PQ --> VIPER_Q
    
    BINARY --> LSM_Q
    SCALAR --> LSM_Q
    PQ --> LSM_Q
    
    VIPER_Q --> TWO_STAGE
    LSM_Q --> TWO_STAGE
    WAL_Q --> TWO_STAGE
    
    TWO_STAGE --> REFINE
    TWO_STAGE --> MULTIPLIER
    
    style UQE fill:#f9f,stroke:#333,stroke-width:2px
    style TWO_STAGE fill:#bbf,stroke:#333,stroke-width:2px
