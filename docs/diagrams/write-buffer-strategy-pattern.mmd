%%{init: {'theme':'base', 'themeVariables': { 'primaryColor':'#fff', 'primaryBorderColor':'#333', 'fontFamily':'Arial', 'fontSize':'14px'}}}%%
classDiagram
    class WalManager {
        <<orchestrator>>
        -serializers: HashMap~String, WalSerializationStrategy~
        -memtable_manager: WalMemtableManager
        -disk_manager: WalDiskManager
        -recovery_manager: WalRecoveryManager
        -flush_coordinator: FlushCoordinator
        +write_vectors(collection_id, vectors, format)
        +search_vectors(query)
        +recover_all()
    }
    
    class WalSerializationStrategy {
        <<interface>>
        +serialize(vectors) Vec~u8~
        +deserialize(data) Vec~VectorRecord~
        +format_name() str
    }
    
    class ProtoWalSerializer {
        +serialize(vectors)
        +deserialize(data)
        +format_name() "proto"
    }
    note for ProtoWalSerializer "Native protobuf format"
    
    class AvroWalSerializer {
        +serialize(vectors)
        +deserialize(data)
        +format_name() "avro"
    }
    note for AvroWalSerializer "Schema evolution support"
    
    class BincodeWalSerializer {
        +serialize(vectors)
        +deserialize(data)
        +format_name() "bincode"
    }
    note for BincodeWalSerializer "High-performance binary"
    
    class WalMemtableManager {
        <<memory operations>>
        -memtable: GlobalPartitionedMemtable
        +add_vectors(collection_id, vectors)
        +search_vectors(query)
        +should_flush(collection_id)
        +clear_flushed(collection_id, sequences)
    }
    
    class WalDiskManager {
        <<disk operations>>
        -filesystem: FilesystemFactory
        -assignment_service: AssignmentService
        +write_wal_file(collection_id, data)
        +read_wal_files(collection_id)
        +delete_wal_file(path)
        +list_wal_files()
    }
    
    class WalRecoveryManager {
        <<recovery operations>>
        -disk_manager: WalDiskManager
        -serializers: HashMap~String, WalSerializationStrategy~
        -storage_engines: HashMap~String, UnifiedStorageEngine~
        +recover_all()
        +recover_collection(collection_id)
        +get_recovery_stats()
    }
    
    class DirectVectorService {
        <<entry point>>
        -wal_manager: WalManager
        -collection_service: CollectionService
        +insert_vectors(collection_id, vectors)
        +search_vectors(query)
    }
    
    class OptimizedWalWriter {
        <<performance layer>>
        -write_queue: Channel
        -assignment_cache: Cache
        -directory_cache: Cache
        +write_vectors(collection_id, vectors)
        +get_metrics()
    }
    note for OptimizedWalWriter "14,939 vectors/second"
    
    %% Inheritance relationships
    ProtoWalSerializer --|> WalSerializationStrategy : implements
    AvroWalSerializer --|> WalSerializationStrategy : implements
    BincodeWalSerializer --|> WalSerializationStrategy : implements
    
    %% Composition relationships
    DirectVectorService --> OptimizedWalWriter : uses
    DirectVectorService --> WalManager : delegates to
    WalManager *-- WalSerializationStrategy : contains multiple
    WalManager *-- WalMemtableManager : orchestrates
    WalManager *-- WalDiskManager : orchestrates
    WalManager *-- WalRecoveryManager : orchestrates
    WalRecoveryManager --> WalDiskManager : uses
    WalRecoveryManager --> WalSerializationStrategy : uses
    
    %% Clean separation of concerns shown in notes
    
    %% Architecture notes
    note for WalManager "Clean Separation of Concerns:\n\n• WalManager: Orchestration only\n• Serializers: Format conversion only\n• MemtableManager: Memory operations only\n• DiskManager: I/O operations only\n• RecoveryManager: Recovery logic only\n\nEach component has a single,\nwell-defined responsibility"
    
    note for OptimizedWalWriter "Performance Achievements:\n\n• Write: 14,939 vectors/second\n• Latency: 0.07ms per vector\n• Memory: 40% reduction\n• Recovery: 10x faster\n\nAchieved through:\n• OptimizedWalWriter batching\n• Clean component boundaries\n• Parallel recovery\n• Direct-to-storage recovery"
    
    note for WalSerializationStrategy "Serialization Formats:\n\nProto (Default):\n• Native protobuf\n• Zero overhead\n• Cross-language support\n\nAvro:\n• Schema evolution\n• Compression built-in\n• Legacy compatibility\n\nBincode:\n• Rust-native performance\n• Smallest size\n• Fastest serialization"