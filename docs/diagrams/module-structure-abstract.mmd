%%{init: {"theme":"neutral", "themeVariables": {"primaryColor":"#4A90E2","primaryBorderColor":"#2563eb","secondaryColor":"#5CB85C","tertiaryColor":"#F5A623","lineColor":"#64748b","background":"transparent","fontFamily":"-apple-system, BlinkMacSystemFont, Segoe UI, Roboto, sans-serif","fontSize":"14px"}}}%%

classDiagram
    %% High-Level Module Overview - Shows module relationships and boundaries
    
    class APIModule {
        <<Module>>
        api/
        +REST API Endpoints
        +gRPC Service Implementation
        +Request Validation
        +Protocol Conversion
        Protocol Abstraction Layer
        Client Interface
    }
    
    class VectorOperationsModule {
        <<Module>>
        services/vector_operations/
        +Vector Insert/Update/Delete
        +Vector Search & Analytics
        +Bulk Operations
        +MVCC Resolution
        Core Business Logic
        Performance Optimized
    }
    
    class StorageModule {
        <<Module>>
        storage/
        +Dual Storage Engines
        +Write-Ahead Logging
        +Compression & Quantization
        +Transaction Coordination
        Data Persistence Layer
        Hardware Optimized
    }
    
    class QueryModule {
        <<Module>>
        query/
        +SQL Query Processing
        +Filter Evaluation
        +Query Optimization
        +Hardware Acceleration
        Query Processing Layer
        SQL-First Design
    }
    
    class InfrastructureModule {
        <<Module>>
        infrastructure/
        +Hardware Capabilities
        +Cache Management
        +Metrics & Monitoring
        +Resource Coordination
        System Foundation Layer
        Platform Abstraction
    }
    
    %% Module Dependencies (High-Level Coupling)
    APIModule --> VectorOperationsModule : delegates to
    APIModule --> QueryModule : routes queries to
    
    VectorOperationsModule --> StorageModule : persists via
    QueryModule --> StorageModule : reads from
    QueryModule --> VectorOperationsModule : coordinates with
    
    StorageModule --> InfrastructureModule : utilizes
    VectorOperationsModule --> InfrastructureModule : utilizes
    QueryModule --> InfrastructureModule : utilizes
    
    %% Module Interfaces (Well-Defined Boundaries)
    VectorOperationsModule ..> APIModule : provides services
    StorageModule ..> VectorOperationsModule : provides storage
    InfrastructureModule ..> StorageModule : provides capabilities
    QueryModule ..> APIModule : provides query processing
    
    %% Professional styling
    classDef apiStyle fill:#e3f2fd,stroke:#1976d2,stroke-width:3px,color:#000000
    classDef businessStyle fill:#e8f5e8,stroke:#388e3c,stroke-width:3px,color:#000000
    classDef dataStyle fill:#fff3e0,stroke:#f57c00,stroke-width:3px,color:#000000
    classDef queryStyle fill:#f3e5f5,stroke:#7b1fa2,stroke-width:3px,color:#000000
    classDef infraStyle fill:#fce4ec,stroke:#c2185b,stroke-width:3px,color:#000000
    
    class APIModule apiStyle
    class VectorOperationsModule businessStyle
    class StorageModule dataStyle
    class QueryModule queryStyle
    class InfrastructureModule infraStyle