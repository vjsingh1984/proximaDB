graph TD
    Start([ProximaDB Compression Strategy<br/>Release 1.0]) --> Defaults
    
    subgraph Defaults["Default Configuration"]
        D1[ZSTD-3 Compression<br/>Balanced Performance]
        D2[Mixed Compression Support<br/>Gradual Migration]
        D3[Fixed Levels per Pattern<br/>Predictable Overhead]
    end
    
    Defaults --> EngineDecision{Storage Engine}
    
    EngineDecision -->|VIPER| ViperStrategy
    EngineDecision -->|SST| SstStrategy
    
    subgraph ViperStrategy["VIPER Compression Strategy"]
        V1[Standard Parquet Format<br/>Ecosystem Compatibility]
        V2[Pre/Post Transformations<br/>Not in Parquet Layer]
        V3[4-6 bit → Pack INT8<br/>Bytemuck for Max Compression]
        
        V1 --> VectorHandling{Vector Type}
        VectorHandling -->|FP32| VF1[List&lt;Float32&gt;<br/>ZSTD-3]
        VectorHandling -->|INT8/16| VF2[List&lt;Int8/16&gt;<br/>Native Storage]
        VectorHandling -->|4-6 bit| VF3[Pack to INT8<br/>81-87% reduction]
        VectorHandling -->|Sparse| VF4[COO Format<br/>70-90% reduction]
    end
    
    subgraph SstStrategy["SST Compression Strategy"]
        S1[Custom Serialization<br/>Maximum Control]
        S2[⭐ Adaptive Precision<br/>PRIMARY METHOD]
        S3[Universal Application<br/>Works for ALL Vectors]
        
        S1 --> S2
        S2 --> Benefits
        
        subgraph Benefits["Adaptive Precision Benefits"]
            B1[50-75% Storage Reduction]
            B2[-5% Read Performance]
            B3[Tunable Accuracy]
            B4[Predictable Overhead]
        end
        
        S3 --> Future{Future Optimizations}
        Future -.->|Phase 2| XOR[XOR Delta<br/>Sequential Vectors]
        Future -.->|Phase 3| Sparse[Sparse Format<br/>High Sparsity]
    end
    
    subgraph AccessPatterns["Access Pattern Configuration"]
        AP1[Archive: ZSTD-9]
        AP2[Write Heavy: LZ4]
        AP3[Read Heavy: None/ZSTD-1]
        AP4[Balanced: ZSTD-3]
    end
    
    ViperStrategy --> AccessPatterns
    SstStrategy --> AccessPatterns
    
    subgraph PythonSDK["Python SDK Defaults"]
        PY1[Smart Defaults by Engine]
        PY2[Dimension-Based Tuning]
        PY3[Out-of-Box Optimization]
        
        PY1 --> Examples
        subgraph Examples["Example Defaults"]
            E1[768D + VIPER → ZSTD-3]
            E2[1536D + SST → Adaptive Precision]
            E3[Sparse + Any → COO Format]
        end
    end
    
    AccessPatterns --> PythonSDK
    
    style Start fill:#e1f5fe
    style S2 fill:#ffeb3b,stroke:#f57c00,stroke-width:3px
    style Benefits fill:#c8e6c9
    style D1 fill:#fff9c4
    style D2 fill:#fff9c4
    style D3 fill:#fff9c4