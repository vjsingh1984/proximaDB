%%{init: {"theme":"neutral", "themeVariables": {"primaryColor":"#2563eb","primaryTextColor":"#ffffff","primaryBorderColor":"#1e40af","lineColor":"#64748b","secondaryColor":"#10b981","secondaryTextColor":"#ffffff","tertiaryColor":"#f59e0b","tertiaryTextColor":"#ffffff","background":"transparent","mainBkg":"#ffffff","secondBkg":"#f8fafc","textColor":"#1e293b","nodeTextColor":"#1e293b","fontFamily":"-apple-system, BlinkMacSystemFont, Segoe UI, Roboto, sans-serif","fontSize":"14px","clusterBkg":"#f1f5f9","clusterBorder":"#cbd5e1","edgeLabelBackground":"#ffffff"}}}%%
graph LR
    subgraph "SST1 File Format"
        M[Magic Bytes<br/>4 bytes<br/>'SST1']
        HL[Header Length<br/>4 bytes<br/>uint32]
        HD[Header Data<br/>Variable<br/>Metadata]
        BL[Bloom Length<br/>4 bytes<br/>uint32]
        BD[Bloom Filter<br/>Variable<br/>Probabilistic]
        IL[Index Length<br/>4 bytes<br/>uint32]
        ID[Index Data<br/>Variable<br/>B-Tree/Skip List]
        DB[Data Blocks<br/>Variable<br/>Compressed Vectors]
    end

    M --> HL
    HL --> HD
    HD --> BL
    BL --> BD
    BD --> IL
    IL --> ID
    ID --> DB

    style M fill:#ffcdd2
    style HL fill:#f8bbd0
    style HD fill:#e1bee7
    style BL fill:#d1c4e9
    style BD fill:#c5cae9
    style IL fill:#bbdefb
    style ID fill:#b3e5fc
    style DB fill:#b2dfdb