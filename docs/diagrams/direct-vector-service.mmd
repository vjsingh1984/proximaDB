            VIPER[ViperEngine<br/>Columnar Storage<br/>Predicate Pushdown]
            LSM[LsmEngine<br/>Atomic Compaction<br/>Metadata Filtering]
        end
        
        UAC[UnifiedAtomicCoordinator<br/>ACID Operations<br/>Staging Pattern]
    end

