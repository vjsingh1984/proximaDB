%%{init: {'theme':'neutral', 'themeVariables': {'primaryColor':'#3b82f6','primaryTextColor':'#1f2937','primaryBorderColor':'#6b7280','lineColor':'#9ca3af','secondaryColor':'#10b981','tertiaryColor':'#f59e0b','background':'transparent','mainBkg':'#f3f4f6','secondBkg':'#e5e7eb','textColor':'#1f2937'}}}%%

flowchart TB
    subgraph Client ["Client Layer"]
        A[Search Request<br/>collection_id, query_vector, k, metadata_filter]
        Z[Search Results<br/>Top k vectors with metadata]
    end
    
    subgraph Orchestration ["Orchestration Layer (VectorOperationsService)"]
        B[Query Planning<br/>Determine filter order]
        C[Result Cache Check]
        D[Orchestrate Search<br/>Parallel execution]
        E[Merge & Deduplicate<br/>MVCC resolution]
        F[Final Ranking<br/>Distance-based sort]
    end
    
    subgraph WAL ["WAL/Memtable Layer (Always Searched)"]
        G[Get Unflushed Batches]
        H[Bloom Filter Check<br/>95% metadata reduction]
        I[Distance Calculation<br/>SIMD/GPU accelerated]
    end
    
    subgraph Indexes ["AXIS Index Layer (Memory/Disk Tiered)"]
        J{Index Available?}
        JE{Index Evicted?}
        K[HNSW Search<br/>Memory: top layers<br/>Disk: bottom layers]
        L[IVF Search<br/>Memory: centroids<br/>Disk: posting lists]
        M[PQ Two-Stage<br/>1. Quantized codes<br/>2. FP32 rerank]
        FB[Fallback to Storage]
    end
    
    subgraph SST ["SST Engine (Row-based Storage)"]
        O[SST Three-Stage Filter]
        Q1[Stage 1: Bloom Filter<br/>Skip entire files]
        Q2[Stage 2: Index Block<br/>Skip data blocks]
        Q3[Stage 3: Row Filter<br/>In-memory metadata]
    end
    
    subgraph VIPER ["VIPER Engine (Columnar Storage)"]
        N[VIPER Columnar Search]
        P1[Predicate Pushdown<br/>Parquet statistics]
        P2[Column Pruning<br/>Load only needed]
        P3[Two-Stage Search<br/>Quantized → FP32]
    end
    
    %% Flow connections
    A --> B
    B --> C
    C -->|Cache Miss| D
    C -->|Cache Hit| Z
    
    %% WAL always searched
    D ==> G
    G --> H
    H -->|Pass Filter| I
    I -->|WAL Results| E
    
    %% Index path with eviction handling
    D ==> J
    J -->|Available| K
    J -->|Available| L
    J -->|Available| M
    J -->|Not Available| JE
    JE -->|Evicted| FB
    FB --> O
    FB --> N
    
    K -->|Index Results| E
    L -->|Index Results| E
    M -->|Reranked Results| E
    
    %% SST three-stage pipeline
    O --> Q1
    Q1 -->|Pass| Q2
    Q2 -->|Pass| Q3
    Q3 -->|SST Results| E
    
    %% VIPER columnar pipeline
    N --> P1
    P1 --> P2
    P2 --> P3
    P3 -->|VIPER Results| E
    
    %% Final merge and return
    E --> F
    F --> Z
    
    %% Styling
    style A fill:#e1f5fe
    style Z fill:#c8e6c9
    style H fill:#fff3e0
    style Q1 fill:#fff3e0
    style P1 fill:#fff3e0
    style M fill:#fce4ec
    style P3 fill:#fce4ec
    style E fill:#f3e5f5
    style JE fill:#ffccbc
    style FB fill:#ffccbc