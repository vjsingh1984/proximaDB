flowchart TD
    Start([Start: Choose Compression])
    Start --> Q1{What is your<br/>primary goal?}
    
    Q1 -->|Minimize Latency| Speed[Speed Priority]
    Q1 -->|Balance| Balanced[Balanced Approach]
    Q1 -->|Minimize Storage| Storage[Storage Priority]
    
    %% Speed Path
    Speed --> Q2{Vector<br/>Dimensions?}
    Q2 -->|< 512| LZ4_Low[LZ4<br/>No compression level]
    Q2 -->|512-1024| Snappy[Snappy<br/>No compression level]
    Q2 -->|> 1024| ZSTD1[ZSTD Level 1-2<br/>Fast compression]
    
    %% Balanced Path
    Balanced --> Q3{Storage<br/>Engine?}
    Q3 -->|SST| SST_Balanced
    Q3 -->|VIPER| VIPER_Balanced
    
    SST_Balanced --> Q4{Access<br/>Pattern?}
    Q4 -->|Random| ZSTD3[ZSTD Level 3<br/>4MB blocks]
    Q4 -->|Sequential| ZSTD6[ZSTD Level 6<br/>8MB blocks]
    
    VIPER_Balanced --> Q5{Query<br/>Type?}
    Q5 -->|Analytics| ZSTD_Quant[ZSTD Level 3-6<br/>+ INT8 Quantization]
    Q5 -->|Real-time| ZSTD_NoQuant[ZSTD Level 3<br/>No Quantization]
    
    %% Storage Path
    Storage --> Q6{Query<br/>Frequency?}
    Q6 -->|High| Storage_High
    Q6 -->|Medium| Storage_Medium
    Q6 -->|Low/Archive| Storage_Low
    
    Storage_High --> Q7{Engine?}
    Q7 -->|SST| Brotli4[Brotli Level 4-6<br/>8MB blocks]
    Q7 -->|VIPER| ZSTD9_PQ[ZSTD Level 9<br/>+ PQ8 Quantization]
    
    Storage_Medium --> Q8{Data Type?}
    Q8 -->|Dense Vectors| Brotli7[Brotli Level 7-9<br/>12MB blocks]
    Q8 -->|Text/Legacy| Gzip_Zlib[Gzip/Zlib Level 6<br/>Good compatibility]
    Q8 -->|Mixed Data| Bzip2[Bzip2 Level 5-7<br/>Balanced ratio]
    
    Storage_Low --> Q9{Extreme Compression?}
    Q9 -->|Maximum Ratio| LZMA[LZMA Level 6-9<br/>16MB blocks]
    Q9 -->|LZMA2 Based| XZ[XZ Level 6-9<br/>Better than LZMA]
    Q9 -->|Legacy Support| Deflate_Legacy[Deflate Level 6<br/>Raw compression]
    
    %% Recommendations
    LZ4_Low --> Rec1[Recommendation:<br/>2-3x compression<br/>< 2% latency impact]
    Snappy --> Rec2[Recommendation:<br/>2x compression<br/>< 3% latency impact]
    ZSTD1 --> Rec3[Recommendation:<br/>3x compression<br/>< 5% latency impact]
    
    ZSTD3 --> Rec4[Recommendation:<br/>3.8x compression<br/>6% latency impact]
    ZSTD6 --> Rec5[Recommendation:<br/>4.2x compression<br/>10% latency impact]
    
    ZSTD_Quant --> Rec6[Recommendation:<br/>8-16x compression<br/>15% latency impact]
    ZSTD_NoQuant --> Rec7[Recommendation:<br/>3.8x compression<br/>6% latency impact]
    
    Brotli4 --> Rec8[Recommendation:<br/>4.2x compression<br/>12% latency impact]
    ZSTD9_PQ --> Rec9[Recommendation:<br/>16-32x compression<br/>20% latency impact]
    
    Brotli7 --> Rec10[Recommendation:<br/>5x compression<br/>15% latency impact]
    ZSTD9 --> Rec11[Recommendation:<br/>4.5x compression<br/>12% latency impact]
    
    LZMA --> Rec12[Recommendation:<br/>6-8x compression<br/>25% latency impact]
    XZ --> Rec13[Recommendation:<br/>7x compression<br/>30% latency impact]
    
    Gzip_Zlib --> Rec14[Recommendation:<br/>3.5x compression<br/>Compatible with all systems]
    Bzip2 --> Rec15[Recommendation:<br/>4.8x compression<br/>15% latency impact]
    Deflate_Legacy --> Rec16[Recommendation:<br/>3.2x compression<br/>Legacy system support]
    
    %% Styling
    classDef speedClass fill:#10b981,stroke:#065f46,color:#000000
    classDef balancedClass fill:#3b82f6,stroke:#1e40af,color:#000000
    classDef storageClass fill:#f59e0b,stroke:#92400e,color:#000000
    classDef recClass fill:#6b7280,stroke:#374151,color:#000000
    
    class LZ4_Low,Snappy,ZSTD1,Speed speedClass
    class ZSTD3,ZSTD6,ZSTD_Quant,ZSTD_NoQuant,Balanced,SST_Balanced,VIPER_Balanced balancedClass
    class Brotli4,Brotli7,ZSTD9,ZSTD9_PQ,LZMA,XZ,Storage,Storage_High,Storage_Medium,Storage_Low storageClass
    class Rec1,Rec2,Rec3,Rec4,Rec5,Rec6,Rec7,Rec8,Rec9,Rec10,Rec11,Rec12,Rec13 recClass