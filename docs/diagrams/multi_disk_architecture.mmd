%%{init: {'theme':'base', 'themeVariables': { 'primaryColor':'#fff', 'primaryBorderColor':'#333', 'fontFamily':'Arial', 'fontSize':'14px'}}}%%
graph TB
    %% ProximaDB Server Components
    subgraph "ProximaDB Server"
        subgraph "API Layer"
            REST["REST Server :5678"]
            gRPC["gRPC Server :5679"]
        end
        
        subgraph "Service Layer"
            CollSvc["Collection Service"]
            AvroSvc["Unified Avro Service"]
            VectorCoord["Vector Storage Coordinator"]
        end
        
        subgraph "Assignment Service"
            RRAService["Round-Robin Assignment Service"]
            SCMapper["Storage Component Mapper"]
            Discovery["Discovery Service"]
        end
        
        subgraph "WAL Layer"
            WALMgr["WAL Manager"]
            AvroWAL["Avro WAL Strategy"]
            BincodeWAL["Bincode WAL Strategy"]
            BaseWAL["Base WAL Strategy Trait"]
        end
        
        subgraph "Storage Layer"
            VIPER["VIPER Engine"]
            LSM["LSM Engine"]
            FSFactory["Filesystem Factory"]
        end
    end
    
    %% Multi-Disk Storage
    subgraph "Multi-Disk Storage"
        subgraph "Disk 1"
            WAL1["WAL"]
            Storage1["Storage"]
            Meta1["Metadata"]
        end
        
        subgraph "Disk 2"
            WAL2["WAL"]
            Storage2["Storage"]
            Meta2["Metadata"]
        end
        
        subgraph "Disk 3"
            WAL3["WAL"]
            Storage3["Storage"]
            Meta3["Metadata"]
        end
    end
    
    %% Cloud Storage
    subgraph "Cloud Storage"
        S3["S3 Compatible"]
        Azure["Azure Blob"]
        GCS["Google Cloud"]
    end
    
    %% Connections
    REST --> CollSvc
    gRPC --> CollSvc
    CollSvc --> AvroSvc
    AvroSvc --> VectorCoord
    VectorCoord --> RRAService
    RRAService --> WALMgr
    WALMgr --> AvroWAL
    WALMgr --> BincodeWAL
    AvroWAL -.->|inherits| BaseWAL
    BincodeWAL -.->|inherits| BaseWAL
    BaseWAL --> RRAService
    RRAService --> SCMapper
    Discovery --> SCMapper
    WALMgr --> VIPER
    WALMgr --> LSM
    VIPER --> FSFactory
    LSM --> FSFactory
    
    %% Multi-disk assignments
    RRAService -->|assigns collections| WAL1
    RRAService -->|round-robin| WAL2
    RRAService -->|distribution| WAL3
    
    RRAService -->|performance-based| Storage1
    RRAService -->|assignment| Storage2
    RRAService -->|strategy| Storage3
    
    FSFactory --> WAL1
    FSFactory --> WAL2
    FSFactory --> WAL3
    FSFactory --> Storage1
    FSFactory --> Storage2
    FSFactory --> Storage3
    FSFactory --> Meta1
    
    %% Cloud connectivity
    FSFactory -->|file:// → s3://| S3
    FSFactory -->|file:// → adls://| Azure
    FSFactory -->|file:// → gcs://| GCS
    
    %% Notes
    RRAServiceNote["Round-Robin Assignment Logic:<br/>• Collection → Disk mapping<br/>• Fair distribution across disks<br/>• Affinity-based placement<br/>• Discovery on startup"]
    
    BaseWALNote["Base Trait Pattern:<br/>• Consistent assignment logic<br/>• Polymorphic behavior<br/>• No code duplication<br/>• Extensible interface"]
    
    CloudNote["URL-Based Configuration:<br/>file:///data/disk1/wal<br/>s3://bucket/proximadb/wal<br/>adls://account/container/wal<br/>gcs://bucket/proximadb/wal"]
    
    RRAService -.-> RRAServiceNote
    BaseWAL -.-> BaseWALNote
    Cloud -.-> CloudNote
    
    %% Styling
    classDef server fill:#E3F2FD,stroke:#1976D2,stroke-width:2px
    classDef storage fill:#FFF8E1,stroke:#F57C00,stroke-width:2px
    classDef cloud fill:#E8F5E9,stroke:#388E3C,stroke-width:2px
    classDef note fill:#FFF3E0,stroke:#FF9800,stroke-width:1px
    
    class REST,gRPC,CollSvc,AvroSvc,VectorCoord,RRAService,SCMapper,Discovery,WALMgr,AvroWAL,BincodeWAL,BaseWAL,VIPER,LSM,FSFactory server
    class WAL1,WAL2,WAL3,Storage1,Storage2,Storage3,Meta1,Meta2,Meta3 storage
    class S3,Azure,GCS cloud
    class RRAServiceNote,BaseWALNote,CloudNote note