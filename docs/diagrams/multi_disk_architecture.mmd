        end
        
        subgraph "Service Layer"
            CollSvc["Collection Service"]
            AvroSvc["Unified Avro Service"]
            VectorCoord["Vector Storage Coordinator"]
        end
        
        subgraph "Assignment Service"
            RRAService["Round-Robin Assignment Service"]
            SCMapper["Storage Component Mapper"]
            Discovery["Discovery Service"]
        end
        
        subgraph "WriteAheadLog Layer"
            WriteAheadLogMgr["WriteAheadLog Manager"]
