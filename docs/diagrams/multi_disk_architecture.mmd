        end
        
        subgraph "Storage Layer"
            VIPER["VIPER Engine"]
            SST["SST Engine"]
            FSFactory["Filesystem Factory"]
        end
    end
    
    %% Multi-Disk Storage
    subgraph "Multi-Disk Storage"
        subgraph "Disk 1"
            WriteAheadLog1["WriteAheadLog"]
            Storage1["Storage"]
            Meta1["Metadata"]
        end
        
        subgraph "Disk 2"
            WriteAheadLog2["WriteAheadLog"]
            Storage2["Storage"]
            Meta2["Metadata"]
        end
        
        subgraph "Disk 3"
            WriteAheadLog3["WriteAheadLog"]
            Storage3["Storage"]
            Meta3["Metadata"]
        end
    end
    
    %% Cloud Storage
    subgraph "Cloud Storage"
        S3["S3 Compatible"]
        Azure["Azure Blob"]
        GCS["Google Cloud"]
    end
    
    %% Connections
    REST --> CollSvc
    gRPC --> CollSvc
    CollSvc --> AvroSvc
    AvroSvc --> VectorCoord
    VectorCoord --> RRAService
    RRAService --> WriteAheadLogMgr
    WriteAheadLogMgr --> AvroWriteAheadLog
    WriteAheadLogMgr --> BincodeWriteAheadLog
    AvroWriteAheadLog -.->|inherits| BaseWriteAheadLog
    BincodeWriteAheadLog -.->|inherits| BaseWriteAheadLog
    BaseWriteAheadLog --> RRAService
    RRAService --> SCMapper
    Discovery --> SCMapper
    WriteAheadLogMgr --> VIPER
    WriteAheadLogMgr --> SST
    VIPER --> FSFactory
    SST --> FSFactory
    
    %% Multi-disk assignments
    RRAService -->|assigns collections| WriteAheadLog1
    RRAService -->|round-robin| WriteAheadLog2
    RRAService -->|distribution| WriteAheadLog3
    
    RRAService -->|performance-based| Storage1
    RRAService -->|assignment| Storage2
    RRAService -->|strategy| Storage3
    
    FSFactory --> WriteAheadLog1
    FSFactory --> WriteAheadLog2
    FSFactory --> WriteAheadLog3
    FSFactory --> Storage1
    FSFactory --> Storage2
    FSFactory --> Storage3
    FSFactory --> Meta1
    
    %% Cloud connectivity
    FSFactory -->|file:// → s3://| S3
    FSFactory -->|file:// → adls://| Azure
    FSFactory -->|file:// → gcs://| GCS
    
    %% Notes
    RRAServiceNote["Round-Robin Assignment Logic:<br/>• Collection → Disk mapping<br/>• Fair distribution across disks<br/>• Affinity-based placement<br/>• Discovery on startup"]
    
    BaseWriteAheadLogNote["Base Trait Pattern:<br/>• Consistent assignment logic<br/>• Polymorphic behavior<br/>• No code duplication<br/>• Extensible interface"]
    
    CloudNote["URL-Based Configuration:<br/>file:///data/disk1/wal<br/>s3://bucket/proximadb/wal<br/>adls://account/container/wal<br/>gcs://bucket/proximadb/wal"]
    
    RRAService -.-> RRAServiceNote
    BaseWriteAheadLog -.-> BaseWriteAheadLogNote
    Cloud -.-> CloudNote
    
