flowchart TD
    Start([Start]) --> Receive[Receive search request]
    
    Receive --> Note1[/"Query vector<br/>k = 10<br/>candidate_multiplier = 3.0"/]
    
    Note1 --> Stage1{{"Stage 1: Quantized Filtering"}}
    
    subgraph Stage1_Details["Stage 1: Quantized Filtering"]
        Load[Load quantized vectors] --> LoadNote[/"Reduced memory bandwidth<br/>(1/8 to 1/32 of original)"/]
        LoadNote --> Compute[Compute approximate distances]
        Compute --> ComputeNote[/"Using SIMD operations<br/>on quantized data"/]
        ComputeNote --> Select[Select k × multiplier candidates]
        Select --> SelectNote[/"10 × 3.0 = 30 candidates"/]
        SelectNote --> MetaCheck{Metadata filters?}
        MetaCheck -->|Yes| Apply[Apply metadata filtering]
        MetaCheck -->|No| Skip1[Continue]
        Apply --> Skip1
    end
    
    Stage1 --> Stage1_Details
    Stage1_Details --> Stage2{{"Stage 2: Full Precision Verification"}}
    
    subgraph Stage2_Details["Stage 2: Full Precision Verification"]
        LoadFP32[Load FP32 vectors for candidates] --> LoadFP32Note[/"Only 30 vectors loaded<br/>instead of entire dataset"/]
        LoadFP32Note --> ComputeExact[Compute exact distances]
        ComputeExact --> ComputeExactNote[/"High precision calculation<br/>for final accuracy"/]
        ComputeExactNote --> Rerank[Rerank candidates]
        Rerank --> SelectFinal[Select final top-k results]
    end
    
    Stage2 --> Stage2_Details
    Stage2_Details --> Return[Return results]
    Return --> ReturnNote[/"10 results with<br/>100% accuracy"/]
    ReturnNote --> End([End])
    
    %% Styling
    classDef stage fill:#E3F2FD,stroke:#1976D2,stroke-width:2px
    classDef note fill:#FFF9C4,stroke:#F57F17,stroke-width:1px
    classDef process fill:#E8F5E9,stroke:#388E3C,stroke-width:1px
    
    class Stage1,Stage2 stage
    class Note1,LoadNote,ComputeNote,SelectNote,LoadFP32Note,ComputeExactNote,ReturnNote note
    class Load,Compute,Select,Apply,LoadFP32,ComputeExact,Rerank,SelectFinal,Return process