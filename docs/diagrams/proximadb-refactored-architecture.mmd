%%{init: {'theme':'base', 'themeVariables': { 'primaryColor':'#fff', 'primaryBorderColor':'#333', 'fontFamily':'Arial', 'fontSize':'14px'}}}%%
classDiagram
    class UnifiedHandlers {
        -vector_service: Arc~VectorService~
        -collection_service: Arc~CollectionService~
        +handle_collection_operation(op: proto::CollectionOperation) proto::CollectionResponse
        +handle_vector_batch(req: proto::VectorBatchRequest) proto::VectorOperationResponse
        +handle_vector_search(req: proto::VectorSearchRequest) proto::SearchResponse
    }
    <<new>> UnifiedHandlers
    
    class RestAdapter {
        -handlers: Arc~UnifiedHandlers~
        +collection_operation(json: Json) JsonResponse
        +vector_batch(json: Json) JsonResponse
        +vector_search(json: Json) JsonResponse
    }
    <<simplified>> RestAdapter
    
    class RestProtoConverter {
        +json_to_proto_collection_request(json)$ proto::CollectionRequest
        +json_to_proto_vector_batch(json)$ proto::VectorBatchRequest
        +proto_to_json_response(proto)$ JsonValue
    }
    <<new>> RestProtoConverter
    
    class GrpcAdapter {
        -handlers: Arc~UnifiedHandlers~
        +create_collection(req: Request~CreateCollectionRequest~) Response~CreateCollectionResponse~
        +insert_vectors(req: Request~InsertVectorsRequest~) Response~InsertVectorsResponse~
        +search_vectors(req: Request~SearchVectorsRequest~) Response~SearchVectorsResponse~
    }
    <<simplified>> GrpcAdapter
    
    class ProtoTypes {
        +Collection
        +CollectionConfig
        +VectorBatch
        +VectorRecord
        +SearchQuery
        +SearchResult
        +OperationMetrics
    }
    <<enhanced>> ProtoTypes
    note for ProtoTypes "Single source of truth\nfor all data types"
    
    class VectorService {
        -storage_engine: Arc~UnifiedStorageEngine~
        -wal_manager: Arc~WalManager~
        -axis_manager: Arc~AxisManager~
        +handle_vector_batch(req: proto::VectorBatchRequest) Result~proto::VectorOperationResponse~
        +search_vectors(req: proto::VectorSearchRequest) Result~proto::SearchResponse~
        -storage_aware_search(collection_id, queries) Result~Vec[proto::SearchResult]~
    }
    <<refactored>> VectorService
    
    class CollectionService {
        -metadata_backend: Arc~dyn MetadataBackend~
        +create_collection(req: proto::CreateCollectionRequest) Result~proto::CreateCollectionResponse~
        +get_collection(id: String) Result~Option[proto::Collection]~
    }
    
    class WalManager {
        -strategy: ProtoWalStrategy
        -storage_engines: HashMap~String, Arc[dyn UnifiedStorageEngine]~
        +write_vector_batch(batch: proto::VectorBatch) Result~Vec[u64]~
        +flush_to_storage(collection_id) Result~()~
    }
    <<refactored>> WalManager
    
    class ProtoWalStrategy {
        +serialize_batch(batch: proto::VectorBatch) Result~Vec[u8]~
        +deserialize_batch(data: Vec[u8]) Result~proto::VectorBatch~
        +get_stats() WalStats
    }
    <<new>> ProtoWalStrategy
    note for ProtoWalStrategy "Replaces both Avro and Bincode strategies\nUses protobuf for all serialization"
    
    class UnifiedStorageEngine {
        <<interface>>
        +insert_vector_batch(batch: proto::VectorBatch) Result~()~
        +search_vectors(query: proto::SearchQuery) Result~Vec[proto::SearchResult]~
        +flush(collection_id: String) Result~()~
    }
    <<updated>> UnifiedStorageEngine
    
    class ViperEngine {
        +insert_vector_batch(batch: proto::VectorBatch) Result~()~
        -write_parquet_file(vectors: Vec[proto::VectorRecord]) Result~()~
    }
    
    class LsmEngine {
        +insert_vector_batch(batch: proto::VectorBatch) Result~()~
        -write_sst_file(records: Vec[proto::VectorRecord]) Result~()~
    }
    
    %% Relationships
    RestAdapter --> UnifiedHandlers : delegates
    GrpcAdapter --> UnifiedHandlers : delegates
    RestAdapter --> RestProtoConverter : uses
    UnifiedHandlers --> VectorService : uses
    UnifiedHandlers --> CollectionService : uses
    VectorService --> UnifiedStorageEngine : uses
    VectorService --> WalManager : uses
    WalManager --> ProtoWalStrategy : uses
    WalManager --> UnifiedStorageEngine : flushes to
    ViperEngine ..|> UnifiedStorageEngine : implements
    LsmEngine ..|> UnifiedStorageEngine : implements
    
    %% Notes as separate elements
    note for UnifiedHandlers "BENEFITS:\n- Single implementation for all operations\n- No duplicate logic between REST/gRPC\n- Consistent error handling\n- Easier to test"
    
    note for ProtoWalStrategy "BENEFITS:\n- No Avro conversion overhead\n- Type safety with proto\n- Simpler serialization\n- Better performance"