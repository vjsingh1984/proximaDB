@startuml ML_Clustering_Architecture
!theme plain
title ML Clustering Architecture for ProximaDB
subtitle K-means++ Implementation with Storage-Aware Search

package "ML Clustering System" {
    
    package "Model Training" {
        class ClusteringModelManager {
            - models: HashMap<CollectionId, ClusteringModel>
            - model_dir: PathBuf
            - stats_dir: PathBuf
            - config: ClusteringConfig
            --
            + train_model(collection_id, vectors) -> Result<ClusteringModel>
            + load_model(collection_id) -> Result<ClusteringModel>
            + should_retrain(collection_id, current_count) -> bool
            + save_model(collection_id, model) -> Result<()>
            + get_model_stats(collection_id) -> ModelStats
        }
        
        class ClusteringModel {
            - centroids: Vec<Vec<f32>>
            - assignments: HashMap<VectorId, ClusterId>
            - stats: ModelStats
            --
            + assign_to_cluster(vector) -> ClusterId
            + get_cluster_centroid(cluster_id) -> Vec<f32>
            + get_cluster_vectors(cluster_id) -> Vec<VectorId>
            + predict_cluster(vector) -> ClusterId
        }
        
        class KMeansPlusPlusInitializer {
            - rng: ThreadRng
            --
            + initialize_centroids(vectors, k) -> Vec<Vec<f32>>
            + compute_initial_distances(vectors, centroids) -> Vec<f64>
            + select_next_centroid(vectors, distances) -> Vec<f32>
        }
        
        class ModelStats {
            - vector_count: usize
            - cluster_count: usize
            - last_trained: chrono::DateTime
            - training_duration: Duration
            - inertia: f64
            - silhouette_score: f64
            --
            + to_json() -> String
            + from_json(json) -> Result<ModelStats>
        }
    }
    
    package "Search Integration" {
        class ViperSearchEngine {
            - clustering_models: Arc<ClusteringModelManager>
            - search_config: SearchConfig
            --
            + search_with_clustering(query, k, filters) -> Result<SearchResults>
            + direct_search(query, k) -> Result<SearchResults>
            + cluster_optimized_search(query, k) -> Result<SearchResults>
            + search_cluster(cluster_id, query, k) -> Result<SearchResults>
        }
        
        class SearchStrategy {
            <<enumeration>>
            DIRECT
            CLUSTER_OPTIMIZED
            HYBRID
        }
        
        class SearchResult {
            - vector_id: VectorId
            - score: f32
            - metadata: HashMap<String, Value>
            - algorithm_used: String
            - cluster_id: Option<ClusterId>
            - created_at: DateTime
        }
    }
    
    package "Storage Integration" {
        class BackgroundManager {
            - clustering_models: Arc<ClusteringModelManager>
            - last_training_counts: Arc<RwLock<HashMap<CollectionId, usize>>>
            - training_threshold: f64
            --
            + should_train_model(collection_id, current_count) -> bool
            + trigger_model_training(collection_id) -> Result<()>
            + monitor_collection_growth() -> Result<()>
        }
        
        class ModelPersistence {
            - base_path: PathBuf
            --
            + save_model(collection_id, model) -> Result<()>
            + load_model(collection_id) -> Result<ClusteringModel>
            + save_stats(collection_id, stats) -> Result<()>
            + load_stats(collection_id) -> Result<ModelStats>
        }
    }
}

package "Core Components" {
    class ViperEngine {
        - clustering_models: Arc<ClusteringModelManager>
        --
        + get_parquet_files_for_collection(collection_id) -> Result<Vec<PathBuf>>
        + search_vectors_in_cluster(cluster_id, query, k) -> Result<SearchResults>
    }
    
    class CollectionService {
        - clustering_models: Arc<ClusteringModelManager>
        --
        + get_collection_metadata(collection_id) -> Result<CollectionMetadata>
        + get_vector_count(collection_id) -> Result<usize>
    }
}

' Relationships
ClusteringModelManager --> ClusteringModel : manages
ClusteringModel --> ModelStats : tracks
ClusteringModelManager --> KMeansPlusPlusInitializer : uses
ClusteringModelManager --> ModelPersistence : persists via

ViperSearchEngine --> ClusteringModelManager : uses
ViperSearchEngine --> SearchStrategy : determines
ViperSearchEngine --> SearchResult : returns
ViperSearchEngine --> ViperEngine : delegates to

BackgroundManager --> ClusteringModelManager : coordinates
BackgroundManager --> ModelPersistence : uses

ViperEngine --> ClusteringModelManager : integrates
CollectionService --> ClusteringModelManager : provides metadata

note top of ClusteringModelManager
    **Key Features:**
    - K-means++ initialization for optimal centroids
    - 20% growth threshold for intelligent retraining
    - Model persistence in __models/ directory
    - Statistics tracking for performance monitoring
    - Only operates on collections >1M vectors
end note

note top of ViperSearchEngine
    **Search Flow:**
    1. Determine strategy (direct vs clustered)
    2. Load appropriate clustering model
    3. Execute parallel cluster search
    4. Aggregate and deduplicate results
    5. Return ranked search results
end note

note top of BackgroundManager
    **Training Trigger:**
    - Monitors vector count growth
    - Triggers retraining at 20% growth
    - Coordinates with flush/compaction cycles
    - Maintains training statistics
end note

@enduml