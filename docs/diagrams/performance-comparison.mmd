graph TD
    subgraph "Traditional Search"
        T1[Load All Vectors<br/>100% Memory BW]
        T2[Compute All Distances<br/>O n × d]
        T3[Sort & Return Top-k<br/>O n log k]
    end
    
    subgraph "Two-Stage Search"
        S1[Load Quantized Vectors<br/>6.25% Memory BW]
        S2[Compute Approx Distances<br/>O n × d/8]
        S3[Select Candidates<br/>O n log 3k]
        S4[Load Candidate FP32<br/>0.3% Memory BW]
        S5[Precise Rerank<br/>O 3k × d]
        S6[Return Top-k<br/>O 3k log k]
    end
    
    T1 --> T2
    T2 --> T3
    
    S1 --> S2
    S2 --> S3
    S3 --> S4
    S4 --> S5
    S5 --> S6
    
    style T1 fill:#FFCDD2
    style T2 fill:#FFCDD2
    style T3 fill:#FFCDD2
    style S1 fill:#C8E6C9
    style S2 fill:#C8E6C9
    style S3 fill:#C8E6C9
    style S4 fill:#C8E6C9
    style S5 fill:#C8E6C9
    style S6 fill:#C8E6C9