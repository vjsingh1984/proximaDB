classDiagram
    class WalStrategy {
        <<interface>>
        +strategy_name()
        +initialize(config, filesystem)
        +set_storage_engine(engine)
        +write_entry(entry)
        +read_entries(collection_id, from_seq, limit)
        +flush(collection_id)
        +get_assignment_service()
        +select_wal_url_for_collection(collection_id, config)
        +discover_existing_assignments(config)
    }
    
    class AvroWalStrategy {
        -config: WalConfig
        -filesystem: FilesystemFactory
        -memory_table: WalBehaviorWrapper
        -disk_manager: WalDiskManager
        -storage_engine: UnifiedStorageEngine
        -assignment_service: AssignmentService
        +strategy_name()
        +serialize_entries(entries)
        +deserialize_entries(data)
        +get_assignment_service()
    }
    note for AvroWalStrategy "Memtable: HashMap (random access)"
    
    class BincodeWalStrategy {
        -config: WalConfig
        -filesystem: FilesystemFactory
        -memory_table: WalBehaviorWrapper
        -disk_manager: WalDiskManager
        -storage_engine: UnifiedStorageEngine
        -assignment_service: AssignmentService
        +strategy_name()
        +serialize_entries(entries)
        +deserialize_entries(data)
        +get_assignment_service()
    }
    note for BincodeWalStrategy "Memtable: BTree (ordered flush)"
    
    class AssignmentService {
        <<interface>>
        +assign_storage_url(collection_id, config)
        +get_assignment(collection_id, component_type)
        +record_assignment(collection_id, component_type, assignment)
        +remove_assignment(collection_id, component_type)
        +get_all_assignments(component_type)
        +get_assignment_stats()
    }
    
    class RoundRobinAssignmentService {
        -assignments: HashMap
        -round_robin_counters: HashMap
        +assign_storage_url(collection_id, config)
        +get_assignment(collection_id, component_type)
        +record_assignment(collection_id, component_type, assignment)
        +get_next_round_robin_index(component_type, storage_urls)
        +hash_collection_id(collection_id)
    }
    
    class StorageAssignmentResult {
        +storage_url: String
        +directory_index: usize
        +assigned_at: DateTime
    }
    
    class StorageComponentType {
        <<enumeration>>
        Wal
        Viper
        Lsm
        Index
        Metadata
    }
    
    class WalConfig {
        +wal_urls: Vec~String~
        +distribution_strategy: DistributionStrategy
        +collection_affinity: bool
        +memory_flush_size_bytes: usize
        +global_flush_threshold: usize
    }
    
    %% Inheritance relationships
    AvroWalStrategy --|> WalStrategy : implements
    BincodeWalStrategy --|> WalStrategy : implements
    RoundRobinAssignmentService --|> AssignmentService : implements
    
    %% Composition relationships
    AvroWalStrategy *-- AssignmentService : uses
    BincodeWalStrategy *-- AssignmentService : uses
    RoundRobinAssignmentService --> StorageAssignmentResult : creates
    RoundRobinAssignmentService --> StorageComponentType : manages
    WalStrategy --> WalConfig : configured by
    
    %% Notes
    note "Avro WAL Strategy:\n• Schema-based serialization\n• Compact binary format\n• Cross-language compatibility\n• Built-in compression" as avro_note
    
    note "Bincode WAL Strategy:\n• Native Rust performance\n• Zero-copy deserialization\n• Minimal overhead\n• Type safety" as bincode_note
    
    note "Base Trait Implementation:\n\n```rust\nasync fn select_wal_url_for_collection(\n    &self, \n    collection_id: &str, \n    config: &WalConfig\n) -> Result<String> {\n    // Check existing assignment\n    if let Some(assignment) = self.get_assignment_service()\n        .get_assignment(&CollectionId::from(collection_id), StorageComponentType::Wal).await {\n        return Ok(assignment.storage_url);\n    }\n    \n    // Create new assignment\n    let assignment_config = StorageAssignmentConfig {\n        storage_urls: config.wal_urls.clone(),\n        component_type: StorageComponentType::Wal,\n        collection_affinity: config.collection_affinity,\n    };\n    \n    let assignment = self.get_assignment_service()\n        .assign_storage_url(&CollectionId::from(collection_id), &assignment_config).await?;\n        \n    Ok(assignment.storage_url)\n}\n```" as base_impl_note
    
    note "Round-Robin Algorithm:\n\n```rust\nasync fn get_next_round_robin_index(\n    &self,\n    component_type: StorageComponentType,\n    storage_urls: &[String],\n) -> Result<usize> {\n    let mut counters = self.round_robin_counters.write().await;\n    let counter = counters.entry(component_type).or_insert(0);\n    let index = *counter % storage_urls.len();\n    *counter = (*counter + 1) % storage_urls.len();\n    Ok(index)\n}\n```\n\nAffinity Algorithm:\n```rust\nfn hash_collection_id(&self, collection_id: &CollectionId) -> usize {\n    let mut hasher = DefaultHasher::new();\n    collection_id.hash(&mut hasher);\n    hasher.finish() as usize\n}\n```" as round_robin_note
    
    AvroWalStrategy -.-> avro_note
    BincodeWalStrategy -.-> bincode_note
    WalStrategy -.-> base_impl_note
    RoundRobinAssignmentService -.-> round_robin_note