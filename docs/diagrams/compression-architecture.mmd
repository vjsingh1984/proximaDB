graph TB
    subgraph "Client SDK"
        SDK[Python SDK]
        CC[CompressionConfig]
        SO[SearchOptimization]
    end

    subgraph "API Layer"
        REST[REST API]
        GRPC[gRPC API]
    end

    subgraph "Service Layer"
        DVS[DirectVectorService]
        UQP[UnifiedQueryPlanner]
    end

    subgraph "Storage Engines"
        SST[SST Engine]
        VIPER[VIPER Engine]
    end

    subgraph "Compression"
        SSTC[SST Compression<br/>- ZSTD<br/>- LZ4<br/>- Snappy]
        VIPERC[VIPER Compression<br/>- Parquet<br/>- Dual Columns]
    end

    subgraph "Storage Format"
        SST1[SST1 Format<br/>Magic: b'SST1']
        PARQ[Parquet Format]
    end

    subgraph "Cache"
        DC[Decompression Cache<br/>- LRU Eviction<br/>- Auto Invalidation]
    end

    SDK --> CC
    SDK --> SO
    CC --> REST
    CC --> GRPC
    SO --> REST
    SO --> GRPC
    
    REST --> DVS
    GRPC --> DVS
    
    DVS --> UQP
    UQP --> SST
    UQP --> VIPER
    
    SST --> SSTC
    VIPER --> VIPERC
    
    SSTC --> SST1
    VIPERC --> PARQ
    
    SST1 --> DC
    PARQ --> DC
    
    %% Professional neutral colors that work in light and dark modes
    classDef clientStyle fill:#f0f4f8,stroke:#6b7280,stroke-width:2px,color:#1f2937
    classDef serviceStyle fill:#f9fafb,stroke:#60a5fa,stroke-width:2px,color:#1f2937
    classDef engineStyle fill:#fef3c7,stroke:#f59e0b,stroke-width:2px,color:#1f2937
    classDef compressionStyle fill:#e0e7ff,stroke:#6366f1,stroke-width:2px,color:#1f2937
    classDef formatStyle fill:#fce7f3,stroke:#ec4899,stroke-width:2px,color:#1f2937
    classDef cacheStyle fill:#dcfce7,stroke:#22c55e,stroke-width:2px,color:#1f2937

    class SDK,CC,SO clientStyle
    class REST,GRPC,DVS,UQP serviceStyle
    class SST,VIPER engineStyle
    class SSTC,VIPERC compressionStyle
    class SST1,PARQ formatStyle
    class DC cacheStyle