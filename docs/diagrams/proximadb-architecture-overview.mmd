        end
    end
    
    %% Persistence Layer
    subgraph Persistence["💾 Persistence Layer"]
        WriteBuffer["Write Buffer<br/>📁 storage/persistence/write_buffer/<br/>🔄 Proto/Avro/Bincode"]
