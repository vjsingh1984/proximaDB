    subgraph Gateway["🔄 API Gateway Layer"]
        RestHandler["REST Handler<br/>📁 handlers/unified_handlers.rs<br/>🔧 JSON ↔ Proto"]
        GrpcHandler["gRPC Handler<br/>📁 network/grpc/service.rs<br/>⚡ Direct Proto"]
        UnifiedAPI["Unified API<br/>📁 proto/proximadb.proto<br/>🎯 Single Schema"]
