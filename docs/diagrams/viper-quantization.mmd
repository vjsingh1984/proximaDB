graph TB
    subgraph "VIPER Engine Architecture"
        subgraph "Pipeline Components"
            PP[Pipeline Processor<br/>Operator Chain]
            WT[WriteThroughCache<br/>Hot Data Cache]
            PQ[ParquetQuantizer<br/>Column Quantization]
            PR[ParquetReconstructor<br/>Row Reconstruction]
        end
        
        subgraph "Storage Format"
            subgraph "Row Group"
                ID[ID Column<br/>String/UUID]
                VEC[Vector Column<br/>FP32 Array]
                QVEC[Quantized Vectors<br/>Binary/Scalar/PQ]
                META[Metadata Column<br/>JSON/Binary]
                EXTRA[Extra Metadata<br/>Bloom Filters]
            end
        end
        
        subgraph "Search Pipeline"
            S1[Stage 1: Metadata Filter<br/>Predicate Pushdown]
            S2[Stage 2: Quantized Search<br/>Candidate Selection]
            S3[Stage 3: Full Precision<br/>Final Ranking]
        end
        
        subgraph "Compaction"
            UAC[UnifiedAtomicCoordinator<br/>ACID Guarantees]
            MERGE[File Merging<br/>Row Group Optimization]
            STATS[Statistics Update<br/>Min/Max/Bloom]
        end
    end
    
    %% Pipeline flow
    PP --> WT
    PP --> PQ
    WT --> PR
    PQ --> QVEC
    
    %% Search flow
    S1 --> META
    S1 --> EXTRA
    S2 --> QVEC
    S3 --> VEC
    
    %% Compaction flow
    UAC --> MERGE
    MERGE --> STATS
    
    %% Storage connections
    PR --> ID
    PR --> VEC
    PR --> META
    
    style PP fill:#e3f2fd,stroke:#1976d2,stroke-width:2px
    style UAC fill:#fff3e0,stroke:#f57c00,stroke-width:2px
    style S1 fill:#e8f5e9,stroke:#388e3c,stroke-width:2px
    style S2 fill:#e8f5e9,stroke:#388e3c,stroke-width:2px
    style S3 fill:#e8f5e9,stroke:#388e3c,stroke-width:2px
    style ID fill:#E3F2FD
    style VEC fill:#FFE082
    style QVEC fill:#C5E1A5
    style META fill:#F8BBD0