graph TB
    subgraph "VIPER Parquet Storage"
        subgraph "Row Group 1"
            A1[Vector ID Column]
            A2[FP32 Vector Column]
            A3[Quantized Vector Column]
            A4[Metadata Columns]
        end
        
        subgraph "Row Group 2"
            B1[Vector ID Column]
            B2[FP32 Vector Column]
            B3[Quantized Vector Column]
            B4[Metadata Columns]
        end
    end
    
    subgraph "Search Operations"
        C[Stage 1: Quantized Search]
        D[Stage 2: Full Precision]
        E[Predicate Pushdown]
    end
    
    C --> A3
    C --> B3
    D --> A2
    D --> B2
    E --> A4
    E --> B4
    
    style A1 fill:#E3F2FD
    style A2 fill:#FFE082
    style A3 fill:#C5E1A5
    style A4 fill:#F8BBD0
    style B1 fill:#E3F2FD
    style B2 fill:#FFE082
    style B3 fill:#C5E1A5
    style B4 fill:#F8BBD0
    style C fill:#81C784
    style D fill:#4FC3F7
    style E fill:#CE93D8