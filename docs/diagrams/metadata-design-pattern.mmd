graph TB
    subgraph "Document Ingestion Pipeline"
        D[Document] --> C[Chunking Service]
        C --> E[Embedding Service]
        E --> PR[prepare_vector_records]
    end
    
    subgraph "Metadata Enrichment"
        PR --> CM[Core Metadata]
        PR --> EM[Enrichment Function]
        PR --> SM[Source Metadata]
        
        CM --> FM[Filterable Metadata]
        EM --> FM
        SM --> |High Cardinality| FM
        SM --> |Low Cardinality| XM[Extra Metadata]
    end
    
    subgraph "Storage Optimization"
        FM --> |Indexed| VC[VIPER Columns]
        XM --> |Not Indexed| VS[VIPER Storage]
        FM --> |All Queryable| SR[SST Rows]
        XM --> SR
    end
    
    subgraph "Query Performance"
        Q[Query] --> QF[Query Filter]
        QF --> |Fast| VC
        QF --> |Standard| SR
    end
    
    style D fill:#f9f,stroke:#333,stroke-width:2px
    style PR fill:#bbf,stroke:#333,stroke-width:2px
    style FM fill:#9f9,stroke:#333,stroke-width:2px
    style XM fill:#ff9,stroke:#333,stroke-width:2px