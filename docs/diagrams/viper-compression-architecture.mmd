graph TB
    subgraph Input["Input Layer"]
        Vectors[FP32 Vectors<br/>1536 dimensions]
        Metadata[Metadata<br/>Key-Value Pairs]
    end
    
    subgraph Transform["Pre-Write Transformations"]
        Quant{Quantization<br/>Config?}
        Sparse{Sparse<br/>Detection?}
        
        Quant -->|INT8/INT16| StandardQuant[Standard<br/>Quantization]
        Quant -->|4-6 bit| CustomPack[Pack with<br/>Bytemuck to INT8]
        Quant -->|None| PassThrough1[No Transform]
        
        Sparse -->|>70% zeros| COO[Convert to COO<br/>indices + values]
        Sparse -->|Dense| PassThrough2[No Transform]
    end
    
    subgraph Storage["Parquet Storage Layer"]
        direction LR
        VectorCol[Vector Column<br/>List&lt;Float32&gt; or<br/>List&lt;Int8/16&gt;]
        MetaCol[Metadata Columns<br/>with Encoding Hints]
        
        VectorCol -.->|PLAIN| P1[Standard<br/>Encoding]
        VectorCol -.->|BYTE_STREAM_SPLIT| P2[If Supported<br/>by Arrow]
        
        MetaCol -.->|DICTIONARY| M1[Low Cardinality<br/>Strings]
        MetaCol -.->|RLE| M2[Repeated<br/>Values]
        MetaCol -.->|DELTA| M3[Sequential<br/>Values]
    end
    
    subgraph Compression["File-Level Compression"]
        ZSTD[ZSTD<br/>Configurable Level<br/>1-22]
        LZ4[LZ4<br/>Fast]
        None[No Compression]
    end
    
    subgraph Read["Post-Read Transformations"]
        Decomp[Decompress<br/>if Needed]
        Unpack{Transform<br/>Type?}
        
        Unpack -->|Packed Bits| UnpackBits[Unpack from INT8<br/>to Original Bits]
        Unpack -->|COO Format| Reconstruct[Reconstruct<br/>Dense Vector]
        Unpack -->|Standard| NoTransform[Direct Use]
        
        UnpackBits --> Final[FP32 Vector<br/>for Distance Calc]
        Reconstruct --> Final
        NoTransform --> Final
    end
    
    Vectors --> Quant
    Vectors --> Sparse
    Metadata --> MetaCol
    
    StandardQuant --> VectorCol
    CustomPack --> VectorCol
    PassThrough1 --> VectorCol
    COO --> VectorCol
    PassThrough2 --> VectorCol
    
    VectorCol --> ZSTD
    MetaCol --> ZSTD
    ZSTD --> Decomp
    LZ4 --> Decomp
    None --> Decomp
    
    Decomp --> Unpack

    style Input fill:#e3f2fd
    style Transform fill:#f3e5f5
    style Storage fill:#fff3e0
    style Compression fill:#e8f5e9
    style Read fill:#fce4ec
    style Final fill:#c8e6c9