    Hash3 --> CompositeStrategy
    
    SimpleStrategy --> InsertOp
    BitPackedStrategy --> InsertOp
    ByteAlignedStrategy --> InsertOp
    CompositeStrategy --> InsertOp
    
    InsertOp --> QueryOp
    QueryOp --> FalsePositive
    
    %% Performance Integration
    QueryOp --> MemoryUsage
    QueryOp --> QuerySpeed
    FalsePositive --> AccuracyMetrics
    
    %% Storage Integration
    SimpleStrategy --> SSTableFilter
    BitPackedStrategy --> VIPERFilter
    CompositeStrategy --> PersistentStorage
    
