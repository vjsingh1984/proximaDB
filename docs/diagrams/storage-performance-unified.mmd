    %% Cache Hierarchy Flow
    L1Hot --> L1Warm
    L1Warm --> L2Fast
    L2Fast --> L2Compressed
    L2Compressed --> L3Network
    L3Network --> L3Archive
    
    %% Engine Optimizations
    L1Hot --> ViperCache
    L1Warm --> SstCache
    ViperCache --> ViperCompression
    SstCache --> SstCompression
    
    %% Tiering Intelligence
    AccessPattern --> TierClassifier
    TierClassifier --> TierMigration
    TierMigration --> HotTierTarget
    TierMigration --> WarmTierTarget
    TierMigration --> ColdTierTarget
    
    %% Feedback Loops
    HotTierTarget --> AccessPattern
    WarmTierTarget --> TierClassifier
    ColdTierTarget --> TierMigration
    
