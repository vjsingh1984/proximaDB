@startuml
!theme blueprint

package "Core Types" {
    class VectorRecord {
        +id: String
        +collection_id: String
        +vector: Vector
        +metadata: Map
        +timestamp: DateTime
        +expires_at: OptionalDateTime
    }
    
    class Collection {
        +id: String
        +name: String
        +dimension: usize
        +distance_metric: DistanceMetric
        +storage_engine: StorageEngine
        +indexing_algorithm: IndexAlgorithm
        +index_config: IndexConfig
        +created_at: DateTime
        +metadata: Map
    }
    
    class IndexConfig {
        +update_mode: IndexUpdateMode
        +async_update_timeout_ms: OptionalU64
        +async_update_batch_size: OptionalUsize
        +enable_background_optimization: bool
        +hnsw_config: OptionalHnswConfig
        +ivf_config: OptionalIvfConfig
        +build_concurrency: OptionalUsize
        +memory_limit_mb: OptionalUsize
        +checkpoint_interval_ms: OptionalU64
    }
    
    enum IndexUpdateMode {
        Synchronous
        Asynchronous
        Hybrid
    }
    
    enum DistanceMetric {
        Cosine
        Euclidean
        Manhattan
        DotProduct
        Hamming
    }
    
    enum StorageEngine {
        Viper
        Lsm
        Mmap
        Hybrid
    }
}

package "AXIS Index System" {
    class AxisManager {
        -config: AxisConfig
        -collection_service: CollectionService
        -adaptive_engine: AdaptiveIndexEngine
        -migration_engine: IndexMigrationEngine
        -collection_strategies: Map
        +set_collection_service(service)
        +get_collection_index_config(collection_id)
        +insert(vector)
        +search(query)
        +migrate_index(collection_id, new_strategy)
    }
    
    class AdaptiveIndexEngine {
        -performance_monitor: PerformanceMonitor
        +analyze_collection_characteristics(collection_id)
        +recommend_index_strategy(characteristics)
        +optimize_index_config(collection_id)
    }
    
    class IndexMigrationEngine {
        +create_migration_plan(from, to)
        +execute_migration(plan)
        +rollback_migration(migration_id)
    }
    
    AxisManager --> AdaptiveIndexEngine
    AxisManager --> IndexMigrationEngine
}

package "Service Layer" {
    class CollectionService {
        -storage_engine: StorageEngine
        -metadata_store: MetadataStore
        -index_manager: AxisIndexManager
        +create_collection(request)
        +get_collection(id)
        +get_collection_index_config(id)
        +update_collection_index_config(id, config)
        +list_collections()
        +delete_collection(id)
    }
    
    class VectorService {
        -storage_engine: StorageEngine
        -search_engine: SearchEngine
        +insert_vectors(collection_id, vectors)
        +get_vectors(collection_id, ids)
        +search_vectors(collection_id, query)
        +delete_vectors(collection_id, ids)
    }
}

CollectionService --> AxisManager
VectorService --> StorageEngine
Collection --> IndexConfig
AxisManager --> IndexConfig
IndexConfig --> IndexUpdateMode

@enduml