%%{init: {"theme":"neutral", "themeVariables": {"primaryColor":"#2563eb","primaryTextColor":"#ffffff","primaryBorderColor":"#1e40af","lineColor":"#64748b","secondaryColor":"#10b981","secondaryTextColor":"#ffffff","tertiaryColor":"#f59e0b","tertiaryTextColor":"#ffffff","background":"transparent","mainBkg":"#ffffff","secondBkg":"#f8fafc","textColor":"#1e293b","nodeTextColor":"#1e293b","fontFamily":"-apple-system, BlinkMacSystemFont, Segoe UI, Roboto, sans-serif","fontSize":"14px","clusterBkg":"#f1f5f9","clusterBorder":"#cbd5e1","edgeLabelBackground":"#ffffff"}}}%%
graph LR
    subgraph "Insert Flow"
        Insert[Vector Insert]
        Insert --> WAL1[Write to WAL]
        WAL1 --> Mem1[Buffer in Memtable]
        Mem1 --> Index1[Update Index]
        Index1 --> Ack[Return ACK]
    end
    
    subgraph "Search Flow"
        Search[Search Request]
        Search --> Cache1[Check Cache]
        Cache1 --> Index2[Query Index]
        Index2 --> Filter[Apply Filters]
        Filter --> Rank[Rank Results]
        Rank --> Return[Return Results]
    end
    
    subgraph "Background Operations"
        direction TB
        Flush[<b>Flush Process</b><br/>Memtable → Disk]
        Compact[<b>Compaction</b><br/>Merge SSTables]
        Tier[<b>Tiering</b><br/>Hot → Cold data]
        GC[<b>Garbage Collection</b><br/>Clean expired]
    end
    
    Mem1 -.-> Flush
    Flush -.-> Compact
    Compact -.-> Tier
    Tier -.-> GC
    
    style Insert fill:#e6f4ea
    style Search fill:#e8f0fe
    style Flush fill:#fef7e0
    style Compact fill:#f3e5f5
    style Tier fill:#fce4ec
    style GC fill:#e0f2fe