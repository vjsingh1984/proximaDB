%%{init: {'theme':'default'}}%%
graph TB
    %% Collection Service Architecture (2025-08-06)
    %% Shows how collection metadata and storage assignments work
    
    subgraph client[" Client Layer "]
        API[REST/gRPC API]:::api
        SDK[Python SDK]:::sdk
    end
    
    subgraph service[" Collection Service "]
        CS[CollectionService]:::service
        Meta[Metadata Backend]:::metadata
        
        subgraph metadata_structure[" Collection Metadata "]
            CM[Collection]:::proto
            Config[CollectionConfig]:::proto
            Stats[CollectionStats]:::proto
            SA[StorageAssignment]:::assignment
        end
    end
    
    subgraph storage[" Storage Layer "]
        DVS[DirectVectorService]:::dvs
        VIPER[VIPER Engine]:::engine
        SST[SST Engine]:::engine
        WAL[Write-Ahead Log]:::wal
    end
    
    subgraph filesystem[" File System "]
        DataDir[Data Directory]:::dir
        WALDir[WAL Directory]:::dir
        MetaDir[Metadata Directory]:::dir
    end
    
    %% Flow for Collection Creation
    API -->|CreateCollection| CS
    CS -->|1. Generate UUID| CM
    CS -->|2. Assign Storage| SA
    SA -->|data_location| DataDir
    SA -->|wal_location| WALDir
    CS -->|3. Persist| Meta
    Meta -->|Store Collection| MetaDir
    
    %% Flow for Vector Operations
    SDK -->|Insert/Search| API
    API -->|Vector Operation| DVS
    DVS -->|Get Metadata| CS
    CS -->|Return with SA| DVS
    DVS -->|Route by Engine| VIPER
    DVS -->|Route by Engine| SST
    
    %% Storage Assignment Details
    SA -.->|Contains| data_loc[data_location: URL]:::detail
    SA -.->|Contains| wal_loc[wal_location: URL]:::detail
    SA -.->|Contains| loc_idx[location_index: u32]:::detail
    SA -.->|Contains| assigned[assigned_at: timestamp]:::detail
    
    %% WAL Recovery Flow
    DVS -->|On Startup| WAL
    WAL -->|List Collections| CS
    CS -->|Return with SA| WAL
    WAL -->|Scan wal_location| WALDir
    
    %% Annotations
    CS -.- note1[No Assignment Service<br/>Storage managed internally]:::note
    SA -.- note2[Replaces AssignmentService<br/>Embedded in Collection]:::note
    WAL -.- note3[Uses metadata for<br/>WAL discovery]:::note
    
    %% Styling
    classDef api fill:#3498db,stroke:#2980b9,stroke-width:2px,color:#fff
    classDef sdk fill:#e74c3c,stroke:#c0392b,stroke-width:2px,color:#fff
    classDef service fill:#f39c12,stroke:#d68910,stroke-width:2px,color:#fff
    classDef metadata fill:#2ecc71,stroke:#27ae60,stroke-width:2px,color:#fff
    classDef proto fill:#9b59b6,stroke:#8e44ad,stroke-width:2px,color:#fff
    classDef assignment fill:#e67e22,stroke:#d35400,stroke-width:3px,color:#fff
    classDef dvs fill:#1abc9c,stroke:#16a085,stroke-width:2px,color:#fff
    classDef engine fill:#34495e,stroke:#2c3e50,stroke-width:2px,color:#fff
    classDef wal fill:#95a5a6,stroke:#7f8c8d,stroke-width:2px,color:#fff
    classDef dir fill:#ecf0f1,stroke:#bdc3c7,stroke-width:2px,color:#2c3e50
    classDef detail fill:#fff3cd,stroke:#856404,stroke-width:1px,color:#856404
    classDef note fill:#d1ecf1,stroke:#0c5460,stroke-width:1px,color:#0c5460,stroke-dasharray: 5 5