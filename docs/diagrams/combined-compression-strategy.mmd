            V4 --> V5[Parquet<br/>Storage]
            
            V2 -.-> VM[.vmeta<br/>Sidecar]
            
            style V2 fill:#e8f5e9
            style V3 fill:#e1f5fe
            style V4 fill:#fff3e0
        end
        
        subgraph "SST Engine Pipeline"
            direction LR
