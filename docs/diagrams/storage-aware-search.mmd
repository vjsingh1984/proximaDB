graph LR
    subgraph "Client Request"
        QUERY["Search Query<br/>k=10, vector=..."]
    end
    
    subgraph "Storage-Aware Router"
        ROUTER[Polymorphic Router<br/>Auto Engine Selection]
        DETECT[Location Detection<br/>WriteBuffer/Storage/Compacted]
    end
    
    subgraph "Three-Layer Search"
        subgraph "Layer 1: WriteBuffer"
            WriteBuffer_SEARCH[WriteBuffer Search<br/>Recent Vectors]
            WriteBuffer_RESULTS[Latest Updates]
        end
        
        subgraph "Layer 2: Storage"
            VIPER_SEARCH[VIPER Search<br/>Columnar Scan]
            SST_SEARCH[SST Search<br/>SSTable Scan]
            STORAGE_RESULTS[Main Dataset]
        end
        
        subgraph "Layer 3: Compacted"
            COMPACT_SEARCH[Compacted Search<br/>Optimized Data]
            COMPACT_RESULTS[Historical Data]
        end
    end
    
    subgraph "Result Processing"
        MERGE[Result Merger<br/>Version Ordering]
        DEDUP[Deduplication<br/>MVCC Resolution]
        TOPK[Top-K Selection<br/>Final Results]
    end
    
    QUERY --> ROUTER
    ROUTER --> DETECT
    
    DETECT --> WriteBuffer_SEARCH
    DETECT --> VIPER_SEARCH
    DETECT --> SST_SEARCH
    DETECT --> COMPACT_SEARCH
    
    WriteBuffer_SEARCH --> WriteBuffer_RESULTS
    VIPER_SEARCH --> STORAGE_RESULTS
    SST_SEARCH --> STORAGE_RESULTS
    COMPACT_SEARCH --> COMPACT_RESULTS
    
    WriteBuffer_RESULTS --> MERGE
    STORAGE_RESULTS --> MERGE
    COMPACT_RESULTS --> MERGE
    
    MERGE --> DEDUP
    DEDUP --> TOPK
    
    style ROUTER fill:#f9f,stroke:#333,stroke-width:2px
    style MERGE fill:#bbf,stroke:#333,stroke-width:2px
    style TOPK fill:#bfb,stroke:#333,stroke-width:2px
    
    classDef performance fill:#ffd,stroke:#330,stroke-width:2px
    class DETECT,WriteBuffer_SEARCH,VIPER_SEARCH,SST_SEARCH performance