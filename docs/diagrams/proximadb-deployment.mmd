    %% Client connections
    PythonSDK --> LB
    RestClient --> LB
    GrpcClient --> LB
    SQLClient --> LB

    %% Load balancer to servers
    LB --> REST1
    LB --> REST2
    LB --> REST3
    LB --> GRPC1
    LB --> GRPC2
    LB --> GRPC3

    %% Server components
    REST1 --> Server1
    GRPC1 --> Server1
    REST2 --> Server2
    GRPC2 --> Server2
    REST3 --> Server3
    GRPC3 --> Server3

    %% Storage hierarchy
    Server1 --> Mem1
    Mem1 --> NVMe1
    NVMe1 --> HDD1
    
    Server2 --> Mem2
    Mem2 --> NVMe2
    NVMe2 --> HDD2
    
    Server3 --> Mem3
    Mem3 --> NVMe3
    NVMe3 --> HDD3

    %% Shared storage
    HDD1 --> S3
    HDD2 --> S3
    HDD3 --> S3
    
    Server1 --> NFS
    Server2 --> NFS
    Server3 --> NFS

    %% GPU acceleration
    Server1 -.->|Distance Computation| GPU1
    Server2 -.->|Distance Computation| GPU2
    Server3 -.->|Distance Computation| GPU3

    %% Service discovery
    Server1 --> Consul
    Server2 --> Consul
    Server3 --> Consul
    
    %% Monitoring
    Server1 --> Prometheus
    Server2 --> Prometheus
    Server3 --> Prometheus
    Prometheus --> Grafana
    
    Server1 --> OpenTelemetry
    Server2 --> OpenTelemetry
    Server3 --> OpenTelemetry

