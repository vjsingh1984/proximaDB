graph TB
    %% Client Layer
    subgraph ClientLayer["🌐 Client Layer"]
        Python["Python SDK<br/>proximadb-python"]
        REST["REST API<br/>:5678"]
        GRPC["gRPC API<br/>:5679"]
    end
    
    %% API Gateway & Routing
    subgraph APIGateway["⚡ API Gateway"]
        VOS["VectorOperationsService<br/>40-60% latency reduction<br/>Direct memtable access"]
        Router["Intelligent Router<br/>Collection-aware<br/>Protocol selection"]
    end
    
    %% Query Planning & Optimization
    subgraph QueryOptimization["🎯 Query Optimization"]
        QueryPlanner["Query Planner<br/>Compression-aware<br/>Hardware-optimized"]
        BloomFilter["Bloom Filters<br/>95% scan reduction<br/>3-stage filtering"]
        CacheOrchestrator["Cache Orchestrator<br/>Multi-tier caching<br/>LRU/LFU/ARC"]
    end
    
    %% Storage Engines
    subgraph StorageEngines["💾 Storage Engines"]
        VIPER["VIPER Engine<br/>Columnar format<br/>Analytics-optimized<br/>Parquet-based"]
        SST["SST Engine<br/>Row format<br/>OLTP-optimized<br/>LSM-tree based"]
        WAL["Write-Ahead Log<br/>Durability<br/>Recovery"]
    end
    
    %% Compression & Quantization
    subgraph Compression["🗜️ Compression & Quantization"]
        CompEngine["Compression Engine<br/>ZSTD/LZ4/Snappy<br/>Adaptive selection"]
        QuantEngine["Quantization Engine<br/>INT8/PQ/Binary<br/>Two-stage search"]
    end
    
    %% Hardware Acceleration
    subgraph HardwareAccel["🚀 Hardware Acceleration"]
        SIMD["SIMD/AVX-512<br/>Vector operations<br/>Auto-detection"]
