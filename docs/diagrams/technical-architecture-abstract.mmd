        Memory["Memory Pool<br/>Zero-copy<br/>Buffer reuse"]
    end
    
    %% AXIS Tiering System
    subgraph AXISTiering["📊 AXIS Tiering"]
        TierManager["Tier Manager<br/>Hot→Warm→Cold<br/>Auto-migration"]
        StorageTiers["Storage Tiers<br/>Memory→NVMe→SSD→S3<br/>Cost-optimized"]
    end
    
    %% Indexing Algorithms
    subgraph Indexing["🔍 Index Algorithms"]
        HNSW["HNSW<br/>Graph-based<br/>High recall"]
        IVF["IVF<br/>Clustering<br/>Scalable"]
        LSH["LSH<br/>Hash-based<br/>Fast approximate"]
    end
    
    %% Monitoring & Metrics
    subgraph Monitoring["📈 Observability"]
        Metrics["Metrics Collector<br/>OpenTelemetry<br/>Real-time stats"]
        Tracing["Distributed Tracing<br/>Performance analysis"]
    end
    
    %% Connections - Request Flow
    Python --> REST
    Python --> GRPC
    
    REST --> VOS
    GRPC --> VOS
    
    VOS --> Router
    Router --> QueryPlanner
    
    QueryPlanner --> BloomFilter
    QueryPlanner --> CacheOrchestrator
    
    Router --> VIPER
    Router --> SST
    
    VIPER --> CompEngine
    SST --> CompEngine
    
    CompEngine --> QuantEngine
    
    %% Storage Integration
    VIPER --> WAL
    SST --> WAL
    
    %% Hardware Integration
    QuantEngine --> SIMD
    SIMD --> Memory
    GPU -.->|Optional| Memory
    
    %% AXIS Integration
    VIPER --> TierManager
    SST --> TierManager
    TierManager --> StorageTiers
    
    %% Index Integration
    QueryPlanner --> HNSW
    QueryPlanner --> IVF
    QueryPlanner --> LSH
    
    %% Monitoring Integration
    VOS --> Metrics
    Router --> Tracing
    
