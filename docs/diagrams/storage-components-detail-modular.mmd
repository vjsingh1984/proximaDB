    %% Storage Module - Focused on persistence and storage engine capabilities
    
    class StorageEngine {
        <<Interface>>
        storage/traits.rs
        +insert_vectors(params: InsertParameters) Result~InsertResult~
        +search_vectors(params: SearchParameters) Result~SearchResult~
        +delete_vectors(params: DeleteParameters) Result~DeleteResult~
        +do_flush(params: FlushParameters) Result~FlushResult~
        +compact(params: CompactionParameters) Result~CompactionResult~
        +get_engine_stats() EngineStatistics
        Unified Storage Interface
        Engine Abstraction
    }
    
    class ViperEngine {
        <<ConcreteEngine>>
        storage/engines/viper/engine.rs
        -parquet_writer: ParquetWriter
        -unified_search_engine: ViperUnifiedSearchEngine
        -compression_config: CompressionConfig
        +insert_vectors() Result~InsertResult~
        +search_vectors_unified() Result~Vec~SearchResult~~
        +do_flush() Result~FlushResult~
        +optimize_for_analytics() Result~()~
        Columnar Storage (Parquet)
        Analytics-Optimized
        Dual Column Strategy
    }
    
    class SstEngine {
        <<ConcreteEngine>>
        storage/engines/sst/mod.rs
        -sstable_manager: SstableManager
        -hierarchical_sst: HierarchicalSstManager
        -bloom_filters: SmartBloomFilterManager
        +insert_vectors() Result~InsertResult~
        +search_vectors_unified() Result~Vec~SearchResult~~
        +do_flush() Result~FlushResult~
        +optimize_for_oltp() Result~()~
        Row-based SST Files
        OLTP-Optimized
        Hierarchical Architecture
    }
    
    class WriteAheadLog {
        <<Component>>
        storage/persistence/write_ahead_log/mod.rs
        -log_writer: LogWriter
        -recovery_manager: RecoveryManager
        +append(record: VectorRecord) Result~LogPosition~
        +flush() Result~()~
        +recover(position: LogPosition) Result~Vec~VectorRecord~~
        +trim(before: LogPosition) Result~()~
        Durability Guarantee
        Point-in-Time Recovery
        Proto Serialization
    }
    
    class Memtable {
        <<Component>>
        storage/memtable/mod.rs
        -data: DashMap~String, VectorRecord~
        -index: MemoryIndex
        -flush_threshold: usize
        +insert(record: VectorRecord) Result~()~
        +search(query: SearchQuery) Result~Vec~SearchResult~~
        +flush_to_storage() Result~()~
        +size() usize
        In-Memory Buffer
        Fast Write Access
        Automatic Flush
    }
    
    class CompressionEngine {
        <<Component>>
        core/compression/mod.rs
        -algorithm: CompressionAlgorithm
        -level: CompressionLevel
        -context: CompressionContext
        +compress(data: Vec~u8~) Result~Vec~u8~~
        +decompress(data: Vec~u8~) Result~Vec~u8~~
        +analyze_compression_ratio(data: Vec~u8~) f32
        +optimize_for_context(context: CompressionContext) Self
        13 Algorithms Supported
        Context-Aware Processing
        SDK-Driven Configuration
    }
    
    class StorageCoordinator {
        <<Coordinator>>
        storage/coordinator.rs
        -engines: Vec~Box~dyn StorageEngine~~
        -routing_strategy: RoutingStrategy
        +route_operation(operation: StorageOperation) Box~dyn StorageEngine~
        +coordinate_dual_engine_search() Result~Vec~SearchResult~~
        +balance_load() Result~()~
        Engine Orchestration
        Load Balancing
        Dual Engine Coordination
    }
    
    %% Inheritance relationships
    StorageEngine <|-- ViperEngine : implements
    StorageEngine <|-- SstEngine : implements
    
    %% Composition relationships
    ViperEngine *-- CompressionEngine : uses
    SstEngine *-- CompressionEngine : uses
    ViperEngine *-- WriteAheadLog : persists to
    SstEngine *-- WriteAheadLog : persists to
    Memtable *-- WriteAheadLog : backed by
    
    %% Coordination relationships
    StorageCoordinator --> ViperEngine : coordinates
    StorageCoordinator --> SstEngine : coordinates
    StorageCoordinator --> Memtable : manages
    
