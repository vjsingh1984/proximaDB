  'secondaryColor':'#3b82f6',
  'tertiaryColor':'#e2e8f0',
  'background':'#f8fafc',
  'mainBkg':'#ffffff',
  'secondBkg':'#f1f5f9',
  'tertiaryBkg':'#e2e8f0',
  'fontSize':'11px', 
  'fontFamily':'Inter, -apple-system, sans-serif'
