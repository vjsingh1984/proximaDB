classDiagram
    class RestServer {
        +port: u16
        +handlers: UnifiedHandlers
        +start(config: ServerConfig) Result~()~
        +health_check() HealthStatus
        +register_routes() Router
    }
    
    class GrpcServer {
        +port: u16
        +services: VectorOperationsServiceImpl
        +start(config: ServerConfig) Result~()~
        +register_services() ServiceBuilder
        +with_reflection() ServiceBuilder
    }
    
    class UnifiedHandlers {
        +vector_operations_service: Arc~VectorOperationsService~
        +collection_service: Arc~CollectionService~
        +handle_vector_insert(request: InsertRequest) Result~Response~
        +handle_vector_search(request: SearchRequest) Result~Response~
        +handle_collection_create(request: CreateRequest) Result~Response~
    }
    
    class VectorOperationsServiceImpl {
        +vector_operations_service: Arc~VectorOperationsService~
        +insert_vectors(request: InsertVectorsRequest) Result~Response~
        +search_vectors(request: SearchRequest) Result~Response~
        +delete_vectors(request: DeleteRequest) Result~Response~
    }
    
    class NetworkCoordinator {
        +rest_server: RestServer
        +grpc_server: GrpcServer
        +start_all_services() Result~()~
        +graceful_shutdown() Result~()~
        +health_status() SystemHealth
    }
    
    %% Relationships
    RestServer --> UnifiedHandlers : uses
    GrpcServer --> VectorOperationsServiceImpl : uses
    NetworkCoordinator --> RestServer : manages
    NetworkCoordinator --> GrpcServer : manages
    UnifiedHandlers --> VectorOperationsServiceImpl : shares logic
    
    %% Professional styling
    classDef serverStyle fill:#dbeafe,stroke:#1d4ed8,stroke-width:2px,color:#1e293b,font-weight:bold
    classDef handlerStyle fill:#f0fdf4,stroke:#16a34a,stroke-width:2px,color:#14532d,font-weight:bold
    classDef coordinatorStyle fill:#fef2f2,stroke:#dc2626,stroke-width:2px,color:#7f1d1d,font-weight:bold
    
    class RestServer serverStyle
    class GrpcServer serverStyle
    class UnifiedHandlers handlerStyle
    class VectorOperationsServiceImpl handlerStyle
    class NetworkCoordinator coordinatorStyle