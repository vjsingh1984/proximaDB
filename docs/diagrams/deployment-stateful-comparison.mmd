graph LR
    subgraph "Stateless Deployment (Recommended)"
        subgraph "Compute"
            COMPUTE_S[Stateless Compute Instance<br/>(e.g., Kubernetes Pod)]
        end
        subgraph "Storage"
            STORAGE_S[Cloud-Native Object Storage<br/>(e.g., S3, GCS, Azure Blob)]
        end
        COMPUTE_S --> STORAGE_S
        subgraph "Benefits"
            B1_S[✓ Instant AZ Failover]
            B2_S[✓ No Data Migration]
            B3_S[✓ Auto-Scaling]
            B4_S[✓ Zero-Downtime Updates]
            B5_S[✓ Multi-Region Ready]
        end
        subgraph "Cost Structure"
            COST_S[Lower TCO<br/>(Optimized for Cloud)]
        end
    end
    
    subgraph "Stateful Deployment (Performance-Oriented)"
        subgraph "Compute"
            COMPUTE_F[Stateful Compute Instance<br/>(e.g., VM with Attached Disk)]
        end
        subgraph "Storage"
            STORAGE_F[High-Performance Persistent Disk<br/>(e.g., EBS, Azure Disk, PD-SSD)]
        end
        COMPUTE_F --> STORAGE_F
        subgraph "Limitations"
            L1_F[✗ AZ-Locked]
            L2_F[✗ Manual Failover]
            L3_F[✗ Downtime for Resize]
            L4_F[✗ Complex Backup]
            L5_F[✗ Single-Region Bound]
        end
        subgraph "Cost Structure"
            COST_F[Higher TCO<br/>(Higher Storage Costs)]
        end
    end
    
    subgraph "Traditional Database Cluster"
        subgraph "Compute"
            COMPUTE_T[Multiple Database Nodes<br/>(Primary/Replicas)]
        end
        subgraph "Infrastructure"
            INFRA_T[Load Balancers, Monitoring, Backup Systems]
        end
        COMPUTE_T --> INFRA_T
        subgraph "Cost Structure"
            COST_T[Highest TCO<br/>(Complex Infrastructure)]
        end
    end
