            AppNGRPC["gRPC Server<br/> :5679<br/> Binary Proto<br/> VectorOperationsService"]
        end
    end
    
    %% Multi-Disk Storage Configuration with Block Size Optimization
    subgraph Storage[" Multi-Disk Storage Configuration"]
        subgraph HighPerf[" High-Performance Tier"]
            NVMe1["NVMe SSD 1<br/> Hot Data Storage<br/> <100μs Latency<br/> block_size_kb = 512-1024<br/> IOPS Optimized"]
            NVMe2["NVMe SSD 2<br/> Index Storage<br/> AXIS Indexes<br/> block_size_kb = 1024<br/> Search Optimization"]
        end
        
        subgraph Standard["💿 Standard Tier"]
            SSD1["SATA SSD 1<br/>💿 Warm Data Storage<br/> ~1ms Latency<br/> block_size_kb = 2048<br/> Balanced Performance"]
