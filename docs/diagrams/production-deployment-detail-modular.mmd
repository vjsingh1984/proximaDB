        subgraph Archive[" Archive Tier"]
            HDD1["SATA HDD 1<br/> Cold Data Archive<br/> ~10ms Latency<br/> block_size_kb = 256-512<br/> Cost Optimized"]
            HDD2["SATA HDD 2<br/> Backup Storage<br/> block_size_kb = 512<br/> Sequential I/O"]
        end
    end
    
    %% Database & Metadata
    subgraph DataLayer[" Data & Metadata Layer"]
        MetadataDB["Metadata Database<br/> PostgreSQL/FileStore<br/> Collection Metadata<br/> Query Planning"]
        
        ConfigStore["Configuration Store<br/> Configuration Management<br/> Runtime Settings<br/> Performance Tuning"]
    end
    
    %% Cloud Storage Integration with Optimized Block Sizes
    subgraph CloudTier[" Multi-Cloud Storage"]
        subgraph AWS["🔶 Amazon Web Services"]
            S3["S3 Storage<br/> Object Storage<br/> block_size_kb = 3072-4096<br/> API Efficiency Optimized<br/> 7 calls → 1-2 calls"]
            EBS["EBS gp3 Volumes<br/> Block Storage<br/> block_size_kb = 256-3072<br/> IOPS: 16K, Throughput: 1GB/s<br/> Sequential 256KB blocks"]
        end
        
        subgraph Azure["🔷 Microsoft Azure"]
            BlobStorage["Blob Storage<br/> Cool/Archive Tiers<br/> block_size_kb = 3072-8192<br/> Cost vs Performance Balance<br/> Lifecycle Management"]
            PremiumSSD["Premium SSD<br/> Ultra Low Latency<br/> block_size_kb = 512-4096<br/> 80K IOPS, 1.2GB/s<br/> Custom Performance"]
        end
        
        subgraph GCP["🔴 Google Cloud Platform"]
            CloudStorage["Cloud Storage<br/> Nearline/Coldline<br/> block_size_kb = 1024-8192<br/> Cost-Effective Processing<br/> Auto-class Management"]
            PersistentDisk["Persistent Disk<br/> SSD Extreme/Balanced<br/> block_size_kb = 256-4096<br/> 120K IOPS, 4GB/s<br/> Regional Persistence"]
        end
    end
    
    %% Monitoring & Operations
    subgraph Monitoring[" Monitoring & Operations"]
        Prometheus["Prometheus<br/> Metrics Collection<br/>⏰ Time-series Data<br/> Alerting Rules"]
        
        Grafana["Grafana<br/> Visualization<br/> Performance Dashboards<br/> Real-time Monitoring"]
        
        Logging["Centralized Logging<br/> ELK Stack/Splunk<br/> Log Aggregation<br/>🐛 Troubleshooting"]
