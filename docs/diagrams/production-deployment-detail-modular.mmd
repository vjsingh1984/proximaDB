    App1REST --> NVMe1
    App1REST --> SSD1
    App1GRPC --> NVMe2
    App1GRPC --> SSD2
    
    App2REST --> NVMe1
    App2REST --> SSD1
    App2GRPC --> NVMe2
    App2GRPC --> SSD2
    
    %% Archive & Cold Storage
    SSD1 -.->|"Archive Policy"| HDD1
    SSD2 -.->|"Backup Policy"| HDD2
    
    %% Cloud Integration
    NVMe1 -.->|"Hybrid Cloud"| EBS
    NVMe2 -.->|"Hybrid Cloud"| PremiumSSD
    SSD1 -.->|"Cloud Sync"| S3
    SSD2 -.->|"Cloud Sync"| BlobStorage
    HDD1 -.->|"Cold Archive"| CloudStorage
    HDD2 -.->|"Disaster Recovery"| PersistentDisk
    
    %% Metadata & Configuration
    App1REST --> MetadataDB
    App2REST --> MetadataDB
    AppNREST --> ConfigStore
    
