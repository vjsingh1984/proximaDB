%%{init: {"theme":"neutral", "themeVariables": {"primaryColor":"#2563eb","primaryTextColor":"#ffffff","primaryBorderColor":"#1e40af","lineColor":"#64748b","secondaryColor":"#10b981","secondaryTextColor":"#ffffff","tertiaryColor":"#f59e0b","tertiaryTextColor":"#ffffff","background":"transparent","mainBkg":"#ffffff","secondBkg":"#f8fafc","textColor":"#1e293b","nodeTextColor":"#1e293b","fontFamily":"-apple-system, BlinkMacSystemFont, Segoe UI, Roboto, sans-serif","fontSize":"14px","clusterBkg":"#f1f5f9","clusterBorder":"#cbd5e1","edgeLabelBackground":"#ffffff"}}}%%
flowchart TD
    %% Input Stage
    Start([ Vector Search Request<br/> Query Vector + Filters<br/> Top-K Results])
    
    %% Query Processing
    QueryParse{ Parse Search Query<br/> Extract Components}
    VectorQuery[Vector Component<br/> 128-4096 dimensions<br/> Distance Metric]
    MetadataFilter[Metadata Filters<br/> WHERE conditions<br/> Collection scope]
    
    %% Stage 1: Coarse Search
    Stage1{ Stage 1: Coarse Search<br/> Approximate Filtering}
    
    %% Index Selection
    IndexSelect{ AXIS Index Selection<br/> Performance Optimization}
    HNSW[ HNSW Index<br/> High Precision<br/> Graph Traversal]
    IVF[ IVF Index<br/> Large Scale<br/> Clustering-based]
    LSH[ LSH Index<br/> Binary/Hamming<br/> Hash-based]
    Annoy[ Annoy Index<br/> Fast Approximate<br/> Tree-based]
    
    %% Coarse Results
    CoarseResults[ Coarse Candidates<br/> 10-100x Target K<br/> Fast Retrieval]
    
    %% Stage 2: Fine Search  
    Stage2{ Stage 2: Fine Search<br/> Exact Distance Calculation}
    
    %% Distance Computation
    DistanceCalc[ Distance Calculation<br/> compute/unified_distance.rs<br/> SIMD Optimized<br/> Hardware Accelerated]
    
    %% Metadata Application
    MetadataApply{ Apply Metadata Filters<br/> WHERE clause processing}
    FilteredResults[ Filtered Results<br/> Exact Matches<br/> Score + Metadata]
    
    %% Final Processing
    RankingSort[ Ranking & Sorting<br/> Score Normalization<br/> Top-K Selection]
    
    %% Output
    FinalResults([ Final Results<br/> Top-K Vectors<br/> <10ms p95<br/> 99.9% Accuracy])
    
    %% Flow Connections
    Start --> QueryParse
    QueryParse --> VectorQuery
    QueryParse --> MetadataFilter
    
    VectorQuery --> Stage1
    MetadataFilter --> Stage1
    
    Stage1 --> IndexSelect
    
    %% Index Selection Branches
    IndexSelect -->|High Precision| HNSW
    IndexSelect -->|Large Scale| IVF  
    IndexSelect -->|Binary/Hamming| LSH
    IndexSelect -->|Fast Approximate| Annoy
    
    HNSW --> CoarseResults
    IVF --> CoarseResults
    LSH --> CoarseResults
    Annoy --> CoarseResults
    
    CoarseResults --> Stage2
    Stage2 --> DistanceCalc
    DistanceCalc --> MetadataApply
    
    MetadataApply -->|Filters Match| FilteredResults
    MetadataApply -->|Filters Fail| DistanceCalc
    
    FilteredResults --> RankingSort
    RankingSort --> FinalResults
    
    %% Performance Annotations
    Stage1 -.->|"10-100x Candidates"| CoarseResults
    DistanceCalc -.->|"SIMD Accelerated"| FilteredResults
    RankingSort -.->|"Top-K Selection"| FinalResults
    
    %% Decision Styling
    classDef startStyle fill:#38a169,stroke:#2f855a,stroke-width:3px,color:#000000
    classDef processStyle fill:#3182ce,stroke:#2c5aa0,stroke-width:2px,color:#000000
    classDef decisionStyle fill:#805ad5,stroke:#6b46c1,stroke-width:2px,color:#000000
    classDef indexStyle fill:#d69e2e,stroke:#b7791f,stroke-width:2px,color:#000000
    classDef resultStyle fill:#e53e3e,stroke:#c53030,stroke-width:2px,color:#000000
    classDef endStyle fill:#38b2ac,stroke:#319795,stroke-width:3px,color:#000000
    
    class Start,FinalResults startStyle
    class VectorQuery,MetadataFilter,CoarseResults,DistanceCalc,FilteredResults,RankingSort processStyle
    class QueryParse,Stage1,Stage2,IndexSelect,MetadataApply decisionStyle
    class HNSW,IVF,LSH,Annoy indexStyle