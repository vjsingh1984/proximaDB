graph LR
    subgraph Analysis["Vector Analysis"]
        Input[Input Vectors<br/>FP32 Array]
        
        Similarity{Check<br/>Similarity}
        Sparsity{Check<br/>Sparsity}
        Precision{Check<br/>Precision}
        
        Input --> Similarity
        Input --> Sparsity
        Input --> Precision
    end
    
    subgraph Techniques["Compression Techniques"]
        XOR[XOR Delta Encoding<br/>40-60% compression<br/>for similar vectors]
        
        Adaptive[Adaptive Precision<br/>50-75% compression<br/>controlled loss]
        
        SparseFormat[Sparse Formats<br/>COO/CSR/RLE<br/>70-90% for sparse]
        
        BitPack[Bit Packing<br/>4-6 bit quantization<br/>81-87% compression]
        
        Standard[Standard ZSTD<br/>10-30% compression<br/>general purpose]
    end
    
    subgraph Selection["Adaptive Selection"]
        Similarity -->|High >0.8| XOR
        Similarity -->|Low <0.3| Standard
        
        Sparsity -->|>70% zeros| SparseFormat
        Sparsity -->|Dense| CheckPrecision{Precision<br/>Needed?}
        
        Precision -->|Can Reduce| Adaptive
        Precision -->|Full Required| Standard
        
        CheckPrecision -->|Low| BitPack
        CheckPrecision -->|High| Standard
    end
    
    subgraph Storage["SST Block Format V2"]
        Header[Block Header<br/>- Magic: SST2<br/>- Compression Type<br/>- Vector Encoding<br/>- Dimensions<br/>- Checksums]
        
        CompressedData[Compressed Data<br/>Based on Selected<br/>Technique]
        
        XOR --> Header
        Adaptive --> Header
        SparseFormat --> Header
        BitPack --> Header
        Standard --> Header
        
        Header --> CompressedData
    end
    
    subgraph Decompression["Streaming Decompression"]
        Reader[Streaming Reader<br/>Constant Memory]
        Decompress[Decompress Next<br/>Vector on Demand]
        Skip[Skip Capability<br/>for Range Queries]
        
        CompressedData --> Reader
        Reader --> Decompress
        Reader --> Skip
        
        Decompress --> Output[FP32 Vector<br/>for Distance Calc]
    end
    
    style Analysis fill:#e1f5fe
    style Techniques fill:#f3e5f5
    style Selection fill:#fff9c4
    style Storage fill:#ffecb3
    style Decompression fill:#c8e6c9