graph TB
    %% Client Request Layer
    subgraph ClientLayer["Client Requests"]
        RestReq["REST Request<br/>HTTP/JSON<br/>:5678/vectors"]
        GrpcReq["gRPC Request<br/>Binary Proto<br/>:5679"]
    end
    
    %% Vector Operations Service Core
    subgraph ServiceCore["VectorOperationsService Core"]
        ServiceMain["VectorOperationsService<br/>services/vector_operations_service.rs<br/>Direct Memtable Access<br/>40-60% Latency Reduction"]
        
        Operations["Core Operations<br/>• insert_vectors()<br/>• search_vectors()<br/>• delete_vectors()<br/>• route_to_engine()"]
    end
    
    %% Engine Routing Logic
    subgraph RoutingLogic["Engine Routing"]
        CollectionRouter["Collection Router<br/>Collection-Aware<br/>Engine Selection"]
        
        EngineMap["Engine Mapping<br/>HashMap<String, Engine><br/>O(1) Lookup"]
    end
    
    %% Storage Engine Integration
    subgraph StorageEngines["Storage Engines"]
        ViperDirect["VIPER Direct Access<br/>engines/viper/engine.rs<br/>Columnar Operations<br/>ML-Optimized"]
        
        SstDirect["SST Direct Access<br/>engines/sst/mod.rs<br/>Row-based Operations<br/>Range Queries"]
    end
    
    %% Memory Management
    subgraph MemoryMgmt["Memory Management"]
        DirectMemtable["Direct Memtable<br/>memtable/implementations/<br/>No Indirection<br/>Lock-Free Access"]
        
        VectorPool["Vector Memory Pool<br/>compute/memory_pool.rs<br/>Buffer Reuse<br/>30-50% Allocation Reduction"]
    end
    
    %% Performance Features
    subgraph PerfFeatures["Performance Features"]
        BatchOpt["Batch Optimization<br/>500-1000 Vector Batches<br/>Vectorized Operations"]
        
        ZeroCopy["Zero-Copy Design<br/>Proto Direct Access<br/>No Serialization Overhead"]
        
        HardwareAccel["Hardware Acceleration<br/>SIMD Instructions<br/>GPU Support (Optional)"]
    end
    
    %% Response Path
    subgraph ResponsePath["Response Processing"]
        ResultAgg["Result Aggregation<br/>Multi-Engine Results<br/>Score Normalization"]
        
        ResponseFormat["Response Formatting<br/>Proto → JSON (REST)<br/>Direct Proto (gRPC)"]
    end
    
    %% Request Flow
    RestReq --> ServiceMain
    GrpcReq --> ServiceMain
    
    ServiceMain --> Operations
    Operations --> CollectionRouter
    CollectionRouter --> EngineMap
    
    EngineMap --> ViperDirect
    EngineMap --> SstDirect
    
    ViperDirect --> DirectMemtable
    SstDirect --> DirectMemtable
    DirectMemtable --> VectorPool
    
    %% Performance Integration
    Operations --> BatchOpt
    Operations --> ZeroCopy
    VectorPool --> HardwareAccel
    
    %% Response Flow
    ViperDirect --> ResultAgg
    SstDirect --> ResultAgg
    ResultAgg --> ResponseFormat
    ResponseFormat --> RestReq
    ResponseFormat --> GrpcReq
    
    %% Performance Metrics Annotations
    ServiceMain -.->|"40-60% Faster"| Operations
    DirectMemtable -.->|"No Indirection"| VectorPool
    BatchOpt -.->|"500-1000 Batch"| HardwareAccel
    ZeroCopy -.->|"Zero Serialization"| ResponseFormat
    
