%% ProximaDB Enterprise Architecture - Comprehensive Class Diagram
%% Generated from codebase analysis - September 12, 2025

classDiagram
    %% ==============================================
    %% CORE STORAGE ENGINE ARCHITECTURE
    %% ==============================================
    
    class UnifiedStorageEngine {
        <<trait>>
        +engine_name() String
        +strategy() StorageEngineStrategy
        +do_flush(params: FlushParameters) Result~FlushResult~
        +do_compact(params: CompactionParameters) Result~CompactionResult~
        +search_vectors_unified(ctx: StorageQueryContext) Result~Vec~OptimizedSearchRecord~~
        +vector_by_id(collection_id: str, vector_id: str) Result~Option~VectorRecord~~
        +collect_engine_metrics() Result~HashMap~String, Value~~
    }
    
    class SstStorage {
        -write_buffer: WriteBuffer
        -bloom_filters: BloomFilterManager
        -compaction_manager: CompactionManager
        +new(config: SstConfig) Self
        +insert_vector(record: VectorRecord) Result~()~
        +search_with_filters(query: SearchQuery) Result~Vec~SearchResult~~
        +get_statistics() SstStatistics
    }
    
    class ViperEngine {
        -parquet_writer: ParquetWriter
        -column_filters: ColumnFilterManager
        -quantization_engine: UnifiedQuantizationEngine
        +new(config: ViperConfig) Self
        +write_batch(vectors: Vec~VectorRecord~) Result~()~
        +columnar_search(query: ColumnarQuery) Result~SearchResult~
        +optimize_storage() Result~()~
    }
    
    class NovaEngine {
        -hierarchical_cache: HierarchicalStatsCache
        -progressive_search: ProgressiveSearchEngine
        -quantized_columns: QuantizedColumnManager
        +new(config: NovaConfig) Self
        +progressive_search(query: ProgressiveQuery) Result~Vec~SearchResult~~
        +optimize_quantization() Result~()~
    }
    
    class SwiftEngine {
        -superblock_cache: SuperblockCache
        -hierarchical_blocks: HierarchicalBlockManager
        +new(config: SwiftConfig) Self
        +fast_search(query: FastQuery) Result~Vec~SearchResult~~
        +optimize_superblocks() Result~()~
    }
    
    class RaptorEngine {
        -rowgroup_manager: RowGroupManager
        -adaptive_pxk: AdaptivePxKOptimizer
        +new(config: RaptorConfig) Self
        +adaptive_search(query: AdaptiveQuery) Result~SearchResult~
        +optimize_rowgroups() Result~()~
    }
    
    class PrismEngine {
        -memory_optimizer: MemoryOptimizer
        -tree_navigator: TreeNavigator
        +new(config: PrismConfig) Self
        +memory_optimized_search(query: MemoryQuery) Result~SearchResult~
        +navigate_tree(path: TreePath) Result~Vec~Node~~
    }
    
    class HelixEngine {
        -spiral_storage: SpiralStorageManager
        -time_series_optimizer: TimeSeriesOptimizer
        +new(config: HelixConfig) Self
        +temporal_search(query: TemporalQuery) Result~SearchResult~
        +optimize_spiral_pattern() Result~()~
    }

    %% ==============================================
    %% QUERY SYSTEM ARCHITECTURE
    %% ==============================================
    
    class QueryEngine {
        -vector_ops: Arc~VectorOperationsService~
        -optimizer: UnifiedQueryOptimizer
        +new(services: SharedServices) Self
        +execute_sql(sql: str) Result~SqlExecutionResult~
        +execute_vector_search(query: VectorSearchQuery) Result~VectorSearchResult~
        +explain_sql(sql: str) Result~ExplainPlan~
    }
    
    class ExecutionPlanner {
        -vector_service: Arc~VectorOperationsService~
        -graph_service: Arc~GraphService~
        -cost_model: CostModel
        -cache_orchestrator: Option~Arc~CrossCacheOrchestrator~~
        +new(vector_service: Arc~VectorOperationsService~, graph_service: Arc~GraphService~) Self
        +with_cache(vector_service: Arc~VectorOperationsService~, graph_service: Arc~GraphService~, cache: Arc~CrossCacheOrchestrator~) Self
        +create_plan(query: Query) Result~ExecutionPlan~
        +plan_select(select: Select) Result~ExecutionPlan~
        +generate_cache_key(query: Query) String
    }
    
    class QueryExecutor {
        -vector_service: Option~Arc~VectorOperationsService~~
        -graph_service: Arc~GraphService~
        -memory_pool: VectorPool
        +new(vector_service: Option~Arc~VectorOperationsService~~, graph_service: Arc~GraphService~) Self
        +execute_plan(plan: ExecutionPlan) Result~QueryResult~
        +execute_vector_search(collection_id: str, query_vector: Option~Vec~f32~~, filters: Option~FilterExpression~, top_k: usize, distance_metric: str) Result~Vec~QueryRow~~
        +union_rows(left: Vec~QueryRow~, right: Vec~QueryRow~, all: bool) Result~Vec~QueryRow~~
        +intersect_rows(left: Vec~QueryRow~, right: Vec~QueryRow~, all: bool) Result~Vec~QueryRow~~
        +except_rows(left: Vec~QueryRow~, right: Vec~QueryRow~, all: bool) Result~Vec~QueryRow~~
    }

    class VectorPool {
        -query_row_pool: Arc~Mutex~Vec~Vec~QueryRow~~~~
        -field_map_pool: Arc~Mutex~Vec~HashMap~String, Value~~~~
        +new() Self
        +get_query_row_vec() Vec~QueryRow~
        +return_query_row_vec(vec: Vec~QueryRow~)
        +get_field_map() HashMap~String, Value~
        +return_field_map(map: HashMap~String, Value~)
    }

    %% ==============================================
    %% CACHE SYSTEM ARCHITECTURE  
    %% ==============================================
    
    class CrossCacheOrchestrator {
        -query_cache: Option~Arc~QueryCache~~
        -filter_cache: Option~Arc~BitmapFilterCache~~
        -index_cache: Option~Arc~IndexNodeCache~~
        -metadata_cache: Option~Arc~MetadataStore~~
        -pattern_tracker: Arc~AccessPatternTracker~
        -memory_allocator: Arc~DynamicMemoryAllocator~
        -prefetch_engine: Arc~PredictivePrefetchEngine~
        +new(total_budget: usize) Self
        +get(cache_type: CacheType, key: str) Result~Option~Vec~u8~~~
        +put(cache_type: CacheType, key: String, value: Vec~u8~, ttl: Option~Duration~) Result~()~
        +remove(cache_type: CacheType, key: str) Result~()~
        +execute_batch(batch: BatchCacheOperation) Result~Vec~Option~Vec~u8~~~~
        +get_metrics() Result~CacheMetrics~
    }
    
    class DistanceTableCache {
        -cache_orchestrator: Arc~CrossCacheOrchestrator~
        -config: CacheConfig
        +new(config: CacheConfig, cache_orchestrator: Arc~CrossCacheOrchestrator~) Result~Self~
        +get_or_compute(key: DistanceTableKey, compute_fn: F) Result~Vec~Vec~f32~~~
        +warm_cache_batch(keys: Vec~DistanceTableKey~, compute_fn: F) Result~()~
        +prefetch_related(base_key: DistanceTableKey) Result~()~
        +get_statistics() CacheStats
    }

    class VectorPool {
        -query_row_pool: Arc~Mutex~Vec~Vec~QueryRow~~~~
        -field_map_pool: Arc~Mutex~Vec~HashMap~String, Value~~~~
        +new() Self
        +get_query_row_vec() Vec~QueryRow~
        +return_query_row_vec(vec: Vec~QueryRow~)
        +get_field_map() HashMap~String, Value~
        +return_field_map(map: HashMap~String, Value~)
    }

    %% ==============================================
    %% INDEX SYSTEM (AXIS ENGINE)
    %% ==============================================
    
    class AxisManager {
        -config: AxisConfig
        -global_id_index: GlobalIdIndex
        -dense_vector_index: DenseVectorIndex
        -sparse_vector_index: SparseVectorIndex
        -metadata_index: MetadataIndex
        -event_log: Arc~EventLog~
        +new(config: AxisConfig) Result~Self~
        +index_vector(vector_record: VectorRecord) Result~()~
        +search(query_vector: Vec~f32~, k: usize) Result~Vec~SearchResult~~
        +update_index_statistics() Result~()~
        +get_index_stats() Result~IndexStatistics~
    }
    
    class MigrationEngine {
        -config: MigrationConfig
        -performance_analyzer: PerformanceAnalyzer
        +new(config: MigrationConfig) Self
        +calculate_performance_improvement(from: IndexSelectionStrategy, to: IndexSelectionStrategy, migration_duration: Duration) f64
        +algorithm_performance_score(algorithm: IndexAlgorithm) f64
        +data_type_multiplier(data_type: Data) f64
        +estimate_migration_cost(strategy: MigrationStrategy) Result~MigrationCost~
    }

    %% ==============================================
    %% SERVICES LAYER
    %% ==============================================
    
    class CollectionService {
        -storage_engine: Arc~StorageEngine~
        -metadata_backend: Arc~MetadataBackend~
        -axis_manager: Arc~AxisManager~
        -index_config_cache: Arc~DashMap~String, IndexConfig~~
        +new(storage_engine: Arc~StorageEngine~, metadata_backend: Arc~MetadataBackend~, axis_manager: Arc~AxisManager~) Self
        +create_collection(config: CreateCollectionRequest) Result~Collection~
        +get_collection(id: str) Result~Option~Collection~~
        +delete_collection(id: str) Result~()~
        +list_collections() Result~Vec~Collection~~
    }
    
    class VectorOperationsService {
        -storage_engine: Arc~StorageEngine~
        -axis_manager: Arc~AxisManager~
        -event_log: Arc~EventLogService~
        +new(storage_engine: Arc~StorageEngine~, axis_manager: Arc~AxisManager~) Self
        +insert_vectors(collection_id: str, vectors: Vec~VectorRecord~) Result~InsertResult~
        +execute_search_internal(request: SearchRequest) Result~SearchResult~
        +update_vector(collection_id: str, vector_id: str, vector: VectorRecord) Result~()~
        +delete_vector(collection_id: str, vector_id: str) Result~()~
    }
    
    class GraphService {
        -orion_engine: Arc~OrionEngine~
        -pulsar_engine: Arc~PulsarEngine~
        -quasar_engine: Arc~QuasarEngine~
        +new(config: GraphConfig) Result~Self~
        +execute_traversal(request: GraphTraversalRequest) Result~GraphTraversalResult~
        +get_stats() Result~GraphStats~
        +add_edge(edge: Edge) Result~()~
        +remove_edge(edge_id: str) Result~()~
    }

    %% ==============================================
    %% API LAYER
    %% ==============================================
    
    class UnifiedHandlers {
        -shared_services: Arc~SharedServices~
        -metrics_collector: Arc~MetricsCollector~
        +new(services: Arc~SharedServices~) Self
        +create_collection(request: CreateCollectionRequest) Result~Collection~
        +insert_vectors(request: InsertVectorsRequest) Result~InsertVectorsResponse~
        +search_vectors(request: SearchVectorsRequest) Result~SearchVectorsResponse~
        +delete_collection(request: DeleteCollectionRequest) Result~DeleteCollectionResponse~
    }
    
    class MultiServer {
        -rest_server: Option~RestServer~
        -grpc_server: Option~GrpcServer~
        -handlers: Arc~UnifiedHandlers~
        -auth_middleware: AuthMiddleware
        +new(config: MultiServerConfig) Self
        +start() Result~()~
        +stop() Result~()~
        +status() ServerStatus
    }

    %% ==============================================
    %% MONITORING & ENTERPRISE FEATURES
    %% ==============================================
    
    class EnterpriseDashboard {
        -system_collector: Arc~SystemMetricsCollector~
        -query_collector: Arc~QueryMetricsCollector~
        -storage_collector: Arc~StorageMetricsCollector~
        -cache_orchestrator: Option~Arc~CrossCacheOrchestrator~~
        -alert_config: AlertConfiguration
        -active_alerts: Arc~RwLock~HashMap~String, ActiveAlert~~~
        +new(collectors: ...) Result~Self~
        +get_dashboard_state() Result~DashboardState~
        +update_metrics() Result~()~
        +check_alerts(state: DashboardState) Result~()~
        +export_json() Result~String~
    }
    
    class MetricsCollector {
        -operation_metrics: DashMap~String, OperationMetrics~
