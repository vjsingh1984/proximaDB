        -entity_headers: DashMap~String, EntityHeader~
        -entity_to_vectors: DashMap~String, Vec~String~~
        -vector_to_entity: DashMap~String, String~
        +global() Option~Arc~Self~~
        +store_entity(collection_id: str, entity: Entity) Result~()~
        +get_entity(collection_id: str, entity_id: str) Result~Option~Entity~~
        +batch_filter_entities(collection_id: str, filters: Vec~MetadataFilter~, limit: Option~usize~) Result~Vec~Entity~~
        +stream_entities(collection_id: str, filters: Vec~MetadataFilter~, batch_size: usize) impl Stream~Item=Result~Vec~Entity~~~
        +header_matches_filter(header: EntityHeader, filter: MetadataFilter) bool
