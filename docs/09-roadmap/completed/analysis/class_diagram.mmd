    %% ==============================================
    %% COMPUTE & DISTANCE LAYER
    %% ==============================================
    
    class UnifiedDistanceCompute {
        -backend: ComputeBackend
        -hardware_features: HardwareFeatures
        +auto_select_backend() ComputeBackend
        +compute_distances(query: Vec~f32~, vectors: Vec~Vec~f32~~, metric: DistanceMetric) Result~Vec~f32~~
        +batch_compute(queries: Vec~Vec~f32~~, vectors: Vec~Vec~f32~~) Result~Vec~Vec~f32~~~
        +detect_hardware() HardwareFeatures
    }
    
    class UnifiedQuantizationEngine {
        -quantization_config: QuantizationConfig
        -codebook_store: Arc~dyn CodebookStore~
        +new(config: QuantizationConfig) Self
        +quantize_vectors(vectors: Vec~Vec~f32~~, level: QuantizationLevel) Result~QuantizedVectors~
        +dequantize_vectors(quantized: QuantizedVectors) Result~Vec~Vec~f32~~~
        +auto_select_quantization(vectors: Vec~Vec~f32~~) QuantizationLevel
    }

