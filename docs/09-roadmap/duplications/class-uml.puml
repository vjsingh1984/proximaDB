@startuml
' title "ProximaDB High-Level Architecture"

package "Core" {
  class VectorRecord
  class InternalSearchResult
  class OptimizedSearchRecord
  class SimilarityResult
}

package "Compute" {
  class UnifiedDistanceCompute
}

package "Storage" {
  interface UnifiedStorageEngine
  class SstStorage
  class ViperEngine
  class NovaEngine
  class SwiftEngine
  class PrismEngine
  class RaptorEngine
}

package "Services" {
  class VectorOperationsService
  class CollectionService
  class GraphService
}

package "CLI" {
    class Cli
    class Commands
}

package "Bloom Filters" {
    interface BloomFilterStrategy
    class SstableBloomFilter
    class BloomFilterBuilder
}

package "Generic Wrappers" {
    class GenericConfig<T>
    class GenericMetadata<T>
    class GenericStats<T>
    class GenericResult<T>
}


VectorOperationsService --> UnifiedStorageEngine
CollectionService --> UnifiedStorageEngine
GraphService --> UnifiedStorageEngine

UnifiedStorageEngine <|-- SstStorage
UnifiedStorageEngine <|-- ViperEngine
UnifiedStorageEngine <|-- NovaEngine
UnifiedStorageEngine <|-- SwiftEngine
UnifiedStorageEngine <|-- PrismEngine
UnifiedStorageEngine <|-- RaptorEngine


note right of UnifiedDistanceCompute
  This class centralizes all distance
  and similarity calculations.
end note

note right of InternalSearchResult
  This struct is redundant with
  SimilarityResult and OptimizedSearchRecord.
end note

note right of Cli
  This CLI definition is duplicated
  across multiple benchmark binaries.
end note

note right of SstableBloomFilter
  This struct has duplicated logic
  with BloomFilterBuilder.
end note

note right of GenericConfig
  These generic wrappers have
  duplicated `new` and `with_*` methods.
end note

@enduml