    ViperEngine --|> UnifiedStorageEngine : "implements"
    ViperEngine --|> StorageEngineStrategy : "implements"
    SwiftEngine --|> UnifiedStorageEngine : "implements"
    PrismEngine --|> UnifiedStorageEngine : "implements"
    
    SstStorage ||--|| WriteAheadLogManager : "owns"
    WriteAheadLogManager ||--|| Memtable : "owns"
    WriteAheadLogManager ||--|| FlushCoordinator : "owns"
    
    CollectionService ||--|| MetadataStore : "uses"
    MetadataStore ||--|| MetadataBackend : "uses"
    FilestoreMetadataBackend --|> MetadataBackend : "implements"
    RocksDbMetadataBackend --|> MetadataBackend : "implements"
    
    VectorOperationsService ||--|| UnifiedQueryOptimizer : "owns"
    VectorOperationsService ||--o Collection : "caches"
    
    AxisManager ||--o Index : "manages multiple"
    HnswIndex --|> Index : "implements"
    IvfIndex --|> Index : "implements"
    LshIndex --|> Index : "implements"
    
    UnifiedStorageEngine ||--o VectorRecord : "stores"
    Collection ||--|| CollectionConfig : "owns"
    
    VectorOperationsService ||--|| DistanceComputationEngine : "uses"
    SstStorage ||--|| UnifiedQuantizationEngine : "uses"
    ViperEngine ||--|| UnifiedQuantizationEngine : "uses"
