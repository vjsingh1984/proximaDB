        +CollectionConfig config
        +Option~StorageAssignment~ storage_assignment
        +u32 created_at
        +Option~u32~ updated_at
        +CollectionStatus status
        +Option~CollectionStatistics~ statistics
    }

    class CollectionConfig {
        +String name
        +i32 dimension
        +i32 distance_metric
        +i32 storage_engine
        +Option~IndexConfig~ index_config
        +Option~CompressionConfig~ compression
        +Option~QuantizationConfig~ quantization
        +Option~CollectionSchema~ schema
    }

