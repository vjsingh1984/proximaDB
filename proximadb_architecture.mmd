```mermaid
classDiagram
    %% ==========================================
    %% MAIN APPLICATION AND DATABASE CORE
    %% ==========================================
    
    class ProximaDB {
        -Arc~RwLock~StorageEngine~~ storage
        -Option~MultiServer~ multi_server
        -Config _config
        +new(config: Config) ProximaDB
        +start() Result~()~
        +stop() Result~()~
        +server_status() Option~ServerStatus~
        +is_server_running() bool
        +http_server_address() Option~SocketAddr~
        +grpc_server_address() Option~SocketAddr~
    }

    %% ==========================================
    %% NETWORK LAYER (MULTI-SERVER ARCHITECTURE)
    %% ==========================================
    
    class MultiServer {
        -MultiServerConfig config
        -SharedServices shared_services
        +new(config: MultiServerConfig, services: SharedServices) MultiServer
        +start() Result~()~
        +stop() Result~()~
        +get_status() ServerStatus
    }

    class SharedServices {
        -Arc~VectorOperationsService~ vector_service
        -Arc~CollectionService~ collection_service
        -Arc~EventLogService~ event_log_service
        -Option~Arc~MetricsCollector~~ metrics_collector
        +new(metrics: Option~Arc~MetricsCollector~~, config: StorageConfig) Result~(SharedServices, Arc~CollectionService~)~
        +recover_vectors_from_write_buffer(storage: Arc~RwLock~StorageEngine~~) Result~()~
    }

    class RestHttpServer {
        -SocketAddr bind_address
        -Arc~SharedServices~ shared_services
        +new(config: RestHttpServerConfig, services: Arc~SharedServices~) Self
        +start() Result~()~
        +stop() Result~()~
    }

    class GrpcHttpServer {
        -SocketAddr bind_address
        -Arc~SharedServices~ shared_services
        +new(config: GrpcHttpServerConfig, services: Arc~SharedServices~) Self
        +start() Result~()~
        +stop() Result~()~
    }

    %% ==========================================
    %% CORE SERVICES
    %% ==========================================
    
    class VectorOperationsService {
        -Arc~dyn StorageEngine~ storage_engine
        -Arc~UnifiedQueryOptimizer~ query_optimizer
        -Arc~DashMap~String, Arc~Collection~~~ collection_cache
        +new(storage_engine: Arc~dyn StorageEngine~) Self
        +search_vectors_with_filters(...) Result~Vec~VectorRecord~~
        +execute_unified_plan(...) Result~Vec~VectorRecord~~
        +get_or_load_collection(id: String) Result~Arc~Collection~~
        +get_available_files(collection_id: String) Result~Vec~String~~
        +get_vector_count(collection_id: String) Result~usize~
        +get_column_count(collection_id: String) Result~usize~
    }

    class CollectionService {
        -Arc~FilestoreMetadataBackend~ metadata_backend
        -Arc~FilesystemFactory~ filesystem_factory
        -Arc~RwLock~HashMap~String, IndexConfig~~~ index_config_cache
        -StorageConfig storage_config
        +new(backend: Arc~FilestoreMetadataBackend~, config: StorageConfig) Result~Self~
        +create_collection(config: CollectionConfig) Result~CollectionServiceResponse~
        +get_collection(id: String) Result~Option~Collection~~
        +list_collections() Result~Vec~Collection~~
        +delete_collection(id: String) Result~()~
        +update_collection(...) Result~CollectionServiceResponse~
        +resolve_compression_config(...) Option~CompressionConfig~
        +create_default_index_config(...) IndexConfig
        +compute_storage_path(...) Result~String~
    }

    class EventLogService {
        -Arc~RwLock~HashMap~String, EventQueue~~~ queues
        -EventLogConfig config
        +new(config: EventLogConfig) Self
        +create_queue(collection_id: String) Result~()~
        +append_event(collection_id: String, event: FlushEvent) Result~EventOffset~
        +get_stats(collection_id: String) Result~EventLogStats~
        +acknowledge_consumption(...) Result~()~
        +get_events_since(...) Result~Vec~FlushEvent~~
        +cleanup_acknowledged_events(collection_id: String) Result~()~
    }

    %% ==========================================
    %% STORAGE ENGINE ARCHITECTURE
    %% ==========================================
    
    class StorageEngine {
        -Arc~RwLock~HashMap~String, Arc~dyn UnifiedStorageEngine~~~~~ lsm_trees
        -Arc~RwLock~HashMap~String, MmapReader~~~ mmap_readers
        -Arc~TransactionCoordinator~ transaction_coordinator
        -Option~Arc~dyn CollectionMetadataProvider~~ metadata_provider
        -StorageConfig config
        +new(config: StorageConfig) Result~Self~
        +new_without_collection_service(config: StorageConfig) Result~Self~
        +set_metadata_provider(provider: Arc~dyn CollectionMetadataProvider~)
        +start() Result~()~
        +stop() Result~()~
        +insert_vectors(...) Result~InsertResult~
        +search_vectors(...) Result~Vec~VectorRecord~~
        +delete_vectors(...) Result~()~
        +flush_collection(collection_id: String) Result~FlushResult~
        +compact_collection(collection_id: String) Result~CompactionResult~
        +get_collection_stats(collection_id: String) Result~StorageStatistics~
    }

    <<interface>> UnifiedStorageEngine {
        +insert(records: Vec~VectorRecord~) Result~InsertResult~
        +search(...) Result~Vec~VectorRecord~~
        +delete(ids: Vec~VectorId~) Result~()~
        +flush(params: FlushParameters) Result~FlushResult~
        +compact(params: CompactionParameters) Result~CompactionResult~
        +get_statistics() Result~EngineStatistics~
        +get_health() Result~EngineHealth~
    }

    <<interface>> StorageEngineStrategy {
        +supports_compression(algorithm: CompressionAlgorithm) bool
        +supports_quantization(level: QuantizationLevel) bool
        +supports_distance_metric(metric: DistanceMetric) bool
        +get_optimal_batch_size() usize
        +get_memory_footprint() usize
        +get_io_characteristics() IoCharacteristics
    }

    %% ==========================================
