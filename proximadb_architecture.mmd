        +set_gauge(name: String, value: f64)
        +record_histogram(name: String, value: f64)
        +get_metric(name: String) Option~MetricValue~
        +export_prometheus() String
        +export_json() String
        +get_all_metrics() HashMap~String, MetricValue~
    }

    %% ==========================================
    %% CORE DATA TYPES
    %% ==========================================
    
    class VectorRecord {
        +Option~String~ id
        +Vec~f32~ vector
        +Vec~MetadataItem~ metadata
        +u32 timestamp
        +Option~u32~ updated_at
        +Option~u32~ expires_at
        +Option~u32~ version
        +Option~Vec~u8~~ quantized_vector
        +serialize_with_config(config: VectorSerializationConfig) Result~Vec~u8~~
        +deserialize_with_config(data: &[u8], config: VectorSerializationConfig) Result~VectorRecord~
    }

    class Collection {
        +String id
