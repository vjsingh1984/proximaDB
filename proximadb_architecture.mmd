        +new(config: SstConfig, filesystem: Arc~FilesystemFactory~) Result~Self~
        +from_core_config(...) Result~Self~
        +write_sorted_vector_records(...) Result~()~
        +read_sstable_file(...) Result~Vec~VectorRecord~~
        +create_sstable_reader(...) Result~UnifiedSstableReader~
        +compact_sstables(...) Result~CompactionResult~
        +build_bloom_filter(records: &[VectorRecord]) Result~BloomFilter~
        +serialize_sstable_header(...) Result~Vec~u8~~
        +deserialize_sstable_header(data: &[u8]) Result~SstableHeader~
    }

    class ViperEngine {
        -ViperConfig config
        -Arc~ParquetManager~ parquet_manager
        -Arc~ColumnarCompactor~ compactor
        -Arc~FilesystemFactory~ filesystem_factory
        +new(config: ViperConfig, filesystem: Arc~FilesystemFactory~) Result~Self~
        +from_core_config(...) Result~Self~
        +write_parquet_batch(...) Result~()~
        +read_parquet_file(...) Result~Vec~VectorRecord~~
