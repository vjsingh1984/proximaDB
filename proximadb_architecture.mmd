    %% ==========================================
    %% WRITE-AHEAD LOG SUBSYSTEM
    %% ==========================================
    
    class WriteAheadLogManager {
        -WALConfig config
        -Arc~RwLock~Memtable~~ memtable
        -Arc~FlushCoordinator~ flush_coordinator
        -Arc~RecoveryManager~ recovery_manager
        -Arc~FilesystemFactory~ filesystem_factory
        +new(config: WALConfig, filesystem: Arc~FilesystemFactory~) Result~Self~
        +append_vector_batch(...) Result~BatchId~
        +flush_memtable_to_storage(...) Result~FlushResult~
        +recover_from_wal() Result~Vec~VectorRecord~~
        +compact_wal_segments() Result~()~
        +get_wal_statistics() Result~WALStatistics~
        +search_vectors_in_wal(...) Result~Vec~VectorRecord~~
    }

    class Memtable {
        -Arc~DashMap~VectorId, VectorRecord~~ data
        -Arc~AtomicUsize~ size_estimate
        -Arc~BloomFilter~ bloom_filter
        +new() Self
        +insert(record: VectorRecord) Result~()~
        +get(id: VectorId) Option~VectorRecord~
        +search_vectors(...) Result~Vec~VectorRecord~~
        +drain_all() Vec~VectorRecord~
        +size_estimate() usize
        +len() usize
        +clear()
        +contains_id(id: VectorId) bool
    }

    class FlushCoordinator {
        -FlushConfig config
        -Arc~Sender~FlushTask~~ task_sender
        +new(config: FlushConfig) Result~Self~
