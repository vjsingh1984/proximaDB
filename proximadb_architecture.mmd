        +fast_lookup_by_id(id: VectorId) Result~Option~VectorRecord~~
        +batch_lookup_by_ids(ids: Vec~VectorId~) Result~Vec~VectorRecord~~
        +rebuild_id_index() Result~()~
    }

    class PrismEngine {
        -PrismConfig config
        -Vec~StorageTier~ tiers
        -Arc~TierManager~ tier_manager
        +new(config: PrismConfig) Result~Self~
