        +search_index(...) Result~Vec~ScoredResult~~
        +update_index(...) Result~()~
        +delete_from_index(...) Result~()~
        +get_index_statistics(index_name: String) Result~IndexStatistics~
        +optimize_index(index_name: String) Result~()~
    }

