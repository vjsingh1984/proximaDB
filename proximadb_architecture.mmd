        +get_flush_statistics() FlushStatistics
        +cancel_pending_flushes() Result~()~
    }

    %% ==========================================
    %% TRANSACTION COORDINATOR
    %% ==========================================
    
    class TransactionCoordinator {
        -Arc~DashMap~TransactionId, TransactionMetadata~~ active_operations
        -Arc~DashMap~String, StagingArea~~ staging_areas
        -StagingConfig config
        +new(config: StagingConfig) Self
        +begin_transaction(...) Result~TransactionId~
        +commit_transaction(tx_id: TransactionId) Result~()~
        +rollback_transaction(tx_id: TransactionId) Result~()~
        +stage_vectors(...) Result~()~
        +cleanup_completed_operations()
        +get_transaction_status(tx_id: TransactionId) Option~TransactionalOperationStatus~
    }

    %% ==========================================
    %% METADATA MANAGEMENT
    %% ==========================================
    
    class MetadataStore {
        -Arc~dyn MetadataBackend~ backend
        -Arc~RwLock~HashMap~String, Collection~~~ collection_cache
        +new(backend: Arc~dyn MetadataBackend~) Self
        +store_collection(collection: Collection) Result~()~
        +get_collection(id: String) Result~Option~Collection~~
        +list_collections() Result~Vec~Collection~~
