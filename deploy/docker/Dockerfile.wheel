# ProximaDB embedded-mode Python wheel builder
# ----------------------------------------------------------------------------
# Produces the `proximadb_embedded` wheel (PROXIMADB_MODE=embedded) for the
# linux target AnvaiOps deploys to. This is the ONLY artifact that needs
# PyO3/libpython — the server image stays Python-free.
#
# Build (wheel lands in ./wheels/):
#   docker build -f deploy/docker/Dockerfile.wheel \
#     --target export -o type=local,dest=./wheels .
#
# Mechanism: root [lib] is rlib-only (ADR-006); build.rs adds cdylib when
# CARGO_FEATURE_PYLIB is set, and maturin builds the pyo3 cdylib via the
# `python,pylib` features (see clients/python-embedded/pyproject.toml).
# ----------------------------------------------------------------------------
FROM rust:1.95-slim-bookworm AS wheelbuilder

# python3-dev + libpython for PyO3 link; maturin for the wheel.
RUN apt-get update && apt-get install -y --no-install-recommends \
    pkg-config \
    libssl-dev \
    cmake \
    protobuf-compiler \
    libprotobuf-dev \
    python3 \
    python3-dev \
    python3-pip \
    && rm -rf /var/lib/apt/lists/*
RUN pip3 install --no-cache-dir --break-system-packages "maturin>=1.4,<2.0"

WORKDIR /build
# .dockerignore excludes target/, .git/, docs/, benches/, ui/, node_modules/
COPY . .

# Build the wheel against the repo-root manifest with the embedded package's
# [tool.maturin] config (features = python,pylib; bindings = pyo3).
RUN cd clients/python-embedded \
 && maturin build --release -m ../../Cargo.toml --features python,pylib --compatibility linux --out /wheels \
 && ls -la /wheels && sha256sum /wheels/*.whl

# Export-only stage: `-o type=local,dest=./wheels` copies just the wheel out.
FROM scratch AS export
COPY --from=wheelbuilder /wheels/ /
