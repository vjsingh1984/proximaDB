<?xml version="1.0" encoding="UTF-8"?>
<!--
  ProximaDB Windows Installer (WiX v4)
  
  This manifest creates an MSI installer for ProximaDB on Windows.
  Build with: wix build proximadb.wxs -o proximadb-version-x64.msi
  
  Features:
  - Installs binaries to C:\Program Files\ProximaDB\
  - Creates config directory in C:\ProgramData\ProximaDB\
  - Adds binaries to PATH
  - Registers as Windows Service (optional)
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="ProximaDB" Version="$(var.Version)" Manufacturer="ProximaDB Contributors" UpgradeCode="YOUR-GUID-HERE" Scope="perMachine">
    
    <SummaryInformation Description="ProximaDB - Cloud-native vector database" Comments="High-performance vector database for AI applications" />
    
    <!-- Media: Single cabinet, embedded -->
    <Media Id="1" Cabinet="proximadb.cab" EmbedCompact="yes" />
    
    <!-- Installation Directory: Program Files -->
    <StandardDirectory Id="ProgramFilesFolder">
      <Directory Id="INSTALLFOLDER" Name="ProximaDB" />
    </StandardDirectory>
    
    <!-- Config Directory: ProgramData -->
    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="CONFIGDIR" Name="ProximaDB">
        <Component Id="ConfigDirComponent" Guid="*">
          <CreateFolder />
          <RemoveFolder Id="RemoveConfigDir" On="uninstall" />
        </Component>
      </Directory>
    </StandardDirectory>
    
    <!-- Data Directory: ProgramData -->
    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="DATADIR" Name="ProximaDBData">
        <Component Id="DataDirComponent" Guid="*">
          <CreateFolder />
          <RemoveFolder Id="RemoveDataDir" On="uninstall" />
        </Component>
      </Directory>
    </StandardDirectory>
    
    <!-- Main Feature: Binaries -->
    <Feature Id="Binaries" Title="ProximaDB Binaries" Level="1" AllowAbsent="no">
      <!-- Server Binary -->
      <Component Id="ServerComponent" Directory="INSTALLFOLDER" Guid="*">
        <File Id="ServerFile" Source="proximadb-server.exe" KeyPath="yes" />
      </Component>
      
      <!-- Benchmark Tool -->
      <Component Id="BenchComponent" Directory="INSTALLFOLDER" Guid="*">
        <File Id="BenchFile" Source="proximadb-bench.exe" />
      </Component>
      
      <!-- Migration Tool -->
      <Component Id="MigrateComponent" Directory="INSTALLFOLDER" Guid="*">
        <File Id="MigrateFile" Source="proximadb-migrate.exe" />
      </Component>
      
      <!-- Config File -->
      <Component Id="ConfigComponent" Directory="INSTALLFOLDER" Guid="*">
        <File Id="ConfigFile" Source="config.toml" />
      </Component>
      
      <!-- PATH Environment Variable -->
      <Component Id="PathComponent" Directory="INSTALLFOLDER" Guid="YOUR-GUID-HERE">
        <Environment Id="Path" Name="PATH" Value="[INSTALLFOLDER]" Permanent="no" Part="last" Action="set" System="yes" />
      </Component>
      
      <!-- Config and Data directories -->
      <ComponentRef Id="ConfigDirComponent" />
      <ComponentRef Id="DataDirComponent" />
    </Feature>
    
    <!-- Start Menu Shortcuts -->
    <Feature Id="Shortcuts" Title="Start Menu Shortcuts" Level="1">
      <Component Id="StartMenuComponent" Directory="ProgramMenuFolder" Guid="YOUR-GUID-HERE">
        <Directory Id="ProgramMenuFolder" Name="Programs">
          <Directory Id="ProximaDBMenuFolder" Name="ProximaDB">
            <Shortcut Id="ServerShortcut" Name="ProximaDB Server" Description="Start ProximaDB Server" Target="[INSTALLFOLDER]proximadb-server.exe" Arguments="--config &quot;[CONFIGDIR]config.toml&quot;" WorkingDirectory="INSTALLFOLDER" />
            <Shortcut Id="ConfigShortcut" Name="ProximaDB Config" Description="Edit ProximaDB Configuration" Target="[CONFIGDIR]config.toml" />
            <RemoveFolder Id="RemoveMenuFolder" On="uninstall" />
            <RegistryValue Root="HKCU" Key="Software\ProximaDB" Name="installed" Type="integer" Value="1" KeyPath="yes" />
          </Directory>
        </Directory>
      </Component>
    </Feature>
    
    <!-- Upgrade Detection -->
    <MajorUpgrade DowngradeErrorMessage="A newer version of ProximaDB is already installed." />
    
    <!-- Launch Condition: Windows 10+ -->
    <Launch Condition="Installed OR (VersionNT >= 603)" Message="ProximaDB requires Windows 8.1 or later." />
    
    <!-- Installation UI: Simple -->
    <UIRef Id="WixUI_InstallDir" />
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    
  </Package>
</Wix>
