<?xml version="1.0" encoding="UTF-8"?>
<!--
    Sample XML file for testing code chunking.

    This file contains various XML constructs to test parsing.
-->
<!DOCTYPE configuration [
    <!ENTITY maxRetries "3">
    <!ENTITY defaultTimeout "30.0">
]>
<configuration xmlns="http://proximadb.io/config"
               xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:schemaLocation="http://proximadb.io/config config.xsd">

    <!-- Metadata section -->
    <metadata>
        <version>1.0.0</version>
        <author>ProximaDB Team</author>
        <description>Sample configuration for testing</description>
        <createdAt>2025-01-01T00:00:00Z</createdAt>
    </metadata>

    <!-- Constants -->
    <constants>
        <constant name="maxRetries" type="integer">&maxRetries;</constant>
        <constant name="defaultTimeout" type="float">&defaultTimeout;</constant>
        <constant name="environment" type="string">production</constant>
    </constants>

    <!-- Server configuration -->
    <server>
        <host>localhost</host>
        <port>5678</port>
        <bindAddress>0.0.0.0</bindAddress>

        <tls enabled="true">
            <certFile>/etc/ssl/certs/server.crt</certFile>
            <keyFile>/etc/ssl/private/server.key</keyFile>
            <caFile>/etc/ssl/certs/ca.crt</caFile>
        </tls>

        <timeouts>
            <read unit="seconds">30</read>
            <write unit="seconds">30</write>
            <idle unit="seconds">120</idle>
        </timeouts>

        <rateLimit enabled="true">
            <requestsPerSecond>1000</requestsPerSecond>
            <burstSize>100</burstSize>
        </rateLimit>
    </server>

    <!-- Database configuration -->
    <database>
        <primary driver="postgres">
            <host>localhost</host>
            <port>5432</port>
            <name>proximadb</name>
            <credentials>
                <username>admin</username>
                <password encrypted="true">***</password>
            </credentials>
            <pool>
                <minConnections>10</minConnections>
                <maxConnections>100</maxConnections>
                <idleTimeout unit="minutes">30</idleTimeout>
            </pool>
        </primary>

        <replicas>
            <replica weight="50">
                <host>replica1.db.local</host>
                <port>5432</port>
            </replica>
            <replica weight="50">
                <host>replica2.db.local</host>
                <port>5432</port>
            </replica>
        </replicas>
    </database>

    <!-- Users -->
    <users>
        <user id="user_1">
            <name>Test User</name>
            <email>test@example.com</email>
            <roles>
                <role>admin</role>
                <role>developer</role>
            </roles>
            <metadata>
                <department>Engineering</department>
                <location>Remote</location>
            </metadata>
        </user>

        <user id="user_2">
            <name>Admin User</name>
            <email>admin@example.com</email>
            <roles>
                <role>super_admin</role>
            </roles>
            <metadata>
                <department>IT</department>
                <location>Headquarters</location>
            </metadata>
        </user>
    </users>

    <!-- Services -->
    <services>
        <service name="userService" enabled="true">
            <endpoints>
                <endpoint path="/api/v1/users">
                    <method>GET</method>
                    <method>POST</method>
                </endpoint>
                <endpoint path="/api/v1/users/{id}">
                    <method>GET</method>
                    <method>PUT</method>
                    <method>DELETE</method>
                </endpoint>
            </endpoints>
            <healthCheck>
                <endpoint>/health</endpoint>
                <interval unit="seconds">30</interval>
                <timeout unit="seconds">5</timeout>
            </healthCheck>
        </service>

        <service name="vectorService" enabled="true">
            <endpoints>
                <endpoint path="/api/v1/vectors">
                    <method>POST</method>
                </endpoint>
                <endpoint path="/api/v1/search">
                    <method>POST</method>
                </endpoint>
            </endpoints>
            <batchSize>1000</batchSize>
        </service>
    </services>

    <!-- Storage engines -->
    <storageEngines>
        <engine name="sst" enabled="true">
            <compression>lz4</compression>
            <blockSize>4096</blockSize>
        </engine>

        <engine name="helix" enabled="true">
            <hilbertOrder>16</hilbertOrder>
            <cacheSize unit="GB">1</cacheSize>
        </engine>

        <engine name="viper" enabled="true">
            <parquet>
                <rowGroupSize>1000000</rowGroupSize>
                <compression>snappy</compression>
            </parquet>
        </engine>
    </storageEngines>

    <!-- Logging -->
    <logging level="info" format="json">
        <outputs>
            <output type="console" level="debug"/>
            <output type="file" level="info">
                <path>/var/log/proximadb/app.log</path>
                <rotation>
                    <maxSize unit="MB">100</maxSize>
                    <maxAge unit="days">7</maxAge>
                    <maxBackups>5</maxBackups>
                </rotation>
            </output>
            <output type="syslog" level="warn">
                <facility>local0</facility>
            </output>
        </outputs>
    </logging>

    <!-- Workflow definition -->
    <workflow name="Data Processing Pipeline">
        <steps>
            <step id="fetch" action="fetchData">
                <params>
                    <param name="timeout">60</param>
                </params>
                <onSuccess>transform</onSuccess>
                <onFailure>alert</onFailure>
            </step>

            <step id="transform" action="transformData">
                <params>
                    <operations>
                        <operation type="filter">
                            <condition>status == 'active'</condition>
                        </operation>
                        <operation type="map">
                            <fields>
                                <field>id</field>
                                <field>name</field>
                                <field>value</field>
                            </fields>
                        </operation>
                    </operations>
                </params>
                <onSuccess>store</onSuccess>
            </step>

            <step id="store" action="storeResults">
                <params>
                    <param name="destination">database</param>
                    <param name="batchSize">1000</param>
                </params>
            </step>

            <step id="alert" action="sendAlert">
                <params>
                    <param name="channel">slack</param>
                    <param name="message">Pipeline failed</param>
                </params>
            </step>
        </steps>
    </workflow>

    <!-- Feature flags -->
    <features>
        <feature name="newSearchAlgorithm" enabled="true"/>
        <feature name="experimentalCaching" enabled="false"/>
        <feature name="advancedAnalytics" enabled="true"/>

        <rollout>
            <gradual enabled="true">
                <percentage>25</percentage>
            </gradual>
        </rollout>
    </features>

</configuration>
