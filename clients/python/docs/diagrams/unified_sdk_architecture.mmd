graph TB
    %% Client Layer
    Client[ProximaDB Client]:::client
    
    %% Unified Architecture Components (Updated 2025-08-06)
    subgraph unified[" Unified Architecture "]
        Router[Intelligent Router]:::router
        Batch[Unified Batch Manager]:::batch
        Cache[Smart Cache System]:::cache
        Pool[Resource Pool]:::pool
    end
    
    %% Protocol Layer
    subgraph protocols[" Protocol Handlers "]
        REST[REST Client]:::rest
        GRPC[gRPC Client]:::grpc
        ConnPool[Connection Pools]:::connpool
    end
    
    %% Features
    subgraph features[" Enhanced Features "]
        Chunking[Text Chunking]:::feature
        Embedding[Embedding Providers]:::feature
        Streaming[Vector Streaming]:::feature
    end
    
    %% Server
    Server[ProximaDB Server]:::server
    
    %% Connections
    Client --> Router
    Client --> Batch
    Client --> Cache
    Client --> Pool
    
    Router --> REST
    Router --> GRPC
    Router -.->|Dynamic Selection| protocols
    
    Batch -->|Protocol Aware| REST
    Batch -->|Protocol Aware| GRPC
    
    Cache -->|L1/L2 Cache| Client
    Cache -->|Prefetch| Server
    
    Pool -->|Connection Pooling| ConnPool
    Pool -->|Object Pooling| features
    
    REST --> ConnPool
    GRPC --> ConnPool
    ConnPool --> Server
    
    Chunking --> Client
    Embedding --> Client
    Streaming --> Client
    
    %% Performance Annotations
    Router -.- perf1[20-40% Better Routing]:::annotation
    Batch -.- perf2[2-3x Throughput]:::annotation
    Cache -.- perf3[85-95% Hit Rate]:::annotation
    Pool -.- perf4[20-35% Latency Reduction]:::annotation
    
    %% Styling
    classDef client fill:#3498db,stroke:#2980b9,stroke-width:3px,color:#fff
    classDef router fill:#e74c3c,stroke:#c0392b,stroke-width:2px,color:#fff
    classDef batch fill:#f39c12,stroke:#d68910,stroke-width:2px,color:#fff
    classDef cache fill:#2ecc71,stroke:#27ae60,stroke-width:2px,color:#fff
    classDef pool fill:#9b59b6,stroke:#8e44ad,stroke-width:2px,color:#fff
    classDef rest fill:#1abc9c,stroke:#16a085,stroke-width:2px,color:#fff
    classDef grpc fill:#34495e,stroke:#2c3e50,stroke-width:2px,color:#fff
    classDef connpool fill:#95a5a6,stroke:#7f8c8d,stroke-width:2px,color:#fff
    classDef feature fill:#ecf0f1,stroke:#bdc3c7,stroke-width:2px,color:#2c3e50
    classDef server fill:#2c3e50,stroke:#34495e,stroke-width:3px,color:#fff
    classDef annotation fill:#fff3cd,stroke:#856404,stroke-width:1px,color:#856404,stroke-dasharray: 5 5