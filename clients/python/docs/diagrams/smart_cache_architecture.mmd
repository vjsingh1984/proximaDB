%%{init: {
  'theme': 'default',
  'themeVariables': {
    'background': '#f5f7fa',
    'primaryColor': '#5c6ac4',
    'primaryTextColor': '#ffffff',
    'primaryBorderColor': '#43467f',
    'lineColor': '#43467f',
    'secondaryColor': '#00a0b0',
    'tertiaryColor': '#f4511e',
    'mainBkg': '#e4e5f1',
    'secondBkg': '#c1c6e2',
    'textColor': '#202223',
    'labelTextColor': '#202223',
    'classText': '#202223',
    'fillType0': '#ffc58b',
    'fillType1': '#f7b731',
    'fillType2': '#5fcbc3',
    'fillType3': '#5c6ac4',
    'fillType4': '#ab7bee',
    'fillType5': '#fe817f',
    'fillType6': '#68d2df',
    'fillType7': '#8b92c9'
  }
}}%%

graph TD
    %% Client requests
    Client[Client Request]:::client
    
    %% Smart Cache System
    subgraph cache[" Smart Cache System "]
        %% L1 Cache
        subgraph l1[" L1 Cache - Hot Data "]
            L1LFU[LFU Strategy<br/>100 entries]:::l1cache
            L1Hit{Cache Hit?}:::decision
        end
        
        %% L2 Cache
        subgraph l2[" L2 Cache - Warm Data "]
            L2LRU[LRU Strategy<br/>1000 entries]:::l2cache
            L2Hit{Cache Hit?}:::decision
            Promote[Promote to L1]:::action
        end
        
        %% Cache Features
        subgraph features[" Advanced Features "]
            Compress[Compression<br/>gzip/lz4]:::feature
            TTL[TTL Expiration<br/>per entry]:::feature
            Prefetch[Predictive<br/>Prefetching]:::feature
            Invalid[Smart<br/>Invalidation]:::feature
        end
    end
    
    %% Storage
    Server[ProximaDB Server]:::server
    
    %% Flow
    Client --> L1Hit
    L1Hit -->|Yes| CacheReturn1[Return Cached Data<br/>~0.1ms]:::success
    L1Hit -->|No| L2Hit
    
    L2Hit -->|Yes| Promote
    Promote --> CacheReturn2[Return Cached Data<br/>~0.5ms]:::success
    L2Hit -->|No| Server
    
    Server --> ServerReturn[Fetch from Server<br/>~10-50ms]:::fetch
    ServerReturn --> StoreL2[Store in L2]:::action
    ServerReturn --> CheckHot{Frequently<br/>Accessed?}:::decision
    CheckHot -->|Yes| StoreL1[Store in L1]:::action
    CheckHot -->|No| Return[Return to Client]:::return
    
    StoreL1 --> Return
    StoreL2 --> Return
    
    %% Feature connections
    L1LFU -.-> Compress
    L2LRU -.-> Compress
    L1LFU -.-> TTL
    L2LRU -.-> TTL
    Server -.-> Prefetch
    L1LFU -.-> Invalid
    L2LRU -.-> Invalid
    
    %% Metrics
    subgraph metrics[" Cache Metrics "]
        HitRate[Hit Rate: 85-95%]:::metric
        AvgLatency[Avg Latency: 0.3ms]:::metric
        Memory[Memory Usage: <100MB]:::metric
        Evictions[Evictions: LFU/LRU]:::metric
    end
    
    cache -.-> metrics
    
    %% Performance notes
    CacheReturn1 -.- perf1[100x faster than server]:::annotation
    CacheReturn2 -.- perf2[20x faster than server]:::annotation
    Prefetch -.- perf3[Reduces misses by 30%]:::annotation
    
    %% Styling
    classDef client fill:#5c6ac4,stroke:#43467f,stroke-width:3px,color:#fff
    classDef l1cache fill:#00a0b0,stroke:#007a86,stroke-width:2px,color:#fff
    classDef l2cache fill:#f7b731,stroke:#d49d1c,stroke-width:2px,color:#fff
    classDef decision fill:#ab7bee,stroke:#8659c3,stroke-width:2px,color:#fff
    classDef action fill:#5fcbc3,stroke:#3ca99f,stroke-width:2px,color:#fff
    classDef feature fill:#fe817f,stroke:#e5615f,stroke-width:2px,color:#fff
    classDef server fill:#43467f,stroke:#2d2f56,stroke-width:3px,color:#fff
    classDef success fill:#68d2df,stroke:#4ab8c7,stroke-width:3px,color:#fff
    classDef fetch fill:#f4511e,stroke:#d43a0f,stroke-width:2px,color:#fff
    classDef return fill:#8b92c9,stroke:#6970a5,stroke-width:2px,color:#fff
    classDef metric fill:#e4e5f1,stroke:#c1c6e2,stroke-width:2px,color:#202223
    classDef annotation fill:#fff8e1,stroke:#f9a825,stroke-width:1px,color:#e65100,stroke-dasharray: 5 5
    
    style cache fill:#f5f7fa,stroke:#5c6ac4,stroke-width:3px
    style l1 fill:#e0f7fa,stroke:#00a0b0,stroke-width:2px
    style l2 fill:#fff3e0,stroke:#f7b731,stroke-width:2px
    style features fill:#fce4ec,stroke:#fe817f,stroke-width:2px
    style metrics fill:#ede7f6,stroke:#ab7bee,stroke-width:2px