{
  "name": "@proximadb/client",
  "version": "1.0.0",
  "description": "TypeScript/Node.js SDK for ProximaDB vector database",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "module": "dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc && tsc -p tsconfig.esm.json",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write src/**/*.ts"
  },
  "keywords": [
    "proximadb",
    "vector",
    "database",
    "embeddings",
    "similarity-search",
    "ai",
    "ml",
    "graph",
    "typescript"
  ],
  "author": "ProximaDB Contributors",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/proximadb/proximadb.git",
    "directory": "clients/nodejs-embedded"
  },
  "bugs": {
    "url": "https://github.com/proximadb/proximadb/issues"
  },
  "homepage": "https://github.com/proximadb/proximadb#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0"
  },
  "peerDependencies": {},
  "optionalDependencies": {}
}
