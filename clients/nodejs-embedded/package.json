{
  "name": "proximadb-embedded",
  "version": "0.1.4",
  "description": "ProximaDB Embedded - In-process vector database for Node.js with zero network overhead",
  "main": "index.js",
  "types": "index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vjsingh1984/proximadb.git"
  },
  "homepage": "https://github.com/vjsingh1984/proximadb",
  "author": "Vijaykumar Singh <singhvjd@gmail.com>",
  "license": "Apache-2.0",
  "keywords": [
    "vector",
    "database",
    "embedded",
    "similarity-search",
    "ai",
    "ml",
    "embeddings",
    "rust",
    "napi"
  ],
  "engines": {
    "node": ">= 16"
  },
  "napi": {
    "name": "proximadb-embedded",
    "triples": {
      "additional": [
        "aarch64-apple-darwin",
        "aarch64-unknown-linux-gnu",
        "x86_64-apple-darwin",
        "x86_64-unknown-linux-gnu",
        "x86_64-pc-windows-msvc"
      ]
    }
  },
  "scripts": {
    "artifacts": "napi artifacts",
    "build": "napi build --platform --release --features nodejs",
    "build:debug": "napi build --platform --features nodejs",
    "prepublishOnly": "napi prepublish -t npm",
    "test": "jest",
    "universal": "napi universal",
    "version": "napi version"
  },
  "devDependencies": {
    "@napi-rs/cli": "^2.16.3",
    "@types/jest": "^29.5.5",
    "@types/node": "^20.8.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.2.2"
  },
  "optionalDependencies": {
    "proximadb-embedded-darwin-arm64": "0.1.4",
    "proximadb-embedded-darwin-x64": "0.1.4",
    "proximadb-embedded-linux-arm64-gnu": "0.1.4",
    "proximadb-embedded-linux-x64-gnu": "0.1.4",
    "proximadb-embedded-win32-x64-msvc": "0.1.4"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "README.md"
  ]
}
