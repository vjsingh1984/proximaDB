// Integration test for storage assignment path issues
// This test verifies that collection assignments work correctly end-to-end

use std::sync::Arc;
use anyhow::Result;
use tempfile::TempDir;

use proximadb::core::config::{StorageConfig, StorageLocation, AssignmentConfig};
use proximadb::core::VectorRecord;
use proximadb::services::collection_service::CollectionService;
use proximadb::services::direct_vector_service::DirectVectorService;
use proximadb::storage::metadata::backends::filestore_backend::FilestoreMetadataBackend;
use proximadb::storage::assignment_service::{get_assignment_service, HashBasedAssignmentService, set_assignment_service};
use proximadb::storage::persistence::filesystem::FilesystemFactory;
use proximadb::proto::proximadb::CollectionConfig;

#[tokio::test]
async fn test_storage_assignment_end_to_end() -> Result<()> {
    setup_hardware_capabilities();
    // Create temporary directory for test
    let temp_dir = TempDir::new()?;
    let temp_path = temp_dir.path().to_str().unwrap();
    
    // Setup storage configuration
    let storage_config = StorageConfig {
        metadata_url: format!("file://{}/metadata", temp_path),
        storage_locations: vec![StorageLocation {
            url: format!("file://{}/data", temp_path),
            weight: 1,
            tags: vec!["test".to_string()],
        }],
        assignment_config: AssignmentConfig {
            strategy: "hash".to_string(),
            affinity: true,
        },
        ..Default::default()
    };
    
    // Initialize assignment service
    let filesystem_factory = Arc::new(FilesystemFactory::new(Default::default()).await.unwrap());
    let assignment_service = Arc::new(HashBasedAssignmentService::new(filesystem_factory, "round_robin"));
    set_assignment_service(assignment_service.clone())?;
    
    // Create metadata backend
    let metadata_backend = Arc::new(
        FilestoreMetadataBackend::new(&storage_config.metadata_url, storage_config.clone()).await?
    );
    
    // Create collection service
    let collection_service = Arc::new(
        CollectionService::new(metadata_backend.clone(), storage_config.clone()).await?
    );
    
    // Step 1: Create a collection
    let collection_config = CollectionConfig {
        name: "test_assignment_collection".to_string(),
        dimension: 128,
        distance_metric: "cosine".to_string(),
        engine: "viper".to_string(),
        ..Default::default(),
                compression: None,
                optimization_hints: None,
            };
    
    let create_response = collection_service.create_collection(&collection_config).await?;
    assert!(create_response.success, "Collection creation failed: {:?}", create_response.error_message);
    
    let collection = create_response.collection.unwrap();
    let collection_id = collection.id.clone();
    let collection_name = collection.config.unwrap().name.clone();
    
    println!("✅ Created collection: name='{}', id='{}'", collection_name, collection_id);
    
    // Step 2: Verify assignment exists for collection ID (not name)
    let assignment = assignment_service.get_assignment(&collection_id).await;
    assert!(assignment.is_some(), "No assignment found for collection ID: {}", collection_id);
    
    let assignment = assignment.unwrap();
    println!("✅ Found assignment for collection ID '{}': WAL={}, Data={}", 
             collection_id, assignment.write_buffer_url, assignment.data_url);
    
    // Step 3: Verify assignment doesn't exist for collection name (old behavior)
    let name_assignment = assignment_service.get_assignment(&collection_name).await;
    assert!(name_assignment.is_none(), "Assignment should not exist for collection name: {}", collection_name);
    
    // Step 4: Test collection resolution
    let resolved_id = collection_service.resolve_collection_id(&collection_name).await?;
    assert_eq!(resolved_id, Some(collection_id.clone()), "Collection ID resolution failed");
    
    // Step 5: Create DirectVectorService and test vector insertion
    let direct_service = DirectVectorService::new_for_testing(
        metadata_backend,
        storage_config,
    ).await?;
    
    // Create test vectors
    let vectors = vec![
        VectorRecord {
            id: Some("test_vector_1".to_string())),
            vector: vec![0.1; 128],
            metadata: vec![],
            ..Default::default(),
            timestamp: 0,
            updated_at: None,
            expires_at: None,
            distance: None,
            rank: None,
            score: None,
        },
        VectorRecord {
            id: Some("test_vector_2".to_string())),
            vector: vec![0.2; 128],
            metadata: vec![],
            ..Default::default(),
            timestamp: 0,
            updated_at: None,
            expires_at: None,
            distance: None,
            rank: None,
            score: None,
        },
    ];
    
    // Step 6: Insert vectors using collection name (which should resolve to ID)
    let insert_result = direct_service.insert_vectors(&collection_name, vectors).await?;
    assert!(insert_result.success, "Vector insertion failed");
    assert_eq!(insert_result.metrics.successful_count, 2, "Expected 2 successful inserts");
    
    println!("✅ Vector insertion successful: {} vectors inserted", insert_result.metrics.successful_count);
    
    // Step 7: Verify WAL files were created using the assignment
    let filesystem_factory = proximadb::storage::persistence::filesystem::FilesystemFactory::new(Default::default()).await?;
    let filesystem = filesystem_factory.get_filesystem(&assignment.write_buffer_url)?;
    
    let wal_exists = filesystem.exists(&assignment.write_buffer_url).await?;
    assert!(wal_exists, "WAL directory should exist at: {}", assignment.write_buffer_url);
    
    println!("✅ WAL directory verified at: {}", assignment.write_buffer_url);
    
    // Step 8: Test search to ensure end-to-end functionality
    let search_result = direct_service.search_vectors(
        &collection_name,
        vec![0.1; 128],
        2,
        None,
        None,
    ).await?;
    
    assert!(search_result.results.len() > 0, "Search should return results");
    println!("✅ Search successful: {} results found", search_result.results.len());
    
    Ok(())
}

#[tokio::test]
async fn test_assignment_persistence_across_restarts() -> Result<()> {
    setup_hardware_capabilities();
    // Create temporary directory for test
    let temp_dir = TempDir::new()?;
    let temp_path = temp_dir.path().to_str().unwrap();
    
    let storage_config = StorageConfig {
        metadata_url: format!("file://{}/metadata", temp_path),
        storage_locations: vec![StorageLocation {
            url: format!("file://{}/data", temp_path),
            weight: 1,
            tags: vec!["test".to_string()],
        }],
        assignment_config: AssignmentConfig {
            strategy: "hash".to_string(),
            affinity: true,
        },
        ..Default::default()
    };
    
    let collection_name = "persistent_assignment_test";
    let collection_id: String;
    
    // Phase 1: Create collection and assignment
    {
        let filesystem_factory = Arc::new(FilesystemFactory::new(Default::default()).await.unwrap());
        let assignment_service = Arc::new(HashBasedAssignmentService::new(filesystem_factory, "round_robin"));
        set_assignment_service(assignment_service.clone())?;
        
        let metadata_backend = Arc::new(
            FilestoreMetadataBackend::new(&storage_config.metadata_url, storage_config.clone()).await?
        );
        
        let collection_service = Arc::new(
            CollectionService::new(metadata_backend, storage_config.clone()).await?
        );
        
        let collection_config = CollectionConfig {
            name: collection_name.to_string(),
            dimension: 64,
            distance_metric: "cosine".to_string(),
            engine: "viper".to_string(),
            ..Default::default(),
                compression: None,
                optimization_hints: None,
            };
        
        let create_response = collection_service.create_collection(&collection_config).await?;
        assert!(create_response.success);
        
        collection_id = create_response.collection.unwrap().id;
        
        // Verify assignment exists
        let assignment = assignment_service.get_assignment(&collection_id).await;
        assert!(assignment.is_some(), "Assignment should exist after creation");
        
        println!("✅ Phase 1: Created collection '{}' with ID '{}'", collection_name, collection_id);
    }
    
    // Phase 2: Simulate restart - new assignment service instance
    {
        let filesystem_factory = Arc::new(FilesystemFactory::new(Default::default()).await.unwrap());
        let new_assignment_service = Arc::new(HashBasedAssignmentService::new(filesystem_factory, "round_robin"));
        set_assignment_service(new_assignment_service.clone())?;
        
        // Assignment should not exist in new instance (until discovery)
        let assignment = new_assignment_service.get_assignment(&collection_id).await;
        assert!(assignment.is_none(), "Assignment should not exist in new instance before discovery");
        
        // Simulate discovery process
        let recovery_report = new_assignment_service
            .discover_and_recover(&storage_config.storage_locations)
            .await?;
        
        println!("✅ Phase 2: Discovery completed, found {} collections", 
                recovery_report.discovered_collections.len());
        
        // Assignment should now exist after discovery
        let recovered_assignment = new_assignment_service.get_assignment(&collection_id).await;
        assert!(recovered_assignment.is_some(), "Assignment should exist after discovery");
        
        println!("✅ Assignment recovered successfully for collection '{}'", collection_id);
    }
    
    Ok(())
}

#[tokio::test] 
async fn test_concurrent_assignment_access() -> Result<()> {
    setup_hardware_capabilities();
    use std::sync::Arc;
    use tokio::task::JoinSet;
    
    // Create temporary directory
    let temp_dir = TempDir::new()?;
    let temp_path = temp_dir.path().to_str().unwrap();
    
    let storage_config = StorageConfig {
        metadata_url: format!("file://{}/metadata", temp_path),
        storage_locations: vec![
            StorageLocation {
                url: format!("file://{}/data1", temp_path),
                weight: 1,
                tags: vec!["test".to_string()],
            },
            StorageLocation {
                url: format!("file://{}/data2", temp_path),
                weight: 1,
                tags: vec!["test".to_string()],
            },
        ],
        assignment_config: AssignmentConfig {
            strategy: "hash".to_string(),
            affinity: true,
        },
        ..Default::default()
    };
    
    // Initialize services
    let filesystem_factory = Arc::new(FilesystemFactory::new(Default::default()).await.unwrap());
    let assignment_service = Arc::new(HashBasedAssignmentService::new(filesystem_factory, "round_robin"));
    set_assignment_service(assignment_service.clone())?;
    
    let metadata_backend = Arc::new(
        FilestoreMetadataBackend::new(&storage_config.metadata_url, storage_config.clone()).await?
    );
    
    let collection_service = Arc::new(
        CollectionService::new(metadata_backend.clone(), storage_config.clone()).await?
    );
    
    let direct_service = Arc::new(
        DirectVectorService::new_for_testing(metadata_backend, storage_config).await?
    );
    
    // Create multiple collections concurrently
    let mut join_set = JoinSet::new();
    
    for i in 0..10 {
        let collection_service = collection_service.clone();
        let direct_service = direct_service.clone();
        let assignment_service = assignment_service.clone();
        
        join_set.spawn(async move {
            let collection_name = format!("concurrent_test_collection_{}", i);
            
            // Create collection
            let collection_config = CollectionConfig {
                name: collection_name.clone(),
                dimension: 32,
                distance_metric: "cosine".to_string(),
                engine: "viper".to_string(),
                ..Default::default(),
                compression: None,
                optimization_hints: None,
            };
            
            let create_response = collection_service.create_collection(&collection_config).await?;
            assert!(create_response.success);
            
            let collection_id = create_response.collection.unwrap().id;
            
            // Verify assignment exists
            let assignment = assignment_service.get_assignment(&collection_id).await;
            assert!(assignment.is_some(), "Assignment missing for collection {}", collection_id);
            
            // Insert vectors
            let vectors = vec![
                VectorRecord {
                    id: Some(format!("vector_{,
            timestamp: 0,
            updated_at: None,
            expires_at: None,
            distance: None,
            rank: None,
            score: None,
        }_{}", i, 1)),
                    vector: vec![0.1; 32],
                    metadata: vec![],
                    ..Default::default()
                },
            ];
            
            let insert_result = direct_service.insert_vectors(&collection_name, vectors).await?;
            assert!(insert_result.success, "Insert failed for collection {}", collection_name);
            
            Ok::<String, anyhow::Error>(collection_id)
        });
    }
    
    // Wait for all tasks to complete
    let mut collection_ids = Vec::new();
    while let Some(result) = join_set.join_next().await {
        let collection_id = result??;
        collection_ids.push(collection_id);
    }
    
    // Verify all assignments exist
    for collection_id in &collection_ids {
        let assignment = assignment_service.get_assignment(collection_id).await;
        assert!(assignment.is_some(), "Assignment missing for collection {}", collection_id);
    }
    
    println!("✅ Concurrent test completed: {} collections created and tested", collection_ids.len());
    
    Ok(())
}