{
  "_comment_header": [
    "Example multi-tier configuration for ProximaDB. Copy to",
    "config/tier-config.json and adjust the values for your deployment;",
    "or set the PROXIMADB_TIER_CONFIG_URL environment variable to a",
    "URL the container fetches at boot (see deploy/docker/entrypoint.sh).",
    "",
    "Schema contract: see config/TIER_CONFIG.md.",
    "",
    "This file is intentionally domain-neutral. It carries operational",
    "concerns only — caps, limits, feature toggles. Commercial concerns",
    "(dollars, currency, billing primitives, marketing copy) belong in",
    "a separate artifact OWNED BY THE OPERATOR, not in the engine."
  ],

  "schema_version": 1,
  "default_tier": "standard",

  "tiers": [
    {
      "id": "standard",
      "description": "Default tier for new tenants. Suitable for small workloads + evaluation.",
      "allowances": {
        "storage_gb": 5,
        "ingest_gb_per_month": 2,
        "embedding_gb_per_month": 0.5,
        "scan_gb_per_month": 50000,
        "max_collections": 5
      },
      "soft_caps": {
        "scan_budget_gb": 5.0,
        "ef_search_cap": 128,
        "freshness_sla_seconds": 300
      },
      "features": {
        "sync_ingest": false,
        "support_level": "community",
        "deployment_class": "pooled"
      }
    },
    {
      "id": "premium",
      "description": "Higher caps + sync ingest. For production workloads.",
      "allowances": {
        "storage_gb": 50,
        "ingest_gb_per_month": 20,
        "embedding_gb_per_month": 5,
        "scan_gb_per_month": 500000,
        "max_collections": 25
      },
      "soft_caps": {
        "scan_budget_gb": 50.0,
        "ef_search_cap": 320,
        "freshness_sla_seconds": 60
      },
      "features": {
        "sync_ingest": true,
        "support_level": "standard",
        "deployment_class": "pooled"
      }
    },
    {
      "id": "enterprise",
      "description": "Dedicated single-tenant deployments + custom SLAs.",
      "allowances": {
        "storage_gb": 500,
        "ingest_gb_per_month": 200,
        "embedding_gb_per_month": 50,
        "scan_gb_per_month": 5000000,
        "max_collections": 250
      },
      "soft_caps": {
        "scan_budget_gb": 500.0,
        "ef_search_cap": 768,
        "freshness_sla_seconds": 30
      },
      "features": {
        "sync_ingest": true,
        "support_level": "managed",
        "deployment_class": "dedicated"
      }
    }
  ]
}
