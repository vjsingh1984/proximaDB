FROM python:3.11-slim

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements
COPY demo/requirements.txt .

# Install Python dependencies
RUN pip install --no-cache-dir -r requirements.txt

# Download required NLTK data
RUN python -c "import nltk; nltk.download('punkt')"

# Copy Python SDK (build context is parent directory)
COPY clients/python /app/proximadb-sdk
RUN cd /app/proximadb-sdk && pip install -e .

# Copy all demo scripts
COPY demo/*.py ./
COPY demo/run_all_demos.sh ./

# Create results directory
RUN mkdir -p /app/results

# Make scripts executable
RUN chmod +x run_all_demos.sh

# Set environment variables
ENV PYTHONUNBUFFERED=1
ENV PROXIMADB_SERVER_URL=http://proximadb:5678
ENV PROXIMADB_GRPC_URL=proximadb:5679

# Default command runs all demos
CMD ["./run_all_demos.sh"]